---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import KanbanBoard from '../components/KanbanBoard.astro';
import QuickLeadFAB from '../components/QuickLeadFAB.astro';
import QuickExpenseFAB from '../components/expenses/QuickExpenseFAB.astro';
import LeadCaptureModal from '../components/LeadCaptureModal.astro';
import ShareFormModal from '../components/ShareFormModal.astro';
import Toast from '../components/Toast.astro';
---

<Layout title="ObraFlow — CRM de Ventas y Gestión de Obras">
	<!-- Top App Header -->
	<Header />

	<!-- Main CRM Kanban Workspace -->
	<main class="flex-1 flex flex-col overflow-hidden">
		<KanbanBoard />
	</main>

	<!-- HU-01: Quick Lead Floating Action Button (FAB) -->
	<QuickLeadFAB />

	<!-- HU-14: Quick Expense Floating Action Button (FAB) -->
	<QuickExpenseFAB />

	<!-- HU-01: Lead Capture Modal / Mobile Bottom-Sheet -->
	<LeadCaptureModal />

	<!-- HU-02: Share Public Web Form Modal -->
	<ShareFormModal />

	<!-- Global Toast System -->
	<Toast />
</Layout>
