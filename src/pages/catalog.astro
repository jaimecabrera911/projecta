	/* Empty States */
	.empty-state-box {
		padding: 3.5rem 1.5rem;
		background-color: #FFFFFF;
		border: 2px dashed #CBD5E1;
		border-radius: 1rem;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1rem;
	}

	.empty-icon-wrap {
		width: 64px;
		height: 64px;
		border-radius: 9999px;
		background-color: #F1F5F9;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.empty-icon-wrap.icon-amber {
		background-color: #FEF3C7;
	}

	.empty-heading {
		font-size: 1.25rem;
		font-weight: 800;
		color: #0F172A;
		letter-spacing: -0.02em;
	}

	.empty-description {
		font-size: 0.875rem;
		color: #64748B;
		max-width: 32rem;
		line-height: 1.5;
	}

	.empty-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 0.5rem;
	}

	.btn-primary-action {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 48px;
		min-width: 48px;
		padding: 0.75rem 1.25rem;
		border-radius: 0.625rem;
		background-color: #F97316;
		color: #FFFFFF;
		font-size: 0.875rem;
		font-weight: 700;
		border: none;
		cursor: pointer;
		box-shadow: 0 2px 6px rgba(249, 115, 22, 0.3);
		transition: all 0.15s ease;
	}

	.btn-primary-action:hover {
		background-color: #EA580C;
	}

	.btn-secondary-action {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 48px;
		min-width: 48px;
		padding: 0.75rem 1.25rem;
		border-radius: 0.625rem;
		background-color: #F1F5F9;
		border: 1px solid #CBD5E1;
		color: #334155;
		font-size: 0.875rem;
		font-weight: 700;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.btn-secondary-action:hover {
		background-color: #E2E8F0;
		color: #0F172A;
	}

	/* ==========================================================================
	   MODALES (CREATE, EDIT, DELETE)
	   ========================================================================== */
	.modal-backdrop-wrap {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.2s ease;
	}

	.modal-backdrop-wrap.active {
		opacity: 1;
		pointer-events: auto;
	}

	.modal-backdrop-blur {
		position: absolute;
		inset: 0;
		background-color: rgba(15, 23, 42, 0.7);
		backdrop-filter: blur(4px);
	}

	.modal-card-box {
		position: relative;
		z-index: 101;
		width: 100%;
		background-color: #FFFFFF;
		border-radius: 0.75rem;
		box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		max-height: 90vh;
	}

	.modal-sm { max-width: 26rem; }
	.modal-md { max-width: 34rem; }

	.modal-header {
		padding: 1.125rem 1.25rem;
		border-bottom: 1px solid #E2E8F0;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.title-wrap {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.header-icon {
		width: 38px;
		height: 38px;
		border-radius: 0.5rem;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.icon-emerald { background-color: #ECFDF5; color: #059669; }
	.icon-blue { background-color: #EFF6FF; color: #2563EB; }
	.icon-red { background-color: #FEE2E2; color: #DC2626; }

	.title-text {
		font-size: 1.0625rem;
		font-weight: 800;
		color: #0F172A;
		letter-spacing: -0.02em;
	}

	.subtitle-text {
		font-size: 0.8125rem;
		color: #64748B;
	}

	.btn-close {
		min-width: 48px;
		min-height: 48px;
		border-radius: 0.375rem;
		background: none;
		border: none;
		color: #64748B;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
	}

	.btn-close:focus-visible {
		outline: 2px solid #F97316;
		outline-offset: 1px;
	}

	.modal-body-form {
		padding: 1.25rem;
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.form-grid-2 {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.75rem;
	}

	@media (min-width: 640px) {
		.form-grid-2 {
			grid-template-columns: 1fr 1fr;
		}
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
	}

	.form-label {
		font-size: 0.8125rem;
		font-weight: 700;
		color: #334155;
	}

	.text-input,
	.select-input,
	.textarea-input {
		width: 100%;
		min-height: 48px;
		padding: 0.625rem 0.875rem;
		background-color: #F8FAFC;
		border: 1.5px solid #CBD5E1;
		border-radius: 0.5rem;
		font-size: 0.875rem;
		font-family: inherit;
		color: #0F172A;
		outline: none;
		transition: all 0.15s ease;
