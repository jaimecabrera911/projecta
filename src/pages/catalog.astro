		font-weight: 700;
		color: #0F172A;
		line-height: 1.35;
	}

	:global(.card-supplier-meta) {
		font-size: 0.8125rem;
		color: #64748B;
		display: flex;
		align-items: center;
		gap: 0.375rem;
	}

	:global(.card-bottom-row) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-top: 1px solid #F1F5F9;
		padding-top: 0.75rem;
		margin-top: 0.25rem;
	}

	:global(.card-mobile-price-box) {
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-height: 48px;
		padding: 0.25rem 0.5rem;
		border-radius: 0.375rem;
		border: 1.5px dashed transparent;
		transition: all 0.15s ease;
	}

	:global(.card-mobile-price-box:hover),
	:global(.card-mobile-price-box:active) {
		background-color: #FFF7ED;
		border-color: #FDBA74;
	}

	:global(.card-price-label) {
		font-size: 0.6875rem;
		font-weight: 700;
		color: #94A3B8;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	:global(.card-actions-row) {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	:global(.btn-card-mobile-action) {
		min-height: 48px;
		min-width: 48px;
		padding: 0.5rem 0.875rem;
		border-radius: 0.5rem;
		font-size: 0.8125rem;
		font-weight: 700;
		border: 1px solid #CBD5E1;
		background-color: #FFFFFF;
		color: #334155;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.375rem;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	:global(.btn-card-mobile-action:focus-visible) {
		outline: 2px solid #F97316;
		outline-offset: 2px;
	}

	:global(.btn-card-mobile-action.btn-del) {
		color: #DC2626;
		border-color: #FECACA;
		background-color: #FEF2F2;
