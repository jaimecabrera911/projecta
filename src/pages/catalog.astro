	}

	:global(.td-code) {
		padding: 0.875rem 1rem;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.8125rem;
		color: #64748B;
	}

	:global(.td-name) {
		padding: 0.875rem 1rem;
		color: #0F172A;
		font-weight: 600;
	}

	:global(.item-notes-text) {
