		right: 0.5rem;
		width: 44px;
		height: 44px;
		border-radius: 0.375rem;
		background: none;
		border: none;
		color: #94A3B8;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
	}

	.btn-clear-search:hover {
		color: #0F172A;
	}

	.btn-clear-search:focus-visible {
		outline: 2px solid #F97316;
