	}

	.currency-input-shell {
		position: relative;
		display: flex;
		align-items: center;
	}

	.currency-prefix {
		position: absolute;
		left: 0.875rem;
		color: #64748B;
		font-family: var(--font-mono);
		font-weight: 700;
	}

	.currency-input {
		padding-left: 1.75rem;
	}

	.modal-footer-actions {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.75rem;
		padding-top: 0.5rem;
