<script>
	// TypeScript Logic for HU-02 Client-Side Form, Image Compression & CRM Sync
	import { renderIconSvg } from '../../lib/icons';

	interface CompressedPhoto {
		id: string;
		name: string;
		originalSize: number;
		size: number;
		dataUrl: string;
	}

	let uploadedPhotos: CompressedPhoto[] = [];
	const MAX_PHOTOS = 5;
	const TARGET_MAX_WIDTH = 1920;
	const TARGET_MAX_HEIGHT = 1080;
	const TARGET_QUALITY = 0.8;
	const MAX_FILE_SIZE_BYTES = 800 * 1024; // 800 KB

	// Elements
	const form = document.getElementById('public-quote-form') as HTMLFormElement | null;
	const heroSection = document.getElementById('form-hero-section');
	const successScreen = document.getElementById('success-screen-container');
	const submitBtn = document.getElementById('submit-quote-btn') as HTMLButtonElement | null;
	const submitSpinner = document.getElementById('submit-spinner');
	const submitLabel = document.getElementById('submit-label');

	// Inputs
	const nameInput = document.getElementById('client_name') as HTMLInputElement | null;
	const phoneInput = document.getElementById('client_phone') as HTMLInputElement | null;
	const emailInput = document.getElementById('client_email') as HTMLInputElement | null;
	const addressInput = document.getElementById('project_address') as HTMLInputElement | null;
	const typeHiddenInput = document.getElementById('project_type_input') as HTMLInputElement | null;
	const notesInput = document.getElementById('form_notes') as HTMLTextAreaElement | null;
	const honeypotInput = document.getElementById('form-website-url') as HTMLInputElement | null;

	// Dropzone & Compression
	const fileInput = document.getElementById('photo-file-input') as HTMLInputElement | null;
	const dropzone = document.getElementById('dropzone-box');
	const counterBadge = document.getElementById('photo-counter-badge');
	const progressBox = document.getElementById('compression-progress-container');
	const progressStatusText = document.getElementById('compression-status-text');
	const progressPercentText = document.getElementById('compression-percent-text');
	const progressBar = document.getElementById('compression-progress-bar');
	const thumbsGrid = document.getElementById('thumbnails-grid');

	// Success Elements
	const trackingIdEl = document.getElementById('success-tracking-id');
	const copyTrackingBtn = document.getElementById('copy-tracking-btn');
	const summaryName = document.getElementById('summary-client-name');
	const summaryType = document.getElementById('summary-project-type');
	const summaryAddr = document.getElementById('summary-address');
	const summaryPhotos = document.getElementById('summary-photos-count');
	const resetBtn = document.getElementById('reset-form-btn');

	// 1. Detect Embed Mode via Query Param (?embed=true)
	function checkEmbedMode() {
		const urlParams = new URLSearchParams(window.location.search);
		if (urlParams.get('embed') === 'true') {
			document.body.classList.add('is-embedded');
		}
	}
	checkEmbedMode();

	// 2. Project Type Visual Chip Selector
	const typeButtons = document.querySelectorAll('.type-btn');
	typeButtons.forEach((btn) => {
		btn.addEventListener('click', () => {
			typeButtons.forEach((b) => {
				b.classList.remove('active');
				b.setAttribute('aria-checked', 'false');
			});
			btn.classList.add('active');
			btn.setAttribute('aria-checked', 'true');
			const selected = btn.getAttribute('data-type') || 'Remodelación Total';
			if (typeHiddenInput) typeHiddenInput.value = selected;
		});
	});

	// Notification helper for photos (Reemplaza alert nativo prohibido)
	function showPhotoWarning(message: string) {
		const banner = document.getElementById('photo-limit-warning');
		const text = document.getElementById('photo-warning-text');
		if (banner && text) {
			text.textContent = message;
			banner.classList.remove('hidden');
			setTimeout(() => {
				banner.classList.add('hidden');
			}, 4000);
		}
	}

	// 3. Client-Side Canvas Image Compression Engine (< 800 KB, max 1920x1080, WebP con fallback a JPEG)
	async function compressImageFile(file: File): Promise<CompressedPhoto> {
		return new Promise((resolve, reject) => {
			const reader = new FileReader();
			reader.onload = (e) => {
				const img = new Image();
				img.onload = () => {
					let { width, height } = img;

					// Aspect Ratio calculation (máximo 1920x1080)
					if (width > TARGET_MAX_WIDTH || height > TARGET_MAX_HEIGHT) {
						if (width / height > TARGET_MAX_WIDTH / TARGET_MAX_HEIGHT) {
							height = Math.round((height * TARGET_MAX_WIDTH) / width);
							width = TARGET_MAX_WIDTH;
						} else {
							width = Math.round((width * TARGET_MAX_HEIGHT) / height);
							height = TARGET_MAX_HEIGHT;
						}
					}

					const canvas = document.createElement('canvas');
					canvas.width = width;
					canvas.height = height;
					const ctx = canvas.getContext('2d');
					if (!ctx) {
						reject(new Error('Canvas 2D context unavailable'));
						return;
					}

					ctx.imageSmoothingEnabled = true;
					ctx.imageSmoothingQuality = 'high';
					ctx.drawImage(img, 0, 0, width, height);

					// Formato WebP con fallback a JPEG
					let format = 'image/jpeg';
					try {
						const testWebp = canvas.toDataURL('image/webp', 0.5);
						if (testWebp && testWebp.startsWith('data:image/webp')) {
							format = 'image/webp';
						}
					} catch (_) {
						format = 'image/jpeg';
					}

					let quality = TARGET_QUALITY;
					let dataUrl = canvas.toDataURL(format, quality);

					// Calculate approx size in bytes from base64
					let byteSize = Math.round((dataUrl.length - 23) * 0.75);

					// Progressively adjust quality if it exceeds 800 KB
					while (byteSize > MAX_FILE_SIZE_BYTES && quality > 0.4) {
						quality -= 0.1;
						dataUrl = canvas.toDataURL(format, quality);
						byteSize = Math.round((dataUrl.length - 23) * 0.75);
					}

					resolve({
						id: 'photo_' + Math.random().toString(36).substring(2, 9),
						name: file.name,
						originalSize: file.size,
						size: byteSize,
						dataUrl
					});
				};
				img.onerror = () => reject(new Error('Error al cargar la imagen'));
				img.src = e.target?.result as string;
			};
			reader.onerror = () => reject(new Error('Error leyendo el archivo'));
			reader.readAsDataURL(file);
		});
	}

	// 4. Batch Process Photos with Progress Feedback (sin congelar la UI)
	async function handleSelectedFiles(files: FileList | File[]) {
		const rawFiles = Array.from(files);
		const fileArray = rawFiles.filter(f => f.type.startsWith('image/'));
		
		if (fileArray.length < rawFiles.length) {
			showPhotoWarning('Solo se admiten archivos de imagen (JPG, PNG o WebP). Los demás fueron descartados.');
		}

		if (fileArray.length === 0) return;

		const remainingSlots = MAX_PHOTOS - uploadedPhotos.length;
		if (remainingSlots <= 0) {
			showPhotoWarning('Ya has alcanzado el límite máximo de 5 fotografías.');
			return;
		}

		if (fileArray.length > remainingSlots) {
			showPhotoWarning(`Solo se pudieron adjuntar ${remainingSlots} foto(s) para no superar el límite de 5.`);
		}

		const filesToProcess = fileArray.slice(0, remainingSlots);

		// Show progress UI
		progressBox?.classList.remove('hidden');

		for (let i = 0; i < filesToProcess.length; i++) {
			const current = i + 1;
			const total = filesToProcess.length;
			const percent = Math.round(((current - 1) / total) * 100);

			if (progressStatusText) progressStatusText.textContent = `Optimizando foto ${current} de ${total}...`;
			if (progressPercentText) progressPercentText.textContent = `${percent}%`;
			if (progressBar) progressBar.style.width = `${percent}%`;

			// Yield to browser main thread
			await new Promise(r => setTimeout(r, 60));

			try {
				const compressed = await compressImageFile(filesToProcess[i]);
				uploadedPhotos.push(compressed);
				renderThumbnails();
			} catch (err) {
				console.error('Error al optimizar imagen:', err);
			}

			const endPercent = Math.round((current / total) * 100);
			if (progressPercentText) progressPercentText.textContent = `${endPercent}%`;
			if (progressBar) progressBar.style.width = `${endPercent}%`;
		}

		// Hide progress after brief delay
		setTimeout(() => {
			progressBox?.classList.add('hidden');
			if (progressBar) progressBar.style.width = '0%';
		}, 300);

		updatePhotoCounter();
	}

	function renderThumbnails() {
		if (!thumbsGrid) return;

		if (uploadedPhotos.length === 0) {
			thumbsGrid.innerHTML = '';
			thumbsGrid.classList.add('hidden');
			return;
		}

		thumbsGrid.classList.remove('hidden');
		thumbsGrid.innerHTML = '';

		uploadedPhotos.forEach((photo, idx) => {
			const sizeKb = Math.round(photo.size / 1024);

			const card = document.createElement('div');
			card.className = 'thumb-card';
			card.innerHTML = `
				<img src="${photo.dataUrl}" alt="Foto ${idx + 1}" />
				<div class="thumb-overlay">
					<button type="button" class="thumb-del-btn" data-id="${photo.id}" title="Eliminar foto" aria-label="Eliminar foto" style="display: flex; align-items: center; justify-content: center;">
						${renderIconSvg('x', { size: 14 })}
					</button>
					<span class="thumb-size-tag">${sizeKb} KB</span>
				</div>
			`;

			const delBtn = card.querySelector('.thumb-del-btn');
			delBtn?.addEventListener('click', (e) => {
				e.stopPropagation();
				removePhoto(photo.id);
			});

			thumbsGrid.appendChild(card);
		});

		updatePhotoCounter();
	}

	function removePhoto(id: string) {
		uploadedPhotos = uploadedPhotos.filter(p => p.id !== id);
		renderThumbnails();
	}

	function updatePhotoCounter() {
		if (counterBadge) {
			counterBadge.textContent = `${uploadedPhotos.length} / ${MAX_PHOTOS} fotos`;
			if (uploadedPhotos.length >= MAX_PHOTOS) {
				counterBadge.style.color = '#EA580C';
			} else {
				counterBadge.style.color = '#64748B';
			}
		}
	}

	// Dropzone Listeners
	dropzone?.addEventListener('click', () => {
		fileInput?.click();
	});

	dropzone?.addEventListener('keydown', (e) => {
		if (e.key === 'Enter' || e.key === ' ') {
			e.preventDefault();
			fileInput?.click();
		}
	});

	fileInput?.addEventListener('change', () => {
		if (fileInput.files && fileInput.files.length > 0) {
			handleSelectedFiles(fileInput.files);
			fileInput.value = ''; // Reset input to allow re-uploading same file
		}
	});

	// Drag & Drop
	['dragenter', 'dragover'].forEach(eventName => {
		dropzone?.addEventListener(eventName, (e) => {
			e.preventDefault();
			e.stopPropagation();
			dropzone.classList.add('drag-active');
		});
	});

	['dragleave', 'drop'].forEach(eventName => {
		dropzone?.addEventListener(eventName, (e) => {
			e.preventDefault();
			e.stopPropagation();
			dropzone.classList.remove('drag-active');
		});
	});

	dropzone?.addEventListener('drop', (e) => {
		if (e.dataTransfer && e.dataTransfer.files) {
			handleSelectedFiles(e.dataTransfer.files);
		}
	});

	// 5. Validation Helpers
	function validateEmail(email: string): boolean {
		if (!email) return true; // Optional
		// RFC 5322 standard simple regex
		const regex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
		return regex.test(email);
	}

	function clearErrors() {
		document.querySelectorAll('.field-error').forEach(el => el.classList.add('hidden'));
		document.querySelectorAll('.public-input').forEach(el => el.classList.remove('input-error'));
	}

	// 6. Form Submission & Honeypot Neutralizer
	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		clearErrors();

		const clientName = nameInput?.value.trim() || '';
		const clientPhone = phoneInput?.value.trim() || '';
		const clientEmail = emailInput?.value.trim() || '';
		const projectAddress = addressInput?.value.trim() || '';
		const projectType = typeHiddenInput?.value || 'Remodelación Total';
		const notes = notesInput?.value.trim() || '';
		const honeypotVal = honeypotInput?.value || '';

		let hasError = false;

		if (clientName.length < 3) {
			document.getElementById('err-client_name')?.classList.remove('hidden');
			nameInput?.classList.add('input-error');
			hasError = true;
		}

		const phoneClean = clientPhone.replace(/[^0-9]/g, '');
		if (phoneClean.length !== 10) {
			document.getElementById('err-client_phone')?.classList.remove('hidden');
			phoneInput?.classList.add('input-error');
			hasError = true;
		}

		if (clientEmail && !validateEmail(clientEmail)) {
			document.getElementById('err-client_email')?.classList.remove('hidden');
			emailInput?.classList.add('input-error');
			hasError = true;
		}

		if (projectAddress.length < 4) {
			document.getElementById('err-project_address')?.classList.remove('hidden');
			addressInput?.classList.add('input-error');
			hasError = true;
		}

		if (hasError) {
			// Scroll to first error
			const firstError = document.querySelector('.input-error');
			firstError?.scrollIntoView({ behavior: 'smooth', block: 'center' });
			return;
		}

		// Disable button and show spinner
		if (submitBtn) submitBtn.disabled = true;
		submitSpinner?.classList.remove('hidden');
		submitLabel?.classList.add('hidden');

		// Simulación de red 200 OK
		await new Promise(r => setTimeout(r, 450));

		const trackingId = 'lead_pub_' + Math.random().toString(36).substring(2, 8);

		// =========================================================================
		// SEGURIDAD: VERIFICACIÓN HONEYPOT
		// Si el bot llenó el campo oculto website_url, descartamos silenciosamente
		// sin guardar en localStorage, pero mostramos pantalla de éxito falsa.
		// =========================================================================
		if (honeypotVal !== '') {
			console.warn('Bot submission neutralized via Honeypot trap.');
			showSuccessScreen(trackingId, clientName, projectType, projectAddress, uploadedPhotos.length);
			return;
		}

		// =========================================================================
		// INTEGRACIÓN CON CRM: Guardar en localStorage['obraflow_leads']
		// =========================================================================
		try {
			const existingRaw = localStorage.getItem('obraflow_leads');
			let leadsList = existingRaw ? JSON.parse(existingRaw) : [];

			// Save lead with source 'web' and photos metadata
			const newWebLead = {
				id: trackingId,
				client_name: clientName,
				client_phone: '+57' + phoneClean,
				client_email: clientEmail || undefined,
				project_address: projectAddress,
				project_type: projectType,
				notes: notes,
				estimated_budget: 0,
				stage: 'new_lead',
				source: 'web',
				photos_count: uploadedPhotos.length,
				photos: uploadedPhotos.map(p => ({
					name: p.name,
					size: p.size,
					dataUrl: p.dataUrl
				})),
				created_at: new Date().toISOString()
			};

			leadsList.unshift(newWebLead);

			try {
				localStorage.setItem('obraflow_leads', JSON.stringify(leadsList));
			} catch (storageErr) {
				// En caso de cuota de localStorage excedida por fotos en Base64, guardar sin dataUrls
				console.warn('LocalStorage quota limit reached, saving metadata only:', storageErr);
				newWebLead.photos = uploadedPhotos.map(p => ({ name: p.name, size: p.size }));
				localStorage.setItem('obraflow_leads', JSON.stringify(leadsList));
			}

			// Notificar a otras pestañas o ventana madre
			window.dispatchEvent(new CustomEvent('lead-created', { detail: newWebLead }));
			try {
				if (window.parent && window.parent !== window) {
					window.parent.postMessage({ type: 'obraflow:lead-created', lead: newWebLead }, '*');
				}
			} catch (_) {}
		} catch (err) {
			console.error('Error guardando lead en CRM local:', err);
		}

		// Mostrar pantalla de éxito
		showSuccessScreen(trackingId, clientName, projectType, projectAddress, uploadedPhotos.length);
	});

	function showSuccessScreen(trackingId: string, name: string, type: string, addr: string, photoCount: number) {
		if (form) form.classList.add('hidden');
		if (heroSection) heroSection.classList.add('hidden');
		if (successScreen) successScreen.classList.remove('hidden');

		if (trackingIdEl) trackingIdEl.textContent = trackingId;
		if (summaryName) summaryName.textContent = name;
		if (summaryType) summaryType.textContent = type;
		if (summaryAddr) summaryAddr.textContent = addr;
		if (summaryPhotos) {
			summaryPhotos.textContent = `${photoCount} ${photoCount === 1 ? 'foto adjunta' : 'fotos adjuntas'}`;
		}

		window.scrollTo({ top: 0, behavior: 'smooth' });
	}

	// Copy Tracking ID button
	copyTrackingBtn?.addEventListener('click', () => {
		const text = trackingIdEl?.textContent || '';
		if (text && navigator.clipboard) {
			navigator.clipboard.writeText(text).then(() => {
				const orig = copyTrackingBtn.textContent;
				copyTrackingBtn.textContent = '¡Copiado!';
				setTimeout(() => {
					copyTrackingBtn.textContent = orig;
				}, 2000);
			});
		}
	});

	// Reset Form Button
	resetBtn?.addEventListener('click', () => {
		form?.reset();
		uploadedPhotos = [];
		renderThumbnails();
		clearErrors();

		if (submitBtn) submitBtn.disabled = false;
		submitSpinner?.classList.add('hidden');
		submitLabel?.classList.remove('hidden');

		if (successScreen) successScreen.classList.add('hidden');
		if (form) form.classList.remove('hidden');
		if (heroSection) heroSection.classList.remove('hidden');

		window.scrollTo({ top: 0, behavior: 'smooth' });
	});
</script>