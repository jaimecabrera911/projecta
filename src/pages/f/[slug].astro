---
// src/pages/f/[slug].astro
// HU-02: Formulario Web Público Embebible para Clientes
import Layout from '../../layouts/Layout.astro';
import { renderIconSvg } from '../../lib/icons';

export async function getStaticPaths() {
	return [
		{ params: { slug: 'andina-sas' } },
		{ params: { slug: 'demo' } },
		{ params: { slug: 'default' } },
		{ params: { slug: 'construcciones-andina' } }
	];
}

const { slug } = Astro.params;
const companyName = "Construcciones & Reformas Andina SAS";
const companyNit = "NIT 901.442.188-4";
---

<Layout title={`Solicitud de Cotización — ${companyName}`} hasSidebar={false}>
	<main class="public-form-page" id="public-page-wrapper">
		<!-- Public Header (Branding Constructora) - Ocultable en modo ?embed=true -->
		<header class="public-header" id="branding-header">
			<div class="header-container">
				<div class="brand-info">
					<div class="brand-logo">
						<Fragment set:html={renderIconSvg('building', { size: 24 })} />
					</div>
					<div>
						<div class="company-name-row">
							<h1 class="company-name">{companyName}</h1>
							<span class="verified-badge" title="Empresa legalmente constituida y verificada">
								<Fragment set:html={renderIconSvg('check', { size: 13 })} />
								Verificada
							</span>
						</div>
						<p class="company-sub">{companyNit} • Obra Civil & Remodelaciones</p>
					</div>
				</div>

				<div class="header-badge-col">
					<span class="quote-badge">
						<span class="badge-dot"></span>
						Solicitud de Cotización
					</span>
				</div>
			</div>
		</header>

		<!-- Main Content Container -->
		<div class="form-content-area">
			<div class="form-card-container">
				<!-- Title Banner inside Card -->
				<div class="form-hero" id="form-hero-section">
					<div class="hero-badge">Presupuesto Estimado en &lt; 24h</div>
					<h2 class="form-title">Cuéntanos sobre tu proyecto</h2>
					<p class="form-subtitle">
						Diligencia el formulario y sube fotos del espacio actual para estructurar tu presupuesto sin costo ni compromiso.
					</p>
				</div>

				<!-- ==========================================================
				     ESTADO 1: FORMULARIO DE CAPTURA PÚBLICO
				     ========================================================== -->
				<form id="public-quote-form" class="public-form" novalidate>
					<!-- CAMPO HONEYPOT (Antispam invisible para bots) -->
					<div class="honeypot-wrap" aria-hidden="true">
						<label for="form-website-url">Sitio Web (no completar):</label>
						<input
							type="text"
							id="form-website-url"
							name="website_url"
							tabindex="-1"
							autocomplete="off"
							value=""
						/>
					</div>

					<!-- CAMPO 1: Nombre del Cliente -->
					<div class="form-field">
						<label for="client_name" class="field-label">
							Nombre Completo <span class="req">*</span>
						</label>
						<div class="input-shell">
							<span class="input-icon">
								<Fragment set:html={renderIconSvg('user', { size: 18 })} />
							</span>
							<input
								type="text"
								id="client_name"
								name="client_name"
								required
								minlength="3"
								placeholder="Ej. Andrés Delgado"
								class="public-input with-left-icon"
								autocomplete="name"
							/>
						</div>
						<p id="err-client_name" class="field-error hidden">
							Por favor ingresa tu nombre completo (mínimo 3 caracteres).
						</p>
					</div>

					<!-- FILA 2 CAMPOS: WhatsApp y Correo -->
					<div class="form-grid-2">
						<!-- CAMPO 2: WhatsApp con máscara / prefijo -->
						<div class="form-field">
							<label for="client_phone" class="field-label">
								WhatsApp / Celular <span class="req">*</span>
							</label>
							<div class="phone-composite-wrap">
								<div class="country-selector">
									<svg width="18" height="12" viewBox="0 0 600 400" xmlns="http://www.w3.org/2000/svg" style="border-radius:2px;box-shadow:0 0 1px rgba(0,0,0,0.3);flex-shrink:0;">
										<rect width="600" height="200" fill="#FCD116"/>
										<rect y="200" width="600" height="100" fill="#003893"/>
										<rect y="300" width="600" height="100" fill="#CE1126"/>
									</svg>
									<span class="dial-code">+57</span>
								</div>
								<div class="input-shell flex-1">
									<input
										type="tel"
										id="client_phone"
										name="client_phone"
										required
										placeholder="315 555 4321"
										class="public-input font-mono"
										inputmode="tel"
										autocomplete="tel"
									/>
								</div>
							</div>
							<p id="err-client_phone" class="field-error hidden">
								Ingresa un número de WhatsApp válido (10 dígitos).
							</p>
						</div>

						<!-- CAMPO 3: Correo Electrónico (Opcional con validación RFC) -->
						<div class="form-field">
							<label for="client_email" class="field-label">
								Correo Electrónico <span class="opt">(Opcional)</span>
							</label>
							<div class="input-shell">
								<span class="input-icon">
									<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
										<polyline points="22,6 12,13 2,6"></polyline>
									</svg>
								</span>
								<input
									type="email"
									id="client_email"
									name="client_email"
									placeholder="andres@ejemplo.com"
									class="public-input with-left-icon"
									autocomplete="email"
								/>
							</div>
							<p id="err-client_email" class="field-error hidden">
								Ingresa un formato de correo válido (ej. usuario@dominio.com).
							</p>
						</div>
					</div>

					<!-- CAMPO 4: Dirección / Inmueble -->
					<div class="form-field">
						<label for="project_address" class="field-label">
							Dirección aproximada, Barrio o Ciudad <span class="req">*</span>
						</label>
						<div class="input-shell">
							<span class="input-icon">
								<Fragment set:html={renderIconSvg('mapPin', { size: 18 })} />
							</span>
							<input
								type="text"
								id="project_address"
								name="project_address"
								required
								minlength="4"
								placeholder="Ej. Envigado, Antioquia - Loma del Chocho"
								class="public-input with-left-icon"
							/>
						</div>
						<p id="err-project_address" class="field-error hidden">
							Ingresa la ubicación o barrio del inmueble.
						</p>
					</div>

					<!-- CAMPO 5: Selector Táctil Tipo de Proyecto -->
					<div class="form-field">
						<label class="field-label">
							Tipo de Obra o Remodelación <span class="req">*</span>
						</label>
						<input type="hidden" id="project_type_input" name="project_type" value="Cocina Integral" />
						
						<div class="project-types-grid" id="project-type-selector" role="radiogroup" aria-label="Tipo de Obra o Remodelación">
							<button type="button" class="type-btn" data-type="Remodelación Total" role="radio" aria-checked="false">
								<span class="type-icon">
									<Fragment set:html={renderIconSvg('tool', { size: 18 })} />
								</span>
								<span class="type-label">Remodelación Total</span>
							</button>
							<button type="button" class="type-btn active" data-type="Cocina Integral" role="radio" aria-checked="true">
								<span class="type-icon">
									<Fragment set:html={renderIconSvg('home', { size: 18 })} />
								</span>
								<span class="type-label">Cocina Integral</span>
							</button>
							<button type="button" class="type-btn" data-type="Baño" role="radio" aria-checked="false">
								<span class="type-icon">
									<Fragment set:html={renderIconSvg('droplet', { size: 18 })} />
								</span>
								<span class="type-label">Baño</span>
							</button>
							<button type="button" class="type-btn" data-type="Pintura y Acabados" role="radio" aria-checked="false">
								<span class="type-icon">
									<Fragment set:html={renderIconSvg('paint', { size: 18 })} />
								</span>
								<span class="type-label">Pintura y Acabados</span>
							</button>
							<button type="button" class="type-btn" data-type="Adecuación Comercial" role="radio" aria-checked="false">
								<span class="type-icon">
									<Fragment set:html={renderIconSvg('briefcase', { size: 18 })} />
								</span>
								<span class="type-label">Local Comercial</span>
							</button>
							<button type="button" class="type-btn" data-type="Otro" role="radio" aria-checked="false">
								<span class="type-icon">
									<Fragment set:html={renderIconSvg('package', { size: 18 })} />
								</span>
								<span class="type-label">Otro</span>
							</button>
						</div>
					</div>

					<!-- CAMPO 6: Notas / Descripción -->
					<div class="form-field">
						<label for="form_notes" class="field-label">
							Cuéntanos tus expectativas y necesidades <span class="opt">(Opcional)</span>
						</label>
						<textarea
							id="form_notes"
							name="notes"
							rows="3"
							placeholder="Ej. Quiero tumbar un muro divisor, cambiar mesón por cuarzo blanco y cambiar pisos..."
							class="public-textarea"
						></textarea>
					</div>

					<!-- CAMPO 7: Zona Drag & Drop para Fotos (Max 5, Client-Side Canvas Compression) -->
					<div class="form-field">
						<div class="attachment-header">
							<label class="field-label mb-0">
								Fotografías del Espacio Actual <span class="opt">(Máx. 5 fotos)</span>
							</label>
							<span id="photo-counter-badge" class="photo-counter">0 / 5 fotos</span>
						</div>
						<p class="field-hint">
							Toma o adjunta fotos de tu espacio. Nuestro motor optimizará automáticamente cada imagen a alta resolución y &lt; 800 KB.
						</p>

						<!-- Photo Limit / Format Alert Banner (Sin alert nativo) -->
						<div id="photo-limit-warning" class="photo-warning-banner hidden" role="alert">
							<span class="warning-icon" style="display: inline-flex; align-items: center;">
								<Fragment set:html={renderIconSvg('alert', { size: 16 })} />
							</span>
							<span id="photo-warning-text">Límite alcanzado: Máximo 5 fotografías por solicitud.</span>
						</div>

						<!-- Hidden file input -->
						<input
							type="file"
							id="photo-file-input"
							accept="image/jpeg,image/png,image/webp,image/jpg"
							multiple
							class="visually-hidden"
						/>

						<!-- Dropzone -->
						<div
							id="dropzone-box"
							class="dropzone-area"
							role="button"
							tabindex="0"
							aria-label="Arrastra o selecciona hasta 5 fotos"
						>
							<div class="dropzone-inner">
								<div class="dropzone-icon">
									<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
										<polyline points="17 8 12 3 7 8"></polyline>
										<line x1="12" y1="3" x2="12" y2="15"></line>
									</svg>
								</div>
								<div class="dropzone-texts">
									<p class="drop-main">
										<span class="text-highlight">Haz clic para subir fotos</span> o arrástralas aquí
									</p>
									<p class="drop-sub">JPG, PNG o WebP • Compresión inteligente en el navegador</p>
								</div>
							</div>
						</div>

						<!-- Dynamic Compression Progress Bar -->
						<div id="compression-progress-container" class="compression-progress hidden">
							<div class="progress-info">
								<span class="spinner-small"></span>
								<span id="compression-status-text" class="progress-status-label">Optimizando foto 1 de 3...</span>
								<span id="compression-percent-text" class="progress-percent font-mono">0%</span>
							</div>
							<div class="progress-track">
								<div id="compression-progress-bar" class="progress-fill" style="width: 0%"></div>
							</div>
						</div>

						<!-- Thumbnail Grid Preview with Delete Button -->
						<div id="thumbnails-grid" class="thumbnails-grid hidden"></div>
					</div>

					<!-- Disclaimer Privacidad -->
					<div class="privacy-note">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2">
							<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
						</svg>
						<span>Tus datos y fotos están protegidos y se usan exclusivamente para elaborar tu cotización.</span>
					</div>

					<!-- Botón de Envío -->
					<div class="submit-action-wrap">
						<button id="submit-quote-btn" type="submit" class="public-submit-btn">
							<span id="submit-spinner" class="btn-spinner hidden"></span>
							<span id="submit-label" class="btn-content">
								<span>Enviar Solicitud de Cotización</span>
								<Fragment set:html={renderIconSvg('arrowRight', { size: 18 })} />
							</span>
						</button>
					</div>
				</form>

				<!-- ==========================================================
				     ESTADO 2: PANTALLA DE ÉXITO POST-ENVÍO
				     ========================================================== -->
				<div id="success-screen-container" class="success-screen hidden">
					<div class="success-icon-badge">
						<Fragment set:html={renderIconSvg('check', { size: 40 })} />
					</div>

					<h2 class="success-heading">¡Solicitud recibida con éxito!</h2>
					<p class="success-message">
						Te contactaremos en <strong>menos de 24 horas hábiles</strong> con el diagnóstico y presupuesto preliminar de tu obra.
					</p>

					<!-- Tracking Card -->
					<div class="tracking-summary-card">
						<div class="tracking-row">
							<span class="tracking-title">ID de Seguimiento:</span>
							<div class="tracking-id-wrap">
								<span id="success-tracking-id" class="tracking-code font-mono">lead_pub_...</span>
								<button id="copy-tracking-btn" type="button" class="copy-pill" title="Copiar ID">
									<Fragment set:html={renderIconSvg('copy', { size: 14 })} />
									<span>Copiar</span>
								</button>
							</div>
						</div>

						<div class="summary-details">
							<div class="detail-item">
								<span class="det-label">Cliente:</span>
								<span id="summary-client-name" class="det-val font-semibold">—</span>
							</div>
							<div class="detail-item">
								<span class="det-label">Tipo de Obra:</span>
								<span id="summary-project-type" class="det-val">—</span>
							</div>
							<div class="detail-item">
								<span class="det-label">Ubicación:</span>
								<span id="summary-address" class="det-val">—</span>
							</div>
							<div class="detail-item" id="summary-photos-item">
								<span class="det-label">Fotos Adjuntas:</span>
								<span id="summary-photos-count" class="det-val font-mono">0 fotos</span>
							</div>
						</div>
					</div>

					<!-- Acciones Post-Envío -->
					<div class="success-actions">
						<button id="reset-form-btn" type="button" class="btn-secondary-submit">
							Enviar otra solicitud
						</button>
						<a href={`https://wa.me/573109876543?text=Hola,%20acabo%20de%20enviar%20mi%20solicitud%20de%20cotizaci%C3%B3n`} target="_blank" class="btn-wa-direct">
							<span>Escribir por WhatsApp</span>
							<Fragment set:html={renderIconSvg('phone', { size: 16 })} />
						</a>
					</div>
				</div>

				<!-- Footer minimalista -->
				<footer class="form-footer" id="public-form-footer">
					<span>Desarrollado con <strong>ObraFlow</strong> • Sistema Profesional de Presupuestos & Obras</span>
				</footer>
			</div>
		</div>
	</main>
</Layout>

<style>
	/* Contenedor general */
	.public-form-page {
		min-height: 100vh;
		background: linear-gradient(180deg, #F8FAFC 0%, #EEF2F6 100%);
		display: flex;
		flex-direction: column;
		color: #0F172A;
	}

	/* Cabecera Pública */
	.public-header {
		background-color: #0F172A;
		color: #FFFFFF;
		border-bottom: 1px solid #1E293B;
		padding: 1rem 1.25rem;
		box-shadow: 0 4px 16px rgba(15, 23, 42, 0.15);
		position: sticky;
		top: 0;
		z-index: 20;
	}

	.header-container {
		max-width: 52rem;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.brand-info {
		display: flex;
		align-items: center;
		gap: 0.875rem;
	}

	.brand-logo {
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 0.75rem;
		background: linear-gradient(135deg, #F97316, #D97706);
		display: flex;
		align-items: center;
		justify-content: center;
		color: #FFFFFF;
		box-shadow: 0 4px 12px rgba(249, 115, 22, 0.35);
		flex-shrink: 0;
	}

	.company-name-row {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.company-name {
		font-size: 1.0625rem;
		font-weight: 800;
		color: #FFFFFF;
		letter-spacing: -0.02em;
	}

	.verified-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		background-color: rgba(16, 185, 129, 0.15);
		color: #34D399;
		border: 1px solid rgba(52, 211, 153, 0.3);
		font-size: 0.6875rem;
		font-weight: 700;
		padding: 0.125rem 0.5rem;
		border-radius: 9999px;
	}

	.company-sub {
		font-size: 0.75rem;
		color: #94A3B8;
		margin-top: 0.125rem;
	}

	.quote-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		background-color: rgba(249, 115, 22, 0.15);
		border: 1px solid rgba(249, 115, 22, 0.35);
		color: #FB923C;
		font-size: 0.75rem;
		font-weight: 700;
		padding: 0.375rem 0.75rem;
		border-radius: 9999px;
		white-space: nowrap;
	}

	.badge-dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 9999px;
		background-color: #F97316;
		box-shadow: 0 0 6px #F97316;
	}

	/* Form Content Area */
	.form-content-area {
		flex: 1;
		display: flex;
		justify-content: center;
		padding: 2rem 1rem 4rem 1rem;
	}

	.form-card-container {
		width: 100%;
		max-width: 44rem;
		background-color: #FFFFFF;
		border-radius: 1.25rem;
		border: 1px solid #E2E8F0;
		box-shadow: 0 10px 30px -5px rgba(15, 23, 42, 0.08);
		padding: 2rem 1.75rem;
	}

	@media (max-width: 640px) {
		.form-card-container {
			padding: 1.5rem 1.125rem;
			border-radius: 1rem;
		}
		.public-header {
			padding: 0.75rem 1rem;
		}
		.header-badge-col {
			display: none;
		}
	}

	/* Hero section */
	.form-hero {
		text-align: center;
		margin-bottom: 2rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid #F1F5F9;
	}

	.hero-badge {
		display: inline-block;
		background-color: #FFF7ED;
		color: #C2410C;
		border: 1px solid #FFEDD5;
		font-size: 0.75rem;
		font-weight: 700;
		padding: 0.25rem 0.75rem;
		border-radius: 9999px;
		margin-bottom: 0.625rem;
	}

	.form-title {
		font-size: 1.625rem;
		font-weight: 800;
		color: #0F172A;
		letter-spacing: -0.025em;
		line-height: 1.25;
	}

	.form-subtitle {
		font-size: 0.875rem;
		color: #475569;
		margin-top: 0.5rem;
		max-width: 32rem;
		margin-left: auto;
		margin-right: auto;
		line-height: 1.45;
	}

	/* Form structure */
	.public-form {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.honeypot-wrap {
		position: absolute !important;
		left: -9999px !important;
		top: -9999px !important;
		opacity: 0 !important;
		pointer-events: none !important;
		width: 0 !important;
		height: 0 !important;
		overflow: hidden !important;
	}

	.form-field {
		display: flex;
		flex-direction: column;
	}

	.form-grid-2 {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
	}

	@media (min-width: 640px) {
		.form-grid-2 {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	.field-label {
		font-size: 0.8125rem;
		font-weight: 700;
		color: #334155;
		margin-bottom: 0.4rem;
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.req {
		color: #EA580C;
		font-weight: 800;
	}

	.opt {
		color: #64748B;
		font-weight: 600;
		font-size: 0.75rem;
	}

	.field-hint {
		font-size: 0.75rem;
		color: #475569;
		margin-bottom: 0.625rem;
		line-height: 1.35;
	}

	.input-shell {
		position: relative;
		display: flex;
		align-items: center;
	}

	.input-icon {
		position: absolute;
		left: 0.875rem;
		color: #94A3B8;
		pointer-events: none;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.public-input {
		width: 100%;
		min-height: 3rem;
