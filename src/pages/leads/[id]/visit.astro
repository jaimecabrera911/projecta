	cameraInput?.addEventListener('change', (e) => {
		const target = e.target as HTMLInputElement;
		if (target.files && target.files.length > 0) {
			handleIncomingFiles(Array.from(target.files));
			target.value = '';
		}
	});

	galleryInput?.addEventListener('change', (e) => {
		const target = e.target as HTMLInputElement;
		if (target.files && target.files.length > 0) {
			handleIncomingFiles(Array.from(target.files));
			target.value = '';
		}
	});

	async function compressSingleImage(file: File): Promise<{ dataUrl: string; sizeKb: number; name: string }> {
		return new Promise((resolve, reject) => {
			const reader = new FileReader();
			reader.onerror = () => reject(new Error('Error de lectura'));
			reader.onload = (e) => {
				const img = new Image();
				img.onerror = () => reject(new Error('Error de carga de imagen'));
				img.onload = () => {
					const MAX_W = 1920;
					const MAX_H = 1080;
					let w = img.width;
					let h = img.height;

					if (w > MAX_W || h > MAX_H) {
						if (w / h > MAX_W / MAX_H) {
							h = Math.round((h * MAX_W) / w);
							w = MAX_W;
						} else {
							w = Math.round((w * MAX_H) / h);
							h = MAX_H;
						}
					}

					const canvas = document.createElement('canvas');
					canvas.width = w;
					canvas.height = h;
					const ctx = canvas.getContext('2d');
					if (!ctx) {
						reject(new Error('Sin contexto 2D'));
						return;
					}

					ctx.drawImage(img, 0, 0, w, h);

					let dataUrl = canvas.toDataURL('image/webp', 0.82);
					if (!dataUrl.startsWith('data:image/webp')) {
						dataUrl = canvas.toDataURL('image/jpeg', 0.82);
					}

					const comma = dataUrl.indexOf(',');
					const base64Len = dataUrl.length - (comma + 1);
					const sizeBytes = Math.round(base64Len * 0.75);
					const sizeKb = Math.round(sizeBytes / 1024);

					resolve({
						dataUrl,
						sizeKb,
						name: file.name
					});
				};
				img.src = e.target?.result as string;
			};
			reader.readAsDataURL(file);
		});
	}

	async function handleIncomingFiles(files: File[]) {
		if (files.length === 0) return;

		progressBox?.classList.remove('hidden');
		const total = files.length;

		for (let i = 0; i < total; i++) {
			const file = files[i];
			const currentIdx = i + 1;
			const pct = Math.round((currentIdx / total) * 100);

			if (progressStatusText) {
				progressStatusText.textContent = `Optimizando foto ${currentIdx} de ${total} (${file.name})...`;
			}
			if (progressPercentText) {
				progressPercentText.textContent = `${pct}%`;
			}
			if (progressBar) {
				progressBar.style.width = `${pct}%`;
			}

			try {
				const compressed = await compressSingleImage(file);
				const newPhoto: BeforePhoto = {
					id: 'photo_' + Date.now().toString(36) + '_' + Math.random().toString(36).substring(2, 6),
					name: compressed.name,
					dataUrl: compressed.dataUrl,
					sizeKb: compressed.sizeKb,
					zone: activeZone,
					created_at: new Date().toISOString()
				};

				if (!currentLead?.visit?.photos) {
					if (currentLead?.visit) currentLead.visit.photos = [];
				}
				currentLead?.visit?.photos?.push(newPhoto);
			} catch (_) {}
		}

		progressBox?.classList.add('hidden');
		performSave();
		renderPhotosGrid();

		window.dispatchEvent(new CustomEvent('show-toast', {
			detail: {
				title: 'Fotos optimizadas',
				message: `Se agregaron ${total} ${total === 1 ? 'foto' : 'fotos'} a la zona "${activeZone}".`,
				type: 'success'
			}
		}));
	}

	// =========================================================================
	// 6. RENDER PHOTOS GRID
	// =========================================================================
	function escapeHtml(str: string): string {
		const div = document.createElement('div');
		div.textContent = str;
		return div.innerHTML;
	}

	function renderPhotosGrid() {
		if (!photosGrid) return;
		photosGrid.innerHTML = '';

		const photos = currentLead?.visit?.photos || [];
		if (photosCounterPill) {
			photosCounterPill.textContent = `${photos.length} ${photos.length === 1 ? 'foto' : 'fotos'}`;
		}

		if (photos.length === 0) {
			photosEmptyState?.classList.remove('hidden');
			photosGrid.classList.add('hidden');
			return;
		}

		photosEmptyState?.classList.add('hidden');
		photosGrid.classList.remove('hidden');

		photos.forEach((photo, idx) => {
			const card = document.createElement('div');
			card.className = 'photo-card-item';
			card.dataset.id = photo.id;

			card.innerHTML = `
				<div class="photo-thumb-container" data-action="expand" data-index="${idx}">
					<img src="${photo.dataUrl}" alt="${escapeHtml(photo.name)}" class="photo-thumb-img" loading="lazy" />
					<span class="photo-zone-badge">${escapeHtml(photo.zone || 'General')}</span>
					<div class="photo-action-overlay">
						<button type="button" class="btn-thumb-zoom" data-action="expand" data-index="${idx}" title="Ampliar a pantalla completa" aria-label="Ampliar fotografía">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
								<polyline points="15 3 21 3 21 9"></polyline>
								<polyline points="9 21 3 21 3 15"></polyline>
								<line x1="21" y1="3" x2="14" y2="10"></line>
								<line x1="3" y1="21" x2="10" y2="14"></line>
							</svg>
						</button>
					</div>
				</div>
				<div class="photo-footer-bar">
					<span class="photo-meta-text">${photo.sizeKb} KB</span>
					<button type="button" class="btn-thumb-delete" data-action="delete" data-id="${photo.id}" title="Eliminar foto" aria-label="Eliminar fotografía">
						<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="3 6 5 6 21 6"></polyline>
							<path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
						</svg>
					</button>
				</div>
			`;

			// Expand triggers
			const thumbBox = card.querySelector('.photo-thumb-container');
			thumbBox?.addEventListener('click', (e) => {
				const target = e.target as HTMLElement;
				if (target.closest('.btn-thumb-delete')) return;
				openLightbox(idx);
			});

			// Delete trigger
			const deleteBtn = card.querySelector('.btn-thumb-delete');
			deleteBtn?.addEventListener('click', (e) => {
				e.stopPropagation();
				openDeleteModal(photo.id);
			});

			photosGrid.appendChild(card);
		});
	}

	// =========================================================================
	// 7. LIGHTBOX CONTROLLER & SWIPE GESTURES
	// =========================================================================
	function openLightbox(index: number) {
		const photos = currentLead?.visit?.photos || [];
		if (index < 0 || index >= photos.length) return;

		currentLightboxIndex = index;
		updateLightboxView();
		lightboxModal?.classList.add('active');
	}

	function closeLightbox() {
		lightboxModal?.classList.remove('active');
	}

	function updateLightboxView() {
		const photos = currentLead?.visit?.photos || [];
		const photo = photos[currentLightboxIndex];
		if (!photo) return;

		if (lightboxImg) lightboxImg.src = photo.dataUrl;
		if (lightboxZoneBadge) lightboxZoneBadge.textContent = photo.zone || 'General';
		if (lightboxTitle) lightboxTitle.textContent = photo.name || 'Fotografía de obra';
		if (lightboxCounter) lightboxCounter.textContent = `${currentLightboxIndex + 1} de ${photos.length}`;
		if (lightboxFileMeta) lightboxFileMeta.textContent = `${photo.sizeKb} KB • Optimizado Canvas`;
	}

	function prevLightbox() {
		const photos = currentLead?.visit?.photos || [];
		if (photos.length <= 1) return;
		currentLightboxIndex = (currentLightboxIndex - 1 + photos.length) % photos.length;
		updateLightboxView();
	}

	function nextLightbox() {
		const photos = currentLead?.visit?.photos || [];
		if (photos.length <= 1) return;
		currentLightboxIndex = (currentLightboxIndex + 1) % photos.length;
		updateLightboxView();
	}

	btnLightboxPrev?.addEventListener('click', prevLightbox);
	btnLightboxNext?.addEventListener('click', nextLightbox);
	closeLightboxBtn?.addEventListener('click', closeLightbox);
	lightboxBackdrop?.addEventListener('click', closeLightbox);

	// Touch Swipe Support on mobile lightbox
	let touchStartX = 0;
	let touchEndX = 0;

	lightboxStage?.addEventListener('touchstart', (e) => {
		touchStartX = e.changedTouches[0].screenX;
	}, { passive: true });

	lightboxStage?.addEventListener('touchend', (e) => {
		touchEndX = e.changedTouches[0].screenX;
		const diff = touchStartX - touchEndX;
		if (Math.abs(diff) > 45) {
			if (diff > 0) {
				nextLightbox();
			} else {
				prevLightbox();
			}
		}
	}, { passive: true });

	// =========================================================================
	// 8. DELETE PHOTO MODAL (NO NATIVE CONFIRM)
	// =========================================================================
	function openDeleteModal(photoId: string) {
		const photos = currentLead?.visit?.photos || [];
		const photo = photos.find(p => p.id === photoId);
		if (!photo) return;

		photoPendingDeleteId = photoId;
		if (deleteThumbImg) deleteThumbImg.src = photo.dataUrl;
		if (deleteZoneLabel) deleteZoneLabel.textContent = `Zona: ${photo.zone || 'General'}`;

		deleteModal?.classList.add('active');
	}

	function closeDeleteModal() {
		deleteModal?.classList.remove('active');
		photoPendingDeleteId = null;
	}

	closeDeleteBtn?.addEventListener('click', closeDeleteModal);
	cancelDeleteBtn?.addEventListener('click', closeDeleteModal);
	deleteBackdrop?.addEventListener('click', closeDeleteModal);

	confirmDeleteBtn?.addEventListener('click', () => {
		if (!photoPendingDeleteId || !currentLead?.visit?.photos) return;

		currentLead.visit.photos = currentLead.visit.photos.filter(p => p.id !== photoPendingDeleteId);
		performSave();
		renderPhotosGrid();
		closeDeleteModal();

		window.dispatchEvent(new CustomEvent('show-toast', {
			detail: {
				title: 'Foto eliminada',
				message: 'La fotografía fue retirada de la visita técnica.',
				type: 'warning'
			}
		}));
	});

	// Global Keyboard shortcuts (Escape & Arrows)
	window.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') {
			closeLightbox();
			closeDeleteModal();
		} else if (lightboxModal?.classList.contains('active')) {
			if (e.key === 'ArrowLeft') prevLightbox();
			if (e.key === 'ArrowRight') nextLightbox();
		}
	});

	// Refresh timeline on cross-tab proposal tracking updates
	window.addEventListener('storage', (e) => {
		if (e.key === 'obraflow_proposal_views' || e.key === 'obraflow_leads') {
			renderProposalActivity();
		}
	});

	// Initialize
	populateData();
</script>
