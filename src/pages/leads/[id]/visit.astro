	// =========================================================================
	// 5. CLIENT-SIDE CANVAS PHOTO COMPRESSION (< 800 KB)
	// =========================================================================
	cameraTriggerBtn?.addEventListener('click', () => {
		cameraInput?.click();
	});

	galleryTriggerBtn?.addEventListener('click', () => {
