---
// src/pages/leads/[id]/visit.astro
// HU-04: Ficha de Visita Técnica y Galería de Fotos del Antes (Blueprint UX/UI Definitivo)
import Layout from '../../../layouts/Layout.astro';
import Toast from '../../../components/Toast.astro';

export async function getStaticPaths() {
	return [
		{ params: { id: 'lead_01' } },
		{ params: { id: 'lead_02' } },
		{ params: { id: 'lead_03' } },
		{ params: { id: 'lead_04' } },
		{ params: { id: 'lead_05' } },
		{ params: { id: 'lead_06' } },
		{ params: { id: 'lead_07' } },
		{ params: { id: 'lead_08' } },
		{ params: { id: 'demo' } }
	];
}

const { id } = Astro.params;
---

<Layout title={`Visita Técnica — Oportunidad ${id} | ObraFlow`} hasSidebar={false}>
	<div class="visit-page-shell" data-lead-id={id}>
		<!-- Top App Bar / Header Operate Mode -->
		<header class="visit-topbar">
			<div class="topbar-inner">
				<div class="topbar-left">
					<a href="/" class="btn-back" title="Volver al Embudo Kanban" aria-label="Volver al Embudo de Ventas">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<line x1="19" y1="12" x2="5" y2="12"></line>
							<polyline points="12 19 5 12 12 5"></polyline>
						</svg>
						<span class="back-text">Volver al Embudo</span>
					</a>
				</div>

				<div class="topbar-center">
					<span class="system-badge">
						<span class="badge-live-dot"></span>
						Ficha de Visita Técnica en Sitio
					</span>
				</div>

				<div class="topbar-right">
					<div id="global-save-pill" class="autosave-pill state-saved" title="Estado de guardado automático">
						<svg id="pill-icon-saved" class="pill-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="20 6 9 17 4 12"></polyline>
						</svg>
						<svg id="pill-icon-saving" class="pill-icon spin hidden" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<line x1="12" y1="2" x2="12" y2="6"></line>
							<line x1="12" y1="18" x2="12" y2="22"></line>
							<line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line>
							<line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line>
							<line x1="2" y1="12" x2="6" y2="12"></line>
							<line x1="18" y1="12" x2="22" y2="12"></line>
							<line x1="4.93" y1="19.07" x2="7.76" y2="16.24"></line>
							<line x1="16.24" y1="7.76" x2="19.07" y2="4.93"></line>
						</svg>
						<span id="pill-save-text">Guardado</span>
					</div>
				</div>
			</div>
		</header>

		<!-- Main Workspace Area -->
		<main class="visit-content-container">
			<!-- Hero Unificado tipo Cabina de Mando (Lead Cockpit Hero) -->
			<section class="cockpit-hero-card">
				<div class="cockpit-top-bar">
					<div class="cockpit-pills-row">
						<span id="lead-stage-badge" class="stage-pill stage-pill-visit">Visita Agendada</span>
						<span id="lead-type-badge" class="type-pill">Remodelación Total</span>
						<span id="lead-source-badge" class="source-pill hidden">
							<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:middle;margin-right:2px;">
								<circle cx="12" cy="12" r="10"></circle>
								<line x1="2" y1="12" x2="22" y2="12"></line>
								<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
							</svg>
							Web
						</span>
						<span id="lead-budget-display" class="budget-pill hidden">
							$ 0 COP
						</span>
					</div>

					<div class="cockpit-actions-row">
						<a id="btn-lead-wa" href="#" target="_blank" rel="noopener noreferrer" class="btn-cockpit-wa" title="Abrir chat en WhatsApp" aria-label="Abrir WhatsApp con el cliente">
							<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
							</svg>
							<span id="lead-wa-text">WhatsApp</span>
						</a>

						<a id="btn-lead-call" href="#" class="btn-cockpit-call" title="Llamar al cliente directamente" aria-label="Llamar al cliente">
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
							</svg>
							<span id="lead-phone-text">Llamar</span>
						</a>
					</div>
				</div>

				<div class="cockpit-main-info">
					<h1 id="lead-client-name" class="cockpit-client-name">Cargando oportunidad...</h1>
					<p class="cockpit-address">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#F97316" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
							<circle cx="12" cy="10" r="3"></circle>
						</svg>
						<span id="lead-project-address">—</span>
					</p>
				</div>
			</section>

			<!-- Workspace Grid (2 Columnas en Desktop) -->
			<div class="visit-workspace-grid">
				<!-- PANEL IZQUIERDO: Tarjeta Unificada de Inspección en Sitio -->
				<div class="workspace-col-main">
					<section class="visit-section-card unified-inspection-card">
						<div class="section-card-header">
							<div class="section-title-wrap">
								<div class="section-icon-badge icon-orange">
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
										<polyline points="14 2 14 8 20 8"></polyline>
										<line x1="16" y1="13" x2="8" y2="13"></line>
										<line x1="16" y1="17" x2="8" y2="17"></line>
										<polyline points="10 9 9 9 8 9"></polyline>
									</svg>
								</div>
								<div>
									<h2 class="section-title">Inspección Técnica en Sitio</h2>
									<p class="section-desc">Horario de acceso, estado de redes e instalaciones</p>
								</div>
							</div>

							<!-- Botón de Dictado por Voz estilizado con ondas vivas (sin punto rojo plano) -->
							<div class="voice-action-wrap">
								<button
									type="button"
									id="btn-voice-dictate"
									class="btn-voice-dictate"
									title="Activar dictado por voz para hablar con manos libres"
									aria-label="Activar dictado por voz"
								>
									<svg class="mic-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
										<path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
										<path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
										<line x1="12" y1="19" x2="12" y2="23"></line>
										<line x1="8" y1="23" x2="16" y2="23"></line>
									</svg>
									<span class="voice-audio-waves" aria-hidden="true">
										<span class="wave-bar bar-1"></span>
										<span class="wave-bar bar-2"></span>
										<span class="wave-bar bar-3"></span>
										<span class="wave-bar bar-4"></span>
									</span>
									<span id="voice-btn-label" class="voice-text">Dictar por Voz</span>
								</button>
							</div>
						</div>

						<div class="section-card-body">
							<!-- Micro-Campos Horizontales Compactos: Horario y Restricciones -->
							<div class="access-compact-row">
								<div class="micro-field micro-field-schedule">
									<label for="visit-scheduled-input" class="micro-label">
										<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
											<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
											<line x1="16" y1="2" x2="16" y2="6"></line>
											<line x1="8" y1="2" x2="8" y2="6"></line>
											<line x1="3" y1="10" x2="21" y2="10"></line>
										</svg>
										<span>Fecha y Hora Pactada</span>
									</label>
									<div class="micro-input-shell">
										<input
											type="datetime-local"
											id="visit-scheduled-input"
											class="micro-input"
										/>
									</div>
								</div>

								<div class="micro-field micro-field-access">
									<label for="visit-access-input" class="micro-label">
										<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
											<circle cx="12" cy="12" r="10"></circle>
											<line x1="12" y1="16" x2="12" y2="12"></line>
											<line x1="12" y1="8" x2="12.01" y2="8"></line>
										</svg>
										<span>Portería, Restricciones y Horario de Ruido</span>
									</label>
									<div class="micro-input-shell">
										<input
											type="text"
											id="visit-access-input"
											class="micro-input"
											placeholder="Ej: Portería Torre 2 • Conserje Don Carlos • Ruido permitido: Lun-Vie 8am a 5pm"
										/>
									</div>
								</div>
							</div>

							<!-- Barra de Snippets Rápidos de 1 Toque -->
							<div class="quick-snippets-bar">
								<span class="snippets-label">Categorías rápidas:</span>
								<div class="snippets-list">
									<button type="button" class="snippet-btn" data-snippet="• Muros y Demolición: ">+ Muros</button>
									<button type="button" class="snippet-btn" data-snippet="• Red Eléctrica: ">+ Eléctrico</button>
									<button type="button" class="snippet-btn" data-snippet="• Red Hidrosanitaria: ">+ Hidráulico</button>
									<button type="button" class="snippet-btn" data-snippet="• Humedades y Filtraciones: ">+ Humedades</button>
									<button type="button" class="snippet-btn" data-snippet="• Pisos y Nivelación: ">+ Pisos</button>
								</div>
							</div>

							<!-- Textarea de Notas Técnicas con Autosave y Contador -->
							<div class="textarea-shell">
								<textarea
									id="technical-notes-input"
									rows="9"
									class="notes-textarea"
									placeholder="Describe las observaciones técnicas del espacio: estado de muros a demoler, tablero de breakers, presión de agua, nivelación de pisos y requerimientos de obra..."
								></textarea>

								<div class="notes-meta-footer">
									<span id="notes-counter" class="notes-stats">0 palabras • 0 caracteres</span>
									<span id="notes-autosave-indicator" class="autosave-inline-hint">
										<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
											<polyline points="20 6 9 17 4 12"></polyline>
										</svg>
										Autoguardado activo
									</span>
								</div>
							</div>

							<!-- Voice Status Banner con ecualizador animado -->
							<div id="voice-listening-banner" class="voice-status-banner hidden">
								<div class="voice-equalizer" aria-hidden="true">
									<span class="wave-bar bar-1"></span>
									<span class="wave-bar bar-2"></span>
									<span class="wave-bar bar-3"></span>
									<span class="wave-bar bar-4"></span>
								</div>
								<p class="voice-status-text">
									<strong>Escuchando...</strong> Habla con claridad. Tu voz se transcribe en tiempo real dentro de las notas.
								</p>
								<button type="button" id="btn-stop-voice" class="btn-stop-voice">Detener Dictado</button>
							</div>
						</div>
					</section>
				</div>

				<!-- PANEL DERECHO: Estudio Fotográfico "Antes de Obra" -->
				<div class="workspace-col-side">
					<section class="visit-section-card photographic-studio-card">
						<div class="section-card-header">
							<div class="section-title-wrap">
								<div class="section-icon-badge icon-emerald">
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
										<circle cx="12" cy="13" r="4"></circle>
									</svg>
								</div>
								<div>
									<div class="title-with-pill">
										<h2 class="section-title">Estudio Fotográfico "Antes de Obra"</h2>
										<span id="photos-counter-pill" class="count-pill">0 fotos</span>
									</div>
									<p class="section-desc">Compresión automática en cliente &lt; 800 KB</p>
								</div>
							</div>
						</div>

						<div class="section-card-body">
							<!-- Selector de Zona con Scroll Horizontal Suave -->
							<div class="zone-selector-wrap">
								<span class="zone-label">Zona de captura técnica:</span>
								<div class="zone-chips-row" id="zone-chips-container" role="radiogroup" aria-label="Zona de la fotografía">
									<button type="button" class="zone-chip active" data-zone="General" role="radio" aria-checked="true">
										General
									</button>
									<button type="button" class="zone-chip" data-zone="Baño Principal" role="radio" aria-checked="false">
										Baño Principal
									</button>
									<button type="button" class="zone-chip" data-zone="Cocina" role="radio" aria-checked="false">
										Cocina
									</button>
									<button type="button" class="zone-chip" data-zone="Sala / Balcón" role="radio" aria-checked="false">
										Sala / Balcón
									</button>
									<button type="button" class="zone-chip" data-zone="Fachada" role="radio" aria-checked="false">
										Fachada
									</button>
									<button type="button" class="zone-chip" data-zone="Habitación" role="radio" aria-checked="false">
										Habitación
									</button>
								</div>
							</div>

							<!-- Botones Operate Mode de Mínimo 48px: Cámara y Galería -->
							<div class="upload-actions-bar">
								<input
									type="file"
									id="camera-file-input"
									accept="image/*"
									capture="environment"
									class="hidden"
								/>
								<button
									type="button"
									id="btn-camera-trigger"
									class="btn-action-upload btn-camera-action"
									aria-label="Abrir cámara del teléfono para tomar foto del antes"
								>
									<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
										<circle cx="12" cy="13" r="4"></circle>
									</svg>
									<span>Tomar con Cámara</span>
								</button>

								<input
									type="file"
									id="gallery-file-input"
									accept="image/*"
									multiple
									class="hidden"
								/>
								<button
									type="button"
									id="btn-gallery-trigger"
									class="btn-action-upload btn-gallery-action"
									aria-label="Subir fotos existentes desde la galería"
								>
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
										<circle cx="8.5" cy="8.5" r="1.5"></circle>
										<polyline points="21 15 16 10 5 21"></polyline>
									</svg>
									<span>Subir de Galería</span>
								</button>
							</div>

							<!-- Barra de Progreso de Compresión Dinámica -->
							<div id="compression-progress-box" class="compression-progress-wrap hidden" aria-live="polite">
								<div class="progress-info-row">
									<span id="compression-status-text" class="progress-label">Optimizando imagen con Canvas API...</span>
									<span id="compression-percent-text" class="progress-percent">0%</span>
								</div>
								<div class="progress-track">
									<div id="compression-progress-bar" class="progress-fill" style="width: 0%;"></div>
								</div>
							</div>

							<!-- Grid de Fotos del Antes (Aspect Ratio 4:3 con Miniaturas Nítidas) -->
							<div id="before-photos-grid" class="before-photos-grid">
								<!-- Renderizado reactivo desde JavaScript -->
							</div>

							<!-- Estado Vacío Rediseñado: Visor Tecnológico con Corner Brackets ┌ ┐ └ ┘ -->
							<div id="photos-empty-state" class="viewfinder-empty-container hidden">
								<div class="viewfinder-frame">
									<span class="corner-bracket corner-tl"></span>
									<span class="corner-bracket corner-tr"></span>
									<span class="corner-bracket corner-bl"></span>
									<span class="corner-bracket corner-br"></span>
									
									<div class="viewfinder-content">
										<div class="viewfinder-reticle">
											<svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#EA580C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
												<circle cx="12" cy="12" r="9"></circle>
												<line x1="12" y1="3" x2="12" y2="7"></line>
												<line x1="12" y1="17" x2="12" y2="21"></line>
												<line x1="3" y1="12" x2="7" y2="12"></line>
												<line x1="17" y1="12" x2="21" y2="12"></line>
												<circle cx="12" cy="12" r="3"></circle>
											</svg>
										</div>
										<h3 class="viewfinder-title">Visor de Registro Fotográfico del Antes</h3>
										<p class="viewfinder-desc">
											Captura muros, instalaciones y pisos antes de la intervención. Este registro respalda tu presupuesto y da total transparencia al cliente.
										</p>
										<button type="button" class="btn-viewfinder-trigger" id="btn-viewfinder-camera">
											<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
												<path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
												<circle cx="12" cy="13" r="4"></circle>
											</svg>
											<span>Tomar Primera Fotografía</span>
										</button>
									</div>
								</div>
							</div>
						</div>
					</section>

					<!-- HU-10: Timeline de actividad de propuesta comercial -->
					<section id="proposal-activity-card" class="visit-section-card proposal-activity-card hidden" aria-label="Actividad de propuesta comercial">
						<div class="section-card-header">
							<div class="section-title-wrap">
								<div class="section-icon-badge icon-blue">
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
										<circle cx="12" cy="12" r="3"></circle>
									</svg>
								</div>
								<div>
									<div class="title-with-pill">
										<h2 class="section-title">Actividad de la Propuesta</h2>
										<span id="proposal-views-pill" class="count-pill count-pill-blue">0 aperturas</span>
									</div>
									<p class="section-desc">Seguimiento de aperturas del enlace comercial (HU-10)</p>
								</div>
							</div>
						</div>
						<div class="section-card-body">
							<ul id="proposal-activity-timeline" class="proposal-timeline" aria-live="polite"></ul>
							<p id="proposal-activity-empty" class="proposal-timeline-empty">Aún no hay aperturas registradas para la propuesta de este lead.</p>
						</div>
					</section>
				</div>
			</div>
		</main>
	</div>

	<!-- ======================================================================
	     MODAL 1: LIGHTBOX DE PANTALLA COMPLETA CON GESTOS TÁCTILES
	     ====================================================================== -->
	<div id="lightbox-modal" class="lightbox-overlay" role="dialog" aria-modal="true" aria-labelledby="lightbox-photo-title">
		<div id="lightbox-backdrop" class="lightbox-backdrop"></div>
		
		<div class="lightbox-chrome">
			<!-- Header superior del Lightbox -->
			<div class="lightbox-header">
				<div class="lightbox-meta-info">
