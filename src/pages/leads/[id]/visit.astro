	function updateNotesCounter() {
		if (!technicalNotesInput || !notesCounterEl) return;
		const text = technicalNotesInput.value.trim();
		const words = text ? text.split(/\s+/).length : 0;
		const chars = text.length;
		notesCounterEl.textContent = `${words} ${words === 1 ? 'palabra' : 'palabras'} • ${chars} caracteres`;
	}

	// =========================================================================
	// 2. AUTOSAVE ENGINE (DEBOUNCE 3 SECONDS)
	// =========================================================================
	function setAutosaveState(state: 'saving' | 'saved') {
		if (state === 'saving') {
			pillSaved?.classList.remove('state-saved');
			pillSaved?.classList.add('state-saving');
			iconSaved?.classList.add('hidden');
			iconSaving?.classList.remove('hidden');
			if (textSaved) textSaved.textContent = 'Guardando cambios...';
			if (notesAutosaveIndicator) {
				notesAutosaveIndicator.innerHTML = `
					<svg class="spin" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<line x1="12" y1="2" x2="12" y2="6"></line>
						<line x1="12" y1="18" x2="12" y2="22"></line>
					</svg> Guardando...
				`;
				notesAutosaveIndicator.style.color = '#F59E0B';
			}
		} else {
			pillSaved?.classList.remove('state-saving');
			pillSaved?.classList.add('state-saved');
			iconSaved?.classList.remove('hidden');
			iconSaving?.classList.add('hidden');
			const now = new Date();
			const timeStr = now.toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit' });
			if (textSaved) textSaved.textContent = `Guardado (${timeStr})`;
			if (notesAutosaveIndicator) {
				notesAutosaveIndicator.innerHTML = `
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<polyline points="20 6 9 17 4 12"></polyline>
					</svg> Guardado automático (${timeStr})
				`;
				notesAutosaveIndicator.style.color = '#059669';
			}
		}
	}

	function triggerAutosave() {
		setAutosaveState('saving');
		clearTimeout(autosaveDebounceTimer);
		autosaveDebounceTimer = setTimeout(() => {
			performSave();
		}, 3000);
	}

	function performSave() {
		if (!currentLead) return;

		if (!currentLead.visit) {
			currentLead.visit = {};
		}

		if (scheduledInput) {
			currentLead.visit.scheduled_for = scheduledInput.value;
		}
		if (accessInput) {
			currentLead.visit.access_notes = accessInput.value.trim();
		}
		if (technicalNotesInput) {
			currentLead.visit.technical_notes = technicalNotesInput.value.trim();
		}

		currentLead.visit.updated_at = new Date().toISOString();
		currentLead.updated_at = new Date().toISOString();

		// Update in list and persist
		const idx = leads.findIndex(l => l.id === currentLead?.id);
		if (idx >= 0) {
			leads[idx] = { ...currentLead };
		}
		saveLeads(leads);

		setAutosaveState('saved');
	}

	// Attach change and input events to autosave
	scheduledInput?.addEventListener('input', triggerAutosave);
	scheduledInput?.addEventListener('change', performSave);

	accessInput?.addEventListener('input', triggerAutosave);
	accessInput?.addEventListener('blur', performSave);

	technicalNotesInput?.addEventListener('input', () => {
		updateNotesCounter();
		triggerAutosave();
	});
	technicalNotesInput?.addEventListener('blur', performSave);

	// =========================================================================
	// 3. VOICE-TO-TEXT DICTATION (WEB SPEECH RECOGNITION API)
	// =========================================================================
	let speechRecognitionInstance: any = null;
	let isRecording = false;

	function initSpeechRecognition() {
		const SpeechRecognition = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;
		if (!SpeechRecognition) {
			return null;
		}

		const rec = new SpeechRecognition();
		rec.lang = 'es-CO';
		rec.continuous = true;
		rec.interimResults = false;

		rec.onresult = (event: any) => {
			let transcript = '';
			for (let i = event.resultIndex; i < event.results.length; i++) {
				if (event.results[i].isFinal) {
					transcript += event.results[i][0].transcript + ' ';
				}
			}

			if (transcript.trim() && technicalNotesInput) {
				const start = technicalNotesInput.selectionStart || technicalNotesInput.value.length;
				const end = technicalNotesInput.selectionEnd || technicalNotesInput.value.length;
				const currentText = technicalNotesInput.value;
				
				const prefix = (start > 0 && !currentText[start - 1].endsWith(' ') && !currentText[start - 1].endsWith('\n')) ? ' ' : '';
				const injected = prefix + transcript.trim() + ' ';
				
				technicalNotesInput.value = currentText.substring(0, start) + injected + currentText.substring(end);
				technicalNotesInput.selectionStart = technicalNotesInput.selectionEnd = start + injected.length;
				
				updateNotesCounter();
				triggerAutosave();
			}
		};

		rec.onerror = () => {
			stopRecording();
		};

		rec.onend = () => {
			if (isRecording) {
				stopRecording();
			}
		};

		return rec;
	}

	function startRecording() {
		if (!speechRecognitionInstance) {
			speechRecognitionInstance = initSpeechRecognition();
		}

		if (!speechRecognitionInstance) {
			window.dispatchEvent(new CustomEvent('show-toast', {
				detail: {
					title: 'Dictado por voz',
					message: 'Usa el botón de micrófono en el teclado de tu dispositivo para dictar texto en las notas.',
					type: 'info'
				}
			}));
			return;
		}

		try {
			speechRecognitionInstance.start();
			isRecording = true;
			btnVoiceDictate?.classList.add('is-recording');
			if (voiceBtnLabel) voiceBtnLabel.textContent = 'Grabando...';
			voiceListeningBanner?.classList.remove('hidden');
		} catch (_) {
			stopRecording();
		}
	}

	function stopRecording() {
		isRecording = false;
		btnVoiceDictate?.classList.remove('is-recording');
		if (voiceBtnLabel) voiceBtnLabel.textContent = 'Dictar por Voz';
		voiceListeningBanner?.classList.add('hidden');
		try {
			speechRecognitionInstance?.stop();
		} catch (_) {}
	}

	btnVoiceDictate?.addEventListener('click', () => {
		if (isRecording) {
			stopRecording();
		} else {
			startRecording();
		}
	});

	btnStopVoice?.addEventListener('click', stopRecording);

	// Quick Category Snippets for Technical Notes
	document.querySelectorAll('.snippet-btn').forEach((btn) => {
		btn.addEventListener('click', () => {
			const snippet = btn.getAttribute('data-snippet') || '';
			if (!technicalNotesInput) return;
			const currentVal = technicalNotesInput.value;
			const needsNewline = currentVal.length > 0 && !currentVal.endsWith('\n');
			technicalNotesInput.value = currentVal + (needsNewline ? '\n' : '') + snippet;
			technicalNotesInput.focus();
			updateNotesCounter();
			triggerAutosave();
		});
	});

	// =========================================================================
	// 4. ZONE SELECTOR CHIPS
	// =========================================================================
	zoneChips.forEach((chip) => {
		chip.addEventListener('click', () => {
			zoneChips.forEach(c => {
				c.classList.remove('active');
