		const views = getProposalViewsForLead(currentLead.id);
		pill.textContent = `${views.length} ${views.length === 1 ? 'apertura' : 'aperturas'}`;

		if (views.length === 0) {
			card.classList.remove('hidden');
			timeline.innerHTML = '';
			empty.classList.remove('hidden');
			return;
		}

		card.classList.remove('hidden');
		empty.classList.add('hidden');
		timeline.innerHTML = views.map((view) => `
			<li class="proposal-timeline-item">
				<span class="proposal-timeline-dot" aria-hidden="true"></span>
				<div>
