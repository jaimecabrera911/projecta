---
// src/components/Sidebar.astro
// Sidebar de navegación modular para ObraFlow SaaS (Operate Mode & Impeccable)
---

<!-- Backdrop overlay para móviles y tablets (< 1024px) -->
<div id="sidebar-backdrop" class="sidebar-backdrop" aria-hidden="true"></div>

<!-- Sidebar Principal -->
<aside id="app-sidebar" class="app-sidebar" aria-label="Menú principal de módulos">
	<!-- Top: Brand & Close Button (Mobile) -->
	<div class="sidebar-header">
		<a href="/" class="sidebar-brand-link" title="Ir al inicio de ObraFlow">
			<div class="sidebar-brand-emblem">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M2 20h20"></path>
					<path d="m5 20 5-15h4l5 15"></path>
					<path d="M9 13h6"></path>
				</svg>
			</div>
			<div class="sidebar-brand-text">
				<div class="brand-title">
					Obra<span class="text-accent">Flow</span>
					<span class="badge-plan">Pro</span>
				</div>
				<span class="brand-version">v2.4 • Gestión de Obra</span>
			</div>
		</a>

		<button
			id="sidebar-close-btn"
			type="button"
			class="btn-sidebar-close"
			aria-label="Cerrar menú lateral"
			title="Cerrar menú (Escape)"
		>
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
				<line x1="18" y1="6" x2="6" y2="18"></line>
				<line x1="6" y1="6" x2="18" y2="18"></line>
			</svg>
		</button>
	</div>

	<!-- Contexto de Empresa / Organización -->
	<div class="sidebar-org-card">
		<div class="org-avatar">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
				<rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
				<path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
			</svg>
		</div>
		<div class="org-info">
			<span class="org-name" title="Construcciones & Reformas Andina SAS">Construcciones Andina</span>
			<span class="org-status">
				<span class="status-dot"></span>
				En línea • NIT 901.442.188-4
			</span>
		</div>
	</div>

	<!-- Lista de Módulos de Navegación -->
	<nav class="sidebar-nav" aria-label="Módulos del SaaS">
		
		<!-- GRUPO 1: COMERCIAL Y VENTAS -->
		<div class="nav-group">
			<span class="nav-group-title">Gestión Comercial</span>
			
			<a href="/" class="nav-item" data-path="/">
				<span class="nav-icon">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<rect x="3" y="3" width="7" height="18" rx="1"></rect>
						<rect x="14" y="3" width="7" height="11" rx="1"></rect>
					</svg>
				</span>
				<span class="nav-label">Embudo de Ventas</span>
				<span class="nav-badge orange-badge">CRM</span>
			</a>
		</div>

		<!-- GRUPO 2: PRESUPUESTOS Y COSTOS -->
		<div class="nav-group">
			<span class="nav-group-title">Costos y Estimación</span>

			<a href="/catalog" class="nav-item" data-path="/catalog">
				<span class="nav-icon">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
						<path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
					</svg>
				</span>
				<span class="nav-label">Catálogo de Insumos</span>
				<span class="nav-badge green-badge">APU</span>
			</a>

			<a href="/budgets" class="nav-item" data-path="/budgets" title="Constructor jerárquico de presupuestos por capítulos">
				<span class="nav-icon">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
						<polyline points="14 2 14 8 20 8"></polyline>
						<line x1="16" y1="13" x2="8" y2="13"></line>
						<line x1="16" y1="17" x2="8" y2="17"></line>
					</svg>
				</span>
				<span class="nav-label">Presupuestos</span>
				<span class="nav-badge orange-badge">Margen</span>
			</a>
		</div>

		<!-- GRUPO 3: CONTROL DE OBRA -->
		<div class="nav-group">
			<span class="nav-group-title">Operación en Sitio</span>

			<a href="/costing" class="nav-item" data-path="/costing" title="Control Financiero y Matriz Presupuesto vs Real (HU-13)">
				<span class="nav-icon">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
					</svg>
				</span>
				<span class="nav-label">Control de Costos</span>
				<span class="nav-badge green-badge">HU-13</span>
			</a>

			<a href="/expenses/quick" class="nav-item" data-path="/expenses" title="Registro Rápido de Gastos en 3 Toques (HU-14)">
				<span class="nav-icon">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
						<circle cx="12" cy="13" r="4"></circle>
					</svg>
				</span>
				<span class="nav-label">Gastos de Campo</span>
				<span class="nav-badge orange-badge">HU-14</span>
			</a>

			<a href="/costing#costing-change-orders-section" class="nav-item" data-path="/costing#change-orders" title="Órdenes de Cambio y Adicionales Firmados (HU-15)">
				<span class="nav-icon">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
						<polyline points="14 2 14 8 20 8"></polyline>
						<path d="M12 18v-6"></path>
						<path d="m9 15 3 3 3-3"></path>
					</svg>
				</span>
				<span class="nav-label">Órdenes de Cambio</span>
				<span class="nav-badge orange-badge">HU-15</span>
			</a>

			<a href="/schedule" class="nav-item" data-path="/schedule" title="Cronograma Táctil de Tareas de Obra (HU-16)">
				<span class="nav-icon">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
						<line x1="16" y1="2" x2="16" y2="6"></line>
						<line x1="8" y1="2" x2="8" y2="6"></line>
						<line x1="3" y1="10" x2="21" y2="10"></line>
						<path d="m9 16 2 2 4-4"></path>
					</svg>
				</span>
				<span class="nav-label">Cronograma</span>
				<span class="nav-badge green-badge">HU-16</span>
			</a>

			<a href="/daily-logs" class="nav-item" data-path="/daily-logs" title="Bitácora Diaria de Obra con Fotos y Clima (HU-17)">
				<span class="nav-icon">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
						<polyline points="14 2 14 8 20 8"></polyline>
						<circle cx="12" cy="14" r="3"></circle>
					</svg>
				</span>
				<span class="nav-label">Bitácora Diaria</span>
				<span class="nav-badge green-badge">HU-17</span>
			</a>

			<a href="/f/andina-sas" target="_blank" rel="noopener noreferrer" class="nav-item" title="Ver formulario público web en nueva pestaña">
				<span class="nav-icon">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="12" cy="12" r="10"></circle>
						<line x1="2" y1="12" x2="22" y2="12"></line>
						<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
					</svg>
				</span>
				<span class="nav-label">Formulario Cliente</span>
				<span class="nav-external-icon">
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
						<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
						<polyline points="15 3 21 3 21 9"></polyline>
						<line x1="10" y1="14" x2="21" y2="3"></line>
					</svg>
				</span>
			</a>
		</div>
	</nav>

	<!-- Footer del Sidebar: Perfil de Usuario -->
	<div class="sidebar-footer">
		<div class="user-profile-card">
			<div class="user-avatar-circle" id="sidebar-user-avatar">CM</div>
			<div class="user-info-text">
				<span class="user-display-name" id="sidebar-user-name">Carlos Mendoza</span>
				<span class="user-role-label" id="sidebar-user-role">Contratista General</span>
			</div>
			<div class="user-status-dot" title="Sesión activa"></div>
		</div>
	</div>
</aside>

<style>
	/* ==========================================================================
	   ESTILOS DEL SIDEBAR (OPERATE MODE & DESIGN TOKENS)
	   ========================================================================== */
	
	/* Backdrop para móviles */
	.sidebar-backdrop {
		position: fixed;
		inset: 0;
		background-color: rgba(15, 23, 42, 0.7);
		backdrop-filter: blur(4px);
		z-index: 90;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.25s ease;
	}

	.sidebar-backdrop.active {
		opacity: 1;
		pointer-events: auto;
	}

	/* Contenedor del Sidebar */
	.app-sidebar {
		width: 16.5rem;
		min-width: 16.5rem;
		height: 100vh;
		background-color: #0F172A;
		border-right: 1px solid #1E293B;
		display: flex;
		flex-direction: column;
		color: #F8FAFC;
		position: fixed;
		top: 0;
		bottom: 0;
		left: 0;
		z-index: 100;
		transform: translateX(-100%);
		transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
		box-shadow: 4px 0 24px rgba(0, 0, 0, 0.35);
		user-select: none;
	}

	.app-sidebar.open {
		transform: translateX(0);
	}

	/* En Desktop (>= 1024px): Fijo a la izquierda; mantiene su alto y su propio scroll */
	@media (min-width: 1024px) {
		.app-sidebar {
			position: sticky;
			top: 0;
			height: 100vh;
			transform: none;
			box-shadow: none;
			flex-shrink: 0;
		}

		.sidebar-backdrop {
			display: none !important;
		}

		.btn-sidebar-close {
			display: none !important;
		}
	}

	/* Header del Sidebar */
	.sidebar-header {
		padding: 1.25rem 1rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-bottom: 1px solid #1E293B;
	}

	.sidebar-brand-link {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		text-decoration: none;
		color: #FFFFFF;
		border-radius: 0.5rem;
		transition: opacity 0.15s ease;
	}

	.sidebar-brand-link:hover {
		opacity: 0.9;
	}

	.sidebar-brand-link:focus-visible {
		outline: 2px solid #F97316;
		outline-offset: 2px;
	}

	.sidebar-brand-emblem {
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 0.625rem;
		background: linear-gradient(135deg, #F97316, #EA580C);
		display: flex;
		align-items: center;
		justify-content: center;
		color: #FFFFFF;
		box-shadow: 0 4px 12px rgba(249, 115, 22, 0.35);
		flex-shrink: 0;
	}

	.sidebar-brand-text {
		display: flex;
		flex-direction: column;
	}

	.brand-title {
		font-size: 1.125rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		display: flex;
		align-items: center;
		gap: 0.375rem;
		line-height: 1.2;
	}

	.text-accent {
		color: #FB923C;
	}

	.badge-plan {
		font-size: 0.625rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		background-color: rgba(249, 115, 22, 0.2);
		color: #FED7AA;
		border: 1px solid rgba(249, 115, 22, 0.3);
		padding: 0.0625rem 0.375rem;
		border-radius: 9999px;
	}

	.brand-version {
		font-size: 0.6875rem;
		color: #64748B;
		font-weight: 500;
	}

	.btn-sidebar-close {
		width: 48px;
		height: 48px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: transparent;
		border: none;
		color: #94A3B8;
		border-radius: 0.5rem;
		cursor: pointer;
		transition: background-color 0.15s, color 0.15s;
	}

	.btn-sidebar-close:hover {
		background-color: #1E293B;
		color: #FFFFFF;
	}

	.btn-sidebar-close:focus-visible {
		outline: 2px solid #F97316;
		outline-offset: 2px;
	}

	/* Tarjeta de Organización */
	.sidebar-org-card {
		margin: 0.875rem 0.875rem 0.5rem 0.875rem;
		padding: 0.625rem 0.75rem;
		border-radius: 0.625rem;
		background-color: #1E293B;
		border: 1px solid #334155;
		display: flex;
		align-items: center;
		gap: 0.625rem;
	}

	.org-avatar {
		width: 1.875rem;
		height: 1.875rem;
		border-radius: 0.375rem;
		background-color: #0F172A;
		color: #FB923C;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.org-info {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.org-name {
		font-size: 0.75rem;
		font-weight: 700;
		color: #F8FAFC;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.org-status {
		font-size: 0.625rem;
		color: #94A3B8;
		display: flex;
		align-items: center;
		gap: 0.25rem;
		margin-top: 0.125rem;
	}

	.status-dot {
		width: 6px;
		height: 6px;
		border-radius: 9999px;
		background-color: #10B981;
		flex-shrink: 0;
	}

	/* Navegación por Módulos */
	.sidebar-nav {
		flex: 1 1 auto;
		min-height: 0;
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 0.75rem 0.875rem;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.nav-group {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.nav-group-title {
		font-size: 0.6875rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: #64748B;
		padding: 0.25rem 0.625rem;
		margin-bottom: 0.25rem;
	}

	.nav-item {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.625rem 0.75rem;
		min-height: 48px;
		border-radius: 0.625rem;
		color: #94A3B8;
		text-decoration: none;
		font-size: 0.8125rem;
		font-weight: 600;
		transition: all 0.15s ease;
		position: relative;
	}

	.nav-item:hover:not(.nav-item-disabled) {
		background-color: #1E293B;
		color: #F8FAFC;
	}

	.nav-item:focus-visible {
		outline: 2px solid #F97316;
		outline-offset: 2px;
	}

	.nav-item.active {
		background-color: #1E293B;
		color: #FFFFFF;
		font-weight: 700;
		border-left: 3px solid #F97316;
	}

	.nav-item.active .nav-icon {
		color: #F97316;
	}

	.nav-item-disabled {
		opacity: 0.45;
		cursor: not-allowed;
	}

	.nav-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		color: #64748B;
		flex-shrink: 0;
		transition: color 0.15s;
	}

	.nav-label {
		flex: 1;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.nav-badge {
		font-size: 0.625rem;
		font-weight: 800;
		padding: 0.125rem 0.375rem;
		border-radius: 0.375rem;
		font-family: var(--font-mono);
		text-transform: uppercase;
	}

	.orange-badge { background-color: #FFF7ED; color: #EA580C; }
	.blue-badge   { background-color: #EFF6FF; color: #2563EB; }
	.green-badge  { background-color: #ECFDF5; color: #059669; }
	.slate-badge  { background-color: #334155; color: #94A3B8; }

	.nav-external-icon {
		color: #64748B;
		display: flex;
		align-items: center;
	}

	/* Footer del Sidebar */
	.sidebar-footer {
		padding: 0.875rem;
		border-top: 1px solid #1E293B;
		background-color: #0A0F1D;
	}

	.user-profile-card {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		padding: 0.375rem;
		border-radius: 0.5rem;
	}

	.user-avatar-circle {
		width: 2rem;
		height: 2rem;
		border-radius: 9999px;
		background-color: #334155;
		color: #F8FAFC;
		font-size: 0.75rem;
		font-weight: 700;
		display: flex;
		align-items: center;
		justify-content: center;
		border: 1px solid #475569;
		flex-shrink: 0;
	}

	.user-info-text {
		display: flex;
		flex-direction: column;
		min-width: 0;
		flex: 1;
	}

	.user-display-name {
		font-size: 0.75rem;
		font-weight: 700;
		color: #F8FAFC;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.user-role-label {
		font-size: 0.625rem;
		color: #94A3B8;
	}

	.user-status-dot {
		width: 8px;
		height: 8px;
		border-radius: 9999px;
		background-color: #10B981;
		box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.2);
		flex-shrink: 0;
	}
</style>

<script>
	// Controlador de Interacción y Resaltado Reactivo del Sidebar
	function initSidebar() {
		const sidebar = document.getElementById('app-sidebar');
		const backdrop = document.getElementById('sidebar-backdrop');
		const closeBtn = document.getElementById('sidebar-close-btn');

		// 1. Resaltar enlace activo según la URL actual
		const currentPath = window.location.pathname;
		const navItems = document.querySelectorAll<HTMLAnchorElement>('.sidebar-nav .nav-item');

		navItems.forEach((item) => {
			const itemPath = item.getAttribute('data-path');
			if (!itemPath) return;

			// Coincidencia exacta para '/' o prefijo para '/catalog', '/costing', etc.
			const isActive = itemPath === '/'
				? currentPath === '/'
				: currentPath.startsWith(itemPath) || (itemPath === '/costing' && currentPath.includes('/costing'));

			if (isActive) {
				item.classList.add('active');
				item.setAttribute('aria-current', 'page');
			} else {
				item.classList.remove('active');
				item.removeAttribute('aria-current');
			}
		});

		// 2. Funciones para Abrir/Cerrar en Móviles
		function openSidebar() {
			sidebar?.classList.add('open');
			backdrop?.classList.add('active');
			document.body.style.overflow = 'hidden';
		}

		function closeSidebar() {
			sidebar?.classList.remove('open');
			backdrop?.classList.remove('active');
			document.body.style.overflow = '';
		}

		// Event listeners
		closeBtn?.addEventListener('click', closeSidebar);
		backdrop?.addEventListener('click', closeSidebar);

		// Escuchar evento personalizado emitido desde el botón del Header
		window.addEventListener('toggle-sidebar', () => {
			if (sidebar?.classList.contains('open')) {
				closeSidebar();
			} else {
				openSidebar();
			}
		});

		// Cerrar con Escape
		window.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && sidebar?.classList.contains('open')) {
				closeSidebar();
			}
		});

		// 3. Sincronización de Perfil según Rol Activo (HU-14)
		import('../lib/role-store').then(({ getActiveRoleConfig }) => {
			const avatarEl = document.getElementById('sidebar-user-avatar');
			const nameEl = document.getElementById('sidebar-user-name');
			const roleEl = document.getElementById('sidebar-user-role');

			function applyRole(config: any) {
				if (avatarEl) {
					avatarEl.textContent = config.avatar;
					avatarEl.style.background = config.avatarBg;
				}
				if (nameEl) nameEl.textContent = config.name;
				if (roleEl) roleEl.textContent = config.label;
			}

			applyRole(getActiveRoleConfig());

			window.addEventListener('obraflow:role-change', (e: any) => {
				if (e.detail?.config) {
					applyRole(e.detail.config);
				}
			});
		});
	}

	// Ejecutar al cargar y tras transiciones
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initSidebar);
	} else {
		initSidebar();
	}
</script>
