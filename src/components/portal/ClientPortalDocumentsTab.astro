---
// src/components/portal/ClientPortalDocumentsTab.astro
// HU-19: Pestaña 2 del Portal del Cliente — Documentos, Contratos y Órdenes de Cambio Firmables.
import { renderIconSvg } from '../../lib/icons.ts';
---

<section id="tab-documents-panel" class="portal-tab-panel" role="tabpanel" aria-labelledby="tab-documents-btn">
	<!-- 1. Contrato Principal de Obra -->
	<div class="document-section-card">
		<div class="doc-card-header">
			<div class="doc-title-box">
				<span class="doc-header-icon" set:html={renderIconSvg('fileText', { size: 20 })}></span>
				<div>
					<h2 class="doc-heading">Contrato Principal de Obra Civil</h2>
					<p class="doc-subheading">Documento legal base que rige el alcance, plazos y condiciones de la remodelación.</p>
				</div>
			</div>
			<span class="signed-badge" style="display: inline-flex; align-items: center; gap: 4px;">
				<span set:html={renderIconSvg('check', { size: 12 })}></span>
				<span>Firmado Digitalmente</span>
			</span>
		</div>

		<div class="contract-file-strip">
			<div class="file-icon-wrap" set:html={renderIconSvg('budget', { size: 24 })}></div>
			<div class="file-meta-col">
				<strong id="portal-contract-title" class="file-title">Contrato Principal de Obra Civil y Remodelación</strong>
				<div class="file-specs-line">
					<span id="portal-contract-code" class="file-code">CTR-PROJ_ANDINA_001-2026</span>
					<span class="meta-dot">•</span>
					<span class="file-weight">1.4 MB (PDF Oficial)</span>
					<span class="meta-dot">•</span>
					<span id="portal-contract-date" class="file-date">Firmado el 2 de Noviembre de 2026</span>
				</div>
			</div>

			<button
				id="btn-download-contract-pdf"
				type="button"
				class="btn-file-download"
				title="Descargar copia del contrato firmado en PDF"
			>
				<span set:html={renderIconSvg('fileDownload', { size: 16 })}></span>
				<span>Descargar PDF</span>
			</button>
		</div>
	</div>

	<!-- 2. Trabajos Adicionales (Órdenes de Cambio) -->
	<div class="document-section-card">
		<div class="doc-card-header">
			<div class="doc-title-box">
				<span class="doc-header-icon orange" set:html={renderIconSvg('clipboard', { size: 20 })}></span>
				<div>
					<h2 class="doc-heading">Trabajos Adicionales y Modificaciones (Órdenes de Cambio)</h2>
					<p class="doc-subheading">Aprobaciones formales de modificaciones al alcance original del proyecto.</p>
				</div>
			</div>
			<div id="portal-co-counter-badge" class="change-orders-badge">
				0 adicionales
			</div>
		</div>

		<!-- Lista de Órdenes de Cambio (Inyectada Dinámicamente) -->
		<div id="portal-change-orders-list" class="change-orders-stream">
			<!-- Renderizado interactivo -->
		</div>
	</div>
</section>

<style>
	.portal-tab-panel {
		display: none;
		flex-direction: column;
		gap: 1.25rem;
		width: 100%;
	}

	.portal-tab-panel.active {
		display: flex;
	}

	.document-section-card {
		background-color: #FFFFFF;
		border: 1.5px solid #E2E8F0;
		border-radius: 1rem;
		padding: 1.25rem 1.5rem;
		box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.doc-card-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		border-bottom: 1px solid #F1F5F9;
		padding-bottom: 0.875rem;
	}

	.doc-title-box {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.doc-header-icon {
		width: 40px;
		height: 40px;
		border-radius: 0.625rem;
		background-color: #0F172A;
		color: #2563EB;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.doc-header-icon.orange {
		color: #F97316;
	}

	.doc-heading {
		font-size: 1.0625rem;
		font-weight: 800;
		color: #0F172A;
		margin: 0;
	}

	.doc-subheading {
		font-size: 0.75rem;
		color: #64748B;
		margin: 0.15rem 0 0 0;
	}

	.signed-badge {
		font-size: 0.6875rem;
		font-weight: 800;
		background-color: #ECFDF5;
		color: #047857;
		border: 1px solid #A7F3D0;
		padding: 0.25rem 0.65rem;
		border-radius: 9999px;
		white-space: nowrap;
	}

	.change-orders-badge {
		font-size: 0.6875rem;
		font-weight: 800;
		background-color: #F1F5F9;
		color: #475569;
		border: 1px solid #CBD5E1;
		padding: 0.25rem 0.65rem;
		border-radius: 9999px;
		white-space: nowrap;
	}

	/* Fila del Contrato */
	.contract-file-strip {
		background-color: #F8FAFC;
		border: 1.5px solid #CBD5E1;
		border-radius: 0.75rem;
		padding: 1rem 1.25rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.file-icon-wrap {
		width: 44px;
		height: 44px;
		border-radius: 0.5rem;
		background-color: #EFF6FF;
		color: #1D4ED8;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.file-meta-col {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		flex: 1;
		min-width: 240px;
	}

	.file-title {
		font-size: 0.875rem;
		font-weight: 800;
		color: #0F172A;
	}

	.file-specs-line {
		font-size: 0.6875rem;
		color: #64748B;
		display: flex;
		align-items: center;
		gap: 0.45rem;
		flex-wrap: wrap;
	}

	.file-code {
		font-family: 'JetBrains Mono', monospace;
		font-weight: 700;
		color: #334155;
	}

	.meta-dot {
		color: #CBD5E1;
	}

	.btn-file-download {
		min-height: 44px;
		padding: 0 1rem;
		border-radius: 0.5rem;
		background-color: #0F172A;
		color: #FFFFFF;
		font-size: 0.75rem;
		font-weight: 700;
		border: none;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		transition: all 0.15s ease;
		user-select: none;
	}

	.btn-file-download:hover {
		background-color: #1E293B;
		transform: translateY(-1px);
	}

	/* Flujo de Órdenes de Cambio */
	.change-orders-stream {
		display: flex;
		flex-direction: column;
		gap: 0.875rem;
	}

	:global(.co-item-card) {
		background-color: #F8FAFC;
		border: 1.5px solid #E2E8F0;
		border-radius: 0.75rem;
		padding: 1.125rem 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.875rem;
		transition: all 0.15s ease;
	}

	:global(.co-item-card.pending) {
		background: linear-gradient(135deg, #FFF7ED 0%, #FFFDF8 100%);
		border: 1.5px solid #FDBA74;
		box-shadow: 0 2px 6px rgba(249, 115, 22, 0.08);
	}

	:global(.co-item-card.approved) {
		border-color: #A7F3D0;
		background-color: #F0FDF4;
	}

	:global(.co-card-top-row) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	:global(.co-code-title-wrap) {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		flex: 1;
		min-width: 200px;
	}

	:global(.co-code-badge) {
		font-size: 0.75rem;
		font-weight: 800;
		font-family: 'JetBrains Mono', monospace;
		padding: 0.2rem 0.55rem;
		border-radius: 0.375rem;
		background-color: #0F172A;
		color: #F8FAFC;
	}

	:global(.co-title-text) {
		font-size: 0.875rem;
		font-weight: 800;
		color: #0F172A;
	}

	:global(.co-status-pill) {
		font-size: 0.6875rem;
		font-weight: 800;
		padding: 0.2rem 0.65rem;
		border-radius: 9999px;
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		white-space: nowrap;
	}

	:global(.co-status-pill.pending) {
		background-color: #FEF3C7;
		color: #92400E;
		border: 1px solid #F59E0B;
	}

	:global(.co-status-pill.approved) {
		background-color: #ECFDF5;
		color: #047857;
		border: 1px solid #A7F3D0;
	}

	:global(.co-justification-text) {
		font-size: 0.8125rem;
		color: #475569;
		margin: 0;
		line-height: 1.45;
	}

	:global(.co-meta-footer-row) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		border-top: 1px dashed #CBD5E1;
		padding-top: 0.75rem;
	}

	:global(.co-price-days-box) {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	:global(.co-amount-number) {
		font-size: 1.125rem;
		font-weight: 900;
		font-family: 'JetBrains Mono', monospace;
		color: #0F172A;
	}

	:global(.co-days-pill) {
		font-size: 0.6875rem;
		font-weight: 700;
		background-color: #E2E8F0;
		color: #334155;
		padding: 0.15rem 0.5rem;
		border-radius: 4px;
	}

	:global(.btn-action-sign-co) {
		min-height: 48px;
		padding: 0 1.25rem;
		border-radius: 0.625rem;
		background: linear-gradient(135deg, #F97316 0%, #EA580C 100%);
		color: #FFFFFF;
		font-size: 0.8125rem;
		font-weight: 800;
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		box-shadow: 0 2px 6px rgba(249, 115, 22, 0.25);
		transition: all 0.15s ease;
		user-select: none;
	}

	:global(.btn-action-sign-co:hover) {
		background: linear-gradient(135deg, #EA580C 0%, #C2410C 100%);
		transform: translateY(-1px);
	}

	:global(.co-signed-signature-info) {
		font-size: 0.6875rem;
		color: #047857;
		font-weight: 700;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	:global(.empty-change-orders-box) {
		padding: 1.5rem;
		text-align: center;
		color: #64748B;
		font-size: 0.8125rem;
		background-color: #F8FAFC;
		border-radius: 0.5rem;
		border: 1px dashed #CBD5E1;
	}

	@media (max-width: 600px) {
		.contract-file-strip {
			flex-direction: column;
			align-items: stretch;
		}

		.btn-file-download {
			justify-content: center;
		}

		:global(.co-meta-footer-row) {
			flex-direction: column;
			align-items: stretch;
		}

		:global(.btn-action-sign-co) {
			width: 100%;
			justify-content: center;
		}
	}
</style>
