---
// src/components/portal/ClientPortalFinancesTab.astro
// HU-19: Pestaña 1 del Portal del Cliente — Finanzas, Saldos e Historial de Abonos.
import { renderIconSvg } from '../../lib/icons.ts';
---

<section id="tab-finances-panel" class="portal-tab-panel active" role="tabpanel" aria-labelledby="tab-finances-btn">
	<!-- 1. Tarjetas Resumen de Finanzas -->
	<div class="finances-hero-card">
		<div class="hero-header-row">
			<div class="hero-title-box">
				<span class="hero-icon" set:html={renderIconSvg('creditCard', { size: 20 })}></span>
				<div>
					<h2 class="hero-title">Estado Financiero de tu Obra</h2>
					<p class="hero-subtitle">Valores liquidados en vivo con base contractual y órdenes de cambio aprobadas.</p>
				</div>
			</div>
			<div id="portal-paid-pct-badge" class="paid-pct-pill">
				65.3% Pagado
			</div>
		</div>

		<!-- Grid de Métricas Principales -->
		<div class="finances-metrics-grid">
			<div class="finance-metric-box">
				<span class="metric-label">Valor Contratado Total:</span>
				<strong id="portal-val-contracted" class="metric-amount">$ 67.750.000</strong>
				<span class="metric-note">Incluye adicionales aprobados</span>
			</div>

			<div class="finance-metric-box">
				<span class="metric-label">Anticipos y Pagos Realizados:</span>
				<strong id="portal-val-paid" class="metric-amount paid">$ 44.250.000</strong>
				<span class="metric-note" id="portal-count-abonos">2 abonos registrados</span>
			</div>

			<div class="finance-metric-box highlight-balance">
				<span class="metric-label highlight">Saldo Pendiente por Pagar:</span>
				<strong id="portal-val-balance" class="metric-amount balance">$ 23.500.000</strong>
				<span class="metric-note highlight">Pendiente según actas de avance</span>
			</div>
		</div>

		<!-- Barra de Progreso Visual de Pago -->
		<div class="payment-progress-wrapper" aria-label="Progreso de pago de la obra">
			<div class="progress-labels-row">
				<span>Pagos aplicados: <strong id="progress-text-paid">65.3%</strong></span>
				<span>Saldo restante: <strong id="progress-text-balance">34.7%</strong></span>
			</div>
			<div class="progress-track">
				<div id="portal-progress-bar-fill" class="progress-fill" style="width: 65.3%;"></div>
			</div>
		</div>
	</div>

	<!-- 2. Historial de Abonos y Comprobantes -->
	<div class="payments-history-card">
		<div class="history-card-header">
			<div class="history-title-box">
				<span class="history-icon" set:html={renderIconSvg('receipt', { size: 18 })}></span>
				<h3 class="history-heading">Historial de Pagos y Abonos Recibidos</h3>
			</div>
			<span class="history-count-badge" id="portal-payments-count">2 pagos</span>
		</div>

		<div id="portal-payments-list" class="payments-list">
			<!-- Inyectado dinámicamente desde client-portal-store -->
		</div>
	</div>

	<!-- Modal Lightbox de Comprobante de Caja -->
	<div id="receipt-modal-lightbox" class="receipt-lightbox-overlay hidden" role="dialog" aria-modal="true" aria-label="Comprobante de Caja">
		<div class="receipt-lightbox-content">
			<div class="receipt-lightbox-header">
				<div class="receipt-header-left">
					<span class="receipt-icon" set:html={renderIconSvg('receipt', { size: 18 })}></span>
					<strong id="receipt-modal-title">Recibo de Caja Oficial</strong>
				</div>
				<button id="btn-close-receipt-modal" type="button" class="btn-close-modal" aria-label="Cerrar comprobante">
					<span set:html={renderIconSvg('x', { size: 18 })}></span>
				</button>
			</div>

			<div class="receipt-lightbox-body">
				<img id="receipt-modal-img" src="" alt="Comprobante de caja" class="receipt-svg-render" />
			</div>

			<div class="receipt-lightbox-footer">
				<span class="receipt-audit-note">Documento auditable generado por ObraFlow SaaS</span>
				<button id="btn-print-receipt" type="button" class="btn-print-receipt">
					<span set:html={renderIconSvg('fileDownload', { size: 16 })}></span>
					<span>Imprimir Recibo</span>
				</button>
			</div>
		</div>
	</div>
</section>

<style>
	.portal-tab-panel {
		display: none;
		flex-direction: column;
		gap: 1.25rem;
		width: 100%;
	}

	.portal-tab-panel.active {
		display: flex;
	}

	/* Tarjeta Resumen Financiero */
	.finances-hero-card {
		background-color: #FFFFFF;
		border: 1.5px solid #E2E8F0;
		border-radius: 1rem;
		padding: 1.25rem 1.5rem;
		box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.hero-header-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.hero-title-box {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.hero-icon {
		width: 40px;
		height: 40px;
		border-radius: 0.625rem;
		background-color: #0F172A;
		color: #10B981;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.hero-title {
		font-size: 1.125rem;
		font-weight: 800;
		color: #0F172A;
		margin: 0;
	}

	.hero-subtitle {
		font-size: 0.75rem;
		color: #64748B;
		margin: 0.15rem 0 0 0;
	}

	.paid-pct-pill {
		font-size: 0.75rem;
		font-weight: 800;
		background-color: #ECFDF5;
		color: #047857;
		border: 1px solid #A7F3D0;
		padding: 0.35rem 0.85rem;
		border-radius: 9999px;
		white-space: nowrap;
	}

	/* Grid de Métricas */
	.finances-metrics-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}

	.finance-metric-box {
		background-color: #F8FAFC;
		border: 1px solid #E2E8F0;
		border-radius: 0.75rem;
		padding: 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.finance-metric-box.highlight-balance {
		background: linear-gradient(135deg, #FFF7ED 0%, #FEF3C7 100%);
		border: 1.5px solid #F59E0B;
		box-shadow: 0 2px 6px rgba(245, 158, 11, 0.15);
	}

	.metric-label {
		font-size: 0.6875rem;
		font-weight: 800;
		color: #64748B;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.metric-label.highlight {
		color: #92400E;
	}

	.metric-amount {
		font-size: 1.35rem;
		font-weight: 900;
		font-family: 'JetBrains Mono', monospace;
		color: #0F172A;
		letter-spacing: -0.02em;
	}

	.metric-amount.paid {
		color: #059669;
	}

	.metric-amount.balance {
		color: #C2410C;
	}

	.metric-note {
		font-size: 0.6875rem;
		color: #94A3B8;
		font-weight: 600;
	}

	.metric-note.highlight {
		color: #B45309;
	}

	/* Barra de Progreso */
	.payment-progress-wrapper {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.progress-labels-row {
		display: flex;
		justify-content: space-between;
		font-size: 0.75rem;
		color: #475569;
		font-weight: 600;
	}

	.progress-track {
		width: 100%;
		height: 10px;
		background-color: #E2E8F0;
		border-radius: 9999px;
		overflow: hidden;
	}

	.progress-fill {
		height: 100%;
		background: linear-gradient(90deg, #10B981 0%, #059669 100%);
		border-radius: 9999px;
		transition: width 0.4s ease;
	}

	/* Historial de Pagos */
	.payments-history-card {
		background-color: #FFFFFF;
		border: 1px solid #E2E8F0;
		border-radius: 1rem;
		padding: 1.25rem 1.5rem;
		box-shadow: 0 1px 4px rgba(15, 23, 42, 0.04);
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.history-card-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		border-bottom: 1px solid #F1F5F9;
		padding-bottom: 0.75rem;
	}

	.history-title-box {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.history-icon {
		color: #F97316;
		display: flex;
		align-items: center;
	}

	.history-heading {
		font-size: 0.9375rem;
		font-weight: 800;
		color: #0F172A;
		margin: 0;
	}

	.history-count-badge {
		font-size: 0.6875rem;
		font-weight: 800;
		background-color: #F1F5F9;
		color: #475569;
		padding: 0.15rem 0.5rem;
		border-radius: 9999px;
	}

	.payments-list {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	:global(.payment-item-card) {
		background-color: #F8FAFC;
		border: 1px solid #E2E8F0;
		border-radius: 0.75rem;
		padding: 0.875rem 1rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		transition: border-color 0.15s ease, background-color 0.15s ease;
	}

	:global(.payment-item-card:hover) {
		border-color: #CBD5E1;
		background-color: #F1F5F9;
	}

	:global(.payment-left-meta) {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-width: 220px;
		flex: 1;
	}

	:global(.payment-receipt-pill) {
		font-size: 0.75rem;
		font-weight: 800;
		font-family: 'JetBrains Mono', monospace;
		background-color: #0F172A;
		color: #F8FAFC;
		padding: 0.3rem 0.6rem;
		border-radius: 0.375rem;
		flex-shrink: 0;
	}

	:global(.payment-text-col) {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	:global(.payment-concept-text) {
		font-size: 0.8125rem;
		font-weight: 800;
		color: #0F172A;
	}

	:global(.payment-sub-line) {
		font-size: 0.6875rem;
		color: #64748B;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	:global(.payment-right-col) {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	:global(.payment-amount-val) {
		font-size: 1rem;
		font-weight: 900;
		font-family: 'JetBrains Mono', monospace;
		color: #059669;
		white-space: nowrap;
	}

	:global(.btn-view-receipt) {
		min-height: 40px;
		padding: 0 0.75rem;
		border-radius: 0.5rem;
		border: 1px solid #CBD5E1;
		background-color: #FFFFFF;
		color: #334155;
		font-size: 0.75rem;
		font-weight: 700;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		cursor: pointer;
		user-select: none;
		transition: all 0.15s ease;
	}

	:global(.btn-view-receipt:hover) {
		background-color: #F8FAFC;
		border-color: #0F172A;
		color: #0F172A;
	}

	/* Lightbox de Comprobante */
	.receipt-lightbox-overlay {
		position: fixed;
		inset: 0;
		background-color: rgba(15, 23, 42, 0.75);
		backdrop-filter: blur(4px);
		z-index: 1000;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem;
	}

	.receipt-lightbox-overlay.hidden {
		display: none !important;
	}

	.receipt-lightbox-content {
		background-color: #FFFFFF;
		border-radius: 1rem;
		width: 100%;
		max-width: 480px;
		max-height: 90vh;
		display: flex;
		flex-direction: column;
		box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
		overflow: hidden;
	}

	.receipt-lightbox-header {
		padding: 1rem 1.25rem;
		background-color: #0F172A;
		color: #F8FAFC;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.receipt-header-left {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.9375rem;
	}

	.receipt-icon {
		color: #10B981;
		display: flex;
		align-items: center;
	}

	.btn-close-modal {
		background: transparent;
		border: none;
		color: #94A3B8;
		cursor: pointer;
		width: 36px;
		height: 36px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 0.375rem;
		transition: all 0.15s ease;
	}

	.btn-close-modal:hover {
		color: #FFFFFF;
		background-color: #1E293B;
	}

	.receipt-lightbox-body {
		padding: 1rem;
		background-color: #F8FAFC;
		overflow-y: auto;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.receipt-svg-render {
		max-width: 100%;
		height: auto;
		border-radius: 0.5rem;
		box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
	}

	.receipt-lightbox-footer {
		padding: 0.875rem 1.25rem;
		background-color: #FFFFFF;
		border-top: 1px solid #E2E8F0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.receipt-audit-note {
		font-size: 0.6875rem;
		color: #64748B;
	}

	.btn-print-receipt {
		min-height: 40px;
		padding: 0 1rem;
		border-radius: 0.5rem;
		background-color: #0F172A;
		color: #FFFFFF;
		font-size: 0.75rem;
		font-weight: 700;
		border: none;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		transition: all 0.15s ease;
	}

	.btn-print-receipt:hover {
		background-color: #1E293B;
	}

	@media (max-width: 768px) {
		.finances-metrics-grid {
			grid-template-columns: 1fr;
		}

		.finances-hero-card {
			padding: 1rem;
		}

		:global(.payment-item-card) {
			flex-direction: column;
			align-items: stretch;
		}

		:global(.payment-right-col) {
			justify-content: space-between;
		}
	}
</style>
