---
// src/components/portal/ClientPortalProgressTab.astro
// HU-19: Pestaña 3 del Portal del Cliente — Muro de Avance y Galería de Fotos de Obra.
import { renderIconSvg } from '../../lib/icons.ts';
---

<section id="tab-progress-panel" class="portal-tab-panel" role="tabpanel" aria-labelledby="tab-progress-btn">
	<!-- 1. Galería Fotográfica Reciente -->
	<div class="progress-section-card">
		<div class="progress-card-header">
			<div class="progress-title-box">
				<span class="progress-header-icon" set:html={renderIconSvg('camera', { size: 20 })}></span>
				<div>
					<h2 class="progress-heading">Memoria Fotográfica de Avance</h2>
					<p class="progress-subheading">Registros visuales verificados en campo con sello de agua técnico de obra.</p>
				</div>
			</div>
			<span id="portal-photos-count-badge" class="photos-count-pill">0 fotos</span>
		</div>

		<!-- Grid de Miniaturas de Fotos -->
		<div id="portal-public-photos-grid" class="public-photos-grid">
			<!-- Inyectado dinámicamente -->
		</div>
	</div>

	<!-- 2. Bitácora Cronológica de la Cuadrilla -->
	<div class="progress-section-card">
		<div class="progress-card-header">
			<div class="progress-title-box">
				<span class="progress-header-icon orange" set:html={renderIconSvg('calendar', { size: 20 })}></span>
				<div>
					<h2 class="progress-heading">Diario de Obra Compartido</h2>
					<p class="progress-subheading">Reportes de jornada técnica autorizados por la dirección de obra.</p>
				</div>
			</div>
			<span id="portal-logs-count-badge" class="photos-count-pill">0 reportes</span>
		</div>

		<!-- Feed de Reportes Públicos -->
		<div id="portal-public-logs-stream" class="public-logs-stream">
			<!-- Inyectado dinámicamente -->
		</div>
	</div>

	<!-- Modal Lightbox de Fotografías -->
	<div id="portal-photo-lightbox" class="photo-lightbox-overlay hidden" role="dialog" aria-modal="true" aria-label="Visualizador de fotografía de obra">
		<div class="photo-lightbox-modal">
			<button id="btn-close-photo-lightbox" type="button" class="btn-close-lightbox" aria-label="Cerrar imagen">
				<span set:html={renderIconSvg('x', { size: 22 })}></span>
			</button>

			<div class="lightbox-img-wrapper">
				<img id="portal-lightbox-img" src="" alt="Fotografía de obra" class="lightbox-img" />
			</div>

			<div class="lightbox-caption-bar">
				<span id="portal-lightbox-caption" class="lightbox-caption-text">Evidencia fotográfica verificada</span>
				<span id="portal-lightbox-date" class="lightbox-date-text">2026-11-20</span>
			</div>
		</div>
	</div>
</section>

<style>
	.portal-tab-panel {
		display: none;
		flex-direction: column;
		gap: 1.25rem;
		width: 100%;
	}

	.portal-tab-panel.active {
		display: flex;
	}

	.progress-section-card {
		background-color: #FFFFFF;
		border: 1.5px solid #E2E8F0;
		border-radius: 1rem;
		padding: 1.25rem 1.5rem;
		box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.progress-card-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		border-bottom: 1px solid #F1F5F9;
		padding-bottom: 0.875rem;
	}

	.progress-title-box {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.progress-header-icon {
		width: 40px;
		height: 40px;
		border-radius: 0.625rem;
		background-color: #0F172A;
		color: #10B981;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.progress-header-icon.orange {
		color: #F97316;
	}

	.progress-heading {
		font-size: 1.0625rem;
		font-weight: 800;
		color: #0F172A;
		margin: 0;
	}

	.progress-subheading {
		font-size: 0.75rem;
		color: #64748B;
		margin: 0.15rem 0 0 0;
	}

	.photos-count-pill {
		font-size: 0.6875rem;
		font-weight: 800;
		background-color: #F1F5F9;
		color: #475569;
		padding: 0.2rem 0.65rem;
		border-radius: 9999px;
	}

	/* Grid de Fotos */
	.public-photos-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
		gap: 0.875rem;
	}

	:global(.portal-photo-card) {
		background-color: #F8FAFC;
		border: 1px solid #E2E8F0;
		border-radius: 0.75rem;
		overflow: hidden;
		cursor: pointer;
		display: flex;
		flex-direction: column;
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}

	:global(.portal-photo-card:hover) {
		transform: translateY(-2px);
		box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
	}

	:global(.portal-photo-img-box) {
		width: 100%;
		height: 135px;
		overflow: hidden;
		background-color: #0F172A;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	:global(.portal-photo-img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.25s ease;
	}

	:global(.portal-photo-card:hover .portal-photo-img) {
		transform: scale(1.04);
	}

	:global(.portal-photo-info-bar) {
		padding: 0.5rem 0.65rem;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		background-color: #FFFFFF;
	}

	:global(.portal-photo-caption) {
		font-size: 0.75rem;
		font-weight: 700;
		color: #0F172A;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	:global(.portal-photo-date) {
		font-size: 0.6875rem;
		color: #64748B;
	}

	/* Feed de Reportes Públicos */
	.public-logs-stream {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	:global(.portal-log-card) {
		background-color: #F8FAFC;
		border: 1.5px solid #E2E8F0;
		border-radius: 0.875rem;
		padding: 1.125rem 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.875rem;
	}

	:global(.portal-log-top-row) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		border-bottom: 1px solid #E2E8F0;
		padding-bottom: 0.65rem;
	}

	:global(.portal-log-date-badge) {
		font-size: 0.8125rem;
		font-weight: 800;
		color: #0F172A;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}

	:global(.portal-log-meta-badges) {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	:global(.portal-weather-badge) {
		font-size: 0.6875rem;
		font-weight: 800;
		padding: 0.15rem 0.55rem;
		border-radius: 9999px;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		background-color: #FEF3C7;
		color: #92400E;
		border: 1px solid #FDE68A;
	}

	:global(.portal-workers-badge) {
		font-size: 0.6875rem;
		font-weight: 700;
		padding: 0.15rem 0.55rem;
		border-radius: 9999px;
		background-color: #ECFDF5;
		color: #047857;
		border: 1px solid #A7F3D0;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	:global(.portal-log-notes) {
		font-size: 0.875rem;
		color: #334155;
		margin: 0;
		line-height: 1.5;
	}

	:global(.portal-log-tasks-flow) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	:global(.portal-task-pill) {
		font-size: 0.6875rem;
		font-weight: 700;
		padding: 0.2rem 0.55rem;
		border-radius: 0.375rem;
		background-color: #FFFFFF;
		border: 1px solid #CBD5E1;
		color: #0F172A;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	:global(.portal-task-pill.done) {
		border-color: #10B981;
		background-color: #F0FDF4;
		color: #047857;
	}

	/* Lightbox de Fotografía */
	.photo-lightbox-overlay {
		position: fixed;
		inset: 0;
		background-color: rgba(15, 23, 42, 0.9);
		backdrop-filter: blur(6px);
		z-index: 1000;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem;
	}

	.photo-lightbox-overlay.hidden {
		display: none !important;
	}

	.photo-lightbox-modal {
		background-color: #0F172A;
		border: 1px solid #334155;
		border-radius: 1rem;
		width: 100%;
		max-width: 680px;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		position: relative;
		box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
	}

	.btn-close-lightbox {
		position: absolute;
		top: 0.75rem;
		right: 0.75rem;
		z-index: 10;
		width: 44px;
		height: 44px;
		background-color: rgba(15, 23, 42, 0.7);
		border: 1px solid #475569;
		color: #F8FAFC;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.btn-close-lightbox:hover {
		background-color: #F97316;
		color: #FFFFFF;
	}

	.lightbox-img-wrapper {
		width: 100%;
		max-height: 70vh;
		background-color: #000000;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.lightbox-img {
		max-width: 100%;
		max-height: 70vh;
		object-fit: contain;
	}

	.lightbox-caption-bar {
		padding: 0.875rem 1.25rem;
		background-color: #0F172A;
		border-top: 1px solid #1E293B;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.lightbox-caption-text {
		font-size: 0.8125rem;
		font-weight: 700;
		color: #F8FAFC;
	}

	.lightbox-date-text {
		font-size: 0.75rem;
		color: #94A3B8;
		font-family: 'JetBrains Mono', monospace;
	}

	@media (max-width: 600px) {
		.public-photos-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.progress-section-card {
			padding: 1rem;
		}
	}
</style>
