---
// src/components/Toast.astro
---

<div id="toast-notification" class="toast-box">
	<div class="toast-icon">
		<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
			<polyline points="20 6 9 17 4 12"></polyline>
		</svg>
	</div>
	<div class="toast-body">
		<h4 id="toast-title" class="toast-title-text">Notificación</h4>
		<p id="toast-message" class="toast-msg-text">Operación completada exitosamente.</p>
	</div>
	<button id="toast-close-btn" type="button" class="toast-close" aria-label="Cerrar">
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
			<line x1="18" y1="6" x2="6" y2="18"></line>
			<line x1="6" y1="6" x2="18" y2="18"></line>
		</svg>
	</button>
</div>

<style>
	.toast-box {
		position: fixed;
		top: 1.25rem;
		right: 1.25rem;
		z-index: 60;
		transform: translateY(-5rem);
		opacity: 0;
		pointer-events: none;
		transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
		display: flex;
		align-items: center;
		gap: 0.75rem;
		background-color: rgba(15, 23, 42, 0.95);
		backdrop-filter: blur(8px);
		color: #FFFFFF;
		padding: 0.875rem 1rem;
		border-radius: 1rem;
		border: 1px solid #334155;
		box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
		max-width: 24rem;
	}

	.toast-box.active {
		transform: translateY(0);
		opacity: 1;
		pointer-events: auto;
	}

	.toast-icon {
		width: 2rem;
		height: 2rem;
		border-radius: 0.625rem;
		background-color: rgba(16, 185, 129, 0.2);
		color: #34D399;
		border: 1px solid rgba(16, 185, 129, 0.3);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.toast-body {
		flex: 1;
		text-align: left;
		padding-right: 0.5rem;
	}

	.toast-title-text {
		font-size: 0.75rem;
		font-weight: 700;
		color: #F8FAFC;
		line-height: 1.2;
	}

	.toast-msg-text {
		font-size: 0.6875rem;
		color: #CBD5E1;
		margin-top: 0.125rem;
		line-height: 1.2;
	}

	.toast-close {
		background: none;
		border: none;
		color: #94A3B8;
		font-size: 0.75rem;
		cursor: pointer;
		padding: 0.25rem;
	}

	.toast-close:hover {
		color: #FFFFFF;
	}
</style>

<script>
	const toast = document.getElementById('toast-notification');
	const toastTitle = document.getElementById('toast-title');
	const toastMessage = document.getElementById('toast-message');
	const toastClose = document.getElementById('toast-close-btn');

	let timeoutId: any = null;

	function showToast(title: string, message: string) {
		if (!toast || !toastTitle || !toastMessage) return;

		toastTitle.textContent = title;
		toastMessage.textContent = message;

		toast.classList.add('active');

		if (timeoutId) clearTimeout(timeoutId);

		timeoutId = setTimeout(() => {
			toast.classList.remove('active');
		}, 3800);
	}

	toastClose?.addEventListener('click', () => {
		toast?.classList.remove('active');
	});

	window.addEventListener('show-toast', (e: any) => {
		const { title, message } = e.detail || {};
		showToast(title || 'Éxito', message || '');
	});
</script>
