		border: 1px solid #E2E8F0;
		border-radius: 0.875rem;
		padding: 1.5rem;
		box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
		margin-top: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.co-section-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.co-header-info {
		display: flex;
		align-items: flex-start;
