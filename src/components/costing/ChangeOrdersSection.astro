---
// src/components/costing/ChangeOrdersSection.astro
// HU-15: Sección de Gestión, Seguimiento y Envío de Órdenes de Cambio (Adicionales de Obra).
---

<section id="costing-change-orders-section" class="co-section-card" aria-label="Gestión de órdenes de cambio y adicionales de obra">
	<!-- Cabecera de la Sección -->
	<div class="co-section-header">
		<div class="co-header-info">
			<div class="co-header-icon" aria-hidden="true">
				<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
					<polyline points="14 2 14 8 20 8"></polyline>
					<path d="M12 18v-6"></path>
					<path d="m9 15 3 3 3-3"></path>
				</svg>
			</div>
			<div>
				<div class="co-title-kicker-wrap">
					<span class="co-kicker-pill">Blindaje Legal & Cobro 100% · HU-15</span>
				</div>
				<h2 class="co-section-title">Órdenes de Cambio y Adicionales</h2>
				<p class="co-section-desc">Cotiza adicionales solicitados en obra y envíalos por WhatsApp para aprobación y firma digital del cliente.</p>
			</div>
		</div>

		<div class="co-header-actions">
			<button
				id="btn-section-new-co"
				type="button"
				class="btn-new-change-order"
				title="Crear nueva orden de cambio para esta obra"
				aria-label="Crear nueva orden de cambio"
			>
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<line x1="12" y1="5" x2="12" y2="19"></line>
					<line x1="5" y1="12" x2="19" y2="12"></line>
				</svg>
				<span>+ Nueva Orden de Cambio</span>
			</button>
		</div>
	</div>

	<!-- KPIs de Consolidado de Adicionales -->
	<div class="co-summary-pills-row" id="co-summary-pills-row">
		<div class="co-kpi-pill">
			<span class="kpi-label">Adicionales Contratados:</span>
			<span id="kpi-co-total-sale" class="kpi-value text-emerald mono-value">$ 0 COP</span>
		</div>
		<div class="co-kpi-pill">
			<span class="kpi-label">Costo Directo Adicional:</span>
			<span id="kpi-co-total-cost" class="kpi-value text-slate mono-value">$ 0 COP</span>
		</div>
		<div class="co-kpi-pill">
			<span class="kpi-label">Prórroga Acumulada:</span>
			<span id="kpi-co-total-days" class="kpi-value text-orange mono-value">+ 0 días</span>
		</div>
		<div class="co-kpi-pill">
			<span class="kpi-label">Pendientes de Firma:</span>
			<span id="kpi-co-pending-count" class="kpi-value text-amber mono-value">0</span>
		</div>
	</div>

	<!-- Lista de Órdenes de Cambio del Proyecto -->
	<div class="co-cards-list" id="co-cards-list">
		<!-- Inyectado dinámicamente con JavaScript -->
	</div>

	<!-- Estado Vacío -->
	<div id="co-empty-state" class="co-empty-box hidden">
		<div class="empty-icon-bubble" aria-hidden="true">
			<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
				<polyline points="14 2 14 8 20 8"></polyline>
				<line x1="16" y1="13" x2="8" y2="13"></line>
				<line x1="16" y1="17" x2="8" y2="17"></line>
			</svg>
		</div>
		<h3 class="empty-title">Sin órdenes de cambio registradas</h3>
		<p class="empty-desc">Todo trabajo extra que solicite el cliente debe cotizarse y firmarse aquí para garantizar su cobro sin disputas.</p>
		<button id="btn-empty-new-co" type="button" class="btn-empty-create">
			<span>+ Crear Primera Orden de Cambio</span>
		</button>
	</div>
</section>

<!-- Modal Lightbox para Visualizar Firma Digital Formal -->
<div id="co-signature-lightbox" class="lightbox-backdrop hidden" role="dialog" aria-modal="true" aria-label="Comprobante de firma digital">
	<div class="lightbox-sheet">
		<div class="lightbox-head">
			<div class="lightbox-title-wrap">
				<span class="status-verified-pill">✓ Firma Digital Verificada</span>
				<h3 id="lightbox-co-code" class="lightbox-title">Acta de Aprobación</h3>
			</div>
			<button id="btn-close-lightbox" type="button" class="btn-lightbox-close" aria-label="Cerrar comprobante">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
			</button>
		</div>

		<div class="lightbox-body">
			<div class="evidence-box">
				<div class="evidence-img-wrap">
					<img id="lightbox-signature-img" src="data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='1' height='1'%3E%3C/svg%3E" alt="Firma digital del cliente" class="client-signature-img" />
				</div>
				<div class="evidence-meta">
					<div class="meta-row">
						<span class="meta-lbl">Firmante:</span>
						<strong id="lightbox-signer-name" class="meta-val">-</strong>
					</div>
					<div class="meta-row">
						<span class="meta-lbl">Identificación:</span>
						<strong id="lightbox-signer-id" class="meta-val">-</strong>
					</div>
					<div class="meta-row">
						<span class="meta-lbl">Fecha y Hora:</span>
						<strong id="lightbox-signed-at" class="meta-val mono-value">-</strong>
					</div>
					<div class="meta-row">
						<span class="meta-lbl">Monto Aprobado:</span>
						<strong id="lightbox-signed-amount" class="meta-val text-emerald mono-value">-</strong>
					</div>
				</div>
			</div>
			<p class="legal-disclaimer">Este documento constituye aceptación contractual expresa según la Ley 527 de 1999 de Comercio Electrónico y Firmas Digitales de Colombia.</p>
		</div>
	</div>
</div>

<style>
