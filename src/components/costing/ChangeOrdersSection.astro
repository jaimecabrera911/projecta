		display: none !important;
	}
</style>

<script>
	import {
		loadAllChangeOrders,
		getChangeOrdersByProject,
		generateWhatsAppShareLink,
		type ChangeOrder
	} from '../../lib/change-order-store';
	import { loadAllProjects, type ProjectCosting } from '../../lib/costing-store';

	const formatCOP = (val: number): string => {
		return new Intl.NumberFormat('es-CO', {
			style: 'currency',
			currency: 'COP',
			maximumFractionDigits: 0
		}).format(val || 0);
	};

	let activeProjectId = 'proj_andina_001';

	function initChangeOrdersSection() {
		const section = document.getElementById('costing-change-orders-section');
		if (!section) return;

		// 1. Determinar proyecto activo
		const urlParams = new URLSearchParams(window.location.search);
		const requestedId = urlParams.get('id') || urlParams.get('projectId');
		if (requestedId) {
			activeProjectId = requestedId;
		}

		renderSection();
		setupSectionEventListeners();
	}

	function renderSection() {
		const cardsContainer = document.getElementById('co-cards-list');
		const emptyState = document.getElementById('co-empty-state');
		if (!cardsContainer || !emptyState) return;

		const allProjects = loadAllProjects();
		const currentProject = allProjects.find((p) => p.project_id === activeProjectId) || allProjects[0];
		const orders = getChangeOrdersByProject(activeProjectId);

		// Actualizar KPIs de consolidado
		updateKpiSummary(orders);

		if (orders.length === 0) {
			cardsContainer.innerHTML = '';
			emptyState.classList.remove('hidden');
			return;
		}

		emptyState.classList.add('hidden');

		cardsContainer.innerHTML = orders
			.map((order) => {
				const chapter = currentProject?.chapters.find((c) => c.chapter_id === order.chapter_id);
				const chapterName = chapter ? chapter.name : 'Capítulo Asignado';

				const statusClass =
					order.status === 'approved'
						? 'status-pill-approved'
						: order.status === 'rejected'
						? 'status-pill-rejected'
						: 'status-pill-pending';

				const statusText =
					order.status === 'approved'
						? '✓ Aprobada y Firmada'
						: order.status === 'rejected'
						? '✕ Rechazada'
						: '⏳ Pendiente de Firma';

				const isApproved = order.status === 'approved';
				const waUrl = generateWhatsAppShareLink(order, '', window.location.origin);
				const magicUrl = `${window.location.origin}/change-orders/view?token=${encodeURIComponent(order.magic_token)}`;

				const dateFormatted = new Date(order.created_at).toLocaleDateString('es-CO', {
					day: 'numeric',
					month: 'short',
					year: 'numeric'
				});

				return `
				<article class="co-card-item ${order.status}" id="co-card-${order.id}">
					<div class="co-card-top-row">
						<div class="co-left-badges">
							<span class="co-code-badge">${escapeHtml(order.code)}</span>
							<span class="co-chapter-badge">${escapeHtml(chapterName)}</span>
							<span class="co-chapter-badge">${dateFormatted}</span>
						</div>
						<span class="co-status-pill ${statusClass}">${statusText}</span>
					</div>

					<div class="co-content-row">
						<h3 class="co-card-title">${escapeHtml(order.title)}</h3>
						<p class="co-card-desc">${escapeHtml(order.justification)}</p>
					</div>

					<div class="co-metrics-strip">
						<div class="metric-unit">
							<span class="metric-unit-lbl">Cobro al Cliente:</span>
							<strong class="metric-unit-val text-emerald mono-value">${formatCOP(order.sale_price_amount)}</strong>
						</div>
						<div class="metric-unit">
							<span class="metric-unit-lbl">Costo Directo Obra:</span>
							<strong class="metric-unit-val text-slate mono-value">${formatCOP(order.cost_amount)}</strong>
						</div>
						<div class="metric-unit">
							<span class="metric-unit-lbl">Margen Bruto:</span>
							<strong class="metric-unit-val text-orange mono-value">${order.margin_pct.toFixed(1)}%</strong>
						</div>
						${
							order.additional_days > 0
								? `
							<div class="metric-unit">
								<span class="metric-unit-lbl">Prórroga Entrega:</span>
								<strong class="metric-unit-val text-amber mono-value">+ ${order.additional_days} días</strong>
							</div>
						`
								: ''
						}
					</div>

					<div class="co-actions-bottom-row">
						<div>
							${
								isApproved
									? `
								<span class="co-signature-stamp-note">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
									<span>Firmado por ${escapeHtml(order.signed_by_name || 'Cliente')} (${new Date(order.signed_at || '').toLocaleDateString('es-CO')})</span>
								</span>
							`
									: `
								<span class="text-amber" style="font-size: 0.75rem; font-weight: 700;">
									⚠️ No ejecutable en obra hasta contar con la firma del cliente
								</span>
							`
							}
						</div>

						<div class="co-action-btns-right">
							${
								!isApproved
									? `
								<a href="${waUrl}" target="_blank" rel="noopener noreferrer" class="btn-co-action btn-co-wa" title="Enviar enlace de aprobación por WhatsApp">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
									<span>WhatsApp</span>
								</a>

								<button type="button" class="btn-co-action btn-co-link btn-copy-magic-link" data-url="${magicUrl}" title="Copiar enlace para el cliente">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
									<span>Copiar Link</span>
								</button>

								<a href="/change-orders/view?token=${encodeURIComponent(order.magic_token)}" target="_blank" class="btn-co-action btn-co-sign" title="Abrir pantalla de firma cliente">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
									<span>Firmar</span>
								</a>
							`
									: `
								<button type="button" class="btn-co-action btn-co-verified btn-view-signature" data-order-id="${order.id}">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
									<span>Ver Acta Firmada</span>
								</button>
								<a href="/change-orders/view?token=${encodeURIComponent(order.magic_token)}" target="_blank" class="btn-co-action btn-co-link">
									<span>Ver Detalle</span>
								</a>
							`
							}
						</div>
					</div>
				</article>
			`;
			})
			.join('');

		// Eventos de copiar link
		document.querySelectorAll('.btn-copy-magic-link').forEach((btn) => {
			btn.addEventListener('click', () => {
				const url = btn.getAttribute('data-url') || '';
				if (url) {
					navigator.clipboard.writeText(url).then(() => {
						dispatchToast('✓ Enlace copiado al portapapeles. Listo para enviar al cliente.');
					});
				}
			});
		});

		// Eventos de ver firma
		document.querySelectorAll('.btn-view-signature').forEach((btn) => {
			btn.addEventListener('click', () => {
				const orderId = btn.getAttribute('data-order-id');
				const order = orders.find((o) => o.id === orderId);
				if (order) openSignatureLightbox(order);
			});
		});
	}

	function updateKpiSummary(orders: ChangeOrder[]) {
		const approvedOrders = orders.filter((o) => o.status === 'approved');
		const pendingOrders = orders.filter((o) => o.status === 'pending_signature');

		const totalSale = approvedOrders.reduce((sum, o) => sum + o.sale_price_amount, 0);
		const totalCost = approvedOrders.reduce((sum, o) => sum + o.cost_amount, 0);
		const totalDays = approvedOrders.reduce((sum, o) => sum + o.additional_days, 0);

		const elSale = document.getElementById('kpi-co-total-sale');
		const elCost = document.getElementById('kpi-co-total-cost');
		const elDays = document.getElementById('kpi-co-total-days');
		const elPending = document.getElementById('kpi-co-pending-count');

		if (elSale) elSale.textContent = formatCOP(totalSale);
		if (elCost) elCost.textContent = formatCOP(totalCost);
		if (elDays) elDays.textContent = `+ ${totalDays} días`;
		if (elPending) elPending.textContent = String(pendingOrders.length);
	}

	function setupSectionEventListeners() {
		const newCoBtn = document.getElementById('btn-section-new-co');
		const emptyNewCoBtn = document.getElementById('btn-empty-new-co');

		function openModal() {
			window.dispatchEvent(
				new CustomEvent('open-create-change-order-modal', {
					detail: { projectId: activeProjectId }
				})
			);
		}

		newCoBtn?.addEventListener('click', openModal);
		emptyNewCoBtn?.addEventListener('click', openModal);

		// Sincronizar si cambia el proyecto en el dashboard
		window.addEventListener('costing:project-changed', (e: any) => {
			if (e.detail?.projectId) {
				activeProjectId = e.detail.projectId;
				renderSection();
			}
		});

		// Recargar si se crea o aprueba una orden de cambio
		window.addEventListener('obraflow:change-orders-updated', renderSection);
		window.addEventListener('obraflow:change-order-approved', renderSection);

		// Lightbox cierre
		document.getElementById('btn-close-lightbox')?.addEventListener('click', closeSignatureLightbox);
		document.getElementById('co-signature-lightbox')?.addEventListener('click', (e) => {
			if (e.target === document.getElementById('co-signature-lightbox')) {
				closeSignatureLightbox();
			}
		});
	}

	function openSignatureLightbox(order: ChangeOrder) {
		const lb = document.getElementById('co-signature-lightbox');
		if (!lb) return;

		const codeEl = document.getElementById('lightbox-co-code');
		const imgEl = document.getElementById('lightbox-signature-img') as HTMLImageElement | null;
		const nameEl = document.getElementById('lightbox-signer-name');
		const idEl = document.getElementById('lightbox-signer-id');
		const atEl = document.getElementById('lightbox-signed-at');
		const amtEl = document.getElementById('lightbox-signed-amount');

		if (codeEl) codeEl.textContent = `Acta de Aprobación · ${order.code}`;
		if (imgEl) imgEl.src = order.signature_data_url || '';
		if (nameEl) nameEl.textContent = order.signed_by_name || 'Cliente';
		if (idEl) idEl.textContent = order.signed_by_id_number || 'No especificado';
		if (atEl) {
			atEl.textContent = order.signed_at
				? new Date(order.signed_at).toLocaleString('es-CO')
				: 'Fecha no registrada';
		}
		if (amtEl) amtEl.textContent = formatCOP(order.sale_price_amount);

		lb.classList.remove('hidden');
	}

	function closeSignatureLightbox() {
		document.getElementById('co-signature-lightbox')?.classList.add('hidden');
	}

	function dispatchToast(message: string, type: 'success' | 'warning' | 'error' = 'success') {
		window.dispatchEvent(
			new CustomEvent('obraflow:toast', {
				detail: { message, type }
			})
		);
	}

	function escapeHtml(str: string): string {
		return (str || '')
			.replace(/&/g, '&amp;')
			.replace(/</g, '&lt;')
			.replace(/>/g, '&gt;')
			.replace(/"/g, '&quot;')
			.replace(/'/g, '&#039;');
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initChangeOrdersSection);
	} else {
		initChangeOrdersSection();
	}
</script>
