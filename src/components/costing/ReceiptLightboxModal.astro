---
// src/components/costing/ReceiptLightboxModal.astro
// HU-13: Modal de Auditoría y Visualización en Alta Definición de Recibos de Campo.
import { renderIconSvg } from '../../lib/icons';
---

<div id="receipt-lightbox-modal" class="lightbox-backdrop hidden" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="lightbox-title">
	<div class="lightbox-dialog" id="lightbox-dialog">
		<!-- Header del Modal -->
		<div class="lightbox-header">
			<div class="lightbox-title-group">
				<div class="lightbox-badge-icon" aria-hidden="true" set:html={renderIconSvg('receipt', { size: 20 })}></div>
				<div>
					<h3 id="lightbox-title" class="lightbox-title">Comprobante de Gasto en Campo</h3>
					<p class="lightbox-subtitle" id="lightbox-subtitle">Auditoría contable y soporte fotográfico</p>
				</div>
			</div>

			<button id="btn-close-lightbox" type="button" class="btn-lightbox-close" aria-label="Cerrar vista de recibo">
				<Fragment set:html={renderIconSvg('x', { size: 22 })} />
			</button>
		</div>

		<!-- Cuerpo del Modal: 2 Columnas (Imagen del Recibo + Datos de Auditoría) -->
		<div class="lightbox-body">
			<!-- Visualizador de Imagen / Recibo SVG -->
			<div class="receipt-image-viewer">
				<div class="receipt-paper-wrapper">
					<img id="lightbox-receipt-img" src="" alt="Recibo de compra en obra" class="lightbox-receipt-img" />
				</div>
			</div>

			<!-- Panel de Detalles y Conciliación -->
			<div class="receipt-audit-panel">
				<div class="audit-amount-banner">
					<span class="audit-amount-label">Monto Verificado:</span>
					<span id="lightbox-amount" class="audit-amount-val mono-value">$ 0 COP</span>
				</div>

				<div class="audit-details-list">
					<div class="audit-detail-row">
						<span class="audit-row-label">Concepto:</span>
						<span class="audit-row-val font-bold" id="lightbox-concept">-</span>
					</div>
					<div class="audit-detail-row">
						<span class="audit-row-label">Proveedor / Comercio:</span>
						<span class="audit-row-val" id="lightbox-vendor">-</span>
					</div>
					<div class="audit-detail-row">
						<span class="audit-row-label">Capítulo Imputado:</span>
						<span class="audit-row-val" id="lightbox-chapter">-</span>
					</div>
					<div class="audit-detail-row">
						<span class="audit-row-label">Categoría de Costo:</span>
						<span class="audit-row-val" id="lightbox-category">-</span>
					</div>
					<div class="audit-detail-row">
						<span class="audit-row-label">Fecha de Compra:</span>
						<span class="audit-row-val mono-value" id="lightbox-date">-</span>
					</div>
					<div class="audit-detail-row">
						<span class="audit-row-label">Registrado Por:</span>
						<span class="audit-row-val" id="lightbox-registrant">-</span>
					</div>
					<div class="audit-detail-row" id="lightbox-notes-container">
						<span class="audit-row-label">Notas de Campo:</span>
						<p class="audit-notes-text" id="lightbox-notes">-</p>
					</div>
				</div>

				<div class="audit-validation-badge">
					<Fragment set:html={renderIconSvg('circleCheck', { size: 18 })} />
					<div>
						<strong>Verificado en Obra</strong>
						<span>Comprobante conciliado en la matriz presupuestaria</span>
					</div>
				</div>
			</div>
		</div>

		<!-- Footer del Modal -->
		<div class="lightbox-footer">
			<button id="btn-lightbox-done" type="button" class="btn-lightbox-primary">Cerrar Inspección</button>
		</div>
	</div>
</div>

<style>
	.lightbox-backdrop {
		position: fixed;
		inset: 0;
		z-index: 150;
		background-color: rgba(15, 23, 42, 0.75);
		backdrop-filter: blur(4px);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem;
		opacity: 1;
		transition: opacity 0.2s ease;
	}

	.lightbox-backdrop.hidden {
		display: none !important;
	}

	.lightbox-dialog {
		background-color: #FFFFFF;
		border-radius: 0.875rem;
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
		width: 100%;
		max-width: 820px;
		max-height: 90vh;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		animation: modal-enter 0.25s cubic-bezier(0.16, 1, 0.3, 1);
	}

	@keyframes modal-enter {
		from {
			opacity: 0;
			transform: scale(0.96) translateY(8px);
		}
		to {
			opacity: 1;
			transform: scale(1) translateY(0);
		}
	}

	.lightbox-header {
		padding: 1.25rem 1.5rem;
		border-bottom: 1px solid #E2E8F0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		background-color: #F8FAFC;
	}

	.lightbox-title-group {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.lightbox-badge-icon {
		width: 38px;
		height: 38px;
		border-radius: 0.5rem;
		background-color: #FFF7ED;
		color: #EA580C;
		border: 1px solid #FED7AA;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.lightbox-title {
		font-size: 1.125rem;
		font-weight: 800;
		color: #0F172A;
		margin: 0;
	}

	.lightbox-subtitle {
		font-size: 0.75rem;
		color: #64748B;
		margin: 0.15rem 0 0;
	}

	.btn-lightbox-close {
		width: 48px;
		height: 48px;
		border-radius: 0.5rem;
		border: 1px solid #CBD5E1;
		background-color: #FFFFFF;
		color: #64748B;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.btn-lightbox-close:hover {
		background-color: #F1F5F9;
		color: #0F172A;
		border-color: #94A3B8;
	}

	.btn-lightbox-close:focus-visible {
		outline: 2px solid #F97316;
		outline-offset: 2px;
	}

	.lightbox-body {
		padding: 1.5rem;
		overflow-y: auto;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
		align-items: start;
	}

	.receipt-image-viewer {
		background-color: #F1F5F9;
		border: 1px solid #CBD5E1;
		border-radius: 0.75rem;
		padding: 1rem;
		display: flex;
		align-items: center;
		justify-content: center;
		max-height: 460px;
		overflow-y: auto;
	}

	.receipt-paper-wrapper {
		width: 100%;
		max-width: 320px;
		box-shadow: 0 4px 16px rgba(15, 23, 42, 0.1);
	}

	.lightbox-receipt-img {
		width: 100%;
		height: auto;
		display: block;
		border-radius: 0.375rem;
	}

	.receipt-audit-panel {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.audit-amount-banner {
		background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
		border-radius: 0.75rem;
		padding: 1rem 1.25rem;
		color: #FFFFFF;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.audit-amount-label {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: #94A3B8;
		font-weight: 700;
	}

	.audit-amount-val {
		font-size: 1.625rem;
		font-weight: 800;
		color: #10B981;
		font-family: var(--font-mono, monospace);
	}

	.audit-details-list {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		font-size: 0.8125rem;
	}

	.audit-detail-row {
		display: flex;
		flex-direction: column;
		padding-bottom: 0.45rem;
		border-bottom: 1px solid #F1F5F9;
	}

	.audit-row-label {
		color: #64748B;
		font-size: 0.6875rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		margin-bottom: 0.15rem;
	}

	.audit-row-val {
		color: #0F172A;
	}

	.audit-notes-text {
		margin: 0;
		color: #334155;
		background-color: #F8FAFC;
		padding: 0.5rem 0.75rem;
		border-radius: 0.375rem;
		border-left: 3px solid #CBD5E1;
		font-style: italic;
	}

	.audit-validation-badge {
		margin-top: 0.5rem;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		background-color: #ECFDF5;
		border: 1px solid #A7F3D0;
		border-radius: 0.5rem;
		padding: 0.75rem 1rem;
		color: #047857;
		font-size: 0.8125rem;
	}

	.audit-validation-badge strong {
		display: block;
		font-size: 0.875rem;
	}

	.lightbox-footer {
		padding: 1rem 1.5rem;
		border-top: 1px solid #E2E8F0;
		display: flex;
		justify-content: flex-end;
		background-color: #F8FAFC;
	}

	.btn-lightbox-primary {
		height: 48px;
		padding: 0 1.5rem;
		background-color: #0F172A;
		color: #FFFFFF;
		border: none;
		border-radius: 0.5rem;
		font-size: 0.875rem;
		font-weight: 700;
		cursor: pointer;
		transition: background-color 0.15s ease;
	}

	.btn-lightbox-primary:hover {
		background-color: #1E293B;
	}

	@media (max-width: 768px) {
		.lightbox-body {
			grid-template-columns: 1fr;
		}
	}
</style>
