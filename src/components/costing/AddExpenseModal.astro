---
// src/components/costing/AddExpenseModal.astro
// HU-13: Modal ergonómico para registrar un gasto de campo e imputarlo a un capítulo.
---

<div id="add-expense-modal" class="expense-modal-backdrop hidden" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="expense-modal-title">
	<div class="expense-dialog" id="expense-dialog">
		<!-- Header del Modal -->
		<div class="expense-modal-header">
			<div class="expense-title-group">
				<div class="expense-icon-badge" aria-hidden="true">
					<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<line x1="12" y1="5" x2="12" y2="19"></line>
						<line x1="5" y1="12" x2="19" y2="12"></line>
					</svg>
				</div>
				<div>
					<h3 id="expense-modal-title" class="expense-modal-title">Registrar Gasto de Obra</h3>
					<p class="expense-modal-subtitle">Imputación directa a la matriz de Job Costing</p>
				</div>
			</div>

			<button id="btn-close-expense-modal" type="button" class="btn-modal-close" aria-label="Cerrar formulario de gasto">
				<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<line x1="18" y1="6" x2="6" y2="18"></line>
					<line x1="6" y1="6" x2="18" y2="18"></line>
				</svg>
			</button>
		</div>

		<!-- Formulario de Gasto -->
		<form id="form-add-expense" class="expense-modal-form" novalidate>
			<div class="form-body-scroll">
				<!-- Selector de Capítulo Imputado -->
				<div class="form-group">
					<label for="expense-chapter-select" class="form-label">
						<span>Capítulo de Imputación *</span>
						<span class="label-hint">Determina la afectación presupuestaria</span>
					</label>
					<div class="select-wrapper">
						<select id="expense-chapter-select" class="form-select" required aria-label="Seleccionar capítulo">
							<!-- Opciones inyectadas dinámicamente -->
						</select>
					</div>
				</div>

				<!-- Monto del Gasto con Feedback en Moneda -->
				<div class="form-group">
					<label for="expense-amount-input" class="form-label">
						<span>Valor del Gasto (COP) *</span>
						<span id="amount-format-preview" class="amount-preview mono-value">$ 0 COP</span>
					</label>
					<div class="input-money-wrapper">
						<span class="currency-prefix" aria-hidden="true">$</span>
						<input
							id="expense-amount-input"
							type="number"
							step="1000"
							min="1"
							placeholder="Ej: 350000"
							class="form-input input-money mono-value"
							required
						/>
					</div>
				</div>

				<!-- Concepto / Descripción -->
				<div class="form-group">
					<label for="expense-concept-input" class="form-label">
						<span>Concepto o Descripción del Gasto *</span>
					</label>
					<input
						id="expense-concept-input"
						type="text"
						placeholder="Ej: Compra de tubería PVC presión y codos 90"
						class="form-input"
						required
					/>
				</div>

				<!-- Proveedor / Comercializadora -->
				<div class="form-row-2col">
					<div class="form-group">
						<label for="expense-vendor-input" class="form-label">
							<span>Proveedor o Beneficiario *</span>
						</label>
						<input
							id="expense-vendor-input"
							type="text"
							placeholder="Ej: Homecenter, Ferretería El Martillo"
							class="form-input"
							required
						/>
					</div>

					<div class="form-group">
						<label for="expense-date-input" class="form-label">
							<span>Fecha del Recibo</span>
						</label>
						<input
							id="expense-date-input"
							type="date"
							class="form-input mono-value"
							required
						/>
					</div>
				</div>

				<!-- Selector de Categoría (Chips Táctiles) -->
				<div class="form-group">
					<span class="form-label">Categoría del Costo</span>
					<div class="category-chips-selector" role="radiogroup" aria-label="Categoría del costo">
						<label class="category-chip active">
							<input type="radio" name="expense-cat" value="material" checked class="sr-only" />
							<span>📦 Material</span>
						</label>
						<label class="category-chip">
							<input type="radio" name="expense-cat" value="labor" class="sr-only" />
							<span>👷 Mano de Obra</span>
						</label>
						<label class="category-chip">
							<input type="radio" name="expense-cat" value="equipment" class="sr-only" />
							<span>🚜 Equipos</span>
						</label>
						<label class="category-chip">
							<input type="radio" name="expense-cat" value="subcontract" class="sr-only" />
							<span>🤝 Subcontrato</span>
						</label>
					</div>
				</div>

				<!-- Subida / Simulación de Recibo -->
				<div class="form-group">
					<label class="form-label">
						<span>Comprobante / Recibo de Pago</span>
						<span class="label-hint">Foto de factura o soporte físico</span>
					</label>

					<div class="receipt-upload-zone" id="receipt-upload-zone">
						<input
							id="expense-file-input"
							type="file"
							accept="image/*"
							class="sr-only"
							aria-label="Cargar foto del recibo"
						/>
						<div class="receipt-drop-content" id="receipt-drop-content">
							<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="upload-icon">
								<rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
								<circle cx="8.5" cy="8.5" r="1.5"></circle>
								<polyline points="21 15 16 10 5 21"></polyline>
							</svg>
							<div class="drop-text-group">
								<span class="drop-main-text">Toca para subir foto o arrastra aquí</span>
								<span class="drop-sub-text">PNG, JPG o WebP</span>
							</div>
						</div>

						<!-- Vista previa de foto cargada -->
						<div class="receipt-preview-box hidden" id="receipt-preview-box">
							<img id="expense-preview-img" src="" alt="Vista previa del recibo" class="preview-img-tag" />
							<button id="btn-remove-receipt-img" type="button" class="btn-remove-preview" title="Quitar imagen">✕</button>
						</div>
					</div>

					<!-- Botón de Simulación Inmediata para Demo y Testing -->
					<div class="demo-receipt-quick">
						<button id="btn-simulate-receipt" type="button" class="btn-simulate">
							<span>⚡ Generar comprobante digital auditable con estos datos</span>
						</button>
					</div>
				</div>

				<!-- Notas Adicionales -->
				<div class="form-group">
					<label for="expense-notes-input" class="form-label">
						<span>Notas de Supervisión (Opcional)</span>
					</label>
					<textarea
						id="expense-notes-input"
						rows="2"
						placeholder="Observaciones de campo, número de remisión o motivo de urgencia..."
						class="form-textarea"
					></textarea>
				</div>
			</div>

			<!-- Footer con Acciones -->
			<div class="expense-modal-footer">
				<button id="btn-cancel-expense" type="button" class="btn-modal-cancel">
					Cancelar
				</button>
				<button id="btn-submit-expense" type="submit" class="btn-modal-submit">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
						<polyline points="20 6 9 17 4 12"></polyline>
					</svg>
					<span>Guardar Gasto e Imputar</span>
				</button>
			</div>
		</form>
	</div>
</div>

<style>
	.expense-modal-backdrop {
		position: fixed;
		inset: 0;
		z-index: 150;
		background-color: rgba(15, 23, 42, 0.75);
		backdrop-filter: blur(4px);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem;
		transition: opacity 0.2s ease;
	}

	.expense-modal-backdrop.hidden {
		display: none !important;
	}

	.expense-dialog {
		background-color: #FFFFFF;
		border-radius: 0.875rem;
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
		width: 100%;
		max-width: 600px;
		max-height: 92vh;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		animation: modal-enter 0.25s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.expense-modal-header {
		padding: 1.25rem 1.5rem;
		border-bottom: 1px solid #E2E8F0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		background-color: #F8FAFC;
	}

	.expense-title-group {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.expense-icon-badge {
		width: 40px;
		height: 40px;
		border-radius: 0.5rem;
		background-color: #FFF7ED;
		color: #EA580C;
		border: 1px solid #FED7AA;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.expense-modal-title {
		font-size: 1.125rem;
		font-weight: 800;
		color: #0F172A;
		margin: 0;
	}

	.expense-modal-subtitle {
		font-size: 0.75rem;
		color: #64748B;
		margin: 0.15rem 0 0;
	}

	.btn-modal-close {
		width: 48px;
		height: 48px;
		border-radius: 0.5rem;
		border: 1px solid #CBD5E1;
		background-color: #FFFFFF;
		color: #64748B;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.btn-modal-close:hover {
		background-color: #F1F5F9;
		color: #0F172A;
		border-color: #94A3B8;
	}

	.btn-modal-close:focus-visible {
		outline: 2px solid #F97316;
		outline-offset: 2px;
	}

	.expense-modal-form {
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}

	.form-body-scroll {
		padding: 1.5rem;
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		max-height: calc(92vh - 170px);
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.form-label {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: 0.8125rem;
		font-weight: 700;
		color: #1E293B;
	}

	.label-hint {
		font-size: 0.75rem;
		font-weight: 500;
		color: #64748B;
	}

	.amount-preview {
		color: #059669;
		font-weight: 800;
		font-size: 0.875rem;
	}

	.mono-value {
		font-family: var(--font-mono, 'JetBrains Mono', monospace);
	}

	.select-wrapper {
		position: relative;
	}

	.form-select, .form-input, .form-textarea {
		width: 100%;
		border: 1px solid #CBD5E1;
		border-radius: 0.5rem;
		background-color: #FFFFFF;
		font-family: inherit;
		font-size: 0.875rem;
		color: #0F172A;
		transition: all 0.15s ease;
		box-sizing: border-box;
	}

	.form-select {
		height: 48px;
		padding: 0 2rem 0 0.875rem;
		appearance: none;
		cursor: pointer;
		background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23475569' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
		background-repeat: no-repeat;
		background-position: right 0.75rem center;
		background-size: 14px;
	}

	.form-input {
		height: 48px;
		padding: 0 0.875rem;
	}

	.form-textarea {
		padding: 0.75rem 0.875rem;
		resize: vertical;
	}

	.form-select:focus, .form-input:focus, .form-textarea:focus {
		outline: none;
		border-color: #F97316;
		box-shadow: 0 0 0 3px rgba(249, 115, 22, 0.15);
	}

	.input-money-wrapper {
		position: relative;
		display: flex;
		align-items: center;
	}

	.currency-prefix {
		position: absolute;
		left: 1rem;
		font-size: 1.125rem;
		font-weight: 800;
		color: #64748B;
		pointer-events: none;
	}

	.input-money {
		padding-left: 2.25rem !important;
		font-size: 1.125rem !important;
		font-weight: 800;
	}

	.form-row-2col {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	/* Selector de Categorías (Chips) */
	.category-chips-selector {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.category-chip {
		height: 44px;
		padding: 0 1rem;
		border-radius: 0.5rem;
		border: 1px solid #CBD5E1;
		background-color: #F8FAFC;
		color: #334155;
		font-size: 0.8125rem;
		font-weight: 700;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: all 0.15s ease;
		user-select: none;
	}

	.category-chip:hover {
		background-color: #F1F5F9;
		border-color: #94A3B8;
	}

	.category-chip.active {
		background-color: #0F172A;
		color: #FFFFFF;
		border-color: #0F172A;
		box-shadow: 0 2px 6px rgba(15, 23, 42, 0.15);
	}

	/* Zona de Subida de Recibo */
	.receipt-upload-zone {
		border: 2px dashed #CBD5E1;
		border-radius: 0.625rem;
		padding: 1rem;
		text-align: center;
		background-color: #F8FAFC;
		cursor: pointer;
		transition: all 0.15s ease;
		position: relative;
	}

	.receipt-upload-zone:hover {
		border-color: #F97316;
		background-color: #FFF7ED;
	}

	.receipt-drop-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
	}

	.upload-icon {
		color: #F97316;
	}

	.drop-main-text {
		font-size: 0.8125rem;
		font-weight: 700;
		color: #1E293B;
		display: block;
	}

	.drop-sub-text {
		font-size: 0.75rem;
		color: #64748B;
	}

	.receipt-preview-box {
		position: relative;
		display: inline-block;
		max-width: 140px;
	}

	.preview-img-tag {
		width: 100%;
		height: auto;
		border-radius: 0.375rem;
		border: 1px solid #CBD5E1;
		box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
	}

	.btn-remove-preview {
		position: absolute;
		top: -8px;
		right: -8px;
		width: 26px;
		height: 26px;
		border-radius: 50%;
		background-color: #DC2626;
		color: #FFFFFF;
		border: 2px solid #FFFFFF;
		cursor: pointer;
		font-size: 0.75rem;
		font-weight: bold;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.demo-receipt-quick {
		margin-top: 0.4rem;
	}

	.btn-simulate {
		width: 100%;
		padding: 0.5rem;
		background-color: #F1F5F9;
		border: 1px solid #CBD5E1;
		border-radius: 0.375rem;
		font-size: 0.75rem;
		font-weight: 700;
		color: #334155;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.btn-simulate:hover {
		background-color: #E2E8F0;
		color: #0F172A;
		border-color: #94A3B8;
	}

	.expense-modal-footer {
		padding: 1rem 1.5rem;
		border-top: 1px solid #E2E8F0;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.75rem;
		background-color: #F8FAFC;
	}

	.btn-modal-cancel {
		height: 48px;
		padding: 0 1.25rem;
		background-color: #FFFFFF;
		border: 1px solid #CBD5E1;
		border-radius: 0.5rem;
		font-size: 0.875rem;
		font-weight: 700;
		color: #475569;
		cursor: pointer;
	}

	.btn-modal-cancel:hover {
		background-color: #F1F5F9;
		color: #0F172A;
	}

	.btn-modal-submit {
		height: 48px;
		padding: 0 1.5rem;
		background-color: #F97316;
		border: 1px solid #EA580C;
		border-radius: 0.5rem;
		font-size: 0.875rem;
		font-weight: 700;
		color: #FFFFFF;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		box-shadow: 0 2px 6px rgba(249, 115, 22, 0.25);
		transition: all 0.15s ease;
	}

	.btn-modal-submit:hover {
		background-color: #EA580C;
		box-shadow: 0 4px 12px rgba(249, 115, 22, 0.35);
	}

	.btn-modal-submit:focus-visible {
		outline: 2px solid #0F172A;
		outline-offset: 2px;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border-width: 0;
	}

	.hidden {
		display: none !important;
	}

	@media (max-width: 540px) {
		.form-row-2col {
			grid-template-columns: 1fr;
		}
		.expense-modal-footer {
			flex-direction: column-reverse;
		}
		.btn-modal-cancel, .btn-modal-submit {
			width: 100%;
			justify-content: center;
		}
	}
</style>
