---
// src/components/Header.astro
// Barra superior ejecutiva con selector de roles y accesos directos (HU-14)
import HeaderRoleSwitcher from './HeaderRoleSwitcher.astro';
---

<header class="app-header">
	<div class="header-inner">
		<!-- Left: Sidebar Hamburger Toggle + Breadcrumb -->
		<div class="header-left-cluster">
			<button
				id="header-sidebar-toggle"
				type="button"
				class="btn-sidebar-hamburger"
				aria-label="Abrir menú de navegación lateral"
				title="Abrir menú de navegación"
			>
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<line x1="3" y1="12" x2="21" y2="12"></line>
					<line x1="3" y1="6" x2="21" y2="6"></line>
					<line x1="3" y1="18" x2="21" y2="18"></line>
				</svg>
			</button>

			<div class="header-breadcrumb">
				<a href="/" class="crumb-brand-mini" title="ObraFlow">
					<div class="mini-emblem">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M2 20h20"></path>
							<path d="m5 20 5-15h4l5 15"></path>
							<path d="M9 13h6"></path>
						</svg>
					</div>
					<span class="mini-brand-name">Obra<span class="text-accent">Flow</span></span>
				</a>
				<span class="crumb-separator" aria-hidden="true">/</span>
				<span id="header-breadcrumb-page" class="crumb-page-title">Embudo Comercial</span>
			</div>
		</div>

		<!-- Right: Action Stats & User Controls -->
		<div class="actions-group">
			<!-- Pipeline Value Pill -->
			<div class="pipeline-pill desktop-only">
				<span class="pill-label">Pipeline Activo:</span>
				<span id="header-pipeline-val" class="pill-val">$ 202.0M COP</span>
			</div>

			<!-- Web Form Share Trigger Button (HU-02) -->
			<button
				id="header-share-form-btn"
				type="button"
				class="btn-web-form"
				title="Compartir Formulario Web Público (HU-02)"
			>
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="12" cy="12" r="10"></circle>
					<line x1="2" y1="12" x2="22" y2="12"></line>
					<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
				</svg>
				<span>Formulario Web</span>
			</button>

			<!-- Desktop "Nuevo Lead" Trigger Button -->
			<button
				id="header-new-lead-btn"
				type="button"
				class="btn-primary desktop-only"
			>
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
					<line x1="12" y1="5" x2="12" y2="19"></line>
					<line x1="5" y1="12" x2="19" y2="12"></line>
				</svg>
				<span>Nuevo Lead</span>
				<kbd class="kbd-badge">Alt+N</kbd>
			</button>

			<!-- Botón Registro Rápido de Gastos de Campo (HU-14) -->
			<a
				href="/expenses/quick"
				id="header-quick-expense-btn"
				class="btn-field-camera"
				title="Registro Rápido de Gastos en 3 Toques (HU-14)"
				aria-label="Registrar gasto de campo en 3 toques"
			>
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
					<circle cx="12" cy="13" r="4"></circle>
				</svg>
				<span class="desktop-only">Gastos Campo</span>
			</a>

			<!-- Selector de Roles de Usuario con Dropdown (HU-14) -->
			<HeaderRoleSwitcher />
		</div>
	</div>
</header>

<style>
	.app-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background-color: #0F172A;
		border-bottom: 1px solid #1E293B;
		color: #FFFFFF;
		padding: 0.625rem 1.25rem;
		box-shadow: 0 4px 12px rgba(15, 23, 42, 0.25);
	}

	.header-inner {
		max-width: 100%;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	/* Left Cluster */
	.header-left-cluster {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.btn-sidebar-hamburger {
		width: 48px;
		height: 48px;
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: #1E293B;
		border: 1px solid #334155;
		color: #F8FAFC;
		border-radius: 0.5rem;
		cursor: pointer;
		transition: all 0.15s ease;
		flex-shrink: 0;
	}

	.btn-sidebar-hamburger:hover {
		background-color: #334155;
		color: #F97316;
	}

	.btn-sidebar-hamburger:focus-visible {
		outline: 2px solid #F97316;
		outline-offset: 2px;
	}

	@media (min-width: 1024px) {
		.btn-sidebar-hamburger {
			display: none !important;
		}
	}

	/* Breadcrumb */
	.header-breadcrumb {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.crumb-brand-mini {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		text-decoration: none;
		color: #FFFFFF;
		border-radius: 0.375rem;
		transition: opacity 0.15s ease;
	}

	.crumb-brand-mini:hover {
		opacity: 0.85;
	}

	.crumb-brand-mini:focus-visible {
		outline: 2px solid #F97316;
		outline-offset: 2px;
	}

	.mini-emblem {
		width: 1.5rem;
		height: 1.5rem;
		border-radius: 0.375rem;
		background: linear-gradient(135deg, #F97316, #EA580C);
		display: flex;
		align-items: center;
		justify-content: center;
		color: #FFFFFF;
		flex-shrink: 0;
	}

	.mini-brand-name {
		font-size: 0.875rem;
		font-weight: 800;
		letter-spacing: -0.02em;
	}

	.text-accent {
		color: #FB923C;
	}

	.crumb-separator {
		color: #475569;
		font-size: 0.875rem;
		font-weight: 600;
	}

	.crumb-page-title {
		font-size: 0.875rem;
		font-weight: 700;
		color: #F8FAFC;
		letter-spacing: -0.01em;
	}

	/* Right: Actions Group */
	.actions-group {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.pipeline-pill {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		background-color: rgba(30, 41, 59, 0.8);
		border: 1px solid rgba(51, 65, 85, 0.6);
		border-radius: 0.75rem;
		padding: 0.375rem 0.875rem;
		font-size: 0.75rem;
	}

	.pill-label {
		color: #94A3B8;
	}

	.pill-val {
		color: #34D399;
		font-family: var(--font-mono);
		font-weight: 700;
	}

	.btn-primary {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.5rem;
		background-color: #F97316;
		color: #FFFFFF;
		font-size: 0.8125rem;
		font-weight: 700;
		padding: 0.5rem 1rem;
		border-radius: 0.75rem;
		border: none;
		cursor: pointer;
		box-shadow: 0 4px 12px rgba(249, 115, 22, 0.3);
		transition: all 0.15s ease;
	}

	.btn-primary:hover {
		background-color: #EA580C;
		transform: translateY(-1px);
	}

	.btn-primary:focus-visible {
		outline: 2px solid #FFFFFF;
		outline-offset: 2px;
	}

	.btn-web-form {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.5rem;
		background-color: rgba(30, 41, 59, 0.9);
		border: 1px solid rgba(59, 130, 246, 0.45);
		color: #93C5FD;
		font-size: 0.8125rem;
		font-weight: 700;
		padding: 0.5rem 1rem;
		border-radius: 0.75rem;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.btn-web-form:hover {
		background-color: #1E3A8A;
		color: #FFFFFF;
		border-color: #60A5FA;
		transform: translateY(-1px);
	}

	.btn-web-form:focus-visible {
		outline: 2px solid #60A5FA;
		outline-offset: 2px;
	}

	.btn-field-camera {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.5rem;
		background-color: #1E293B;
		border: 1px solid #334155;
		color: #F8FAFC;
		font-size: 0.8125rem;
		font-weight: 700;
		padding: 0.5rem 0.875rem;
		border-radius: 0.75rem;
		text-decoration: none;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.btn-field-camera:hover {
		background-color: #334155;
		color: #F97316;
		border-color: #F97316;
		transform: translateY(-1px);
	}

	.btn-field-camera:focus-visible {
		outline: 2px solid #F97316;
		outline-offset: 2px;
	}

	.kbd-badge {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		background: rgba(194, 65, 12, 0.6);
		border: 1px solid rgba(251, 146, 60, 0.4);
		padding: 0.125rem 0.375rem;
		border-radius: 0.25rem;
		color: #FFF7ED;
	}

	.user-profile {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		padding-left: 0.75rem;
		border-left: 1px solid #1E293B;
	}

	.avatar {
		width: 2rem;
		height: 2rem;
		border-radius: 9999px;
		background-color: #334155;
		border: 1px solid #475569;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.75rem;
		font-weight: 700;
		color: #FB923C;
	}

	.user-details {
		display: flex;
		flex-direction: column;
		text-align: left;
	}

	.user-name {
		font-size: 0.75rem;
		font-weight: 700;
		color: #F1F5F9;
	}

	.user-role {
		font-size: 0.625rem;
		color: #FB923C;
		font-weight: 600;
	}

	@media (max-width: 768px) {
		.desktop-only {
			display: none !important;
		}

		.btn-sidebar-hamburger {
			width: 48px;
			height: 48px;
		}
	}
</style>

<script>
	// Toggle Sidebar via CustomEvent
	document.getElementById('header-sidebar-toggle')?.addEventListener('click', () => {
		window.dispatchEvent(new CustomEvent('toggle-sidebar'));
	});

	// Actualizar Breadcrumb de Página Activa
	const path = window.location.pathname;
	const crumbPage = document.getElementById('header-breadcrumb-page');
	if (crumbPage) {
		if (path.startsWith('/schedule') || path.includes('/schedule')) {
			crumbPage.textContent = 'Cronograma de Obra (HU-16)';
		} else if (path.startsWith('/daily-logs') || path.includes('/daily-logs')) {
			crumbPage.textContent = 'Bitácora Diaria de Obra (HU-17)';
		} else if (path.startsWith('/costing') || path.includes('/costing')) {
			crumbPage.textContent = 'Control de Costos (Job Costing)';
		} else if (path.startsWith('/expenses')) {
			crumbPage.textContent = 'Registro de Gastos (HU-14)';
		} else if (path.startsWith('/change-orders')) {
			crumbPage.textContent = 'Órdenes de Cambio (HU-15)';
		} else if (path.startsWith('/catalog')) {
			crumbPage.textContent = 'Catálogo Maestro de Insumos';
		} else if (path.startsWith('/budgets/editor')) {
			crumbPage.textContent = 'Constructor de Presupuestos';
		} else if (path.startsWith('/budgets')) {
			crumbPage.textContent = 'Presupuestos';
		} else if (path.startsWith('/leads')) {
			crumbPage.textContent = 'Ficha de Visita Técnica';
		} else {
			crumbPage.textContent = 'Embudo Comercial de Obras';
		}
	}

	// Modal Triggers
	document.getElementById('header-share-form-btn')?.addEventListener('click', () => {
		window.dispatchEvent(new CustomEvent('open-share-form-modal'));
	});

	document.getElementById('header-new-lead-btn')?.addEventListener('click', () => {
		window.dispatchEvent(new CustomEvent('open-lead-modal'));
	});

	// Sincronizar pipeline con KanbanBoard en tiempo real
	window.addEventListener('pipeline-updated', (e: any) => {
		const headerVal = document.getElementById('header-pipeline-val');
		if (headerVal && typeof e.detail?.total === 'number') {
			headerVal.textContent = `$ ${(e.detail.total / 1000000).toFixed(1)}M COP`;
		}
	});

	window.addEventListener('keydown', (e) => {
		if ((e.altKey && e.key.toLowerCase() === 'n') || (e.ctrlKey && e.shiftKey && e.key.toLowerCase() === 'l')) {
			e.preventDefault();
			window.dispatchEvent(new CustomEvent('open-lead-modal'));
		}
	});
</script>
