---
// src/components/LeadCaptureModal.astro
// Complete Implementation of HU-01: Captura Rápida de Lead en Campo (< 15 Segundos)
import { renderIconSvg } from '../lib/icons';
---

<div
	id="lead-capture-modal-container"
	class="modal-backdrop-wrap"
	role="dialog"
	aria-modal="true"
	aria-labelledby="modal-title"
>
	<!-- Backdrop Overlay -->
	<div id="modal-backdrop" class="modal-backdrop-blur"></div>

	<!-- Modal Sheet Container -->
	<div id="modal-card" class="modal-card-box">
		<!-- Mobile Tactile Drag Handle -->
		<div class="mobile-drag-bar">
			<div class="drag-pill"></div>
		</div>

		<!-- Header -->
		<div class="modal-header">
			<div class="title-wrap">
				<div class="header-icon" set:html={renderIconSvg('user', { size: 18 })}></div>
				<div>
					<h2 id="modal-title" class="title-text">
						Captura Rápida de Lead
					</h2>
					<p class="subtitle-text">
						Modo Campo • Formulario rápido (<span class="accent-bold">&lt;15s</span>)
					</p>
				</div>
			</div>

			<button id="close-modal-btn" type="button" class="btn-close" aria-label="Cerrar modal">
				<Fragment set:html={renderIconSvg('x', { size: 18 })} />
			</button>
		</div>

		<!-- Form with the 4 Strict Fields -->
		<form id="quick-lead-form" class="modal-form">
			<!-- Field 1: Nombre del Cliente -->
			<div class="form-group">
				<label for="lead-client-name" class="form-label">
					Nombre del Cliente <span class="required">*</span>
				</label>
				<div class="input-wrap">
					<span class="input-icon"><Fragment set:html={renderIconSvg('user', { size: 16 })} /></span>
					<input
						type="text"
						id="lead-client-name"
						name="client_name"
						required
						minlength="3"
						maxlength="150"
						autocapitalize="words"
						placeholder="Ej. Sandra Milena Gómez"
						class="text-input with-icon"
					/>
				</div>
				<p id="name-error" class="error-msg hidden">
					Ingresa el nombre del cliente (mínimo 3 caracteres).
				</p>
			</div>

			<!-- Field 2: WhatsApp / Teléfono -->
			<div class="form-group">
				<label for="lead-client-phone" class="form-label">
					WhatsApp / Teléfono <span class="required">*</span>
				</label>
				<div class="phone-row">
					<div class="country-pill">
						<svg width="18" height="12" viewBox="0 0 600 400" xmlns="http://www.w3.org/2000/svg" style="border-radius:2px;box-shadow:0 0 1px rgba(0,0,0,0.3);flex-shrink:0;">
							<rect width="600" height="200" fill="#FCD116"/>
							<rect y="200" width="600" height="100" fill="#003893"/>
							<rect y="300" width="600" height="100" fill="#CE1126"/>
						</svg>
						<span>+57</span>
					</div>
					<div class="input-wrap flex-1">
						<span class="input-icon"><Fragment set:html={renderIconSvg('phone', { size: 15 })} /></span>
						<input
							type="tel"
							id="lead-client-phone"
							name="client_phone"
							required
							pattern="[0-9]{7,15}"
							inputmode="numeric"
							placeholder="310 987 6543"
							class="text-input with-icon"
						/>
					</div>
				</div>
				<p id="phone-error" class="error-msg hidden">
					Ingresa un número válido (entre 7 y 15 dígitos).
				</p>
			</div>

			<!-- Field 3: Dirección / Zona del Inmueble -->
			<div class="form-group">
				<label for="lead-project-address" class="form-label">
					Dirección / Zona del Inmueble <span class="required">*</span>
				</label>
				<div class="input-wrap">
					<span class="input-icon"><Fragment set:html={renderIconSvg('mapPin', { size: 16 })} /></span>
					<input
						type="text"
						id="lead-project-address"
						name="project_address"
						required
						minlength="4"
						placeholder="Ej. Cra 7 # 116-20 Torre B Apto 502"
						class="text-input with-icon"
					/>
				</div>
				<!-- Fast zone chip suggestions for 1-tap typing -->
				<div class="quick-zones">
					<span class="quick-zones-label">Zonas rápidas:</span>
					<button type="button" class="zone-quick-chip">Poblado</button>
					<button type="button" class="zone-quick-chip">Envigado</button>
					<button type="button" class="zone-quick-chip">Laureles</button>
					<button type="button" class="zone-quick-chip">Chicó</button>
					<button type="button" class="zone-quick-chip">Cedritos</button>
				</div>
				<p id="address-error" class="error-msg hidden">
					Ingresa la dirección o zona aproximada del proyecto.
				</p>
			</div>

			<!-- Field 4: Tipo de Obra (Tactile Chips) -->
			<div class="form-group">
				<label class="form-label">
					Tipo de Obra <span class="required">*</span>
				</label>
				<input type="hidden" id="lead-project-type" name="project_type" value="Remodelación Total" />
				
				<div class="chips-grid" id="project-type-chip-group">
					<button type="button" data-type="Remodelación Total" class="tactile-chip active">
						<Fragment set:html={renderIconSvg('tool', { size: 15 })} />
						<span>Remodelación Total</span>
					</button>
					<button type="button" data-type="Cocina Integral" class="tactile-chip">
						<Fragment set:html={renderIconSvg('home', { size: 15 })} />
						<span>Cocina</span>
					</button>
					<button type="button" data-type="Baño" class="tactile-chip">
						<Fragment set:html={renderIconSvg('droplet', { size: 15 })} />
						<span>Baño</span>
					</button>
					<button type="button" data-type="Pintura y Acabados" class="tactile-chip">
						<Fragment set:html={renderIconSvg('paint', { size: 15 })} />
						<span>Pintura / Acabados</span>
					</button>
					<button type="button" data-type="Adecuación Comercial" class="tactile-chip">
						<Fragment set:html={renderIconSvg('briefcase', { size: 15 })} />
						<span>Local / Oficina</span>
					</button>
					<button type="button" data-type="Otro" class="tactile-chip">
						<Fragment set:html={renderIconSvg('package', { size: 15 })} />
						<span>Otro Proyecto</span>
					</button>
				</div>
			</div>

			<!-- Estimated Budget Helper (Optional) -->
			<div class="form-group">
				<label for="lead-budget-estimate" class="form-label text-muted">
					Presupuesto Estimado Inicial (COP, Opcional)
				</label>
				<div class="input-wrap">
					<span class="input-icon font-mono">$</span>
					<input
						type="text"
						id="lead-budget-estimate"
						name="estimated_budget"
						placeholder="Ej. 25,000,000"
						class="text-input with-icon font-mono"
					/>
				</div>
			</div>

			<!-- Action Buttons -->
			<div class="modal-actions">
				<button id="cancel-modal-btn" type="button" class="btn-cancel">
					Cancelar
				</button>

				<button id="save-lead-btn" type="submit" class="btn-submit">
					<span id="save-btn-spinner" class="spinner-icon hidden">
						<Fragment set:html={renderIconSvg('refresh', { size: 16 })} />
					</span>
					<span id="save-btn-text" class="btn-text-content">
						<span>Guardar Prospecto</span>
						<Fragment set:html={renderIconSvg('check', { size: 16 })} />
					</span>
				</button>
			</div>
		</form>
	</div>
</div>

<style>
	.modal-backdrop-wrap {
		position: fixed;
		inset: 0;
		z-index: 50;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.2s ease-out;
	}

	@media (min-width: 640px) {
		.modal-backdrop-wrap {
			align-items: center;
			padding: 1rem;
		}
	}

	.modal-backdrop-wrap.active {
		opacity: 1;
		pointer-events: auto;
	}

	.modal-backdrop-blur {
		position: fixed;
		inset: 0;
		background-color: rgba(2, 6, 23, 0.65);
		backdrop-filter: blur(4px);
	}

	.modal-card-box {
		position: relative;
		width: 100%;
		max-width: 32rem;
		background-color: #FFFFFF;
		border-top-left-radius: 1.5rem;
		border-top-right-radius: 1.5rem;
		border: 1px solid #E2E8F0;
		box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
		overflow: hidden;
		transform: translateY(100%);
		transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
		display: flex;
		flex-direction: column;
		max-height: 90vh;
	}

	@media (min-width: 640px) {
		.modal-card-box {
			border-radius: 1rem;
			transform: translateY(1rem) scale(0.97);
		}
	}

	.modal-backdrop-wrap.active .modal-card-box {
		transform: translateY(0) scale(1);
	}

	.mobile-drag-bar {
		display: flex;
		justify-content: center;
		padding-top: 0.75rem;
		padding-bottom: 0.25rem;
	}

	@media (min-width: 640px) {
		.mobile-drag-bar {
			display: none;
		}
	}

	.drag-pill {
		width: 3rem;
		height: 0.375rem;
		border-radius: 9999px;
		background-color: #CBD5E1;
	}

	.modal-header {
		padding: 1rem 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-bottom: 1px solid #F1F5F9;
	}

	.title-wrap {
		display: flex;
		align-items: center;
		gap: 0.625rem;
	}

	.header-icon {
		width: 2rem;
		height: 2rem;
		border-radius: 0.5rem;
		background-color: #FFF7ED;
		border: 1px solid #FFEDD5;
		display: flex;
		align-items: center;
		justify-content: center;
		color: #EA580C;
	}

	.title-text {
		font-size: 1.125rem;
		font-weight: 700;
		color: #0F172A;
		line-height: 1.2;
	}

	.subtitle-text {
		font-size: 0.75rem;
		color: #64748B;
		font-weight: 500;
	}

	.accent-bold {
		color: #EA580C;
		font-weight: 700;
	}

	.btn-close {
		width: 2rem;
		height: 2rem;
		border-radius: 0.5rem;
		color: #94A3B8;
		background: none;
		border: none;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
	}

	.btn-close:hover {
		background-color: #F1F5F9;
		color: #0F172A;
	}

	.modal-form {
		padding: 1.25rem 1.5rem;
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		text-align: left;
	}

	.form-group {
		display: flex;
		flex-direction: column;
	}

	.form-label {
		font-size: 0.75rem;
		font-weight: 700;
		color: #334155;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 0.375rem;
	}

	.form-label.text-muted {
		color: #64748B;
	}

	.required {
		color: #EA580C;
		font-weight: 700;
	}

	.input-wrap {
		position: relative;
		display: flex;
		align-items: center;
	}

	.input-wrap.flex-1 {
		flex: 1;
	}

	.input-icon {
		position: absolute;
		left: 0.875rem;
		color: #94A3B8;
		pointer-events: none;
		display: flex;
		align-items: center;
	}

	.input-icon.font-mono {
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.875rem;
	}

	.text-input {
		width: 100%;
		padding: 0.625rem 0.875rem;
		background-color: #F8FAFC;
		border: 1px solid #CBD5E1;
		border-radius: 0.75rem;
		font-size: 0.875rem;
		font-weight: 500;
		color: #0F172A;
		outline: none;
		transition: all 0.15s ease;
	}

	.text-input.with-icon {
		padding-left: 2.5rem;
	}

	.text-input:focus {
		background-color: #FFFFFF;
		border-color: #F97316;
		box-shadow: 0 0 0 3px rgba(249, 115, 22, 0.15);
	}

	.text-input.border-error {
		border-color: #EF4444;
	}

	.phone-row {
		display: flex;
		gap: 0.5rem;
	}

	.country-pill {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		padding: 0.625rem 0.75rem;
		background-color: #F1F5F9;
		border: 1px solid #CBD5E1;
		border-radius: 0.75rem;
		font-size: 0.75rem;
		font-weight: 700;
		color: #334155;
		flex-shrink: 0;
	}

	.quick-zones {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		margin-top: 0.5rem;
		flex-wrap: wrap;
		font-size: 0.6875rem;
		color: #64748B;
	}

	.zone-quick-chip {
		padding: 0.125rem 0.5rem;
		border-radius: 0.375rem;
		background-color: #F1F5F9;
		border: 1px solid #E2E8F0;
		color: #334155;
		font-weight: 600;
		cursor: pointer;
	}

	.zone-quick-chip:hover {
		background-color: #E2E8F0;
	}

	.error-msg {
		font-size: 0.75rem;
		color: #EF4444;
		font-weight: 600;
		margin-top: 0.25rem;
	}

	.hidden {
		display: none !important;
	}

	.modal-actions {
		padding-top: 0.5rem;
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.btn-cancel {
		width: 35%;
		padding: 0.75rem;
		border-radius: 0.75rem;
		border: 1px solid #CBD5E1;
		background-color: #FFFFFF;
		color: #334155;
		font-size: 0.875rem;
		font-weight: 700;
		cursor: pointer;
	}

	.btn-cancel:hover {
		background-color: #F1F5F9;
	}

	.btn-submit {
		width: 65%;
		padding: 0.75rem;
		border-radius: 0.75rem;
		border: none;
		background-color: #F97316;
		color: #FFFFFF;
		font-size: 0.875rem;
		font-weight: 700;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		cursor: pointer;
		box-shadow: 0 4px 14px rgba(249, 115, 22, 0.35);
		transition: all 0.15s ease;
	}

	.btn-submit:hover {
		background-color: #EA580C;
	}

	.btn-text-content {
		display: flex;
		align-items: center;
		gap: 0.375rem;
	}

	.animate-spin {
		animation: spin 1s linear infinite;
	}

	@keyframes spin {
		from { transform: rotate(0deg); }
		to { transform: rotate(360deg); }
	}
</style>

<script>
	const modalContainer = document.getElementById('lead-capture-modal-container');
	const modalBackdrop = document.getElementById('modal-backdrop');
	const closeBtn = document.getElementById('close-modal-btn');
	const cancelBtn = document.getElementById('cancel-modal-btn');
	const form = document.getElementById('quick-lead-form') as HTMLFormElement | null;
	const clientNameInput = document.getElementById('lead-client-name') as HTMLInputElement | null;
	const clientPhoneInput = document.getElementById('lead-client-phone') as HTMLInputElement | null;
	const projectAddressInput = document.getElementById('lead-project-address') as HTMLInputElement | null;
	const projectTypeInput = document.getElementById('lead-project-type') as HTMLInputElement | null;
	const budgetInput = document.getElementById('lead-budget-estimate') as HTMLInputElement | null;
	const saveBtn = document.getElementById('save-lead-btn');
	const saveSpinner = document.getElementById('save-btn-spinner');
	const saveText = document.getElementById('save-btn-text');

	function openModal() {
		if (!modalContainer) return;
		modalContainer.classList.add('active');
		setTimeout(() => {
			clientNameInput?.focus();
		}, 180);
	}

	function closeModal() {
		if (!modalContainer) return;
		modalContainer.classList.remove('active');
		setTimeout(() => {
			form?.reset();
			resetErrors();
		}, 200);
	}

	function resetErrors() {
		document.getElementById('name-error')?.classList.add('hidden');
		document.getElementById('phone-error')?.classList.add('hidden');
		document.getElementById('address-error')?.classList.add('hidden');
		clientNameInput?.classList.remove('border-error');
		clientPhoneInput?.classList.remove('border-error');
		projectAddressInput?.classList.remove('border-error');
	}

	window.addEventListener('open-lead-modal', openModal);
	closeBtn?.addEventListener('click', closeModal);
	cancelBtn?.addEventListener('click', closeModal);
	modalBackdrop?.addEventListener('click', closeModal);

	window.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && modalContainer?.classList.contains('active')) {
			closeModal();
		}
	});

	// Fast Zone Suggestions Click Handler
	document.querySelectorAll('.zone-quick-chip').forEach((chip) => {
		chip.addEventListener('click', () => {
			if (projectAddressInput) {
				const zone = chip.textContent?.trim() || '';
				if (!projectAddressInput.value) {
					projectAddressInput.value = zone;
				} else if (!projectAddressInput.value.includes(zone)) {
					projectAddressInput.value = `${projectAddressInput.value}, ${zone}`;
				}
				projectAddressInput.focus();
			}
		});
	});

	// Project Type Chip Selector
	const projectChips = document.querySelectorAll('.tactile-chip');
	projectChips.forEach((chip) => {
		chip.addEventListener('click', () => {
			projectChips.forEach((c) => c.classList.remove('active'));
			chip.classList.add('active');

			const selectedType = chip.getAttribute('data-type') || 'Remodelación Total';
			if (projectTypeInput) {
				projectTypeInput.value = selectedType;
			}
		});
	});

	// Form Submission Handler
	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		resetErrors();

		const clientName = clientNameInput?.value.trim() || '';
		const clientPhone = clientPhoneInput?.value.trim() || '';
		const projectAddress = projectAddressInput?.value.trim() || '';
		const projectType = projectTypeInput?.value || 'Remodelación Total';
		const rawBudget = budgetInput?.value.replace(/[^0-9]/g, '') || '0';
		const estimatedBudget = parseInt(rawBudget, 10) || 0;

		let hasError = false;

		if (clientName.length < 3) {
			document.getElementById('name-error')?.classList.remove('hidden');
			clientNameInput?.classList.add('border-error');
			hasError = true;
		}

		if (clientPhone.length < 7) {
			document.getElementById('phone-error')?.classList.remove('hidden');
			clientPhoneInput?.classList.add('border-error');
			hasError = true;
		}

		if (projectAddress.length < 4) {
			document.getElementById('address-error')?.classList.remove('hidden');
			projectAddressInput?.classList.add('border-error');
			hasError = true;
		}

		if (hasError) return;

		saveSpinner?.classList.remove('hidden');
		saveBtn?.setAttribute('disabled', 'true');

		if ('vibrate' in navigator) {
			try { navigator.vibrate(40); } catch (_) {}
		}

		setTimeout(() => {
			const newLead = {
				id: 'lead_' + Date.now().toString(36),
				client_name: clientName,
				client_phone: clientPhone,
				project_address: projectAddress,
				project_type: projectType,
				estimated_budget: estimatedBudget,
				created_at: new Date().toISOString(),
				source: 'manual'
			};

			window.dispatchEvent(new CustomEvent('lead-created', { detail: newLead }));

			window.dispatchEvent(new CustomEvent('show-toast', {
				detail: {
					title: '¡Prospecto capturado en <15s!',
					message: `${clientName} ha sido agregado a la columna "Nuevo Lead".`,
					type: 'success'
				}
			}));

			saveSpinner?.classList.add('hidden');
			saveBtn?.removeAttribute('disabled');
			closeModal();
		}, 260);
	});
</script>
