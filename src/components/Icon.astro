---
// src/components/Icon.astro
// Wrapper Astro sobre el sistema de iconos react-icons (Tabler).
// Mantiene compatibilidad con nombres legacy y delega a renderIconSvg.
import { renderIconSvg, type IconName } from '../lib/icons';

interface Props {
	name: IconName | 'kitchen' | 'bath' | 'commercial' | 'map-pin' | 'arrow-right' | 'flag-co';
	size?: number;
	class?: string;
	strokeWidth?: number;
}

const { name, size = 16, class: className = '', strokeWidth = 2 } = Astro.props;

const LEGACY_TO_ICON: Record<string, IconName> = {
	'kitchen': 'home',
	'bath': 'droplet',
	'commercial': 'briefcase',
	'map-pin': 'mapPin',
	'arrow-right': 'arrowRight'
};

const resolvedName = (LEGACY_TO_ICON[name] || name) as IconName;
const svg = name === 'flag-co'
	? `<svg width="${size}" height="${Math.round(size * 0.67)}" viewBox="0 0 600 400" xmlns="http://www.w3.org/2000/svg"${className ? ` class="${className}"` : ''} style="border-radius:2px;box-shadow:0 0 1px rgba(0,0,0,0.3);flex-shrink:0;"><rect width="600" height="200" fill="#FCD116"/><rect y="200" width="600" height="100" fill="#003893"/><rect y="300" width="600" height="100" fill="#CE1126"/></svg>`
	: renderIconSvg(resolvedName, { size, className }).replace('stroke-width="2"', `stroke-width="${strokeWidth}"`);
---
<Fragment set:html={svg} />
