		function editItemForm(item: BudgetItem): string {
			return `
				<form class="item-form" data-form="edit-item" data-item-id="${item.id}" data-chapter-id="${item.chapter_id}" novalidate>
					<div class="item-form-grid">
						<label class="form-field form-field-wide">Descripción *
							<input name="description" type="text" maxlength="140" required minlength="3" value="${escapeHtml(item.description)}" />
						</label>
						<label class="form-field">Categoría
							<select name="category">${categoryOptions(item.category)}</select>
						</label>
						<label class="form-field">Unidad
							<input name="unit" type="text" maxlength="12" value="${escapeHtml(item.unit)}" />
						</label>
						<label class="form-field">Cantidad
							<input name="quantity" type="number" min="0" step="0.01" inputmode="decimal" value="${item.quantity}" />
						</label>
						<label class="form-field">Costo unitario
							<input name="unit_cost_internal" type="number" min="0" step="100" inputmode="decimal" value="${item.unit_cost_internal}" />
						</label>
						<label class="form-field">Margen %
							<input name="margin_percentage" type="number" min="0" max="500" step="1" inputmode="decimal" value="${item.margin_percentage}" />
						</label>
					</div>
					<div class="item-form-actions">
						<button type="button" class="btn-form-cancel" data-action="cancel-edit-item">Cancelar</button>
