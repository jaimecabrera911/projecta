								aria-label="Costo unitario interno de ${escapeHtml(item.description)}" />
						</span>
					</label>

					<label class="item-field">
						<span class="field-label">Margen</span>
						<span class="input-shell">
							<input type="number" min="0" max="500" step="1" inputmode="decimal"
								data-field="margin_percentage" value="${item.margin_percentage}"
								aria-label="Margen de utilidad de ${escapeHtml(item.description)}" />
							<span class="input-suffix" aria-hidden="true">%</span>
						</span>
					</label>

					<div class="item-field item-field-computed">
						<span class="field-label">Venta Unit.</span>
						<strong class="computed-value" data-computed="unit-sale">${formatMoney(line.unitSalePrice)}</strong>
					</div>

					<div class="item-field item-field-computed">
						<span class="field-label">Subtotal Cliente</span>
						<strong class="computed-value computed-strong" data-computed="sale">${formatMoney(line.saleSubtotal)}</strong>
					</div>

					<div class="item-actions">
						<div class="item-action-buttons">
							<button type="button" class="icon-btn" data-action="edit-item" title="Editar descripción y datos" aria-label="Editar ${escapeHtml(item.description)}">
								<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
									<path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
								</svg>
							</button>
							<button type="button" class="icon-btn icon-btn-danger" data-action="delete-item" title="Eliminar partida" aria-label="Eliminar ${escapeHtml(item.description)}">
								<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<polyline points="3 6 5 6 21 6"></polyline>
									<path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
								</svg>
							</button>
						</div>
						<div class="item-delete-confirm">
							<span>¿Eliminar?</span>
							<button type="button" class="btn-mini-danger" data-action="confirm-delete-item">Sí</button>
							<button type="button" class="btn-mini-ghost" data-action="cancel-delete-item">No</button>
