</style>

<script>
	import { calcLine, calcTax, calcTotals, formatMoney } from '../lib/budget-math';
	import { loadCatalog, type CatalogItem } from '../lib/catalog';
	import {
		allItems,
		applyGlobalMargin,
		deleteBudget,
		findBudget,
		persistBudget,
		uid,
		type Budget,
		type BudgetCategory,
		type BudgetChapter,
		type BudgetItem,
		type TaxParameters
	} from '../lib/budget-store';

	const CATEGORY_META: Record<BudgetCategory, { label: string; className: string }> = {
		material: { label: 'Material', className: 'cat-material' },
		labor: { label: 'Mano de Obra', className: 'cat-labor' },
		subcontract: { label: 'Subcontrato', className: 'cat-subcontract' },
		equipment: { label: 'Equipo', className: 'cat-equipment' }
	};

	const budget = findBudget(new URLSearchParams(window.location.search).get('id'));

	if (!budget) {
		document.getElementById('budget-builder-content')?.classList.add('hidden');
		document.getElementById('budget-not-found')?.classList.remove('hidden');
		document.getElementById('budget-totals-bar')?.classList.add('hidden');
	} else {
		initBuilder(budget);

		// HU-08: feedback tras duplicar una plantilla.
		const dupParams = new URLSearchParams(window.location.search);
		if (dupParams.get('duplicated') === '1') {
			dupParams.delete('duplicated');
			const query = dupParams.toString();
			history.replaceState(null, '', `${window.location.pathname}${query ? `?${query}` : ''}`);
			setTimeout(() => {
				window.dispatchEvent(new CustomEvent('show-toast', {
					detail: {
						title: 'Presupuesto duplicado',
						message: 'Presupuesto duplicado exitosamente. Ahora puedes ajustar cantidades.',
						type: 'success'
					}
				}));
			}, 0);
		}
	}

	function initBuilder(currentBudget: Budget) {
		const catalog: CatalogItem[] = loadCatalog();

		const titleInput = document.getElementById('budget-title-input') as HTMLInputElement | null;
		const breadcrumbTitle = document.getElementById('budget-breadcrumb-title');
		const clientLine = document.getElementById('budget-client-line');
		const globalMarginInput = document.getElementById('budget-global-margin') as HTMLInputElement | null;
		const applyMarginBtn = document.getElementById('btn-apply-global-margin');
		const saveState = document.getElementById('budget-save-state');
		const saveText = document.getElementById('budget-save-text');
		const chapterCountEl = document.getElementById('budget-chapter-count');
		const itemCountEl = document.getElementById('budget-item-count');
		const versionPill = document.getElementById('budget-version-pill');
		const taxPill = document.getElementById('budget-tax-pill');
		const chaptersList = document.getElementById('budget-chapters-list');
		const emptyState = document.getElementById('budget-empty-state');
		const chapterForm = document.getElementById('chapter-create-form') as HTMLFormElement | null;
		const chapterNameInput = document.getElementById('chapter-name-input') as HTMLInputElement | null;
		const toggleChapterFormBtn = document.getElementById('btn-toggle-chapter-form');
		const cancelChapterBtn = document.getElementById('btn-cancel-chapter');
		const emptyAddChapterBtn = document.getElementById('btn-empty-add-chapter');
		const structureHint = document.getElementById('budget-structure-hint');
		const deleteBudgetBtn = document.getElementById('btn-delete-budget');
		const deleteBudgetConfirm = document.getElementById('budget-delete-confirm');
		const cancelDeleteBudgetBtn = document.getElementById('btn-cancel-delete-budget');
		const confirmDeleteBudgetBtn = document.getElementById('btn-confirm-delete-budget');

		let openCatalogChapterId: string | null = null;
		let openCustomChapterId: string | null = null;
		let editingItemId: string | null = null;
		let confirmDeleteChapterId: string | null = null;
		let saveTimer: ReturnType<typeof setTimeout> | undefined;

		function escapeHtml(value: string): string {
			return String(value)
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
				.replace(/"/g, '&quot;')
				.replace(/'/g, '&#39;');
		}

		function showToast(title: string, message: string) {
			window.dispatchEvent(new CustomEvent('show-toast', { detail: { title, message, type: 'success' } }));
		}

		function sortedChapters(): BudgetChapter[] {
			return [...currentBudget.chapters].sort((a, b) => a.order_index - b.order_index);
		}

		function findChapter(chapterId: string): BudgetChapter | undefined {
			return currentBudget.chapters.find((chapter) => chapter.id === chapterId);
		}

		function findItem(itemId: string): { chapter: BudgetChapter; item: BudgetItem } | null {
			for (const chapter of currentBudget.chapters) {
				const item = chapter.items.find((entry) => entry.id === itemId);
				if (item) return { chapter, item };
			}
			return null;
		}

		function markSaving() {
			saveState?.classList.add('is-saving');
			if (saveText) saveText.textContent = 'Guardando...';
		}

		function markSaved() {
			saveState?.classList.remove('is-saving');
			if (saveText) saveText.textContent = 'Guardado local';
		}

		function saveNow() {
			persistBudget(currentBudget);
			markSaved();
		}

		function scheduleSave() {
			markSaving();
			if (saveTimer) clearTimeout(saveTimer);
			saveTimer = setTimeout(saveNow, 250);
		}

		function updateMeta() {
			const items = allItems(currentBudget);
			if (chapterCountEl) chapterCountEl.textContent = `${currentBudget.chapters.length} ${currentBudget.chapters.length === 1 ? 'capítulo' : 'capítulos'}`;
			if (itemCountEl) itemCountEl.textContent = `${items.length} ${items.length === 1 ? 'partida' : 'partidas'}`;
			if (versionPill) versionPill.textContent = `v${currentBudget.version}`;
			if (taxPill) taxPill.textContent = currentBudget.tax_scheme === 'aiu' ? 'Esquema AIU' : 'Esquema IVA';
			if (structureHint) {
				structureHint.textContent = items.length === 0
					? 'Crea un capítulo y añade partidas desde el catálogo o a medida.'
					: `${currentBudget.chapters.length} capítulos · ${items.length} partidas · edita cantidades y márgenes en línea.`;
			}
		}

		// --- HU-07: configuración fiscal (IVA general / AIU) ---
		const schemeIvaBtn = document.getElementById('tax-scheme-iva');
		const schemeAiuBtn = document.getElementById('tax-scheme-aiu');
		const paramsIva = document.getElementById('tax-params-iva');
		const paramsAiu = document.getElementById('tax-params-aiu');
		const vatIvaInput = document.getElementById('tax-vat-iva') as HTMLInputElement | null;
		const adminInput = document.getElementById('tax-admin') as HTMLInputElement | null;
		const contingencyInput = document.getElementById('tax-contingency') as HTMLInputElement | null;
		const utilityInput = document.getElementById('tax-utility') as HTMLInputElement | null;
		const vatAiuInput = document.getElementById('tax-vat-aiu') as HTMLInputElement | null;
		const breakdownRows = document.getElementById('tax-breakdown-rows');

		function currentTaxTotals() {
			const lineTotals = calcTotals(allItems(currentBudget));
			return calcTax({
				taxScheme: currentBudget.tax_scheme,
				directCost: lineTotals.directCost,
				saleSubtotal: lineTotals.saleTotal,
				adminPercentage: currentBudget.admin_percentage,
				contingencyPercentage: currentBudget.contingency_percentage,
				utilityPercentage: currentBudget.utility_percentage,
				vatPercentage: currentBudget.vat_percentage
			});
		}

		function pushTotals() {
			const tax = currentTaxTotals();
			updateBreakdown(tax);
			window.dispatchEvent(new CustomEvent('budget:totals', { detail: tax }));
		}

		function formatPct(value: number): string {
			return Number.isInteger(value) ? String(value) : value.toFixed(2);
		}

		function taxRowHtml(sign: string, label: string, amount: number, kind: string): string {
			return `<div class="tax-row tax-row-${kind}">
					<span class="tax-row-sign" aria-hidden="true">${sign}</span>
					<span class="tax-row-label">${escapeHtml(label)}</span>
					<span class="tax-row-value">${formatMoney(amount)}</span>
				</div>`;
		}

		function updateBreakdown(tax: ReturnType<typeof calcTax>) {
			if (!breakdownRows) return;
			const vat = formatPct(currentBudget.vat_percentage);

			if (currentBudget.tax_scheme === 'aiu') {
				breakdownRows.innerHTML = [
					taxRowHtml('', 'Costo directo total (CD)', tax.directCost, 'base'),
					taxRowHtml('+', `Administración (${formatPct(currentBudget.admin_percentage)}%)`, tax.adminAmount, 'add'),
					taxRowHtml('+', `Imprevistos (${formatPct(currentBudget.contingency_percentage)}%)`, tax.contingencyAmount, 'add'),
					taxRowHtml('+', `Utilidad (${formatPct(currentBudget.utility_percentage)}%)`, tax.utilityAmount, 'add'),
					taxRowHtml('=', 'Subtotal AIU', tax.subtotal, 'subtotal'),
					taxRowHtml('+', `IVA sobre utilidad (${vat}%)`, tax.taxAmount, 'tax'),
					taxRowHtml('=', 'Total contrato de obra', tax.grandTotal, 'total')
				].join('');
				return;
			}

			breakdownRows.innerHTML = [
				taxRowHtml('', 'Costo directo total (CD)', tax.directCost, 'base'),
				taxRowHtml('+', 'Utilidad / margen', tax.utilityAmount, 'add'),
				taxRowHtml('=', 'Subtotal de venta', tax.subtotal, 'subtotal'),
				taxRowHtml('+', `IVA sobre la venta (${vat}%)`, tax.taxAmount, 'tax'),
				taxRowHtml('=', 'Total propuesta al cliente', tax.grandTotal, 'total')
			].join('');
		}

		function renderTax() {
			const isAiu = currentBudget.tax_scheme === 'aiu';
			schemeIvaBtn?.classList.toggle('active', !isAiu);
			schemeIvaBtn?.setAttribute('aria-pressed', String(!isAiu));
			schemeAiuBtn?.classList.toggle('active', isAiu);
			schemeAiuBtn?.setAttribute('aria-pressed', String(isAiu));
			paramsIva?.classList.toggle('hidden', isAiu);
			paramsAiu?.classList.toggle('hidden', !isAiu);

			if (vatIvaInput && document.activeElement !== vatIvaInput) vatIvaInput.value = String(currentBudget.vat_percentage);
			if (vatAiuInput && document.activeElement !== vatAiuInput) vatAiuInput.value = String(currentBudget.vat_percentage);
			if (adminInput && document.activeElement !== adminInput) adminInput.value = String(currentBudget.admin_percentage);
			if (contingencyInput && document.activeElement !== contingencyInput) contingencyInput.value = String(currentBudget.contingency_percentage);
			if (utilityInput && document.activeElement !== utilityInput) utilityInput.value = String(currentBudget.utility_percentage);

			updateBreakdown(currentTaxTotals());
		}

		function setTaxScheme(scheme: 'iva' | 'aiu') {
			if (currentBudget.tax_scheme === scheme) return;
			currentBudget.tax_scheme = scheme;
			scheduleSave();
			renderTax();
			pushTotals();
		}

		function bindTaxInput(input: HTMLInputElement | null, key: keyof TaxParameters) {
			input?.addEventListener('input', () => {
				const parsed = parseFloat(input.value);
				if (!Number.isFinite(parsed)) return;
				currentBudget[key] = Math.max(0, Math.min(100, parsed));
				scheduleSave();
				renderTax();
				pushTotals();
			});
		}

		schemeIvaBtn?.addEventListener('click', () => setTaxScheme('iva'));
		schemeAiuBtn?.addEventListener('click', () => setTaxScheme('aiu'));
		bindTaxInput(vatIvaInput, 'vat_percentage');
		bindTaxInput(vatAiuInput, 'vat_percentage');
		bindTaxInput(adminInput, 'admin_percentage');
		bindTaxInput(contingencyInput, 'contingency_percentage');
		bindTaxInput(utilityInput, 'utility_percentage');

		function categoryOptions(selected: BudgetCategory): string {
			return (Object.keys(CATEGORY_META) as BudgetCategory[])
				.map((key) => `<option value="${key}"${key === selected ? ' selected' : ''}>${CATEGORY_META[key].label}</option>`)
				.join('');
		}

		function chapterTotals(chapter: BudgetChapter) {
			return calcTotals(chapter.items);
		}

		function itemRow(item: BudgetItem): string {
