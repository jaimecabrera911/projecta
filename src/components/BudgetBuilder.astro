					</div>

					<label class="item-field">
						<span class="field-label">Cant.</span>
						<input class="field-input" type="number" min="0" step="0.01" inputmode="decimal"
							data-field="quantity" value="${item.quantity}"
							aria-label="Cantidad de ${escapeHtml(item.description)}" />
