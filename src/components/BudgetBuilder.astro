		function customItemForm(chapter: BudgetChapter): string {
			return `
				<form class="item-form" data-form="custom-item" data-chapter-id="${chapter.id}" novalidate>
					<div class="item-form-grid">
						<label class="form-field form-field-wide">Descripción *
							<input name="description" type="text" maxlength="140" required minlength="3" autocomplete="off"
								placeholder="Ej. Pañete liso en muros interiores" />
						</label>
						<label class="form-field">Categoría
							<select name="category">${categoryOptions('material')}</select>
						</label>
						<label class="form-field">Unidad
							<input name="unit" type="text" maxlength="12" value="m²" />
						</label>
						<label class="form-field">Cantidad
							<input name="quantity" type="number" min="0" step="0.01" inputmode="decimal" value="1" />
						</label>
						<label class="form-field">Costo unitario
							<input name="unit_cost_internal" type="number" min="0" step="100" inputmode="decimal" placeholder="0" />
						</label>
						<label class="form-field">Margen %
							<input name="margin_percentage" type="number" min="0" max="500" step="1" inputmode="decimal" value="${currentBudget.global_margin_percentage}" />
						</label>
					</div>
					<div class="item-form-actions">
						<button type="button" class="btn-form-cancel" data-action="close-custom">Cancelar</button>
						<button type="submit" class="btn-form-save">Agregar partida</button>
					</div>
				</form>
			`;
		}

		function catalogResultsHtml(query: string): string {
			const term = query.trim().toLowerCase();
			const matches = catalog
				.filter((item) => {
					if (!term) return true;
					return [item.name, item.code ?? '', item.suggested_supplier ?? '', item.unit]
						.join(' ')
						.toLowerCase()
						.includes(term);
				})
				.slice(0, 8);

			if (catalog.length === 0) {
				return `<p class="catalog-message">El catálogo está vacío. <a href="/catalog">Carga la plantilla de insumos</a> para presupuestar más rápido.</p>`;
			}

			if (matches.length === 0) {
				return `<p class="catalog-message">Sin insumos para “${escapeHtml(query)}”. Prueba con otra palabra o crea una partida personalizada.</p>`;
			}

			return matches
				.map((item) => {
					const meta = CATEGORY_META[item.category] ?? CATEGORY_META.material;
					return `
						<button type="button" class="catalog-result" data-action="add-catalog-item" data-catalog-id="${item.id}">
							<span class="catalog-result-main">
								<span class="catalog-result-name">${escapeHtml(item.name)}</span>
								<span class="catalog-result-meta">
									<span class="cat-pill ${meta.className}">${meta.label}</span>
									${item.code ? ` · ${escapeHtml(item.code)}` : ''} · ${escapeHtml(item.unit)}${item.suggested_supplier ? ` · ${escapeHtml(item.suggested_supplier)}` : ''}
								</span>
							</span>
							<span class="catalog-result-cost">${formatMoney(item.unit_cost)}</span>
							<span class="catalog-result-plus" aria-hidden="true">+</span>
						</button>
					`;
				})
				.join('');
		}

		function catalogPanel(chapter: BudgetChapter): string {
			return `
				<div class="catalog-panel" data-panel="catalog" data-chapter-id="${chapter.id}">
					<div class="catalog-panel-head">
						<div class="catalog-search-shell">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<circle cx="11" cy="11" r="8"></circle>
								<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
							</svg>
							<input class="catalog-search-input" type="text" data-catalog-search autocomplete="off"
								placeholder="Buscar por nombre, código o proveedor..." aria-label="Buscar insumo en el catálogo" />
						</div>
						<button type="button" class="btn-close-panel" data-action="close-catalog" aria-label="Cerrar buscador de catálogo">
							<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
								<line x1="18" y1="6" x2="6" y2="18"></line>
								<line x1="6" y1="6" x2="18" y2="18"></line>
							</svg>
						</button>
					</div>
					<div class="catalog-results" data-catalog-results>
						${catalogResultsHtml('')}
					</div>
				</div>
			`;
		}

		function chapterHtml(chapter: BudgetChapter, index: number): string {
			const totals = chapterTotals(chapter);
			const collapsed = Boolean(chapter.collapsed);
			const confirming = confirmDeleteChapterId === chapter.id;
			const isFirst = index === 0;
			const isLast = index === sortedChapters().length - 1;

			const itemsHtml = chapter.items.length === 0
				? `<div class="chapter-empty-items">Este capítulo aún no tiene partidas. Añade una desde el catálogo o créala a medida.</div>`
				: chapter.items.map((item) => (editingItemId === item.id ? editItemForm(item) : itemRow(item))).join('');

			const actionsHtml = confirming
				? `<div class="chapter-confirm">
						<span>¿Eliminar?</span>
						<button type="button" class="btn-danger-sm" data-action="confirm-delete-chapter">Sí</button>
						<button type="button" class="btn-ghost-sm" data-action="cancel-delete-chapter">No</button>
					</div>`
				: `<button type="button" class="icon-btn" data-action="move-up" ${isFirst ? 'disabled' : ''} title="Subir capítulo" aria-label="Subir capítulo ${escapeHtml(chapter.name)}">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="18 15 12 9 6 15"></polyline>
						</svg>
					</button>
					<button type="button" class="icon-btn" data-action="move-down" ${isLast ? 'disabled' : ''} title="Bajar capítulo" aria-label="Bajar capítulo ${escapeHtml(chapter.name)}">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="6 9 12 15 18 9"></polyline>
						</svg>
					</button>
					<button type="button" class="icon-btn icon-btn-danger" data-action="delete-chapter" title="Eliminar capítulo" aria-label="Eliminar capítulo ${escapeHtml(chapter.name)}">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="3 6 5 6 21 6"></polyline>
							<path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
						</svg>
					</button>`;

			return `
				<article class="chapter-card${collapsed ? ' collapsed' : ''}" id="budget-chapter-${chapter.id}" data-chapter-id="${chapter.id}">
					<div class="chapter-head">
						<button type="button" class="chapter-toggle" data-action="toggle-chapter" aria-expanded="${!collapsed}" aria-controls="chapter-body-${chapter.id}">
							<span class="chapter-index">${String(index + 1).padStart(2, '0')}</span>
							<span class="chapter-name-wrap">
								<span class="chapter-name">${escapeHtml(chapter.name)}</span>
								<span class="chapter-meta">${chapter.items.length} ${chapter.items.length === 1 ? 'partida' : 'partidas'}</span>
							</span>
						</button>

						<div class="chapter-head-totals">
							<div class="chapter-total">
								<span>Costo</span>
								<strong data-chapter-cost>${formatMoney(totals.directCost)}</strong>
							</div>
							<div class="chapter-total">
								<span>Venta</span>
								<strong data-chapter-sale>${formatMoney(totals.saleTotal)}</strong>
							</div>
						</div>

						<div class="chapter-actions">${actionsHtml}</div>
					</div>

					<div class="chapter-body-wrap" id="chapter-body-${chapter.id}">
						<div class="chapter-body-inner">
							<div class="chapter-body">
								<div class="items-head" aria-hidden="true">
									<span>Partida</span>
									<span>Cant.</span>
									<span>Costo Unit.</span>
									<span>Margen</span>
									<span>Venta Unit.</span>
									<span>Subtotal Cliente</span>
									<span></span>
								</div>

								${itemsHtml}

								<div class="chapter-add-actions">
									<button type="button" class="btn-add-from-catalog" data-action="open-catalog">
										<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
											<circle cx="11" cy="11" r="8"></circle>
											<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
										</svg>
										Partida desde Catálogo
									</button>
									<button type="button" class="btn-add-custom" data-action="open-custom">
										+ Partida Personalizada
									</button>
								</div>

								${openCatalogChapterId === chapter.id ? catalogPanel(chapter) : ''}
								${openCustomChapterId === chapter.id ? customItemForm(chapter) : ''}
							</div>
						</div>
					</div>
				</article>
			`;
		}

		function renderChapters() {
			if (!chaptersList) return;
			const chapters = sortedChapters();

			emptyState?.classList.toggle('hidden', chapters.length > 0);
			chaptersList.innerHTML = chapters.map((chapter, index) => chapterHtml(chapter, index)).join('');

			updateMeta();
			pushTotals();

			if (openCatalogChapterId) {
				const search = chaptersList.querySelector<HTMLInputElement>('[data-catalog-search]');
				search?.focus();
			}
			if (openCustomChapterId) {
				const description = chaptersList.querySelector<HTMLInputElement>('form[data-form="custom-item"] input[name="description"]');
				description?.focus();
			}
		}

		function updateRowComputed(row: HTMLElement, item: BudgetItem) {
			const line = calcLine(item);
			const direct = row.querySelector('[data-computed="direct"]');
			const unitSale = row.querySelector('[data-computed="unit-sale"]');
			const sale = row.querySelector('[data-computed="sale"]');
			if (direct) direct.textContent = formatMoney(line.directSubtotal);
			if (unitSale) unitSale.textContent = formatMoney(line.unitSalePrice);
			if (sale) sale.textContent = formatMoney(line.saleSubtotal);
		}

		function updateChapterHeader(chapter: BudgetChapter) {
			const chapterEl = document.getElementById(`budget-chapter-${chapter.id}`);
			if (!chapterEl) return;
			const totals = chapterTotals(chapter);
			const costEl = chapterEl.querySelector('[data-chapter-cost]');
			const saleEl = chapterEl.querySelector('[data-chapter-sale]');
			if (costEl) costEl.textContent = formatMoney(totals.directCost);
			if (saleEl) saleEl.textContent = formatMoney(totals.saleTotal);
		}

		function openChapterForm() {
			chapterForm?.classList.remove('hidden');
			toggleChapterFormBtn?.classList.add('hidden');
			chapterNameInput?.focus();
		}

		function closeChapterForm() {
			chapterForm?.classList.add('hidden');
			toggleChapterFormBtn?.classList.remove('hidden');
			if (chapterForm) chapterForm.reset();
		}

		toggleChapterFormBtn?.addEventListener('click', openChapterForm);
		emptyAddChapterBtn?.addEventListener('click', openChapterForm);
		cancelChapterBtn?.addEventListener('click', closeChapterForm);

		deleteBudgetBtn?.addEventListener('click', () => {
			deleteBudgetBtn.classList.add('hidden');
			deleteBudgetConfirm?.classList.remove('hidden');
		});

		cancelDeleteBudgetBtn?.addEventListener('click', () => {
			deleteBudgetConfirm?.classList.add('hidden');
			deleteBudgetBtn?.classList.remove('hidden');
		});

		confirmDeleteBudgetBtn?.addEventListener('click', () => {
			deleteBudget(currentBudget.id);
			window.location.href = '/budgets';
		});

		chapterForm?.addEventListener('submit', (event) => {
			event.preventDefault();
			const name = chapterNameInput?.value.trim() ?? '';
			if (name.length < 3) {
				showToast('Nombre incompleto', 'Escribe un nombre de capítulo de al menos 3 caracteres.');
				chapterNameInput?.focus();
				return;
			}

			const maxOrder = currentBudget.chapters.reduce((max, chapter) => Math.max(max, chapter.order_index), 0);
			const chapter: BudgetChapter = {
				id: uid('bch'),
				order_index: maxOrder + 1,
				name,
				items: []
			};
			currentBudget.chapters.push(chapter);
			persistBudget(currentBudget);
			closeChapterForm();
			renderChapters();
			showToast('Capítulo creado', `“${name}” está listo para recibir partidas.`);
		});

		titleInput?.addEventListener('input', () => {
			currentBudget.title = titleInput.value;
			if (breadcrumbTitle) breadcrumbTitle.textContent = titleInput.value || 'Constructor';
			scheduleSave();
		});

		globalMarginInput?.addEventListener('input', () => {
			const margin = parseFloat(globalMarginInput.value);
			if (Number.isFinite(margin)) {
				currentBudget.global_margin_percentage = Math.max(0, Math.min(500, margin));
				scheduleSave();
			}
		});

		applyMarginBtn?.addEventListener('click', () => {
			const margin = parseFloat(globalMarginInput?.value ?? '');
			if (!Number.isFinite(margin)) {
				showToast('Margen inválido', 'Escribe un porcentaje de margen válido.');
				globalMarginInput?.focus();
				return;
			}
			const safeMargin = Math.max(0, Math.min(500, margin));
			applyGlobalMargin(currentBudget, safeMargin);
			persistBudget(currentBudget);
			renderChapters();
			showToast('Margen aplicado', `Todas las partidas usan ahora ${safeMargin}% de margen.`);
		});

		chaptersList?.addEventListener('click', (event) => {
			const target = (event.target as HTMLElement).closest<HTMLElement>('[data-action]');
			if (!target) return;

			const action = target.dataset.action;
			const chapterEl = target.closest<HTMLElement>('[data-chapter-id]');
			const chapterId = chapterEl?.dataset.chapterId ?? '';
			const itemEl = target.closest<HTMLElement>('[data-item-id]');
			const itemId = itemEl?.dataset.itemId ?? '';

			if (action === 'toggle-chapter') {
				const chapter = findChapter(chapterId);
				if (!chapter) return;
				chapter.collapsed = !chapter.collapsed;
				chapterEl?.classList.toggle('collapsed', chapter.collapsed);
				target.setAttribute('aria-expanded', String(!chapter.collapsed));
				scheduleSave();
				return;
			}

			if (action === 'move-up' || action === 'move-down') {
				const chapters = sortedChapters();
				const index = chapters.findIndex((chapter) => chapter.id === chapterId);
				const swapWith = action === 'move-up' ? index - 1 : index + 1;
				if (index < 0 || swapWith < 0 || swapWith >= chapters.length) return;
				const current = chapters[index];
				const other = chapters[swapWith];
				const temp = current.order_index;
				current.order_index = other.order_index;
				other.order_index = temp;
				persistBudget(currentBudget);
				renderChapters();
				return;
			}

			if (action === 'delete-chapter') {
				confirmDeleteChapterId = chapterId;
				renderChapters();
				return;
			}

			if (action === 'cancel-delete-chapter') {
				confirmDeleteChapterId = null;
				renderChapters();
				return;
			}

			if (action === 'confirm-delete-chapter') {
				const chapter = findChapter(chapterId);
				if (!chapter) return;
				currentBudget.chapters = currentBudget.chapters.filter((entry) => entry.id !== chapterId);
				confirmDeleteChapterId = null;
				persistBudget(currentBudget);
				renderChapters();
				showToast('Capítulo eliminado', `“${chapter.name}” y sus partidas se quitaron del presupuesto.`);
				return;
			}

			if (action === 'open-catalog') {
				openCatalogChapterId = chapterId;
				openCustomChapterId = null;
				editingItemId = null;
				renderChapters();
				return;
			}

			if (action === 'close-catalog') {
				openCatalogChapterId = null;
				renderChapters();
				return;
			}

			if (action === 'open-custom') {
				openCustomChapterId = chapterId;
				openCatalogChapterId = null;
				editingItemId = null;
				renderChapters();
				return;
			}

			if (action === 'close-custom') {
				openCustomChapterId = null;
				renderChapters();
				return;
			}

			if (action === 'add-catalog-item') {
				const catalogItem = catalog.find((entry) => entry.id === target.dataset.catalogId);
				const chapter = findChapter(chapterId);
				if (!catalogItem || !chapter) return;
				const item: BudgetItem = {
					id: uid('bit'),
					chapter_id: chapter.id,
					catalog_item_id: catalogItem.id,
					description: catalogItem.name,
					category: catalogItem.category,
					unit: catalogItem.unit,
					quantity: 1,
					unit_cost_internal: catalogItem.unit_cost,
					margin_percentage: currentBudget.global_margin_percentage
				};
				chapter.items.push(item);
				openCatalogChapterId = null;
				persistBudget(currentBudget);
				renderChapters();
				document.getElementById(`budget-item-${item.id}`)?.scrollIntoView({ block: 'center', behavior: 'smooth' });
				showToast('Partida añadida', `“${catalogItem.name}” se agregó a ${chapter.name}.`);
				return;
			}

			if (action === 'edit-item') {
				editingItemId = itemId;
				renderChapters();
				return;
			}

			if (action === 'cancel-edit-item') {
				editingItemId = null;
				renderChapters();
				return;
			}

			if (action === 'delete-item') {
				itemEl?.classList.add('confirming');
				return;
			}

			if (action === 'cancel-delete-item') {
				itemEl?.classList.remove('confirming');
				return;
			}

			if (action === 'confirm-delete-item') {
				const found = findItem(itemId);
				if (!found) return;
				found.chapter.items = found.chapter.items.filter((entry) => entry.id !== itemId);
				persistBudget(currentBudget);
				renderChapters();
				showToast('Partida eliminada', `“${found.item.description}” se quitó del presupuesto.`);
			}
		});

		chaptersList?.addEventListener('input', (event) => {
			const input = event.target as HTMLInputElement;

			if (input.matches('[data-catalog-search]')) {
				const panel = input.closest<HTMLElement>('[data-panel="catalog"]');
				const results = panel?.querySelector('[data-catalog-results]');
				if (results) results.innerHTML = catalogResultsHtml(input.value);
				return;
			}

			const field = input.dataset.field;
			if (!field) return;

			const itemEl = input.closest<HTMLElement>('[data-item-id]');
			const found = findItem(itemEl?.dataset.itemId ?? '');
			if (!itemEl || !found) return;

			const value = parseFloat(input.value);
			const safe = Number.isFinite(value) ? Math.max(0, value) : 0;

			if (field === 'quantity') found.item.quantity = safe;
			else if (field === 'unit_cost_internal') found.item.unit_cost_internal = safe;
			else if (field === 'margin_percentage') found.item.margin_percentage = Math.min(500, safe);
			else return;

			updateRowComputed(itemEl, found.item);
			updateChapterHeader(found.chapter);
			pushTotals();
			scheduleSave();
		});

		chaptersList?.addEventListener('submit', (event) => {
			event.preventDefault();
			const form = event.target as HTMLFormElement;
			const formType = form.dataset.form;

			if (formType === 'custom-item') {
				const chapter = findChapter(form.dataset.chapterId ?? '');
				if (!chapter) return;
				const data = new FormData(form);
				const description = String(data.get('description') ?? '').trim();
				const category = String(data.get('category') ?? 'material') as BudgetCategory;
				const unit = String(data.get('unit') ?? '').trim() || 'un';
				const quantity = Math.max(0, parseFloat(String(data.get('quantity') ?? '0')) || 0);
				const cost = Math.max(0, parseFloat(String(data.get('unit_cost_internal') ?? '0')) || 0);
				const margin = Math.max(0, Math.min(500, parseFloat(String(data.get('margin_percentage') ?? '0')) || 0));

				if (description.length < 3) {
					showToast('Descripción incompleta', 'Escribe una descripción de al menos 3 caracteres.');
					return;
				}
				if (quantity <= 0 || cost <= 0) {
					showToast('Datos incompletos', 'La cantidad y el costo unitario deben ser mayores a cero.');
					return;
				}

				const item: BudgetItem = {
					id: uid('bit'),
					chapter_id: chapter.id,
					description,
					category,
					unit,
					quantity,
					unit_cost_internal: cost,
					margin_percentage: margin
				};
				chapter.items.push(item);
				openCustomChapterId = null;
				persistBudget(currentBudget);
				renderChapters();
				document.getElementById(`budget-item-${item.id}`)?.scrollIntoView({ block: 'center', behavior: 'smooth' });
				showToast('Partida creada', `“${description}” se agregó a ${chapter.name}.`);
				return;
			}

			if (formType === 'edit-item') {
				const found = findItem(form.dataset.itemId ?? '');
				if (!found) return;
				const data = new FormData(form);
				const description = String(data.get('description') ?? '').trim();
				const unit = String(data.get('unit') ?? '').trim() || 'un';
				const quantity = Math.max(0, parseFloat(String(data.get('quantity') ?? '0')) || 0);
				const cost = Math.max(0, parseFloat(String(data.get('unit_cost_internal') ?? '0')) || 0);
				const margin = Math.max(0, Math.min(500, parseFloat(String(data.get('margin_percentage') ?? '0')) || 0));

				if (description.length < 3) {
					showToast('Descripción incompleta', 'Escribe una descripción de al menos 3 caracteres.');
					return;
				}

				found.item.description = description;
				found.item.category = String(data.get('category') ?? 'material') as BudgetCategory;
				found.item.unit = unit;
				found.item.quantity = quantity;
				found.item.unit_cost_internal = cost;
				found.item.margin_percentage = margin;
				editingItemId = null;
				persistBudget(currentBudget);
				renderChapters();
				showToast('Partida actualizada', `“${description}” quedó guardada.`);
			}
		});

		// Initial paint
		if (titleInput) titleInput.value = currentBudget.title;
		if (breadcrumbTitle) breadcrumbTitle.textContent = currentBudget.title || 'Constructor';
		if (clientLine) {
			clientLine.textContent = currentBudget.client_name
				? `Cliente: ${currentBudget.client_name}`
				: 'Sin cliente asignado';
		}
		if (globalMarginInput) globalMarginInput.value = String(currentBudget.global_margin_percentage);

		const previewLink = document.getElementById('btn-preview-proposal') as HTMLAnchorElement | null;
		if (previewLink) previewLink.href = `/proposals/view?id=${encodeURIComponent(currentBudget.id)}`;

		renderTax();
		renderChapters();
		// La barra de totales registra su listener al final del bundle: reenviamos tras el primer tick.
		setTimeout(pushTotals, 0);
	}
</script>
