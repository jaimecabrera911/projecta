---
// src/components/daily-logs/DailyLogFeed.astro
// HU-17: Muro Social Estilo Feed de Bitácora Diaria (Cronológico Inverso con Clima, Personal y Galería Lightbox).
import { renderIconSvg } from '../../lib/icons';
---

<div id="daily-logs-feed-container" class="daily-feed-wrapper" aria-label="Muro de publicaciones de bitácora">
	<!-- Barra de Filtros de Privacidad y Simulación (HU-18) -->
	<div class="feed-privacy-toolbar" id="feed-privacy-toolbar">
		<div class="privacy-filters-left">
			<span class="toolbar-label">
				<span style="display: flex; align-items: center;" set:html={renderIconSvg('filter', { size: 14 })}></span>
				<span>Filtrar Muro:</span>
			</span>
			<div class="privacy-chips-group" role="tablist" aria-label="Filtro de privacidad de bitácoras">
				<button
					type="button"
					role="tab"
					aria-selected="true"
					class="feed-filter-chip active"
					id="filter-chip-all"
					data-filter="all"
				>
					<span>Todas</span>
					<span class="chip-count" id="chip-count-all">0</span>
				</button>
				<button
					type="button"
					role="tab"
					aria-selected="false"
					class="feed-filter-chip client"
					id="filter-chip-client"
					data-filter="client"
				>
					<span style="display: flex; align-items: center;" set:html={renderIconSvg('eye', { size: 14 })}></span>
					<span>Públicas Cliente</span>
					<span class="chip-count" id="chip-count-client">0</span>
				</button>
				<button
					type="button"
					role="tab"
					aria-selected="false"
					class="feed-filter-chip internal"
					id="filter-chip-internal"
					data-filter="internal"
				>
					<span style="display: flex; align-items: center;" set:html={renderIconSvg('lock', { size: 14 })}></span>
					<span>Confidenciales</span>
					<span class="chip-count" id="chip-count-internal">0</span>
				</button>
			</div>
		</div>

		<div class="privacy-simulation-right">
			<button
				type="button"
				id="btn-simulate-client-portal"
				class="btn-simulate-client"
				title="Simular exactamente la vista que tendrá el cliente en su portal web (HU-19)"
			>
				<span style="display: flex; align-items: center;" set:html={renderIconSvg('eye', { size: 15 })}></span>
				<span id="simulate-client-btn-text">Ver como Cliente</span>
			</button>
			<a
				href="/portal/portal_restrepo_001"
				target="_blank"
				rel="noopener noreferrer"
				id="btn-open-real-portal"
				class="btn-open-real-portal"
				title="Abrir el Portal Web Real del Cliente (Magic Link) en una pestaña nueva"
			>
				<span style="display: flex; align-items: center;" set:html={renderIconSvg('externalLink', { size: 15 })}></span>
				<span>Portal Web Real ↗</span>
			</a>
		</div>
	</div>

	<!-- Banner informativo cuando el modo de simulación cliente está activo -->
	<div id="client-simulation-banner" class="client-simulation-notice hidden" role="status">
		<div class="sim-notice-left">
			<span class="sim-notice-icon" set:html={renderIconSvg('eye', { size: 20 })}></span>
			<div>
				<strong class="sim-notice-title">Modo Simulación: Vista del Portal del Cliente Activa (HU-18 / HU-19)</strong>
				<p class="sim-notice-desc">Estás visualizando únicamente las entradas con <code>visible_to_client = true</code>. Las notas técnicas y fotos confidenciales están completamente bloqueadas de esta vista.</p>
			</div>
		</div>
		<div class="sim-notice-actions">
			<a
				href="/portal/portal_restrepo_001"
				target="_blank"
				rel="noopener noreferrer"
				class="btn-notice-open-portal"
			>
				Abrir Portal Web Real ↗
			</a>
			<button type="button" id="btn-exit-simulation" class="btn-exit-sim">
				Salir de Vista Cliente
			</button>
		</div>
	</div>

	<!-- Feed Stream (Inyectado dinámicamente) -->
	<div id="daily-logs-stream" class="feed-cards-stream"></div>

	<!-- Estado Vacío -->
	<div id="daily-logs-empty-state" class="feed-empty-notice hidden">
		<div class="empty-icon-wrap" aria-hidden="true">
			<Fragment set:html={renderIconSvg('camera', { size: 36 })} />
		</div>
		<h4 class="empty-title">Aún no hay publicaciones en la bitácora de esta obra</h4>
		<p class="empty-desc">Publica el primer reporte de la jornada utilizando el formulario superior con el estado del clima y fotos de avance.</p>
	</div>
</div>

<!-- Lightbox Modal para Fotografías del Muro -->
<div id="feed-photo-lightbox" class="feed-lightbox-backdrop hidden" aria-hidden="true">
	<div class="feed-lightbox-box">
		<button id="btn-close-feed-lightbox" type="button" class="btn-lightbox-exit" aria-label="Cerrar visor" style="display: flex; align-items: center; justify-content: center;">
			<Fragment set:html={renderIconSvg('x', { size: 18 })} />
		</button>
		<img id="feed-lightbox-img" src="" alt="Fotografía de avance ampliada" class="feed-lightbox-image" />
		<div id="feed-lightbox-caption" class="feed-lightbox-caption-text"></div>
	</div>
</div>

<style>
	.daily-feed-wrapper {
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	/* Barra de Herramientas de Privacidad HU-18 */
	.feed-privacy-toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.75rem 1rem;
		background-color: #FFFFFF;
		border: 1px solid #E2E8F0;
		border-radius: 0.75rem;
		box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
		flex-wrap: wrap;
	}

	.privacy-filters-left {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.toolbar-label {
		font-size: 0.75rem;
		font-weight: 800;
		color: #64748B;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}

	.privacy-chips-group {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		flex-wrap: wrap;
	}

	.feed-filter-chip {
		min-height: 38px;
		padding: 0.35rem 0.75rem;
		border-radius: 9999px;
		border: 1px solid #CBD5E1;
		background-color: #F8FAFC;
		color: #475569;
		font-size: 0.75rem;
		font-weight: 700;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		cursor: pointer;
		user-select: none;
		transition: all 0.15s ease;
	}

	.feed-filter-chip:hover {
		background-color: #F1F5F9;
		border-color: #94A3B8;
		color: #0F172A;
	}

	.feed-filter-chip.active {
		background-color: #0F172A;
		color: #FFFFFF;
		border-color: #0F172A;
	}

	.feed-filter-chip.active.client {
		background-color: #059669;
		border-color: #059669;
		color: #FFFFFF;
	}

	.feed-filter-chip.active.internal {
		background-color: #D97706;
		border-color: #D97706;
		color: #FFFFFF;
	}

	.chip-count {
		font-size: 0.6875rem;
		font-weight: 800;
		padding: 0.1rem 0.4rem;
		border-radius: 9999px;
		background-color: rgba(0, 0, 0, 0.08);
	}

	.feed-filter-chip.active .chip-count {
		background-color: rgba(255, 255, 255, 0.25);
		color: #FFFFFF;
	}

	.privacy-simulation-right {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.btn-open-real-portal {
		min-height: 38px;
		padding: 0.35rem 0.85rem;
		border-radius: 0.5rem;
		border: 1.5px solid #0F172A;
		background-color: #0F172A;
		color: #F8FAFC;
		font-size: 0.75rem;
		font-weight: 800;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		text-decoration: none;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.btn-open-real-portal:hover {
		background-color: #1E293B;
		color: #FFFFFF;
		box-shadow: 0 2px 6px rgba(15, 23, 42, 0.15);
	}

	.sim-notice-actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.btn-notice-open-portal {
		min-height: 38px;
		padding: 0 0.85rem;
		border-radius: 0.5rem;
		border: 1px solid #059669;
		background-color: #059669;
		color: #FFFFFF;
		font-size: 0.75rem;
		font-weight: 800;
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		white-space: nowrap;
		transition: all 0.15s ease;
	}

	.btn-notice-open-portal:hover {
		background-color: #047857;
	}

	.btn-simulate-client {
		min-height: 38px;
		padding: 0.35rem 0.85rem;
		border-radius: 0.5rem;
		border: 1.5px solid #10B981;
		background-color: #ECFDF5;
		color: #047857;
		font-size: 0.75rem;
		font-weight: 800;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.btn-simulate-client:hover {
		background-color: #D1FAE5;
		border-color: #059669;
	}

	.btn-simulate-client.active-sim {
		background-color: #10B981;
		color: #FFFFFF;
	}

	/* Banner Informativo de Simulación */
	.client-simulation-notice {
		background-color: #ECFDF5;
		border: 1.5px solid #10B981;
		border-radius: 0.75rem;
		padding: 0.875rem 1.25rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.sim-notice-left {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		flex: 1;
		min-width: 0;
	}

	.sim-notice-icon {
		color: #059669;
		display: flex;
		align-items: center;
		flex-shrink: 0;
		margin-top: 2px;
	}

	.sim-notice-title {
		font-size: 0.875rem;
		font-weight: 800;
		color: #065F46;
		display: block;
	}

	.sim-notice-desc {
		font-size: 0.75rem;
		color: #047857;
		margin: 0.2rem 0 0 0;
		line-height: 1.4;
	}

	.sim-notice-desc code {
		font-family: monospace;
		background-color: #D1FAE5;
		padding: 0.1rem 0.3rem;
		border-radius: 3px;
	}

	.btn-exit-sim {
		min-height: 38px;
		padding: 0 0.85rem;
		border-radius: 0.5rem;
		border: 1px solid #059669;
		background-color: #FFFFFF;
		color: #065F46;
		font-size: 0.75rem;
		font-weight: 800;
		cursor: pointer;
		white-space: nowrap;
		transition: all 0.15s ease;
	}

	.btn-exit-sim:hover {
		background-color: #D1FAE5;
	}

	.feed-cards-stream {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	:global(.daily-log-card) {
		background-color: #FFFFFF;
		border: 1px solid #E2E8F0;
		border-radius: 1rem;
		box-shadow: 0 1px 4px rgba(15, 23, 42, 0.04);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		transition: box-shadow 0.15s ease, border-color 0.15s ease;
	}

	:global(.daily-log-card.confidential-card) {
		background-color: #FFFDF9;
		border: 1.5px solid #FDE68A;
	}

	:global(.daily-log-card:hover) {
		border-color: #CBD5E1;
		box-shadow: 0 6px 16px rgba(15, 23, 42, 0.08);
	}

	:global(.daily-log-card.confidential-card:hover) {
		border-color: #F59E0B;
	}

	:global(.log-card-header) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1rem 1.5rem;
		background-color: #F8FAFC;
		border-bottom: 1px solid #E2E8F0;
		gap: 1rem;
		flex-wrap: wrap;
	}

	:global(.log-header-left) {
		display: flex;
		align-items: center;
		gap: 0.875rem;
		flex-wrap: wrap;
	}

	:global(.log-date-heading) {
		font-size: 1.0625rem;
		font-weight: 800;
		color: #0F172A;
		margin: 0;
	}

	:global(.weather-badge) {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.75rem;
		font-weight: 800;
		padding: 0.2rem 0.65rem;
		border-radius: 9999px;
	}

	:global(.weather-badge.sunny) {
		background-color: #FEF3C7;
		color: #B45309;
		border: 1px solid #FDE68A;
	}

	:global(.weather-badge.rainy) {
		background-color: #E0F2FE;
		color: #0369A1;
		border: 1px solid #BAE6FD;
	}

	:global(.weather-badge.cloudy) {
		background-color: #F1F5F9;
		color: #334155;
		border: 1px solid #E2E8F0;
	}

	:global(.downtime-badge) {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.75rem;
		font-weight: 800;
		background-color: #FEF3C7;
		color: #92400E;
		border: 1px solid #FCD34D;
		padding: 0.2rem 0.65rem;
		border-radius: 9999px;
	}

	:global(.workers-badge) {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.75rem;
		font-weight: 700;
		background-color: #FFFFFF;
		border: 1px solid #CBD5E1;
		color: #0F172A;
		padding: 0.2rem 0.6rem;
		border-radius: 9999px;
	}

	:global(.privacy-badge) {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.75rem;
		font-weight: 800;
		padding: 0.2rem 0.65rem;
		border-radius: 9999px;
	}

	:global(.privacy-badge.client) {
		background-color: #ECFDF5;
		color: #047857;
		border: 1px solid #A7F3D0;
	}

	:global(.privacy-badge.internal) {
		background-color: #FEF3C7;
		color: #B45309;
		border: 1px solid #FCD34D;
	}

	:global(.btn-toggle-card-privacy) {
		min-height: 36px;
		padding: 0 0.65rem;
		border-radius: 0.5rem;
		border: 1px solid #CBD5E1;
		background-color: #FFFFFF;
		color: #475569;
		font-size: 0.75rem;
		font-weight: 700;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		cursor: pointer;
		user-select: none;
		transition: all 0.15s ease;
	}

	:global(.btn-toggle-card-privacy:hover) {
		background-color: #F8FAFC;
		border-color: #94A3B8;
		color: #0F172A;
	}

	:global(.btn-toggle-card-privacy.to-client:hover) {
		background-color: #ECFDF5;
		border-color: #10B981;
		color: #047857;
	}

	:global(.btn-toggle-card-privacy.to-internal:hover) {
		background-color: #FFFBEB;
		border-color: #F59E0B;
		color: #B45309;
	}

	:global(.log-header-actions) {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	:global(.btn-export-pdf) {
		min-height: 38px;
		padding: 0.35rem 0.85rem;
		border-radius: 0.5rem;
		border: 1.5px solid #CBD5E1;
		background-color: #FFFFFF;
		color: #0F172A;
		font-size: 0.75rem;
		font-weight: 700;
		display: flex;
		align-items: center;
		gap: 0.4rem;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	:global(.btn-export-pdf:hover) {
		background-color: #FFF7ED;
		border-color: #F97316;
		color: #F97316;
	}

	:global(.btn-delete-log) {
		width: 38px;
		height: 38px;
		border-radius: 0.375rem;
		border: 1px solid transparent;
		background: transparent;
		color: #94A3B8;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: all 0.15s ease;
		flex-shrink: 0;
	}

	:global(.btn-delete-log:hover) {
		background-color: #FEE2E2;
		color: #DC2626;
		border-color: #FCA5A5;
	}

	:global(.log-card-body) {
		padding: 1.25rem 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 1.125rem;
	}

	:global(.log-author-row) {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	:global(.author-avatar-circle) {
		width: 38px;
		height: 38px;
		border-radius: 50%;
		background-color: #0F172A;
		color: #FFFFFF;
		font-size: 0.8125rem;
		font-weight: 800;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	:global(.author-info-col) {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}

	:global(.author-name-text) {
		font-size: 0.875rem;
		font-weight: 800;
		color: #0F172A;
	}

	:global(.author-role-sub) {
		font-size: 0.6875rem;
		color: #64748B;
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}

	:global(.log-notes-paragraph) {
		font-size: 0.9375rem;
		color: #334155;
		line-height: 1.55;
		margin: 0;
		white-space: pre-line;
	}

	/* Bloque de actividades vinculadas del cronograma */
	:global(.log-tasks-progress-strip) {
		background-color: #F8FAFC;
		border: 1px solid #E2E8F0;
		border-radius: 0.625rem;
		padding: 0.75rem 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	:global(.tasks-strip-label) {
		font-size: 0.75rem;
		font-weight: 800;
		color: #475569;
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	:global(.tasks-chips-flow) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	:global(.task-sync-badge) {
		background-color: #FFFFFF;
		border: 1px solid #CBD5E1;
		color: #0F172A;
		font-size: 0.75rem;
		padding: 0.35rem 0.65rem;
		border-radius: 0.5rem;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	:global(.task-sync-badge.done) {
		background-color: #ECFDF5;
		border-color: #A7F3D0;
		color: #065F46;
	}

	:global(.task-sync-badge-note) {
		display: block;
		font-size: 0.6875rem;
		color: #64748B;
		margin-top: 0.15rem;
		font-style: italic;
	}

	/* Galería de fotos del reporte */
	:global(.log-photos-gallery-grid) {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		gap: 0.875rem;
		margin-top: 0.25rem;
	}

	:global(.log-photo-item-card) {
		border-radius: 0.625rem;
		overflow: hidden;
		border: 1px solid #E2E8F0;
		background-color: #0F172A;
		display: flex;
		flex-direction: column;
		cursor: pointer;
		position: relative;
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}

	:global(.log-photo-item-card:hover) {
		transform: translateY(-2px);
		box-shadow: 0 6px 14px rgba(15, 23, 42, 0.12);
	}

	:global(.log-photo-img-box) {
		width: 100%;
		height: 140px;
		overflow: hidden;
		background-color: #0F172A;
	}

	:global(.log-photo-img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.2s ease;
	}

	:global(.log-photo-item-card:hover .log-photo-img) {
		transform: scale(1.05);
	}

	:global(.log-photo-caption-bar) {
		padding: 0.5rem 0.75rem;
		background-color: #FFFFFF;
		font-size: 0.75rem;
		font-weight: 700;
		color: #1E293B;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* Estado Vacío */
	.feed-empty-notice {
		padding: 3.5rem 1.5rem;
		text-align: center;
		background-color: #FFFFFF;
		border: 1px dashed #CBD5E1;
		border-radius: 1rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	.empty-icon-wrap {
		width: 64px;
		height: 64px;
		border-radius: 50%;
