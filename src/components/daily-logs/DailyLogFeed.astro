---
// src/components/daily-logs/DailyLogFeed.astro
// HU-17: Muro Social Estilo Feed de Bitácora Diaria (Cronológico Inverso con Clima, Personal y Galería Lightbox).
---

<div id="daily-logs-feed-container" class="daily-feed-wrapper" aria-label="Muro de publicaciones de bitácora">
	<!-- Feed Stream (Inyectado dinámicamente) -->
	<div id="daily-logs-stream" class="feed-cards-stream"></div>

	<!-- Estado Vacío -->
	<div id="daily-logs-empty-state" class="feed-empty-notice hidden">
		<div class="empty-icon-wrap" aria-hidden="true">
			<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
				<circle cx="12" cy="13" r="3"></circle>
			</svg>
		</div>
		<h4 class="empty-title">Aún no hay publicaciones en la bitácora de esta obra</h4>
		<p class="empty-desc">Publica el primer reporte de la jornada utilizando el formulario superior con el estado del clima y fotos de avance.</p>
	</div>
</div>

<!-- Lightbox Modal para Fotografías del Muro -->
<div id="feed-photo-lightbox" class="feed-lightbox-backdrop hidden" aria-hidden="true">
	<div class="feed-lightbox-box">
		<button id="btn-close-feed-lightbox" type="button" class="btn-lightbox-exit" aria-label="Cerrar visor">✕</button>
		<img id="feed-lightbox-img" src="" alt="Fotografía de avance ampliada" class="feed-lightbox-image" />
		<div id="feed-lightbox-caption" class="feed-lightbox-caption-text"></div>
	</div>
</div>

<style>
	.daily-feed-wrapper {
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.feed-cards-stream {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	:global(.daily-log-card) {
		background-color: #FFFFFF;
		border: 1px solid #E2E8F0;
		border-radius: 1rem;
		box-shadow: 0 1px 4px rgba(15, 23, 42, 0.04);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		transition: box-shadow 0.15s ease, border-color 0.15s ease;
	}

	:global(.daily-log-card:hover) {
		border-color: #CBD5E1;
		box-shadow: 0 6px 16px rgba(15, 23, 42, 0.08);
	}

	:global(.log-card-header) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1rem 1.5rem;
		background-color: #F8FAFC;
		border-bottom: 1px solid #E2E8F0;
		gap: 1rem;
		flex-wrap: wrap;
	}

	:global(.log-header-left) {
		display: flex;
		align-items: center;
		gap: 0.875rem;
		flex-wrap: wrap;
	}

	:global(.log-date-heading) {
		font-size: 1.0625rem;
		font-weight: 800;
		color: #0F172A;
		margin: 0;
	}

	:global(.weather-badge) {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.75rem;
		font-weight: 800;
		padding: 0.2rem 0.65rem;
		border-radius: 9999px;
	}

	:global(.weather-badge.sunny) {
		background-color: #FEF3C7;
		color: #B45309;
		border: 1px solid #FDE68A;
	}

	:global(.weather-badge.rainy) {
		background-color: #E0F2FE;
		color: #0369A1;
		border: 1px solid #BAE6FD;
	}

	:global(.weather-badge.cloudy) {
		background-color: #F1F5F9;
		color: #334155;
		border: 1px solid #E2E8F0;
	}

	:global(.workers-badge) {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.75rem;
		font-weight: 700;
		background-color: #FFFFFF;
		border: 1px solid #CBD5E1;
		color: #0F172A;
		padding: 0.2rem 0.6rem;
		border-radius: 9999px;
	}

	:global(.btn-delete-log) {
		width: 38px;
		height: 38px;
		border-radius: 0.375rem;
		border: 1px solid transparent;
		background: transparent;
		color: #94A3B8;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: all 0.15s ease;
		flex-shrink: 0;
	}

	:global(.btn-delete-log:hover) {
		background-color: #FEE2E2;
		color: #DC2626;
		border-color: #FCA5A5;
	}

	:global(.log-card-body) {
		padding: 1.25rem 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 1.125rem;
	}

	:global(.log-author-row) {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	:global(.author-avatar-circle) {
		width: 38px;
		height: 38px;
		border-radius: 50%;
		background-color: #0F172A;
		color: #FFFFFF;
		font-size: 0.8125rem;
		font-weight: 800;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	:global(.author-info-col) {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}

	:global(.author-name-text) {
		font-size: 0.875rem;
		font-weight: 800;
		color: #0F172A;
	}

	:global(.author-role-sub) {
		font-size: 0.6875rem;
		color: #64748B;
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}

	:global(.log-notes-paragraph) {
		font-size: 0.9375rem;
		color: #334155;
		line-height: 1.55;
		margin: 0;
		white-space: pre-line;
	}

	/* Galería de fotos del reporte */
	:global(.log-photos-gallery-grid) {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		gap: 0.875rem;
		margin-top: 0.25rem;
	}

	:global(.log-photo-item-card) {
		border-radius: 0.625rem;
		overflow: hidden;
		border: 1px solid #E2E8F0;
		background-color: #0F172A;
		display: flex;
		flex-direction: column;
		cursor: pointer;
		position: relative;
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}

	:global(.log-photo-item-card:hover) {
		transform: translateY(-2px);
		box-shadow: 0 6px 14px rgba(15, 23, 42, 0.12);
	}

	:global(.log-photo-img-box) {
		width: 100%;
		height: 140px;
		overflow: hidden;
		background-color: #0F172A;
	}

	:global(.log-photo-img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.2s ease;
	}

	:global(.log-photo-item-card:hover .log-photo-img) {
		transform: scale(1.05);
	}

	:global(.log-photo-caption-bar) {
		padding: 0.5rem 0.75rem;
		background-color: #FFFFFF;
		font-size: 0.75rem;
		font-weight: 700;
		color: #1E293B;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* Estado Vacío */
	.feed-empty-notice {
		padding: 3.5rem 1.5rem;
		text-align: center;
		background-color: #FFFFFF;
		border: 1px dashed #CBD5E1;
		border-radius: 1rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	.empty-icon-wrap {
		width: 64px;
		height: 64px;
		border-radius: 50%;
		background-color: #F8FAFC;
		border: 1px solid #E2E8F0;
		color: #64748B;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.empty-title {
		font-size: 1.125rem;
		font-weight: 800;
		color: #0F172A;
		margin: 0;
	}

	.empty-desc {
		font-size: 0.8125rem;
		color: #64748B;
		margin: 0;
		max-width: 440px;
		line-height: 1.45;
	}

	/* Lightbox */
	.feed-lightbox-backdrop {
		position: fixed;
		inset: 0;
		background-color: rgba(0, 0, 0, 0.88);
		backdrop-filter: blur(4px);
		z-index: 500;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1.5rem;
	}

	.feed-lightbox-box {
		position: relative;
		max-width: 820px;
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	.feed-lightbox-image {
		max-width: 100%;
		max-height: 80vh;
		border-radius: 0.5rem;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
	}

	.feed-lightbox-caption-text {
		color: #F8FAFC;
		font-size: 0.9375rem;
		font-weight: 700;
		text-align: center;
	}

	.btn-lightbox-exit {
		position: absolute;
		top: -44px;
		right: 0;
		background: transparent;
		border: none;
		color: #FFFFFF;
		font-size: 1.5rem;
		cursor: pointer;
		width: 44px;
		height: 44px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.hidden {
		display: none !important;
	}

	@media (max-width: 640px) {
		:global(.log-photos-gallery-grid) {
			grid-template-columns: 1fr 1fr;
		}

		:global(.log-photo-img-box) {
			height: 110px;
		}
	}
</style>
