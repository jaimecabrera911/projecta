---
// src/components/daily-logs/DailyLogForm.astro
// HU-17: Formulario Táctil de Registro Diario de Obra (Clima en 1 Toque, Steppers de Personal y Compresión de Fotos).
---

<div id="daily-log-form-card" class="log-form-card" aria-label="Formulario de reporte diario de obra">
	<!-- Encabezado del Formulario -->
	<div class="form-header">
		<div class="form-header-left">
			<div class="form-icon-emblem">
				<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
					<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
					<polyline points="14 2 14 8 20 8"></polyline>
					<line x1="16" y1="13" x2="8" y2="13"></line>
					<line x1="16" y1="17" x2="8" y2="17"></line>
					<polyline points="10 9 9 9 8 9"></polyline>
				</svg>
			</div>
			<div>
				<h3 class="form-heading">Publicar Bitácora del Día</h3>
				<p class="form-subheading">Memoria técnica, clima, personal y registro fotográfico</p>
			</div>
		</div>

		<button
			id="btn-fill-demo-log"
			type="button"
			class="btn-demo-fill"
			title="Rellenar formulario con datos de prueba realistas para pruebas rápidas"
		>
			<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
				<path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path>
			</svg>
			<span>Auto-Llenar Demo</span>
		</button>
	</div>

	<!-- Formulario Principal -->
	<form id="daily-log-form" class="log-form-body" novalidate>
		<input type="hidden" id="log-project-id" name="project_id" value="proj_penthouse_poblado" />
		<input type="hidden" id="log-weather-val" name="weather" value="sunny" />

		<!-- 1. Fila de Fecha y Selector de Clima en 1 Toque -->
		<div class="form-section">
			<div class="form-row-date-weather">
				<!-- Selector de Fecha -->
				<div class="field-date-wrap">
					<label for="log-date-input" class="field-label">Fecha de la Jornada <span class="required">*</span></label>
					<input
						type="date"
						id="log-date-input"
						name="date"
						class="field-input"
						required
					/>
				</div>

				<!-- 1.1 Selector de Clima en 1 Toque (☀️ Soleado, 🌧️ Lluvia, ☁️ Nublado) -->
				<div class="field-weather-wrap">
					<label class="field-label">Condición Climática <span class="required">*</span></label>
					<div class="weather-selector-cluster" role="group" aria-label="Selector de estado del clima">
						<button
							id="weather-btn-sunny"
							type="button"
							class="btn-weather-choice active"
							data-weather="sunny"
							aria-pressed="true"
						>
							<span class="weather-emoji">☀️</span>
							<span class="weather-name">Soleado</span>
						</button>

						<button
							id="weather-btn-rainy"
							type="button"
							class="btn-weather-choice"
							data-weather="rainy"
							aria-pressed="false"
						>
							<span class="weather-emoji">🌧️</span>
							<span class="weather-name">Lluvia</span>
						</button>

						<button
							id="weather-btn-cloudy"
							type="button"
							class="btn-weather-choice"
							data-weather="cloudy"
							aria-pressed="false"
						>
							<span class="weather-emoji">☁️</span>
							<span class="weather-name">Nublado</span>
						</button>
					</div>
				</div>
			</div>
		</div>

		<!-- 2. Registro de Cuadrilla y Personal (Steppers Ergonómicos) -->
		<div class="form-section">
			<div class="workers-steppers-card">
				<div class="steppers-header">
					<div class="steppers-title-left">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
							<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
							<circle cx="9" cy="7" r="4"></circle>
							<path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
							<path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
						</svg>
						<span class="steppers-title">Personal en Obra (Operate Mode):</span>
					</div>

					<div class="total-workers-pill">
						Total: <strong id="total-workers-summary">5</strong> en sitio
					</div>
				</div>

				<div class="steppers-grid">
					<!-- Stepper 1: Oficiales / Maestros -->
					<div class="stepper-unit">
						<div class="stepper-label-box">
							<span class="stepper-role-title">Oficiales Calificados</span>
							<span class="stepper-role-desc">Albañilería, Drywall, Plomería, Redes</span>
						</div>
						<div class="stepper-controls">
							<button
								id="btn-decrement-officials"
								type="button"
								class="btn-stepper-touch"
								aria-label="Disminuir oficiales"
							>
								−
							</button>
							<span id="officials-count-display" class="stepper-value-num">3</span>
							<button
								id="btn-increment-officials"
								type="button"
								class="btn-stepper-touch"
								aria-label="Aumentar oficiales"
							>
								+
							</button>
						</div>
					</div>

					<!-- Stepper 2: Ayudantes / Auxiliares -->
					<div class="stepper-unit">
						<div class="stepper-label-box">
							<span class="stepper-role-title">Ayudantes de Obra</span>
							<span class="stepper-role-desc">Cargue, acarreo, mezclas y limpieza</span>
						</div>
						<div class="stepper-controls">
							<button
								id="btn-decrement-helpers"
								type="button"
								class="btn-stepper-touch"
								aria-label="Disminuir ayudantes"
							>
								−
							</button>
							<span id="helpers-count-display" class="stepper-value-num">2</span>
							<button
								id="btn-increment-helpers"
								type="button"
								class="btn-stepper-touch"
								aria-label="Aumentar ayudantes"
							>
								+
							</button>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- 2.5. Registro de Horas de Paro por Clima o Fuerza Mayor -->
		<div id="downtime-section" class="form-section downtime-section-wrap hidden">
			<div class="downtime-card">
				<div class="downtime-header-row">
					<div class="downtime-title-left">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
							<circle cx="12" cy="12" r="10"></circle>
							<polyline points="12 6 12 12 8 14"></polyline>
						</svg>
						<span class="downtime-title">Horas de Suspensión por Clima / Fuerza Mayor</span>
					</div>
					<div class="downtime-hours-pill" id="downtime-hours-pill-display">
						<span id="downtime-hours-summary">0</span> hrs paro
					</div>
				</div>

				<div class="downtime-controls-row">
					<div class="stepper-unit downtime-stepper">
						<div class="stepper-label-box">
							<span class="stepper-role-title">Horas de Paro</span>
							<span class="stepper-role-desc">Tiempo de cuadrilla parada (máx. 12 hrs)</span>
						</div>
						<div class="stepper-controls">
							<button
								id="btn-decrement-downtime"
								type="button"
								class="btn-stepper-touch btn-stepper-downtime"
								aria-label="Disminuir horas de paro"
							>
								−
							</button>
							<span id="downtime-hours-display" class="stepper-value-num stepper-value-downtime">0</span>
							<button
								id="btn-increment-downtime"
								type="button"
								class="btn-stepper-touch btn-stepper-downtime"
								aria-label="Aumentar horas de paro"
							>
								+
							</button>
						</div>
					</div>
				</div>

				<div class="downtime-reason-row">
					<label for="downtime-reason-input" class="field-label">Motivo de la Suspensión</label>
					<input
						type="text"
						id="downtime-reason-input"
						name="downtime_reason"
						class="field-input"
						placeholder="Ej: Lluvia torrencial desde las 2:00 PM — cuadrilla parada en exteriores"
					/>
				</div>
			</div>
		</div>

		<!-- 2.8. Sincronización con Actividades del Cronograma (HU-16 <-> HU-17) -->
		<div id="daily-log-tasks-section" class="form-section">
			<div class="schedule-sync-card">
				<div class="sync-card-header">
					<div class="sync-title-left">
						<div class="sync-icon-emblem" aria-hidden="true">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
								<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
								<line x1="16" y1="2" x2="16" y2="6"></line>
								<line x1="8" y1="2" x2="8" y2="6"></line>
								<line x1="3" y1="10" x2="21" y2="10"></line>
							</svg>
						</div>
						<div>
							<span class="sync-card-title">Avance en Actividades del Cronograma (Sincronización en Vivo)</span>
							<p class="sync-card-desc">Selecciona las tareas en las que laboró la cuadrilla hoy para actualizar el avance físico y el Gantt automáticamente.</p>
						</div>
					</div>
					<div class="sync-counter-badge" id="sync-tasks-counter-badge">
						0 actividades marcadas
					</div>
				</div>

				<!-- Lista interactiva de tareas del proyecto -->
				<div id="daily-log-tasks-checklist" class="sync-tasks-checklist">
					<!-- Inyectado dinámicamente según la obra activa -->
				</div>
			</div>
		</div>

		<!-- 3. Notas Técnicas de Avance e Incidentes -->
		<div class="form-section">
			<label for="log-notes-textarea" class="field-label">
				Descripción de Actividades Realizadas e Incidentes <span class="required">*</span>
			</label>
			<textarea
				id="log-notes-textarea"
				name="notes"
				rows="3"
				class="field-textarea"
				placeholder="Detalla lo acontecido en la jornada: avances por capítulo, pruebas técnicas, recepción de materiales o incidentes..."
				required
			></textarea>
			<span id="log-notes-error" class="field-error-msg hidden">Por favor ingresa las notas de la jornada.</span>
		</div>

		<!-- 4. Galería y Carga de Fotografías de Avance (< 800 KB en WebP) -->
		<div class="form-section">
			<div class="photos-upload-wrapper">
				<div class="photos-header-row">
					<div>
						<label class="field-label">Fotografías de Avance de Hoy (Hasta 10 fotos)</label>
						<p class="photos-sub-note">Las imágenes se optimizan en segundo plano en WebP (&lt; 800 KB) para cuidar tu plan de datos.</p>
					</div>

					<span id="photos-counter-pill" class="photos-count-badge">0 / 10</span>
				</div>

				<!-- Inputs ocultos y botones de captura -->
				<input
					type="file"
					id="log-photos-input"
					name="photos_files"
					multiple
					accept="image/*"
					capture="environment"
					class="hidden"
				/>

				<div class="photo-actions-row">
					<button
						id="btn-add-photos"
						type="button"
						class="btn-photo-trigger"
						title="Tomar o seleccionar fotos con la cámara"
					>
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
							<path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
							<circle cx="12" cy="13" r="4"></circle>
						</svg>
						<span>Añadir Fotos de Hoy</span>
					</button>

					<button
						id="btn-add-demo-photo"
						type="button"
						class="btn-photo-demo"
						title="Generar una foto técnica con sello de agua para prueba rápida"
					>
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
							<polyline points="20 6 9 17 4 12"></polyline>
						</svg>
						<span>Foto Demo Sello Obra</span>
					</button>
				</div>

				<!-- Carrusel horizontal de fotos previsualizadas antes de publicar -->
				<div id="photos-preview-strip" class="photos-preview-strip hidden"></div>
			</div>
		</div>

		<!-- 5. Barra Inferior de Publicación -->
		<div class="form-footer">
			<div class="footer-author-box">
				<span class="author-label">Reportando como:</span>
				<span id="log-active-author-name" class="author-badge-active">Ing. Mateo Gómez (Residente)</span>
			</div>

			<button
				id="btn-submit-daily-log"
				type="submit"
				class="btn-publish-log"
			>
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
					<line x1="22" y1="2" x2="11" y2="13"></line>
					<polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
				</svg>
				<span>Publicar Bitácora del Día</span>
			</button>
		</div>
	</form>
</div>

<style>
	.log-form-card {
		background-color: #FFFFFF;
		border: 1px solid #E2E8F0;
		border-radius: 1rem;
		box-shadow: 0 2px 6px rgba(15, 23, 42, 0.04);
		overflow: hidden;
	}

	.form-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.25rem 1.5rem;
		background: linear-gradient(180deg, #F8FAFC 0%, #FFFFFF 100%);
		border-bottom: 1px solid #E2E8F0;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.form-header-left {
		display: flex;
		align-items: center;
		gap: 0.875rem;
	}

	.form-icon-emblem {
		width: 44px;
		height: 44px;
		border-radius: 0.625rem;
		background-color: #0F172A;
		color: #F97316;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.form-heading {
		font-size: 1.125rem;
		font-weight: 800;
		color: #0F172A;
		margin: 0;
	}

	.form-subheading {
		font-size: 0.75rem;
		color: #64748B;
		margin: 0.15rem 0 0 0;
	}

	.btn-demo-fill {
		min-height: 40px;
		padding: 0 0.875rem;
		border-radius: 0.5rem;
		border: 1px solid #CBD5E1;
		background-color: #FFFFFF;
		color: #475569;
		font-size: 0.75rem;
		font-weight: 700;
		display: flex;
		align-items: center;
		gap: 0.4rem;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.btn-demo-fill:hover {
		background-color: #F8FAFC;
		border-color: #F97316;
		color: #F97316;
	}

	.log-form-body {
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.form-section {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.field-label {
		font-size: 0.8125rem;
		font-weight: 700;
		color: #1E293B;
	}

	.required {
		color: #EF4444;
	}

	.field-input,
	.field-textarea {
		width: 100%;
		border-radius: 0.5rem;
		border: 1px solid #CBD5E1;
		background-color: #FFFFFF;
		color: #0F172A;
		font-family: inherit;
		font-size: 0.875rem;
		padding: 0.625rem 0.875rem;
		box-sizing: border-box;
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
	}

	.field-input:focus,
	.field-textarea:focus {
		outline: none;
		border-color: #F97316;
		box-shadow: 0 0 0 3px rgba(249, 115, 22, 0.15);
	}

	.field-textarea {
		resize: vertical;
		min-height: 80px;
	}

	.field-error-msg {
		font-size: 0.75rem;
		color: #DC2626;
		font-weight: 600;
	}

	/* Fila Fecha y Clima */
	.form-row-date-weather {
		display: grid;
		grid-template-columns: 240px 1fr;
		gap: 1.25rem;
		align-items: flex-start;
	}

	.field-date-wrap {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.field-weather-wrap {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	/* Selector de Clima en 1 Toque (☀️ Soleado, 🌧️ Lluvia, ☁️ Nublado) */
	.weather-selector-cluster {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.5rem;
	}

	.btn-weather-choice {
		min-height: 48px;
		padding: 0.5rem 0.75rem;
		border-radius: 0.625rem;
		border: 1.5px solid #E2E8F0;
		background-color: #F8FAFC;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		cursor: pointer;
		transition: all 0.15s cubic-bezier(0.16, 1, 0.3, 1);
		font-weight: 700;
		color: #475569;
		font-size: 0.875rem;
	}

	.btn-weather-choice:hover {
		border-color: #CBD5E1;
		background-color: #F1F5F9;
	}

	.btn-weather-choice.active[data-weather="sunny"] {
		background-color: #FEF3C7;
		border-color: #F59E0B;
		color: #B45309;
		box-shadow: 0 2px 6px rgba(245, 158, 11, 0.25);
	}

	.btn-weather-choice.active[data-weather="rainy"] {
		background-color: #E0F2FE;
		border-color: #0284C7;
		color: #0369A1;
		box-shadow: 0 2px 6px rgba(2, 132, 199, 0.25);
	}

	.btn-weather-choice.active[data-weather="cloudy"] {
		background-color: #F1F5F9;
		border-color: #64748B;
		color: #334155;
		box-shadow: 0 2px 6px rgba(100, 116, 139, 0.25);
	}

	.weather-emoji {
		font-size: 1.25rem;
		line-height: 1;
	}

	/* 2. Steppers de Cuadrilla */
	.workers-steppers-card {
		background-color: #F8FAFC;
		border: 1px solid #E2E8F0;
		border-radius: 0.75rem;
		padding: 1.125rem 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.875rem;
	}

	/* 2.5. Sección de Horas de Paro por Clima */
	.downtime-section-wrap {
		transition: all 0.2s ease;
	}

	.downtime-card {
		background: linear-gradient(135deg, #FFF7ED 0%, #FEF3C7 100%);
		border: 1.5px solid #FDE68A;
		border-radius: 0.75rem;
		padding: 1.125rem 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.875rem;
	}

	.downtime-header-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.downtime-title-left {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.8125rem;
		font-weight: 800;
		color: #92400E;
	}

	.downtime-hours-pill {
		font-size: 0.75rem;
		font-weight: 800;
		background-color: #FEF3C7;
		color: #92400E;
		border: 1px solid #F59E0B;
		padding: 0.2rem 0.65rem;
		border-radius: 9999px;
	}

	.downtime-controls-row {
		display: flex;
		gap: 1rem;
	}

	.downtime-stepper {
		flex: 1;
	}

	.btn-stepper-downtime {
		border-color: #F59E0B !important;
		color: #92400E !important;
	}

	.btn-stepper-downtime:hover {
		background-color: #FEF3C7 !important;
		border-color: #D97706 !important;
		color: #78350F !important;
	}

	.stepper-value-downtime {
		color: #92400E !important;
	}

	.downtime-reason-row {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	/* 2.8. Sincronización con Cronograma */
	.schedule-sync-card {
		background-color: #F8FAFC;
		border: 1.5px solid #CBD5E1;
		border-radius: 0.75rem;
		padding: 1.125rem 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.875rem;
	}

	.sync-card-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.sync-title-left {
		display: flex;
		align-items: center;
		gap: 0.65rem;
	}

	.sync-icon-emblem {
		width: 38px;
		height: 38px;
		border-radius: 0.5rem;
		background-color: #0F172A;
		color: #10B981;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.sync-card-title {
		font-size: 0.875rem;
		font-weight: 800;
