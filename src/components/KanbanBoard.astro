	// Abre el borrador existente o pide confirmación para crear uno nuevo
	function openLeadBudget(lead: Lead) {
		try {
			const existing = loadBudgets().find((budget) => budget.lead_id === lead.id);
			if (existing) {
				window.location.href = `/budgets/editor?id=${encodeURIComponent(existing.id)}`;
				return;
			}

			// Sin borrador previo: confirmar antes de crear uno nuevo
			openBudgetConfirmModal(lead);
		} catch (_) {
			window.dispatchEvent(new CustomEvent('show-toast', {
				detail: {
					title: 'No se pudo abrir el presupuesto',
					message: 'Revisa el almacenamiento del navegador e inténtalo de nuevo.',
					type: 'warning'
				}
			}));
		}
	}

	// Crea el borrador tras la confirmación y dirige al constructor
	function createLeadBudgetDraft(lead: Lead) {
		try {
			const budget = createBudget({
				title: `${lead.project_type} — ${lead.client_name}`,
				lead_id: lead.id,
				client_name: lead.client_name,
				global_margin_percentage: 30
			});
			persistBudget(budget);
			window.location.href = `/budgets/editor?id=${encodeURIComponent(budget.id)}`;
		} catch (_) {
			window.dispatchEvent(new CustomEvent('show-toast', {
				detail: {
					title: 'No se pudo crear el presupuesto',
					message: 'Revisa el almacenamiento del navegador e inténtalo de nuevo.',
					type: 'warning'
				}
			}));
		}
	}

	// Alterna la vista activa y sincroniza el conmutador
	function applyView() {
		const isList = currentView === 'list';
		const kanbanScroll = document.getElementById('kanban-columns-container');
		const listView = document.getElementById('funnel-list-view');
		const btnKanban = document.getElementById('view-toggle-kanban');
		const btnList = document.getElementById('view-toggle-list');

		kanbanScroll?.classList.toggle('hidden', isList);
		listView?.classList.toggle('hidden', !isList);

		btnKanban?.classList.toggle('active', !isList);
		btnKanban?.setAttribute('aria-pressed', (!isList).toString());
		btnList?.classList.toggle('active', isList);
		btnList?.setAttribute('aria-pressed', isList.toString());

		renderActiveView();
	}

	function setView(view: 'kanban' | 'list') {
		currentView = view;
		try {
