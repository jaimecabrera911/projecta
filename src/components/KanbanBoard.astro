		padding: 1rem;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.2s ease-out;
	}

	.modal-backdrop-wrap.active {
		opacity: 1;
		pointer-events: auto;
	}

	.modal-backdrop-blur {
		position: fixed;
		inset: 0;
		background-color: rgba(2, 6, 23, 0.65);
		backdrop-filter: blur(4px);
	}

