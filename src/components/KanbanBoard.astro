</style>

<script>
	// Complete Client-Side Lead State Management & Interactive Drag & Drop Engine
	interface Lead {
		id: string;
		client_name: string;
		client_phone: string;
		project_address: string;
		project_type: string;
		estimated_budget: number;
		stage: 'new_lead' | 'visit_scheduled' | 'in_budgeting' | 'proposal_sent' | 'won' | 'lost';
		created_at: string;
		source?: string;
	}

	const STAGES = [
		{ id: 'new_lead', name: 'Nuevo Lead' },
		{ id: 'visit_scheduled', name: 'Visita Agendada' },
		{ id: 'in_budgeting', name: 'En Presupuesto' },
		{ id: 'proposal_sent', name: 'Propuesta Enviada' },
		{ id: 'won', name: 'Ganado / Obra' },
		{ id: 'lost', name: 'Perdido' }
	] as const;

	const DEFAULT_LEADS: Lead[] = [
		{
			id: 'lead_01',
			client_name: 'Sandra Milena López',
			client_phone: '+573109876543',
			project_address: 'Cra 7 # 116-20 Torre B Apto 502 (Chicó)',
			project_type: 'Remodelación Total',
			estimated_budget: 35000000,
			stage: 'new_lead',
			created_at: new Date(Date.now() - 15 * 60 * 1000).toISOString()
		},
		{
			id: 'lead_02',
			client_name: 'Andrés Delgado',
			client_phone: '+573155554321',
			project_address: 'Loma del Chocho (Envigado)',
			project_type: 'Cocina Integral',
			estimated_budget: 10000000,
			stage: 'new_lead',
			created_at: new Date(Date.now() - 2 * 3600 * 1000).toISOString()
		},
		{
			id: 'lead_03',
			client_name: 'Felipe Restrepo',
			client_phone: '+573004448899',
			project_address: 'Castropol (El Poblado)',
			project_type: 'Baño',
			estimated_budget: 22500000,
			stage: 'visit_scheduled',
			created_at: new Date(Date.now() - 24 * 3600 * 1000).toISOString()
		},
		{
			id: 'lead_04',
			client_name: 'Café Origen SAS',
			client_phone: '+573201112233',
			project_address: 'Mall La Frontera Local 104',
			project_type: 'Adecuación Comercial',
			estimated_budget: 48000000,
			stage: 'in_budgeting',
			created_at: new Date(Date.now() - 36 * 3600 * 1000).toISOString()
		},
		{
			id: 'lead_05',
			client_name: 'Valeria Henao',
			client_phone: '+573117778899',
			project_address: 'Laureles Nogal (Medellín)',
			project_type: 'Remodelación Total',
			estimated_budget: 29000000,
			stage: 'proposal_sent',
			created_at: new Date(Date.now() - 48 * 3600 * 1000).toISOString()
		},
		{
			id: 'lead_06',
			client_name: 'Familia Arango Ospina',
			client_phone: '+573189990011',
			project_address: 'Altos de San Lucas (El Poblado)',
			project_type: 'Remodelación Total',
			estimated_budget: 40000000,
			stage: 'won',
			created_at: new Date(Date.now() - 72 * 3600 * 1000).toISOString()
		}
	];

	function loadLeads(): Lead[] {
		try {
			const saved = localStorage.getItem('obraflow_leads');
			if (saved) {
				return JSON.parse(saved);
			}
		} catch (_) {}
		saveLeads(DEFAULT_LEADS);
		return DEFAULT_LEADS;
	}

	function saveLeads(leadsData: Lead[]) {
		try {
			localStorage.setItem('obraflow_leads', JSON.stringify(leadsData));
		} catch (_) {}
	}

	let leads: Lead[] = loadLeads();
	let draggedLeadId: string | null = null;
	let currentActionLeadId: string | null = null;

	// Render the whole Kanban Board Reactively
	function renderKanban() {
		STAGES.forEach(({ id }) => {
			const container = document.getElementById(`cards-${id}`);
			if (container) container.innerHTML = '';
		});

		let grandTotalVal = 0;
		let activeLeadsCount = 0;

		const stageSums: Record<string, { count: number; val: number }> = {
			new_lead: { count: 0, val: 0 },
			visit_scheduled: { count: 0, val: 0 },
			in_budgeting: { count: 0, val: 0 },
			proposal_sent: { count: 0, val: 0 },
			won: { count: 0, val: 0 },
			lost: { count: 0, val: 0 }
		};

		leads.forEach((lead) => {
			const stage = lead.stage || 'new_lead';
			if (!stageSums[stage]) {
				stageSums[stage] = { count: 0, val: 0 };
			}
			stageSums[stage].count += 1;
			stageSums[stage].val += (lead.estimated_budget || 0);

			if (stage !== 'lost') {
				grandTotalVal += (lead.estimated_budget || 0);
				activeLeadsCount += 1;
			}

			const container = document.getElementById(`cards-${stage}`);
			if (container) {
				const cardEl = createCardElement(lead);
				container.appendChild(cardEl);
			}
		});

		// Update column headers
		STAGES.forEach(({ id }) => {
			const countPill = document.getElementById(`badge-count-${id}`);
			const valEl = document.getElementById(`val-${id}`);
			const stats = stageSums[id] || { count: 0, val: 0 };

			if (countPill) countPill.textContent = stats.count.toString();
			if (valEl) {
				valEl.textContent = `$ ${(stats.val / 1000000).toFixed(1)}M`;
			}

			// Empty State Placeholder
			const container = document.getElementById(`cards-${id}`);
			if (container && stats.count === 0) {
				const empty = document.createElement('div');
				empty.className = 'empty-column-placeholder';
				empty.textContent = 'Suelta una tarjeta aquí';
				container.appendChild(empty);
			}
		});

		// Update Top Bar Global Stats
		const totalLeadsEl = document.getElementById('total-leads-count');
		const totalPipelineEl = document.getElementById('total-pipeline-value');
		if (totalLeadsEl) totalLeadsEl.textContent = activeLeadsCount.toString();
		if (totalPipelineEl) totalPipelineEl.textContent = `$ ${(grandTotalVal / 1000000).toFixed(1)}M COP`;
	}

	function createCardElement(lead: Lead): HTMLElement {
		const card = document.createElement('div');
		card.className = 'lead-card';
		card.setAttribute('draggable', 'true');
		card.dataset.id = lead.id;

		const formattedBudget = lead.estimated_budget > 0
			? `$ ${lead.estimated_budget.toLocaleString('es-CO')}`
			: 'Por Cotizar';

		const phoneClean = lead.client_phone.replace(/[^0-9]/g, '');

		card.innerHTML = `
			<div class="card-top-row">
				<div class="tag-group">
					<span class="project-badge">${escapeHtml(lead.project_type)}</span>
				</div>
				<button type="button" class="card-menu-btn" title="Editar oportunidad" data-action="edit" data-id="${lead.id}">
					⋮
				</button>
			</div>

			<h4 class="lead-card-name">${escapeHtml(lead.client_name)}</h4>
			
			<p class="lead-address">
				<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#F97316" stroke-width="2">
					<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
					<circle cx="12" cy="10" r="3"></circle>
				</svg>
				<span title="${escapeHtml(lead.project_address)}">${escapeHtml(lead.project_address)}</span>
			</p>

			<div class="card-bottom-row">
				<span class="card-price">${formattedBudget}</span>
				<div class="card-actions">
					<button type="button" class="btn-card-action" data-action="quick-move" data-id="${lead.id}" title="Cambiar etapa con modal">
						Mover ▾
					</button>
					<a 
						href="https://wa.me/${phoneClean}?text=Hola%20${encodeURIComponent(lead.client_name)},%20te%20escribimos%20de%20Construcciones%20Andina"
						target="_blank" 
						class="btn-card-action btn-card-wa"
						title="Abrir chat en WhatsApp"
					>
						WA
					</a>
				</div>
			</div>
		`;

		// Drag & Drop Events
		card.addEventListener('dragstart', (e) => {
			draggedLeadId = lead.id;
			card.classList.add('is-dragging');
			if (e.dataTransfer) {
				e.dataTransfer.setData('text/plain', lead.id);
				e.dataTransfer.effectAllowed = 'move';
			}
		});

		card.addEventListener('dragend', () => {
			draggedLeadId = null;
			card.classList.remove('is-dragging');
			document.querySelectorAll('.kanban-column').forEach(col => col.classList.remove('drag-over'));
		});

		// Button listeners inside card
		const editBtn = card.querySelector('[data-action="edit"]');
		editBtn?.addEventListener('click', (e) => {
			e.stopPropagation();
			openEditModal(lead);
		});

		const moveBtn = card.querySelector('[data-action="quick-move"]');
		moveBtn?.addEventListener('click', (e) => {
			e.stopPropagation();
			openStageModal(lead);
		});

		return card;
	}

	function escapeHtml(text: string): string {
		const div = document.createElement('div');
		div.textContent = text;
		return div.innerHTML;
	}

	// Setup Drop Zones on all Kanban Columns
	function setupDropZones() {
		const columns = document.querySelectorAll('.kanban-column');
		columns.forEach((col) => {
			col.addEventListener('dragover', (e) => {
				e.preventDefault();
				if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
				col.classList.add('drag-over');
			});

			col.addEventListener('dragleave', () => {
				col.classList.remove('drag-over');
			});

			col.addEventListener('drop', (e) => {
				e.preventDefault();
				col.classList.remove('drag-over');
				const targetStage = col.getAttribute('data-stage') as Lead['stage'];
				const leadId = draggedLeadId || (e.dataTransfer ? e.dataTransfer.getData('text/plain') : null);

				if (leadId && targetStage) {
					moveLeadToStage(leadId, targetStage);
				}
			});
		});
	}

	function moveLeadToStage(leadId: string, newStage: Lead['stage']) {
		const targetLead = leads.find(l => l.id === leadId);
		if (!targetLead) return;

		if (targetLead.stage === newStage) return;

		targetLead.stage = newStage;
		saveLeads(leads);
		renderKanban();

		// Notify User
		const stageObj = STAGES.find(s => s.id === newStage);
		window.dispatchEvent(new CustomEvent('show-toast', {
			detail: {
				title: 'Oportunidad actualizada',
				message: `${targetLead.client_name} se movió a "${stageObj?.name || newStage}".`,
				type: 'success'
			}
		}));
	}

	// ==========================================================================
	// MODAL 1: CAMBIAR ETAPA RÁPIDO (SIN ALERTAS NI PROMPTS DEL NAVEGADOR)
	// ==========================================================================
	const stageModal = document.getElementById('stage-move-modal');
	const stageBackdrop = document.getElementById('stage-move-backdrop');
	const closeStageBtn = document.getElementById('close-stage-modal-btn');
	const cancelStageBtn = document.getElementById('cancel-stage-modal-btn');
	const moveSubtitle = document.getElementById('move-modal-subtitle');
	const stageOptions = document.querySelectorAll('.stage-option-item');

	function openStageModal(lead: Lead) {
		currentActionLeadId = lead.id;
		if (moveSubtitle) {
			moveSubtitle.textContent = `Mover "${lead.client_name}" (${lead.project_type})`;
		}

		// Highlight current stage
		stageOptions.forEach((btn) => {
			const target = btn.getAttribute('data-stage-target');
			if (target === lead.stage) {
				btn.classList.add('current-stage');
			} else {
				btn.classList.remove('current-stage');
			}
		});

		stageModal?.classList.add('active');
	}

	function closeStageModal() {
		stageModal?.classList.remove('active');
		currentActionLeadId = null;
	}

	closeStageBtn?.addEventListener('click', closeStageModal);
	cancelStageBtn?.addEventListener('click', closeStageModal);
	stageBackdrop?.addEventListener('click', closeStageModal);

	stageOptions.forEach((btn) => {
		btn.addEventListener('click', () => {
			const targetStage = btn.getAttribute('data-stage-target') as Lead['stage'];
			if (currentActionLeadId && targetStage) {
				moveLeadToStage(currentActionLeadId, targetStage);
				closeStageModal();
			}
		});
	});

	// ==========================================================================
	// MODAL 2: EDICIÓN COMPLETA DE LEAD
	// ==========================================================================
	const editModal = document.getElementById('edit-lead-modal');
	const editBackdrop = document.getElementById('edit-modal-backdrop');
	const closeEditBtn = document.getElementById('close-edit-modal-btn');
	const cancelEditBtn = document.getElementById('cancel-edit-btn');
	const deleteLeadTriggerBtn = document.getElementById('delete-lead-trigger-btn');
	const editForm = document.getElementById('edit-lead-form') as HTMLFormElement | null;

	const editIdInput = document.getElementById('edit-lead-id') as HTMLInputElement | null;
	const editNameInput = document.getElementById('edit-client-name') as HTMLInputElement | null;
	const editPhoneInput = document.getElementById('edit-client-phone') as HTMLInputElement | null;
	const editAddressInput = document.getElementById('edit-project-address') as HTMLInputElement | null;
	const editTypeSelect = document.getElementById('edit-project-type') as HTMLSelectElement | null;
	const editBudgetInput = document.getElementById('edit-estimated-budget') as HTMLInputElement | null;
	const editStageSelect = document.getElementById('edit-stage-select') as HTMLSelectElement | null;

	function openEditModal(lead: Lead) {
		if (!editModal) return;
		currentActionLeadId = lead.id;
		if (editIdInput) editIdInput.value = lead.id;
		if (editNameInput) editNameInput.value = lead.client_name;
		if (editPhoneInput) editPhoneInput.value = lead.client_phone;
		if (editAddressInput) editAddressInput.value = lead.project_address;
		if (editTypeSelect) editTypeSelect.value = lead.project_type;
		if (editBudgetInput) editBudgetInput.value = lead.estimated_budget ? lead.estimated_budget.toString() : '';
		if (editStageSelect) editStageSelect.value = lead.stage;

		editModal.classList.add('active');
	}

	function closeEditModal() {
		if (!editModal) return;
		editModal.classList.remove('active');
	}

	closeEditBtn?.addEventListener('click', closeEditModal);
	cancelEditBtn?.addEventListener('click', closeEditModal);
	editBackdrop?.addEventListener('click', closeEditModal);

	editForm?.addEventListener('submit', (e) => {
		e.preventDefault();
		const id = editIdInput?.value;
		if (!id) return;

		const target = leads.find(l => l.id === id);
		if (!target) return;

		target.client_name = editNameInput?.value.trim() || target.client_name;
		target.client_phone = editPhoneInput?.value.trim() || target.client_phone;
		target.project_address = editAddressInput?.value.trim() || target.project_address;
		target.project_type = editTypeSelect?.value || target.project_type;
		const rawBudget = editBudgetInput?.value.replace(/[^0-9]/g, '') || '0';
		target.estimated_budget = parseInt(rawBudget, 10) || 0;
		target.stage = (editStageSelect?.value as Lead['stage']) || target.stage;

		saveLeads(leads);
		renderKanban();
		closeEditModal();

		window.dispatchEvent(new CustomEvent('show-toast', {
			detail: {
				title: 'Cambios guardados',
				message: `Oportunidad "${target.client_name}" actualizada con éxito.`,
				type: 'success'
			}
		}));
	});

	// ==========================================================================
	// MODAL 3: CONFIRMACIÓN DE ELIMINACIÓN PERSONALIZADA (SIN CONFIRM DEL NAVEGADOR)
	// ==========================================================================
	const deleteModal = document.getElementById('delete-confirm-modal');
	const deleteBackdrop = document.getElementById('delete-confirm-backdrop');
	const cancelDeleteBtn = document.getElementById('cancel-delete-modal-btn');
	const confirmDeleteBtn = document.getElementById('confirm-delete-action-btn');
	const deleteConfirmText = document.getElementById('delete-confirm-text');

	function openDeleteModal(leadId: string) {
		const target = leads.find(l => l.id === leadId);
		if (!target) return;

		currentActionLeadId = leadId;
		if (deleteConfirmText) {
			deleteConfirmText.textContent = `¿Estás seguro de que deseas eliminar permanentemente a "${target.client_name}"? Esta acción no se puede deshacer.`;
		}

		deleteModal?.classList.add('active');
	}

	function closeDeleteModal() {
		deleteModal?.classList.remove('active');
	}

	deleteLeadTriggerBtn?.addEventListener('click', () => {
		const id = editIdInput?.value;
		if (id) {
			closeEditModal();
			openDeleteModal(id);
		}
	});

	cancelDeleteBtn?.addEventListener('click', closeDeleteModal);
	deleteBackdrop?.addEventListener('click', closeDeleteModal);

	confirmDeleteBtn?.addEventListener('click', () => {
		if (!currentActionLeadId) return;

		const target = leads.find(l => l.id === currentActionLeadId);
		const name = target ? target.client_name : 'Oportunidad';

		leads = leads.filter(l => l.id !== currentActionLeadId);
		saveLeads(leads);
		renderKanban();
		closeDeleteModal();

		window.dispatchEvent(new CustomEvent('show-toast', {
			detail: {
				title: 'Lead eliminado',
				message: `Se ha descartado a "${name}".`,
				type: 'warning'
			}
		}));
	});

	// Close modals on Escape key
	window.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') {
			closeStageModal();
			closeEditModal();
			closeDeleteModal();
		}
	});

	// Listen for new lead created from HU-01 Modal
	window.addEventListener('lead-created', (e: any) => {
		const newLeadData = e.detail;
		if (!newLeadData) return;

		const newLead: Lead = {
			id: newLeadData.id || 'lead_' + Date.now().toString(36),
			client_name: newLeadData.client_name,
			client_phone: newLeadData.client_phone,
			project_address: newLeadData.project_address,
			project_type: newLeadData.project_type,
			estimated_budget: newLeadData.estimated_budget || 0,
			stage: 'new_lead',
			created_at: new Date().toISOString()
		};

		leads.unshift(newLead);
		saveLeads(leads);
		renderKanban();
	});

	// Initial Render and Drop Zones Attachment
	setupDropZones();
	renderKanban();
</script>
