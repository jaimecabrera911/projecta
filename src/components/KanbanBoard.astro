<script>
	// Complete Client-Side Lead State Management & Interactive Drag & Drop Engine (HU-03 / HU-04)
	import { createBudget, loadBudgets, persistBudget } from '../lib/budget-store';

	interface BeforePhoto {
		id: string;
		name: string;
		dataUrl: string;
		sizeKb: number;
		zone: string;
		created_at: string;
	}

	interface TechnicalVisit {
		scheduled_for?: string;
		access_notes?: string;
		technical_notes?: string;
		photos?: BeforePhoto[];
		updated_at?: string;
	}

	interface Lead {
		id: string;
		client_name: string;
		client_phone: string;
		client_email?: string;
		project_address: string;
		project_type: string;
		notes?: string;
		estimated_budget: number;
		stage: 'new_lead' | 'visit_scheduled' | 'in_budgeting' | 'proposal_sent' | 'negotiation' | 'won' | 'lost';
		created_at: string;
		updated_at?: string;
		lost_reason?: string;
		source?: 'manual' | 'web' | string;
		photos_count?: number;
		photos?: Array<{ name: string; size?: number; dataUrl?: string }>;
		visit?: TechnicalVisit;
	}

	const STAGES = [
		{ id: 'new_lead', name: 'Nuevo Lead' },
		{ id: 'visit_scheduled', name: 'Visita Agendada' },
		{ id: 'in_budgeting', name: 'En Presupuesto' },
		{ id: 'proposal_sent', name: 'Propuesta Enviada' },
		{ id: 'negotiation', name: 'En Negociación' },
		{ id: 'won', name: 'Ganado / Obra' },
		{ id: 'lost', name: 'Perdido' }
	] as const;

	const ACTIVE_STAGES: Lead['stage'][] = ['new_lead', 'visit_scheduled', 'in_budgeting', 'proposal_sent', 'negotiation'];

	const DEFAULT_LEADS: Lead[] = [
		{
			id: 'lead_01',
			client_name: 'Sandra Milena López',
			client_phone: '+573109876543',
			project_address: 'Cra 7 # 116-20 Torre B Apto 502 (Chicó)',
			project_type: 'Remodelación Total',
			estimated_budget: 35000000,
			stage: 'new_lead',
			source: 'manual',
			created_at: new Date(Date.now() - 15 * 60 * 1000).toISOString()
		},
		{
			id: 'lead_02',
			client_name: 'Andrés Delgado',
			client_phone: '+573155554321',
			client_email: 'andres@gmail.com',
			project_address: 'Loma del Chocho (Envigado)',
			project_type: 'Cocina Integral',
			notes: 'Quiero tumbar un muro y cambiar muebles y mesón',
			estimated_budget: 18000000,
			stage: 'new_lead',
			source: 'web',
			photos_count: 3,
			created_at: new Date(Date.now() - 2 * 3600 * 1000).toISOString()
		},
		{
			id: 'lead_03',
			client_name: 'Felipe Restrepo',
			client_phone: '+573004448899',
			project_address: 'Castropol (El Poblado)',
			project_type: 'Baño',
			estimated_budget: 22500000,
			stage: 'visit_scheduled',
			created_at: new Date(Date.now() - 24 * 3600 * 1000).toISOString(),
			visit: {
				scheduled_for: '2026-11-22T14:00',
				access_notes: 'Portería Torre 2, citófono 302. Horario permitido de obra: Lun-Vie 8:00 a 17:00.',
				technical_notes: 'Revisión hidrosanitaria del baño principal. Presión de agua adecuada. Se requiere demoler enchapado cerámico antiguo y reemplazar punto de desagüe a 4 pulgadas.',
				photos: []
			}
		},
		{
			id: 'lead_04',
			client_name: 'Café Origen SAS',
			client_phone: '+573201112233',
			project_address: 'Mall La Frontera Local 104',
			project_type: 'Adecuación Comercial',
			estimated_budget: 48000000,
			stage: 'in_budgeting',
			created_at: new Date(Date.now() - 36 * 3600 * 1000).toISOString()
		},
		{
			id: 'lead_05',
			client_name: 'Valeria Henao',
			client_phone: '+573117778899',
			project_address: 'Laureles Nogal (Medellín)',
			project_type: 'Remodelación Total',
			estimated_budget: 29000000,
			stage: 'proposal_sent',
			created_at: new Date(Date.now() - 4 * 24 * 3600 * 1000).toISOString(), // > 3 days (inactivo)
			updated_at: new Date(Date.now() - 4 * 24 * 3600 * 1000).toISOString()
		},
		{
			id: 'lead_06',
			client_name: 'Constructora Capital',
			client_phone: '+573142223344',
			project_address: 'Sector Provenza (Medellín)',
			project_type: 'Pintura y Acabados',
			estimated_budget: 52000000,
			stage: 'negotiation',
			created_at: new Date(Date.now() - 30 * 3600 * 1000).toISOString()
		},
		{
			id: 'lead_07',
			client_name: 'Familia Arango Ospina',
			client_phone: '+573189990011',
			project_address: 'Altos de San Lucas (El Poblado)',
			project_type: 'Remodelación Total',
			estimated_budget: 40000000,
			stage: 'won',
			created_at: new Date(Date.now() - 72 * 3600 * 1000).toISOString()
		},
		{
			id: 'lead_08',
			client_name: 'Inversiones Río Claro',
			client_phone: '+573123456789',
			project_address: 'Calle 50 # 45-20 (Centro)',
			project_type: 'Adecuación Comercial',
			estimated_budget: 65000000,
			stage: 'lost',
			lost_reason: 'Precio elevado',
			created_at: new Date(Date.now() - 5 * 24 * 3600 * 1000).toISOString(),
			updated_at: new Date(Date.now() - 2 * 24 * 3600 * 1000).toISOString()
		}
	];

	// Inactivity detector (> 3 days / 72 hours in active stages)
	function isLeadInactive(lead: Lead): boolean {
		if (!ACTIVE_STAGES.includes(lead.stage)) return false;
		const dateStr = lead.updated_at || lead.created_at;
		if (!dateStr) return false;
		const diffMs = Date.now() - new Date(dateStr).getTime();
		const diffHours = diffMs / (1000 * 60 * 60);
		return diffHours >= 72;
	}

	function loadLeads(): Lead[] {
		try {
			const saved = localStorage.getItem('obraflow_leads');
			if (saved) {
				const parsed: Lead[] = JSON.parse(saved);
				if (Array.isArray(parsed) && parsed.length > 0) {
					// Seed any missing sample leads (negotiation / lost) if older storage exists
					const hasNegotiation = parsed.some(l => l.stage === 'negotiation');
					if (!hasNegotiation) {
						DEFAULT_LEADS.forEach(dl => {
							if (!parsed.some(p => p.id === dl.id)) {
								parsed.push(dl);
							}
						});
						saveLeads(parsed);
					}

					// Ensure lead_03 has visit sample data
					const felipe = parsed.find(l => l.id === 'lead_03');
					if (felipe && !felipe.visit) {
						felipe.visit = {
							scheduled_for: '2026-11-22T14:00',
							access_notes: 'Portería Torre 2, citófono 302. Horario permitido de obra: Lun-Vie 8:00 a 17:00.',
							technical_notes: 'Revisión hidrosanitaria del baño principal. Presión de agua adecuada. Se requiere demoler enchapado cerámico antiguo y reemplazar punto de desagüe a 4 pulgadas.',
							photos: []
						};
						saveLeads(parsed);
					}
					return parsed;
				}
			}
		} catch (_) {}
		saveLeads(DEFAULT_LEADS);
		return DEFAULT_LEADS;
	}

	function saveLeads(leadsData: Lead[]) {
		try {
			localStorage.setItem('obraflow_leads', JSON.stringify(leadsData));
		} catch (_) {}
	}

	let leads: Lead[] = loadLeads();
	let draggedLeadId: string | null = null;
	let currentActionLeadId: string | null = null;
	let pendingLostLeadId: string | null = null;

	// Filter state
	let searchQuery = '';
	let activeTypeFilter = 'all';
	let showOnlyInactive = false;

	function getFilteredLeads(): Lead[] {
		return leads.filter((lead) => {
			// Search query (client_name, project_address, client_phone)
			if (searchQuery) {
				const q = searchQuery.toLowerCase();
				const name = (lead.client_name || '').toLowerCase();
				const addr = (lead.project_address || '').toLowerCase();
				const phone = (lead.client_phone || '').toLowerCase();
				if (!name.includes(q) && !addr.includes(q) && !phone.includes(q)) {
					return false;
				}
			}

			// Project type filter
			if (activeTypeFilter !== 'all') {
				if (lead.project_type !== activeTypeFilter) {
					return false;
				}
			}

			// Inactive filter toggle
			if (showOnlyInactive) {
				if (!isLeadInactive(lead)) {
					return false;
				}
			}

			return true;
		});
	}

	// View state: 'kanban' | 'list' (persistido en el dispositivo)
	const FUNNEL_VIEW_KEY = 'obraflow_funnel_view';
	let currentView: 'kanban' | 'list' = localStorage.getItem(FUNNEL_VIEW_KEY) === 'list' ? 'list' : 'kanban';

	// Iconos react-icons (Tabler) pre-renderizados por el servidor.
	const funnelIcons = (() => {
		try {
			const el = document.getElementById('funnel-icons-data');
			return el && el.textContent ? (JSON.parse(el.textContent) as Record<string, string>) : {};
		} catch (_) {
			return {} as Record<string, string>;
		}
	})();

	const STAGE_CHIP_CLASS: Record<string, string> = {
		new_lead: 'stage-new_lead',
		visit_scheduled: 'stage-visit_scheduled',
		in_budgeting: 'stage-in_budgeting',
		proposal_sent: 'stage-proposal_sent',
		negotiation: 'stage-negotiation',
		won: 'stage-won',
		lost: 'stage-lost'
	};

	function stageLabel(stageId: string): string {
		const stage = STAGES.find(s => s.id === stageId);
		return stage ? stage.name : stageId;
	}

	// Set de lead_ids que ya cuentan con un presupuesto (borrador o enviado)
	function leadIdsWithBudget(): Set<string> {
		try {
			const ids = loadBudgets()
				.map((budget) => budget.lead_id)
				.filter((id): id is string => Boolean(id));
			return new Set(ids);
		} catch (_) {
			return new Set();
		}
	}

	// Actualiza KPIs, contadores de chips y estado del buscador (compartido por ambas vistas)
	function updateSummary(filteredLeads: Lead[]) {
		const totalInactiveCount = leads.filter(l => isLeadInactive(l)).length;
		const chipCountInactiveEl = document.getElementById('chip-count-inactive');
		if (chipCountInactiveEl) chipCountInactiveEl.textContent = totalInactiveCount.toString();

		// Update total leads count in "Todos" chip badge
		const chipCountAllEl = document.getElementById('chip-count-all');
		if (chipCountAllEl) chipCountAllEl.textContent = leads.length.toString();

		let grandTotalVal = 0;
		let activeLeadsCount = 0;
		filteredLeads.forEach((lead) => {
			if ((lead.stage || 'new_lead') !== 'lost') {
				grandTotalVal += (lead.estimated_budget || 0);
				activeLeadsCount += 1;
			}
		});

		// Actualizar tarjeta de estadísticas de la barra superior
		const totalCountEl = document.getElementById('total-leads-count');
		if (totalCountEl) totalCountEl.textContent = activeLeadsCount.toString();

		const totalMoneyEl = document.getElementById('total-pipeline-value');
		if (totalMoneyEl) totalMoneyEl.textContent = `$ ${grandTotalVal.toLocaleString('es-CO')} COP`;

		// Sincronizar pipeline con el Header global en tiempo real
		window.dispatchEvent(new CustomEvent('pipeline-updated', {
			detail: { count: activeLeadsCount, total: grandTotalVal }
		}));

		// Toggle search clear button
		const clearSearchBtn = document.getElementById('clear-search-btn');
		if (clearSearchBtn) clearSearchBtn.style.display = searchQuery ? 'flex' : 'none';
	}

	// Render the whole Kanban Board Reactively with Filter Support
	function renderKanban() {
		STAGES.forEach(({ id }) => {
			const container = document.getElementById(`cards-${id}`);
			if (container) container.innerHTML = '';
		});

		const filteredLeads = getFilteredLeads();
		updateSummary(filteredLeads);
		const budgetsByLead = leadIdsWithBudget();

		const stageSums: Record<string, { count: number; val: number }> = {
			new_lead: { count: 0, val: 0 },
			visit_scheduled: { count: 0, val: 0 },
			in_budgeting: { count: 0, val: 0 },
			proposal_sent: { count: 0, val: 0 },
			negotiation: { count: 0, val: 0 },
			won: { count: 0, val: 0 },
			lost: { count: 0, val: 0 }
		};

		filteredLeads.forEach((lead) => {
			const stage = lead.stage || 'new_lead';
			if (!stageSums[stage]) {
				stageSums[stage] = { count: 0, val: 0 };
			}
			stageSums[stage].count += 1;
			stageSums[stage].val += (lead.estimated_budget || 0);

			const container = document.getElementById(`cards-${stage}`);
			if (container) {
				const cardEl = createCardElement(lead, budgetsByLead.has(lead.id));
				container.appendChild(cardEl);
			}
		});

		// Update column headers & empty states
		STAGES.forEach(({ id }) => {
			const countPill = document.getElementById(`badge-count-${id}`);
			const valEl = document.getElementById(`val-${id}`);
			const stats = stageSums[id] || { count: 0, val: 0 };

			if (countPill) countPill.textContent = stats.count.toString();
			if (valEl) {
				valEl.textContent = `$ ${(stats.val / 1000000).toFixed(1)}M`;
			}

			// Empty State Placeholder
			const container = document.getElementById(`cards-${id}`);
			if (container && stats.count === 0) {
				const empty = document.createElement('div');
				empty.className = 'empty-column-placeholder';
				empty.textContent = searchQuery || activeTypeFilter !== 'all' || showOnlyInactive
					? 'Sin coincidencias'
					: 'Suelta una tarjeta aquí';
				container.appendChild(empty);
			}
		});
	}

	// Vista Lista: renderiza las oportunidades filtradas como filas accionables
	function renderList() {
		const rowsContainer = document.getElementById('funnel-list-rows');
		if (!rowsContainer) return;

		const filteredLeads = getFilteredLeads();
		updateSummary(filteredLeads);
		const budgetsByLead = leadIdsWithBudget();

		if (filteredLeads.length === 0) {
			const emptyText = searchQuery || activeTypeFilter !== 'all' || showOnlyInactive
				? 'Sin coincidencias para los filtros aplicados.'
				: 'Todavía no hay oportunidades en el embudo.';
			rowsContainer.innerHTML = `<div class="funnel-empty">${emptyText}</div>`;
			return;
		}

		rowsContainer.innerHTML = '';
		filteredLeads.forEach((lead) => {
			rowsContainer.appendChild(createListRowElement(lead, budgetsByLead.has(lead.id)));
		});
	}

	// Renderiza la vista activa (Kanban o Lista)
	function renderActiveView() {
		if (currentView === 'list') renderList();
		else renderKanban();
	}

