	function escapeHtml(text: string): string {
		const div = document.createElement('div');
		div.textContent = text;
		return div.innerHTML;
	}

	// Setup Drop Zones on all 7 Kanban Columns
	function setupDropZones() {
		const columns = document.querySelectorAll('.kanban-column');
		columns.forEach((col) => {
			col.addEventListener('dragover', (e) => {
				e.preventDefault();
				if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
				col.classList.add('drag-over');
			});

			col.addEventListener('dragleave', () => {
				col.classList.remove('drag-over');
			});

			col.addEventListener('drop', (e) => {
				e.preventDefault();
				col.classList.remove('drag-over');
				const targetStage = col.getAttribute('data-stage') as Lead['stage'];
				const leadId = draggedLeadId || (e.dataTransfer ? e.dataTransfer.getData('text/plain') : null);

				if (leadId && targetStage) {
					moveLeadToStage(leadId, targetStage);
				}
			});
		});
	}

	// Stage Transition Logic with Lost Interception and Won Celebration
	function moveLeadToStage(leadId: string, newStage: Lead['stage']) {
		const targetLead = leads.find(l => l.id === leadId);
		if (!targetLead) return;

		if (targetLead.stage === newStage) return;

		// Mandatory Lost Reason Scenario: Intercept before moving to lost
		if (newStage === 'lost') {
			openLostReasonModal(leadId);
			return;
		}

		targetLead.stage = newStage;
		targetLead.updated_at = new Date().toISOString();
		saveLeads(leads);
		renderActiveView();

		// Celebration Microanimation when won
		if (newStage === 'won') {
			triggerCelebration();
			window.dispatchEvent(new CustomEvent('show-toast', {
				detail: {
					title: '¡Contrato Ganado!',
					message: `¡Felicitaciones! "${targetLead.client_name}" es ahora una Obra Activa. Proyecto en ejecución.`,
					type: 'success'
				}
			}));
			return;
		}

		// Standard Stage Move Toast
		const stageObj = STAGES.find(s => s.id === newStage);
		window.dispatchEvent(new CustomEvent('show-toast', {
			detail: {
				title: 'Oportunidad actualizada',
				message: `${targetLead.client_name} se movió a "${stageObj?.name || newStage}".`,
				type: 'success'
			}
		}));
	}

	// Microanimation Canvas Particle Burst (Celebration on Won)
	function triggerCelebration() {
		const canvas = document.getElementById('celebration-canvas') as HTMLCanvasElement | null;
		if (!canvas) return;

		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		canvas.width = window.innerWidth;
		canvas.height = window.innerHeight;
		canvas.classList.add('active');

		const colors = ['#10B981', '#059669', '#34D399', '#F97316', '#EA580C', '#06B6D4', '#6366F1', '#FBBF24'];
		const particleCount = 110;
		const particles: Array<{
			x: number;
			y: number;
			vx: number;
			vy: number;
			size: number;
			color: string;
			rotation: number;
			vRot: number;
			opacity: number;
		}> = [];

		for (let i = 0; i < particleCount; i++) {
			particles.push({
				x: Math.random() * canvas.width,
				y: Math.random() * (canvas.height * 0.25) - 20,
				vx: (Math.random() - 0.5) * 7,
				vy: Math.random() * 4 + 3,
				size: Math.random() * 8 + 5,
				color: colors[Math.floor(Math.random() * colors.length)],
				rotation: Math.random() * 360,
				vRot: (Math.random() - 0.5) * 12,
				opacity: 1
			});
		}

		let animationId: number;
		const startTime = Date.now();
		const duration = 2800;

		function animate() {
			const elapsed = Date.now() - startTime;
			if (elapsed > duration) {
				ctx?.clearRect(0, 0, canvas.width, canvas.height);
				canvas.classList.remove('active');
				cancelAnimationFrame(animationId);
				return;
			}

			ctx.clearRect(0, 0, canvas.width, canvas.height);
			const fade = elapsed > duration - 700 ? (duration - elapsed) / 700 : 1;

			particles.forEach((p) => {
				p.x += p.vx;
				p.y += p.vy;
				p.rotation += p.vRot;
				p.vy += 0.08;

				ctx.save();
				ctx.translate(p.x, p.y);
				ctx.rotate((p.rotation * Math.PI) / 180);
				ctx.globalAlpha = Math.max(0, p.opacity * fade);
				ctx.fillStyle = p.color;
				ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 0.6);
				ctx.restore();
			});

			animationId = requestAnimationFrame(animate);
		}

		animate();
	}

	// ==========================================================================
	// MODAL 1: CAMBIAR ETAPA RÁPIDO (SIN ALERTAS NI PROMPTS DEL NAVEGADOR)
	// ==========================================================================
	const stageModal = document.getElementById('stage-move-modal');
	const stageBackdrop = document.getElementById('stage-move-backdrop');
	const closeStageBtn = document.getElementById('close-stage-modal-btn');
	const cancelStageBtn = document.getElementById('cancel-stage-modal-btn');
	const moveSubtitle = document.getElementById('move-modal-subtitle');
	const stageOptions = document.querySelectorAll('.stage-option-item');

	function openStageModal(lead: Lead) {
		currentActionLeadId = lead.id;
		if (moveSubtitle) {
			moveSubtitle.textContent = `Mover "${lead.client_name}" (${lead.project_type})`;
		}

		// Highlight current stage
		stageOptions.forEach((btn) => {
			const target = btn.getAttribute('data-stage-target');
			if (target === lead.stage) {
				btn.classList.add('current-stage');
			} else {
				btn.classList.remove('current-stage');
			}
		});

		stageModal?.classList.add('active');
	}

	function closeStageModal() {
		stageModal?.classList.remove('active');
		currentActionLeadId = null;
	}

	closeStageBtn?.addEventListener('click', closeStageModal);
	cancelStageBtn?.addEventListener('click', closeStageModal);
	stageBackdrop?.addEventListener('click', closeStageModal);

	stageOptions.forEach((btn) => {
		btn.addEventListener('click', () => {
			const targetStage = btn.getAttribute('data-stage-target') as Lead['stage'];
			if (currentActionLeadId && targetStage) {
				const leadIdToMove = currentActionLeadId;
				closeStageModal();
				moveLeadToStage(leadIdToMove, targetStage);
			}
		});
	});

	// ==========================================================================
	// MODAL 2: EDICIÓN COMPLETA DE LEAD
	// ==========================================================================
	const editModal = document.getElementById('edit-lead-modal');
	const editBackdrop = document.getElementById('edit-modal-backdrop');
	const closeEditBtn = document.getElementById('close-edit-modal-btn');
	const cancelEditBtn = document.getElementById('cancel-edit-btn');
	const deleteLeadTriggerBtn = document.getElementById('delete-lead-trigger-btn');
	const editForm = document.getElementById('edit-lead-form') as HTMLFormElement | null;

	const editIdInput = document.getElementById('edit-lead-id') as HTMLInputElement | null;
	const editNameInput = document.getElementById('edit-client-name') as HTMLInputElement | null;
	const editPhoneInput = document.getElementById('edit-client-phone') as HTMLInputElement | null;
	const editEmailInput = document.getElementById('edit-client-email') as HTMLInputElement | null;
	const editAddressInput = document.getElementById('edit-project-address') as HTMLInputElement | null;
	const editTypeSelect = document.getElementById('edit-project-type') as HTMLSelectElement | null;
	const editNotesInput = document.getElementById('edit-notes') as HTMLTextAreaElement | null;
	const editPhotosSection = document.getElementById('edit-photos-section');
	const editPhotosGallery = document.getElementById('edit-photos-gallery');
	const editBudgetInput = document.getElementById('edit-estimated-budget') as HTMLInputElement | null;
	const editStageSelect = document.getElementById('edit-stage-select') as HTMLSelectElement | null;

	function openEditModal(lead: Lead) {
		if (!editModal) return;
		currentActionLeadId = lead.id;
		if (editIdInput) editIdInput.value = lead.id;
		if (editNameInput) editNameInput.value = lead.client_name;
		if (editPhoneInput) editPhoneInput.value = lead.client_phone;
		if (editEmailInput) editEmailInput.value = lead.client_email || '';
		if (editAddressInput) editAddressInput.value = lead.project_address;
		if (editTypeSelect) editTypeSelect.value = lead.project_type;
		if (editNotesInput) editNotesInput.value = lead.notes || '';
		if (editBudgetInput) editBudgetInput.value = lead.estimated_budget ? lead.estimated_budget.toString() : '';
		if (editStageSelect) editStageSelect.value = lead.stage;

		const gotoVisitLink = document.getElementById('edit-goto-visit-link') as HTMLAnchorElement | null;
		if (gotoVisitLink) {
			gotoVisitLink.href = `/leads/${lead.id}/visit`;
		}

		// Render photo gallery if photos exist
		if (editPhotosSection && editPhotosGallery) {
			if (lead.photos && lead.photos.length > 0) {
				editPhotosSection.classList.remove('hidden');
				editPhotosGallery.innerHTML = lead.photos.map(p => `
					<div class="modal-photo-item" title="${escapeHtml(p.name)}">
						${p.dataUrl ? `<img src="${p.dataUrl}" alt="${escapeHtml(p.name)}" />` : `<div style="color:#94A3B8;font-size:10px;padding:8px;text-align:center;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:block;margin:0 auto 2px;"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>Foto</div>`}
					</div>
				`).join('');
			} else {
				editPhotosSection.classList.add('hidden');
				editPhotosGallery.innerHTML = '';
			}
		}

		editModal.classList.add('active');
	}

	function closeEditModal() {
		if (!editModal) return;
		editModal.classList.remove('active');
	}

	closeEditBtn?.addEventListener('click', closeEditModal);
	cancelEditBtn?.addEventListener('click', closeEditModal);
	editBackdrop?.addEventListener('click', closeEditModal);

	editForm?.addEventListener('submit', (e) => {
		e.preventDefault();
		const id = editIdInput?.value;
		if (!id) return;

		const target = leads.find(l => l.id === id);
		if (!target) return;

		const previousStage = target.stage;
		const newSelectedStage = (editStageSelect?.value as Lead['stage']) || target.stage;

		target.client_name = editNameInput?.value.trim() || target.client_name;
		target.client_phone = editPhoneInput?.value.trim() || target.client_phone;
		target.client_email = editEmailInput?.value.trim() || undefined;
		target.project_address = editAddressInput?.value.trim() || target.project_address;
		target.project_type = editTypeSelect?.value || target.project_type;
		target.notes = editNotesInput?.value.trim() || undefined;
		const rawBudget = editBudgetInput?.value.replace(/[^0-9]/g, '') || '0';
		target.estimated_budget = parseInt(rawBudget, 10) || 0;
		target.updated_at = new Date().toISOString();

		closeEditModal();

		// If user selected lost in edit form, route through mandatory lost modal
		if (newSelectedStage === 'lost' && previousStage !== 'lost') {
			saveLeads(leads);
			renderActiveView();
			openLostReasonModal(target.id);
			return;
		}

		target.stage = newSelectedStage;
		saveLeads(leads);
		renderActiveView();

		if (newSelectedStage === 'won' && previousStage !== 'won') {
			triggerCelebration();
			window.dispatchEvent(new CustomEvent('show-toast', {
				detail: {
					title: '¡Contrato Ganado!',
					message: `"${target.client_name}" ahora es una Obra Activa. Proyecto en ejecución.`,
					type: 'success'
				}
			}));
		} else {
			window.dispatchEvent(new CustomEvent('show-toast', {
				detail: {
					title: 'Cambios guardados',
					message: `Oportunidad "${target.client_name}" actualizada con éxito.`,
					type: 'success'
				}
			}));
		}
	});

	// ==========================================================================
	// MODAL 3: CONFIRMACIÓN DE ELIMINACIÓN PERSONALIZADA (SIN CONFIRM NATIVO)
	// ==========================================================================
	const deleteModal = document.getElementById('delete-confirm-modal');
	const deleteBackdrop = document.getElementById('delete-confirm-backdrop');
	const cancelDeleteBtn = document.getElementById('cancel-delete-modal-btn');
	const confirmDeleteBtn = document.getElementById('confirm-delete-action-btn');
	const deleteConfirmText = document.getElementById('delete-confirm-text');

	function openDeleteModal(leadId: string) {
		const target = leads.find(l => l.id === leadId);
		if (!target) return;

		currentActionLeadId = leadId;
		if (deleteConfirmText) {
			deleteConfirmText.textContent = `¿Estás seguro de que deseas eliminar permanentemente a "${target.client_name}"? Esta acción no se puede deshacer.`;
		}

		deleteModal?.classList.add('active');
	}

	function closeDeleteModal() {
		deleteModal?.classList.remove('active');
	}

	deleteLeadTriggerBtn?.addEventListener('click', () => {
		const id = editIdInput?.value;
		if (id) {
			closeEditModal();
			openDeleteModal(id);
		}
	});

	cancelDeleteBtn?.addEventListener('click', closeDeleteModal);
	deleteBackdrop?.addEventListener('click', closeDeleteModal);

	confirmDeleteBtn?.addEventListener('click', () => {
		if (!currentActionLeadId) return;

		const target = leads.find(l => l.id === currentActionLeadId);
		const name = target ? target.client_name : 'Oportunidad';

		leads = leads.filter(l => l.id !== currentActionLeadId);
		saveLeads(leads);
		renderActiveView();
		closeDeleteModal();

		window.dispatchEvent(new CustomEvent('show-toast', {
			detail: {
				title: 'Lead eliminado',
				message: `Se ha descartado a "${name}".`,
				type: 'warning'
			}
		}));
	});

	// ==========================================================================
	// MODAL 3.5: CONFIRMACIÓN DE CREACIÓN DE BORRADOR DE PRESUPUESTO
	// ==========================================================================
	const budgetConfirmModal = document.getElementById('budget-confirm-modal');
	const budgetConfirmBackdrop = document.getElementById('budget-confirm-backdrop');
	const cancelBudgetBtn = document.getElementById('cancel-budget-modal-btn');
	const confirmBudgetBtn = document.getElementById('confirm-budget-action-btn');
	const budgetConfirmText = document.getElementById('budget-confirm-text');
	let pendingBudgetLeadId: string | null = null;

	function openBudgetConfirmModal(lead: Lead) {
		pendingBudgetLeadId = lead.id;
		if (budgetConfirmText) {
			budgetConfirmText.textContent = `Aún no existe un borrador para "${lead.client_name}". Se creará uno nuevo y se abrirá el constructor.`;
		}
		budgetConfirmModal?.classList.add('active');
	}

	function closeBudgetConfirmModal() {
		budgetConfirmModal?.classList.remove('active');
		pendingBudgetLeadId = null;
	}

	cancelBudgetBtn?.addEventListener('click', closeBudgetConfirmModal);
	budgetConfirmBackdrop?.addEventListener('click', closeBudgetConfirmModal);

	confirmBudgetBtn?.addEventListener('click', () => {
		const leadId = pendingBudgetLeadId;
		const target = leadId ? leads.find(l => l.id === leadId) : undefined;
		closeBudgetConfirmModal();
		if (target) createLeadBudgetDraft(target);
	});

	// ==========================================================================
	// MODAL 4: MOTIVO DE PÉRDIDA OBLIGATORIO (HU-03 GHERKIN SCENARIO)
	// ==========================================================================
	const lostModal = document.getElementById('lost-reason-modal');
	const lostBackdrop = document.getElementById('lost-reason-backdrop');
	const closeLostBtn = document.getElementById('close-lost-modal-btn');
	const cancelLostBtn = document.getElementById('cancel-lost-modal-btn');
	const confirmLostBtn = document.getElementById('confirm-lost-btn') as HTMLButtonElement | null;
	const lostLeadNameEl = document.getElementById('lost-lead-name');
	const lostRadios = document.querySelectorAll<HTMLInputElement>('input[name="lost_reason_choice"]');
	const lostOtherWrap = document.getElementById('lost-other-detail-wrap');
	const lostOtherText = document.getElementById('lost-other-text') as HTMLInputElement | null;

	function openLostReasonModal(leadId: string) {
		pendingLostLeadId = leadId;
		const target = leads.find(l => l.id === leadId);
		if (!target) return;

		if (lostLeadNameEl) {
			lostLeadNameEl.textContent = `${target.client_name} (${target.project_type})`;
		}

		// Reset selection
		lostRadios.forEach((r) => {
			r.checked = false;
		});

		if (lostOtherWrap) lostOtherWrap.classList.add('hidden');
		if (lostOtherText) lostOtherText.value = '';
		if (confirmLostBtn) confirmLostBtn.disabled = true;

		lostModal?.classList.add('active');
	}

	function closeLostReasonModal() {
		lostModal?.classList.remove('active');
		pendingLostLeadId = null;
		// Re-render kanban so card is guaranteed displayed in original column if aborted
		renderActiveView();
	}

	lostRadios.forEach((radio) => {
		radio.addEventListener('change', () => {
			if (confirmLostBtn) confirmLostBtn.disabled = false;
			if (radio.value === 'Otro') {
				lostOtherWrap?.classList.remove('hidden');
				lostOtherText?.focus();
			} else {
				lostOtherWrap?.classList.add('hidden');
			}
		});
	});

	closeLostBtn?.addEventListener('click', closeLostReasonModal);
	cancelLostBtn?.addEventListener('click', closeLostReasonModal);
	lostBackdrop?.addEventListener('click', closeLostReasonModal);

	confirmLostBtn?.addEventListener('click', () => {
		if (!pendingLostLeadId) return;

		const target = leads.find(l => l.id === pendingLostLeadId);
		if (!target) {
			closeLostReasonModal();
			return;
		}

		const selectedRadio = document.querySelector<HTMLInputElement>('input[name="lost_reason_choice"]:checked');
		let reason = selectedRadio ? selectedRadio.value : 'Sin especificar';

		if (reason === 'Otro') {
			const detail = lostOtherText?.value.trim();
			reason = detail ? `Otro: ${detail}` : 'Otro motivo';
		}

		target.stage = 'lost';
		target.lost_reason = reason;
		target.updated_at = new Date().toISOString();

		saveLeads(leads);
		renderActiveView();

		lostModal?.classList.remove('active');
		pendingLostLeadId = null;

		window.dispatchEvent(new CustomEvent('show-toast', {
			detail: {
				title: 'Oportunidad descartada',
				message: `"${target.client_name}" se marcó como Perdido (${reason}).`,
				type: 'warning'
			}
		}));
	});

	// ==========================================================================
	// BARRA DE BÚSQUEDA Y FILTROS RÁPIDOS (HU-03 OPERATE MODE)
	// ==========================================================================
	const kanbanSearchInput = document.getElementById('kanban-search-input') as HTMLInputElement | null;
	const clearSearchBtn = document.getElementById('clear-search-btn');
	const filterChips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
	const filterInactiveBtn = document.getElementById('filter-inactive-btn');

	kanbanSearchInput?.addEventListener('input', (e) => {
		searchQuery = (e.target as HTMLInputElement).value.trim();
		renderActiveView();
	});

	clearSearchBtn?.addEventListener('click', () => {
		searchQuery = '';
		if (kanbanSearchInput) kanbanSearchInput.value = '';
		renderActiveView();
	});

	filterChips.forEach((chip) => {
		chip.addEventListener('click', () => {
			filterChips.forEach(c => {
				c.classList.remove('active');
				c.setAttribute('aria-pressed', 'false');
			});
			chip.classList.add('active');
			chip.setAttribute('aria-pressed', 'true');
			activeTypeFilter = chip.getAttribute('data-filter-type') || 'all';
			renderActiveView();
		});
	});

	filterInactiveBtn?.addEventListener('click', () => {
		showOnlyInactive = !showOnlyInactive;
		if (showOnlyInactive) {
			filterInactiveBtn.classList.add('active');
			filterInactiveBtn.setAttribute('aria-pressed', 'true');
		} else {
			filterInactiveBtn.classList.remove('active');
			filterInactiveBtn.setAttribute('aria-pressed', 'false');
		}
		renderActiveView();
	});

	// Close modals on Escape key
	window.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') {
			closeStageModal();
			closeEditModal();
			closeDeleteModal();
			closeLostReasonModal();
			closeBudgetConfirmModal();
		}
	});

	// Listen for new lead created from HU-01 Modal or HU-02 Public Form
	window.addEventListener('lead-created', (e: any) => {
		const newLeadData = e.detail;
		if (!newLeadData) return;

		// Check if lead already exists in state
		const existingIdx = leads.findIndex(l => l.id === newLeadData.id);
		if (existingIdx >= 0) {
			leads[existingIdx] = { ...leads[existingIdx], ...newLeadData, updated_at: new Date().toISOString() };
		} else {
			const newLead: Lead = {
				id: newLeadData.id || 'lead_' + Date.now().toString(36),
				client_name: newLeadData.client_name,
				client_phone: newLeadData.client_phone,
				client_email: newLeadData.client_email,
				project_address: newLeadData.project_address,
				project_type: newLeadData.project_type,
				notes: newLeadData.notes,
				estimated_budget: newLeadData.estimated_budget || 0,
				stage: newLeadData.stage || 'new_lead',
				source: newLeadData.source || 'manual',
				photos_count: newLeadData.photos_count || (newLeadData.photos ? newLeadData.photos.length : 0),
				photos: newLeadData.photos,
				created_at: newLeadData.created_at || new Date().toISOString(),
				updated_at: new Date().toISOString()
			};

			leads.unshift(newLead);
		}

		saveLeads(leads);
		renderActiveView();
	});

	// Storage Event listener for real-time sync across browser tabs / iframes
	window.addEventListener('storage', (e) => {
		if (e.key === 'obraflow_leads') {
			leads = loadLeads();
			renderActiveView();
		}
	});

	// Message Event listener for iframes (ej. Live Preview embebido)
	window.addEventListener('message', (e) => {
		if (e.data && e.data.type === 'obraflow:lead-created' && e.data.lead) {
			window.dispatchEvent(new CustomEvent('lead-created', { detail: e.data.lead }));
		}
	});

	// Kanban Share Web Form Button Listener
	document.getElementById('kanban-share-form-btn')?.addEventListener('click', () => {
		window.dispatchEvent(new CustomEvent('open-share-form-modal'));
	});

	// Initial Render and Drop Zones Attachment
	setupDropZones();
	applyView();
</script>
