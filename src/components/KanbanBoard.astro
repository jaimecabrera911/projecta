---
// src/components/KanbanBoard.astro
// Fully Interactive CRM Board with Drag & Drop, In-Place Editing, Custom Modals (No native alerts/prompts)
import Icon from './Icon';
import { iconSvg } from '../lib/icon-svg';

// Iconos react-icons (Tabler). Se pre-renderizan a SVG para reutilizarlos
// en el HTML que genera el script cliente (tarjetas y filas de la lista).
const funnelIcons = {
	budget: iconSvg('budget', { size: 18 }),
	visit: iconSvg('visit', { size: 18 }),
	move: iconSvg('move', { size: 18 }),
	whatsapp: iconSvg('whatsapp', { size: 18 })
};
---

<script type="application/json" id="funnel-icons-data" set:html={JSON.stringify(funnelIcons)}></script>

<div class="kanban-wrapper">
	<!-- Control & Filter Bar -->
	<div class="kanban-topbar">
		<div>
			<div class="title-row">
				<h1 class="main-heading">
					Embudo Comercial de Obras
				</h1>
				<span class="live-pill">
					<span class="live-dot"></span>
					Interactivo
				</span>
			</div>
			<p class="subtitle">
				Arrastra las tarjetas entre columnas, edita datos o haz clic en <kbd class="kbd-hint">Mover</kbd> para cambiar de etapa.
			</p>
		</div>

		<!-- Actions & Action Stats -->
		<div class="topbar-actions-wrap">
			<!-- Conmutador de formato: Kanban / Lista -->
			<div id="funnel-view-toggle" class="view-toggle" role="group" aria-label="Formato de visualización del embudo">
				<button
					type="button"
					id="view-toggle-kanban"
					class="view-toggle-btn active"
					data-view="kanban"
					aria-pressed="true"
					title="Ver el embudo como tablero Kanban por etapas"
				>
					<Icon name="kanban" size={16} />
					<span>Kanban</span>
				</button>
				<button
					type="button"
					id="view-toggle-list"
					class="view-toggle-btn"
					data-view="list"
					aria-pressed="false"
					title="Ver el embudo como lista ordenada"
				>
					<Icon name="list" size={16} />
					<span>Lista</span>
				</button>
			</div>

			<!-- Action Stats -->
			<div class="stats-card" id="kanban-action-stats-card">
				<div>
					<span class="stat-label">Total Leads</span>
					<span id="total-leads-count" class="stat-value">0</span>
				</div>
				<div class="stat-divider"></div>
				<div>
					<span class="stat-label">Pipeline Activo</span>
					<span id="total-pipeline-value" class="stat-val-money">$ 0 COP</span>
				</div>
			</div>

			<button
				id="kanban-share-form-btn"
				type="button"
				class="btn-kanban-share"
				title="Abrir y compartir enlace de formulario público (HU-02)"
			>
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
					<circle cx="12" cy="12" r="10"></circle>
					<line x1="2" y1="12" x2="22" y2="12"></line>
					<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
				</svg>
				<span>Formulario Web</span>
			</button>
		</div>
	</div>

	<!-- Search & Fast Filters Bar (Operate Mode - HU-03) -->
	<div class="kanban-filters-bar">
		<div class="search-input-wrap">
			<span class="search-icon">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<circle cx="11" cy="11" r="8"></circle>
					<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
				</svg>
			</span>
			<input
				type="search"
				id="kanban-search-input"
				placeholder="Buscar por cliente, dirección o teléfono..."
				class="kanban-search-field"
				autocomplete="off"
				aria-label="Buscar prospectos"
			/>
			<button
				type="button"
				id="clear-search-btn"
				class="clear-search-btn hidden"
				title="Limpiar búsqueda"
				aria-label="Limpiar búsqueda"
			>
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
					<line x1="18" y1="6" x2="6" y2="18"></line>
					<line x1="6" y1="6" x2="18" y2="18"></line>
				</svg>
			</button>
		</div>

		<div class="filter-chips-row" role="group" aria-label="Filtros rápidos por tipo de obra">
			<button type="button" class="filter-chip active" data-filter-type="all" aria-pressed="true">
				<span>Todos</span>
				<span id="chip-count-all" class="chip-count-pill">0</span>
			</button>
			<button type="button" class="filter-chip" data-filter-type="Remodelación Total" aria-pressed="false">
				<span>Remodelación Total</span>
			</button>
			<button type="button" class="filter-chip" data-filter-type="Cocina Integral" aria-pressed="false">
				<span>Cocina</span>
			</button>
			<button type="button" class="filter-chip" data-filter-type="Baño" aria-pressed="false">
				<span>Baño</span>
			</button>
			<button type="button" class="filter-chip" data-filter-type="Pintura y Acabados" aria-pressed="false">
				<span>Pintura</span>
			</button>
			<button type="button" class="filter-chip" data-filter-type="Adecuación Comercial" aria-pressed="false">
				<span>Comercial</span>
			</button>

			<div class="filter-divider"></div>

			<!-- Inactivity Toggle Chip -->
			<button
				type="button"
				class="filter-chip chip-inactive"
				id="filter-inactive-btn"
				data-filter-inactive="false"
				aria-pressed="false"
				title="Mostrar solo prospectos con más de 3 días sin actualizar"
			>
				<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
					<circle cx="12" cy="12" r="10"></circle>
					<polyline points="12 6 12 12 16 14"></polyline>
				</svg>
				<span>Inactivos (&gt; 3d)</span>
				<span id="chip-count-inactive" class="chip-count-pill alert-pill">0</span>
			</button>
		</div>
	</div>

	<!-- Kanban Columns Scroll Container -->
	<div class="kanban-scroll" id="kanban-columns-container">
		
		<!-- COLUMNA 1: NUEVO LEAD -->
		<div class="kanban-column column-highlight" data-stage="new_lead" id="col-wrapper-new_lead">
			<div class="column-header">
				<div class="header-left">
					<span class="header-indicator orange-bg"></span>
					<h3 class="col-title">Nuevo Lead</h3>
					<span id="badge-count-new_lead" class="count-pill orange-pill">0</span>
				</div>
				<span id="val-new_lead" class="col-money">$ 0</span>
			</div>
			<div class="cards-container" data-stage="new_lead" id="cards-new_lead">
				<!-- Dynamically rendered -->
			</div>
		</div>

		<!-- COLUMNA 2: VISITA AGENDADA -->
		<div class="kanban-column" data-stage="visit_scheduled" id="col-wrapper-visit_scheduled">
			<div class="column-header">
				<div class="header-left">
					<span class="header-indicator blue-bg"></span>
					<h3 class="col-title">Visita Agendada</h3>
					<span id="badge-count-visit_scheduled" class="count-pill blue-pill">0</span>
				</div>
				<span id="val-visit_scheduled" class="col-money">$ 0</span>
			</div>
			<div class="cards-container" data-stage="visit_scheduled" id="cards-visit_scheduled">
				<!-- Dynamically rendered -->
			</div>
		</div>

		<!-- COLUMNA 3: EN PRESUPUESTO -->
		<div class="kanban-column" data-stage="in_budgeting" id="col-wrapper-in_budgeting">
			<div class="column-header">
				<div class="header-left">
					<span class="header-indicator purple-bg"></span>
					<h3 class="col-title">En Presupuesto</h3>
					<span id="badge-count-in_budgeting" class="count-pill purple-pill">0</span>
				</div>
				<span id="val-in_budgeting" class="col-money">$ 0</span>
			</div>
			<div class="cards-container" data-stage="in_budgeting" id="cards-in_budgeting">
				<!-- Dynamically rendered -->
			</div>
		</div>

		<!-- COLUMNA 4: PROPUESTA ENVIADA -->
		<div class="kanban-column" data-stage="proposal_sent" id="col-wrapper-proposal_sent">
			<div class="column-header">
				<div class="header-left">
					<span class="header-indicator amber-bg"></span>
					<h3 class="col-title">Propuesta Enviada</h3>
					<span id="badge-count-proposal_sent" class="count-pill amber-pill">0</span>
				</div>
				<span id="val-proposal_sent" class="col-money">$ 0</span>
			</div>
			<div class="cards-container" data-stage="proposal_sent" id="cards-proposal_sent">
				<!-- Dynamically rendered -->
			</div>
		</div>

		<!-- COLUMNA 5: EN NEGOCIACIÓN (HU-03) -->
		<div class="kanban-column column-negotiation" data-stage="negotiation" id="col-wrapper-negotiation">
			<div class="column-header">
				<div class="header-left">
					<span class="header-indicator cyan-bg"></span>
					<h3 class="col-title">En Negociación</h3>
					<span id="badge-count-negotiation" class="count-pill cyan-pill">0</span>
				</div>
				<span id="val-negotiation" class="col-money">$ 0</span>
			</div>
			<div class="cards-container" data-stage="negotiation" id="cards-negotiation">
				<!-- Dynamically rendered -->
			</div>
		</div>

		<!-- COLUMNA 6: GANADO / OBRA ACTIVA -->
		<div class="kanban-column column-won" data-stage="won" id="col-wrapper-won">
			<div class="column-header won-header">
				<div class="header-left">
					<span class="header-indicator emerald-bg"></span>
					<h3 class="col-title won-title">Ganado / Obra</h3>
					<span id="badge-count-won" class="count-pill emerald-pill">0</span>
				</div>
				<span id="val-won" class="col-money emerald-text">$ 0</span>
			</div>
			<div class="cards-container" data-stage="won" id="cards-won">
				<!-- Dynamically rendered -->
			</div>
		</div>

		<!-- COLUMNA 7: PERDIDO / DESCARTADO -->
		<div class="kanban-column column-lost" data-stage="lost" id="col-wrapper-lost">
			<div class="column-header">
				<div class="header-left">
					<span class="header-indicator slate-bg"></span>
					<h3 class="col-title text-slate-500">Perdido</h3>
					<span id="badge-count-lost" class="count-pill slate-pill">0</span>
				</div>
				<span id="val-lost" class="col-money text-slate-400">$ 0</span>
			</div>
			<div class="cards-container" data-stage="lost" id="cards-lost">
				<!-- Dynamically rendered -->
			</div>
		</div>

	</div>

	<!-- Vista Lista del Embudo (alterna con el Kanban) -->
	<section id="funnel-list-view" class="funnel-list hidden" aria-label="Embudo de ventas en formato lista">
		<div class="funnel-list-head" aria-hidden="true">
			<span>Oportunidad</span>
			<span>Etapa</span>
			<span>Presupuesto</span>
			<span>Acciones</span>
		</div>
		<div id="funnel-list-rows" class="funnel-list-rows"></div>
	</section>
</div>

<!-- ==========================================================================
     MODAL 1: CAMBIAR ETAPA RÁPIDO (REEMPLAZA EL ALERT / PROMPT)
     ========================================================================== -->
<div id="stage-move-modal" class="modal-backdrop-wrap" role="dialog" aria-modal="true" aria-labelledby="move-modal-title">
	<div id="stage-move-backdrop" class="modal-backdrop-blur"></div>
	<div class="modal-card-box modal-sm">
		<div class="modal-header">
			<div class="title-wrap">
				<div class="header-icon move-icon">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
						<polyline points="9 18 15 12 9 6"></polyline>
					</svg>
				</div>
				<div>
					<h2 id="move-modal-title" class="title-text">Mover a Otra Etapa</h2>
					<p id="move-modal-subtitle" class="subtitle-text">Selecciona el nuevo tablero para el lead</p>
				</div>
			</div>
			<button id="close-stage-modal-btn" type="button" class="btn-close" aria-label="Cerrar modal">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<line x1="18" y1="6" x2="6" y2="18"></line>
					<line x1="6" y1="6" x2="18" y2="18"></line>
				</svg>
			</button>
		</div>

		<div class="stage-options-list" id="stage-options-container">
			<!-- Option 1: Nuevo Lead -->
			<button type="button" class="stage-option-item" data-stage-target="new_lead">
				<div class="stage-opt-icon orange-bg"></div>
				<div class="stage-opt-text">
					<span class="stage-opt-title">Nuevo Lead</span>
					<span class="stage-opt-desc">Prospecto recién capturado en campo o web</span>
				</div>
				<span class="stage-check-mark">
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<line x1="5" y1="12" x2="19" y2="12"></line>
						<polyline points="12 5 19 12 12 19"></polyline>
					</svg>
				</span>
			</button>

			<!-- Option 2: Visita Agendada -->
			<button type="button" class="stage-option-item" data-stage-target="visit_scheduled">
				<div class="stage-opt-icon blue-bg"></div>
				<div class="stage-opt-text">
					<span class="stage-opt-title">Visita Agendada</span>
					<span class="stage-opt-desc">Inspección técnica y levantamiento de medidas</span>
				</div>
				<span class="stage-check-mark">
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<line x1="5" y1="12" x2="19" y2="12"></line>
						<polyline points="12 5 19 12 12 19"></polyline>
					</svg>
				</span>
			</button>

			<!-- Option 3: En Presupuesto -->
			<button type="button" class="stage-option-item" data-stage-target="in_budgeting">
				<div class="stage-opt-icon purple-bg"></div>
				<div class="stage-opt-text">
					<span class="stage-opt-title">En Presupuesto</span>
					<span class="stage-opt-desc">Elaboración de costos y capítulos (IVA / AIU)</span>
				</div>
				<span class="stage-check-mark">
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<line x1="5" y1="12" x2="19" y2="12"></line>
						<polyline points="12 5 19 12 12 19"></polyline>
					</svg>
				</span>
			</button>

			<!-- Option 4: Propuesta Enviada -->
			<button type="button" class="stage-option-item" data-stage-target="proposal_sent">
				<div class="stage-opt-icon amber-bg"></div>
				<div class="stage-opt-text">
					<span class="stage-opt-title">Propuesta Enviada</span>
					<span class="stage-opt-desc">Oferta comercial compartida (Magic Link o PDF)</span>
				</div>
				<span class="stage-check-mark">
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<line x1="5" y1="12" x2="19" y2="12"></line>
						<polyline points="12 5 19 12 12 19"></polyline>
					</svg>
				</span>
			</button>

			<!-- Option 5: En Negociación (HU-03) -->
			<button type="button" class="stage-option-item" data-stage-target="negotiation">
				<div class="stage-opt-icon cyan-bg"></div>
				<div class="stage-opt-text">
					<span class="stage-opt-title">En Negociación</span>
					<span class="stage-opt-desc">Ajuste de presupuesto y cierre contractual</span>
				</div>
				<span class="stage-check-mark">
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<line x1="5" y1="12" x2="19" y2="12"></line>
						<polyline points="12 5 19 12 12 19"></polyline>
					</svg>
				</span>
			</button>

			<!-- Option 6: Ganado / Obra -->
			<button type="button" class="stage-option-item" data-stage-target="won">
				<div class="stage-opt-icon emerald-bg"></div>
				<div class="stage-opt-text">
					<span class="stage-opt-title">Ganado / Obra Activa</span>
					<span class="stage-opt-desc">Contrato firmado y obra en ejecución</span>
				</div>
				<span class="stage-check-mark">
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<line x1="5" y1="12" x2="19" y2="12"></line>
						<polyline points="12 5 19 12 12 19"></polyline>
					</svg>
				</span>
			</button>

			<!-- Option 7: Perdido -->
			<button type="button" class="stage-option-item" data-stage-target="lost">
				<div class="stage-opt-icon slate-bg"></div>
				<div class="stage-opt-text">
					<span class="stage-opt-title">Perdido / Descartado</span>
					<span class="stage-opt-desc">Rechazado, desistido o sin respuesta</span>
				</div>
				<span class="stage-check-mark">
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<line x1="5" y1="12" x2="19" y2="12"></line>
						<polyline points="12 5 19 12 12 19"></polyline>
					</svg>
				</span>
			</button>
		</div>

		<div class="modal-footer-simple">
			<button id="cancel-stage-modal-btn" type="button" class="btn-cancel w-full">
				Cancelar
			</button>
		</div>
	</div>
</div>

<!-- ==========================================================================
     MODAL 2: EDICIÓN COMPLETA DE LEAD
     ========================================================================== -->
<div id="edit-lead-modal" class="modal-backdrop-wrap" role="dialog" aria-modal="true" aria-labelledby="edit-modal-title">
	<div id="edit-modal-backdrop" class="modal-backdrop-blur"></div>
	<div class="modal-card-box">
		<div class="modal-header">
			<div class="title-wrap">
				<div class="header-icon edit-icon">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
						<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
						<path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
					</svg>
				</div>
				<div>
					<h2 id="edit-modal-title" class="title-text">Editar Oportunidad</h2>
					<p class="subtitle-text">Modifica los datos del cliente o cambia su estado</p>
				</div>
			</div>
			<button id="close-edit-modal-btn" type="button" class="btn-close" aria-label="Cerrar modal">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<line x1="18" y1="6" x2="6" y2="18"></line>
					<line x1="6" y1="6" x2="18" y2="18"></line>
				</svg>
			</button>
		</div>

		<form id="edit-lead-form" class="modal-form">
			<input type="hidden" id="edit-lead-id" />

			<div class="form-group">
				<label for="edit-client-name" class="form-label">Nombre del Cliente *</label>
				<input type="text" id="edit-client-name" required class="text-input" />
			</div>

			<div class="form-group">
				<label for="edit-client-phone" class="form-label">Teléfono / WhatsApp *</label>
				<input type="tel" id="edit-client-phone" required class="text-input font-mono" />
			</div>

			<div class="form-group">
				<label for="edit-client-email" class="form-label">Correo Electrónico (Opcional)</label>
				<input type="email" id="edit-client-email" class="text-input" placeholder="cliente@correo.com" />
			</div>

			<div class="form-group">
				<label for="edit-project-address" class="form-label">Dirección / Inmueble *</label>
				<input type="text" id="edit-project-address" required class="text-input" />
			</div>

			<div class="form-group">
				<label for="edit-project-type" class="form-label">Tipo de Obra *</label>
				<select id="edit-project-type" class="text-input select-input">
					<option value="Remodelación Total">Remodelación Total</option>
					<option value="Cocina Integral">Cocina Integral</option>
					<option value="Baño">Baño</option>
					<option value="Pintura y Acabados">Pintura y Acabados</option>
					<option value="Adecuación Comercial">Adecuación Comercial</option>
					<option value="Otro">Otro</option>
				</select>
			</div>

			<div class="form-group">
				<label for="edit-notes" class="form-label">Notas / Necesidades del Cliente</label>
				<textarea id="edit-notes" rows="2" class="text-input" placeholder="Detalles de la solicitud"></textarea>
			</div>

			<!-- Attached Photos Gallery Preview if any -->
			<div id="edit-photos-section" class="form-group hidden">
				<label class="form-label">Fotos Adjuntas del Espacio</label>
				<div id="edit-photos-gallery" class="modal-photos-gallery"></div>
			</div>

			<div class="form-group">
				<label for="edit-estimated-budget" class="form-label">Presupuesto Estimado (COP)</label>
				<input type="text" id="edit-estimated-budget" class="text-input font-mono" />
			</div>

			<div class="form-group">
				<label for="edit-stage-select" class="form-label">Etapa / Tablero *</label>
				<select id="edit-stage-select" class="text-input select-input font-bold">
					<option value="new_lead">Nuevo Lead</option>
					<option value="visit_scheduled">Visita Agendada</option>
					<option value="in_budgeting">En Presupuesto</option>
