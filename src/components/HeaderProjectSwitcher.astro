---
// src/components/HeaderProjectSwitcher.astro
// Selector de Obra Fijada: abre modal con buscador y permite fijar/desfijar.
import { renderIconSvg } from '../lib/icons';
---
 
 <div id="header-project-switcher" class="header-project-container">
 	<button
 		id="btn-header-project-trigger"
 		type="button"
 		class="btn-project-trigger"
 		aria-haspopup="dialog"
 		aria-expanded="false"
 		aria-label="Fijar obra activa para la plataforma"
 		title="Fijar obra activa para toda la plataforma"
 	>
 		<div class="project-pin-badge" id="header-project-pin-badge" aria-hidden="true">
 			<span class="pin-icon" set:html={renderIconSvg('pin', { size: 16 })}></span>
 		</div>
 		<div class="project-text-cluster">
 			<div class="project-kicker-row">
 				<span class="project-kicker">Obra Fijada</span>
 				<span id="header-project-status-dot" class="project-status-dot hidden" aria-hidden="true" title="Obra activa en ejecución"></span>
 			</div>
 			<div class="project-title-row">
 				<span id="header-project-title" class="project-title">Sin obra fijada</span>
 				<span class="chevron-icon"><Fragment set:html={renderIconSvg('chevronDown', { size: 12 })} /></span>
 			</div>
 		</div>
 	</button>
 
 	<div id="header-project-modal" class="project-modal-backdrop hidden" role="dialog" aria-modal="true" aria-labelledby="project-modal-title">
 		<div class="project-modal-card">
 			<div class="project-modal-header">
 				<div>
 					<p class="dropdown-kicker">Obra activa</p>
 					<h4 id="project-modal-title" class="dropdown-title">Fijar obra en ejecución</h4>
 					<p class="dropdown-subtitle">Busca y selecciona una obra. Si no eliges ninguna, no se fijará nada.</p>
 				</div>
 				<button type="button" id="btn-close-project-modal" class="btn-close-modal" aria-label="Cerrar selector de obra">
 					<Fragment set:html={renderIconSvg('x', { size: 18 })} />
 				</button>
 			</div>
 
 			<div class="project-modal-tools">
 				<label class="search-wrap" for="project-search-input">
 					<span class="search-icon" aria-hidden="true"><Fragment set:html={renderIconSvg('search', { size: 16 })} /></span>
 					<input id="project-search-input" type="search" class="search-input" placeholder="Buscar por obra, cliente o dirección..." autocomplete="off" />
 				</label>
 				<button type="button" id="btn-unpin-project" class="btn-unpin">
 					<Fragment set:html={renderIconSvg('pinnedOff', { size: 16 })} />
 					<span>No fijar ninguna</span>
 				</button>
 			</div>
 
 			<div class="project-options-list" id="header-project-options-list"></div>
 			<div class="dropdown-footer">
 				<span class="dropdown-hint" set:html={`${renderIconSvg('bulb', { size: 14 })} La obra fijada se mantiene activa en todos los módulos.`}></span>
 			</div>
 		</div>
 	</div>
 </div>

<style>
	.header-project-container {
		position: relative;
		display: inline-block;
	}

	.btn-project-trigger {
		min-height: 48px;
		display: flex;
		align-items: center;
		gap: 0.625rem;
		padding: 0.35rem 0.75rem;
		background-color: #1E293B;
		border: 1.5px solid #334155;
		border-radius: 0.625rem;
		color: #F8FAFC;
		cursor: pointer;
		transition: all 0.15s ease;
		max-width: 270px;
		text-align: left;
	}

	.btn-project-trigger:hover {
		background-color: #27354A;
		border-color: #F97316;
	}

	.btn-project-trigger:focus-visible {
		outline: 2px solid #F97316;
		outline-offset: 2px;
	}

	.project-pin-badge {
		width: 32px;
		height: 32px;
		min-width: 32px;
		background: linear-gradient(135deg, rgba(249, 115, 22, 0.2) 0%, rgba(234, 88, 12, 0.3) 100%);
		border: 1px solid rgba(249, 115, 22, 0.4);
		border-radius: 0.375rem;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.9375rem;
		flex-shrink: 0;
	}

	.project-text-cluster {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
		flex: 1;
	}

	.project-kicker-row {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}

	.project-kicker {
		font-size: 0.625rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: #FB923C;
	}

	.project-status-dot {
		width: 6px;
		height: 6px;
		background-color: #10B981;
		border-radius: 50%;
		box-shadow: 0 0 6px #10B981;
		flex-shrink: 0;
	}

	.project-title-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.4rem;
	}

	.project-title {
		font-size: 0.8125rem;
		font-weight: 800;
		color: #FFFFFF;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 175px;
		letter-spacing: -0.01em;
	}

	.chevron-icon {
		color: #94A3B8;
		transition: transform 0.15s ease;
		flex-shrink: 0;
	}

	.btn-project-trigger[aria-expanded='true'] .chevron-icon {
		transform: rotate(180deg);
		color: #F97316;
	}

	/* Modal */
	.project-modal-backdrop { position: fixed; inset: 0; z-index: 120; background: rgba(15, 23, 42, 0.68); display: flex; align-items: center; justify-content: center; padding: 1rem; }
	.project-modal-backdrop.hidden { display: none !important; }
	.project-modal-card { width: min(720px, 100%); max-height: min(80vh, 720px); background: #0F172A; border: 1px solid #334155; border-radius: 1rem; box-shadow: 0 20px 40px rgba(0,0,0,.45); display: flex; flex-direction: column; overflow: hidden; }
	.project-modal-header { padding: 1rem 1.25rem; background: #1E293B; border-bottom: 1px solid #334155; display: flex; gap: 1rem; justify-content: space-between; align-items: flex-start; }
	.btn-close-modal { width: 48px; height: 48px; border-radius: 0.625rem; border: 1px solid #475569; background: #0F172A; color: #E2E8F0; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
	.btn-close-modal:hover { border-color: #F97316; color: #F97316; }
	.project-modal-tools { padding: 1rem 1.25rem; display: grid; grid-template-columns: 1fr auto; gap: 0.75rem; border-bottom: 1px solid #1E293B; }
	.search-wrap { position: relative; display: block; }
	.search-icon { position: absolute; left: 0.875rem; top: 50%; transform: translateY(-50%); color: #94A3B8; display: inline-flex; }
	.search-input { width: 100%; min-height: 48px; border-radius: 0.625rem; border: 1px solid #334155; background: #1E293B; color: #F8FAFC; padding: 0.625rem 0.875rem 0.625rem 2.5rem; font: 500 0.875rem var(--font-sans); }
	.search-input:focus { outline: 2px solid #F97316; outline-offset: 1px; border-color: #F97316; }
	.btn-unpin { min-height: 48px; padding: 0.625rem 0.875rem; border-radius: 0.625rem; border: 1px solid #475569; background: #111827; color: #E2E8F0; font: 700 0.8125rem var(--font-sans); display: inline-flex; align-items: center; gap: 0.5rem; cursor: pointer; white-space: nowrap; }
	.btn-unpin:hover { border-color: #F97316; color: #FDBA74; }
	.btn-unpin.active { border-color: #F97316; background: rgba(249,115,22,.12); color: #FDBA74; }
	.dropdown-kicker { font-size: 0.6875rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: #F97316; margin: 0; }
	.dropdown-title { font-size: 1.125rem; font-weight: 800; color: #FFFFFF; margin: 0.2rem 0 0.25rem 0; }
	.dropdown-subtitle { font-size: 0.8125rem; color: #94A3B8; margin: 0; line-height: 1.45; }
	.project-options-list { padding: 0.75rem 1.25rem 1rem; display: flex; flex-direction: column; gap: 0.5rem; overflow-y: auto; }

	:global(.project-option-item) {
		width: 100%;
		display: flex;
		align-items: flex-start;
		gap: 0.65rem;
		padding: 0.75rem;
		border-radius: 0.5rem;
		border: 1.5px solid transparent;
		background-color: #1E293B;
		color: #F8FAFC;
		cursor: pointer;
		transition: all 0.15s ease;
		text-align: left;
	}

	:global(.project-option-item:hover) {
		background-color: #27354A;
		border-color: #475569;
	}

	:global(.project-option-item.active) {
		background-color: #2A1F18;
		border-color: #F97316;
		box-shadow: 0 2px 8px rgba(249, 115, 22, 0.15);
	}

	:global(.option-pin-indicator) {
		width: 32px;
		height: 32px;
		min-width: 32px;
		border-radius: 0.375rem;
		background-color: #0F172A;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1rem;
		flex-shrink: 0;
		border: 1px solid #334155;
	}

	:global(.project-option-item.active .option-pin-indicator) {
		border-color: #F97316;
		background-color: #381E10;
	}

	:global(.option-details) {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		min-width: 0;
		flex: 1;
	}

	:global(.option-title-line) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	:global(.option-project-name) {
		font-size: 0.8125rem;
		font-weight: 800;
		color: #FFFFFF;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	:global(.badge-active-pinned) {
		font-size: 0.625rem;
		font-weight: 800;
		background-color: #FFEDD5;
		color: #EA580C;
		border: 1px solid #FED7AA;
		padding: 0.1rem 0.45rem;
		border-radius: 9999px;
		flex-shrink: 0;
	}

	:global(.option-meta-line) {
		font-size: 0.6875rem;
		color: #94A3B8;
		display: flex;
		align-items: center;
		gap: 0.35rem;
		flex-wrap: wrap;
	}

	:global(.option-submeta-line) {
		font-size: 0.6875rem;
		color: #CBD5E1;
		font-family: 'JetBrains Mono', monospace;
		margin-top: 0.1rem;
	}

	:global(.option-submeta-line strong) {
		color: #10B981;
	}

	.dropdown-footer {
		padding: 0.625rem 1rem;
		background-color: #0F172A;
		border-top: 1px solid #1E293B;
		text-align: center;
	}

	.dropdown-hint {
		font-size: 0.6875rem;
		color: #64748B;
		display: block;
	}

	.hidden { display: none !important; }
	@media (max-width: 768px) {
		.btn-project-trigger { max-width: 180px; padding: 0.25rem 0.5rem; }
		.project-title { max-width: 96px; }
		.project-modal-tools { grid-template-columns: 1fr; }
		.btn-unpin { width: 100%; justify-content: center; }
	}
	@media (max-width: 480px) {
		.btn-project-trigger { max-width: 48px; padding: 0; justify-content: center; }
		.project-text-cluster { display: none; }
		.project-pin-badge { width: 48px; height: 48px; min-width: 48px; border: 0; background: transparent; }
		.project-modal-card { max-height: calc(100vh - 1rem); }
	}
</style>

	<script>
	import { renderIconSvg } from '../lib/icons';
	import { STORAGE_KEY_ACTIVE_PROJECT, clearActiveProjectId, getAvailableProjects, setActiveProjectId } from '../lib/active-project-store.ts';

	function initHeaderProjectSwitcher() {
		const triggerBtn = document.getElementById('btn-header-project-trigger') as HTMLButtonElement | null;
		const modal = document.getElementById('header-project-modal');
		const closeBtn = document.getElementById('btn-close-project-modal');
		const titleEl = document.getElementById('header-project-title');
		const statusDot = document.getElementById('header-project-status-dot');
		const optionsList = document.getElementById('header-project-options-list');
		const searchInput = document.getElementById('project-search-input') as HTMLInputElement | null;
		const unpinBtn = document.getElementById('btn-unpin-project') as HTMLButtonElement | null;
		if (!triggerBtn || !modal || !closeBtn || !titleEl || !optionsList || !searchInput || !unpinBtn) return;

		const projects = getAvailableProjects();
		const getPinnedId = () => localStorage.getItem(STORAGE_KEY_ACTIVE_PROJECT);

		const renderHeader = () => {
			const currentId = getPinnedId();
			const current = projects.find((p) => p.project_id === currentId);
			titleEl.textContent = current ? current.title : 'Sin obra fijada';
			titleEl.setAttribute('title', current ? current.title : 'No hay obra fijada');
			statusDot?.classList.toggle('hidden', !current);
		};

		const renderOptions = () => {
			const q = searchInput.value.trim().toLowerCase();
			const currentId = getPinnedId();
			unpinBtn.classList.toggle('active', !currentId);
			const filtered = projects.filter((p) => !q || [p.title, p.client_name, p.address].join(' ').toLowerCase().includes(q));
			if (filtered.length === 0) {
				optionsList.innerHTML = `<p class="dropdown-subtitle" style="padding:0.75rem 0;">No hay obras que coincidan con la búsqueda.</p>`;
				return;
			}
			optionsList.innerHTML = filtered.map((proj) => {
				const selected = proj.project_id === currentId;
				const price = new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(proj.target_sale_price || 0);
				return `
					<button type="button" class="project-option-item ${selected ? 'active' : ''}" data-project-id="${proj.project_id}">
						<div class="option-pin-indicator">${selected ? renderIconSvg('pin', { size: 16, color: '#F97316' }) : renderIconSvg('building', { size: 16, color: '#94A3B8' })}</div>
						<div class="option-details">
							<div class="option-title-line">
								<span class="option-project-name">${escapeHtml(proj.title)}</span>
								${selected ? `<span class="badge-active-pinned" style="display:inline-flex;align-items:center;gap:3px;">${renderIconSvg('check', { size: 12 })} Fijada</span>` : ''}
							</div>
							<div class="option-meta-line"><span style="display:inline-flex;align-items:center;gap:4px;">${renderIconSvg('user', { size: 12 })} ${escapeHtml(proj.client_name)}</span><span style="display:inline-flex;align-items:center;gap:4px;">• ${renderIconSvg('mapPin', { size: 12 })} ${escapeHtml(proj.address)}</span></div>
							<div class="option-submeta-line"><span>Presupuesto Vigente: <strong>${price}</strong></span></div>
						</div>
					</button>`;
			}).join('');
			optionsList.querySelectorAll<HTMLButtonElement>('.project-option-item').forEach((btn) => {
				btn.addEventListener('click', () => {
					const pid = btn.dataset.projectId;
					if (!pid) return;
					setActiveProjectId(pid);
					renderHeader();
					closeModal();
					const p = projects.find((item) => item.project_id === pid);
					if (p) (window as any).showToast?.(`Obra fijada: ${p.title}. Activa para todas las vistas.`);
				});
			});
		};

		const openModal = () => { renderOptions(); modal.classList.remove('hidden'); triggerBtn.setAttribute('aria-expanded', 'true'); searchInput.focus(); };
		const closeModal = () => { modal.classList.add('hidden'); triggerBtn.setAttribute('aria-expanded', 'false'); searchInput.value = ''; };

		triggerBtn.addEventListener('click', openModal);
		closeBtn.addEventListener('click', closeModal);
		modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
		searchInput.addEventListener('input', renderOptions);
		unpinBtn.addEventListener('click', () => { clearActiveProjectId(); renderHeader(); closeModal(); (window as any).showToast?.('No hay obra fijada. Selecciona una cuando la necesites.'); });
		document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.classList.contains('hidden')) { closeModal(); triggerBtn.focus(); } });
		window.addEventListener('obraflow:project-changed', renderHeader);
		renderHeader();
	}

	function escapeHtml(str: string): string {
		return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
	}

	if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initHeaderProjectSwitcher);
	else initHeaderProjectSwitcher();
</script>
