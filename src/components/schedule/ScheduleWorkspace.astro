	// ==========================================
	// VISTA 2: CALENDARIO MENSUAL
	// ==========================================
	const MONTH_NAMES = [
		'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
		'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'
	];

	function renderCalendarView() {
		const monthHeading = document.getElementById('cal-current-month-label');
		const daysGrid = document.getElementById('calendar-days-grid');
		if (monthHeading) {
			monthHeading.textContent = `${MONTH_NAMES[calMonth]} ${calYear}`;
		}
		if (!daysGrid) return;

		const allProjTasks = getTasksByProject(activeProjectId);
		const todayStr = getTodayDateString();

		// Primer día del mes (1 = Lun, 0 = Dom en JS; ajustamos para que Lun sea 0)
		const firstDayObj = new Date(calYear, calMonth, 1);
		let startDay = firstDayObj.getDay() - 1; // Lun = 0, Dom = 6
		if (startDay < 0) startDay = 6;

		const daysInMonth = new Date(calYear, calMonth + 1, 0).getDate();
		const daysInPrevMonth = new Date(calYear, calMonth, 0).getDate();

		let html = '';

		// Días del mes previo para rellenar
		for (let i = startDay - 1; i >= 0; i--) {
			const dayNum = daysInPrevMonth - i;
			html += `<div class="cal-day-cell other-month"><div class="day-number">${dayNum}</div></div>`;
		}

		// Días del mes actual
		for (let day = 1; day <= daysInMonth; day++) {
			const currentDayDateStr = `${calYear}-${String(calMonth + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
			const isToday = currentDayDateStr === todayStr;
			const isSelected = currentDayDateStr === calSelectedDate;

			// Tareas que caen en este día (rango start_date a end_date)
			const dayTasks = allProjTasks.filter((t) => {
				return currentDayDateStr >= t.start_date && currentDayDateStr <= t.end_date;
			});

			const cellClasses = ['cal-day-cell'];
			if (isToday) cellClasses.push('is-today');
			if (isSelected) cellClasses.push('is-selected');

			let dotsHtml = '';
			dayTasks.slice(0, 4).forEach((t) => {
				const isOver = isTaskOverdue(t, todayStr);
				let dotClass = t.status;
				if (isOver && t.status !== 'completed') dotClass = 'overdue';
				dotsHtml += `<span class="task-dot ${dotClass}" title="${escapeHtml(t.title)}"></span>`;
			});

			html += `
				<div
					class="${cellClasses.join(' ')}"
					data-cal-date="${currentDayDateStr}"
					role="button"
					tabindex="0"
					aria-label="${day} de ${MONTH_NAMES[calMonth]}, ${dayTasks.length} tareas"
				>
					<div class="day-cell-top">
						<span class="day-number">${day}</span>
						${dayTasks.length > 0 ? `<span class="day-badge-count">${dayTasks.length}</span>` : ''}
					</div>
					<div class="day-dots-wrap">
						${dotsHtml}
					</div>
				</div>
			`;
		}

		// Rellenar resto de celdas para completar cuadrícula (múltiplo de 7)
		const totalCells = startDay + daysInMonth;
		const remaining = (7 - (totalCells % 7)) % 7;
		for (let i = 1; i <= remaining; i++) {
			html += `<div class="cal-day-cell other-month"><div class="day-number">${i}</div></div>`;
		}

		daysGrid.innerHTML = html;

		// Listeners para selección de día
		daysGrid.querySelectorAll<HTMLElement>('.cal-day-cell[data-cal-date]').forEach((cell) => {
			cell.addEventListener('click', () => {
				const date = cell.dataset.calDate;
				if (!date) return;
				calSelectedDate = date;
				daysGrid.querySelectorAll('.cal-day-cell').forEach((c) => c.classList.remove('is-selected'));
				cell.classList.add('is-selected');
				renderDayAgenda();
			});
		});

		renderDayAgenda();
	}

	function renderDayAgenda() {
		const agendaTitle = document.getElementById('agenda-selected-date-title');
		const agendaSub = document.getElementById('agenda-tasks-count-subtitle');
		const tasksContainer = document.getElementById('agenda-tasks-list');
		const emptyNotice = document.getElementById('agenda-empty-state');
		if (!tasksContainer) return;

		const allProjTasks = getTasksByProject(activeProjectId);
		const chapters = getProjectChapters(activeProjectId);
		const todayStr = getTodayDateString();

		const dayTasks = allProjTasks.filter((t) => {
			return calSelectedDate >= t.start_date && calSelectedDate <= t.end_date;
		});

		if (agendaTitle) {
			agendaTitle.textContent = `Actividades del ${formatDateFull(calSelectedDate)}`;
		}
		if (agendaSub) {
			agendaSub.textContent = `${dayTasks.length} ${dayTasks.length === 1 ? 'actividad programada' : 'actividades programadas'}`;
		}

		if (dayTasks.length === 0) {
			tasksContainer.innerHTML = '';
			emptyNotice?.classList.remove('hidden');
			return;
		}

		emptyNotice?.classList.add('hidden');
		let html = '';

		dayTasks.forEach((t) => {
			const isDone = t.status === 'completed';
			const isOver = isTaskOverdue(t, todayStr);
			const chap = chapters.find((c) => c.id === t.chapter_id);
			const chapName = chap ? chap.name : 'Capítulo';

			html += `
				<div class="agenda-task-item ${isDone ? 'completed' : ''} ${isOver ? 'overdue' : ''}">
					<div class="agenda-task-left">
						<button
							type="button"
							class="btn-task-checkbox"
							data-agenda-toggle="${t.id}"
							aria-label="${isDone ? 'Marcar pendiente' : 'Marcar completada'}"
						>
							<div class="checkbox-circle">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5">
									<polyline points="20 6 9 17 4 12"></polyline>
								</svg>
							</div>
						</button>
						<div class="agenda-task-info" data-open-detail="${t.id}" style="cursor: pointer;" title="Toca para ver detalle, fotos y comentarios">
							<h5 class="agenda-task-name">${escapeHtml(t.title)}</h5>
							<div class="agenda-task-meta">
								<span class="agenda-chapter-badge">${escapeHtml(chapName)}</span>
								<span>• ${escapeHtml(t.assigned_to)}</span>
								<span>• ${formatDateShort(t.start_date)} al ${formatDateShort(t.end_date)}</span>
								${t.evidences && t.evidences.length > 0 ? `<span class="evidence-pill">📸 ${t.evidences.length}</span>` : ''}
								${t.comments && t.comments.length > 0 ? `<span class="comment-pill">💬 ${t.comments.length}</span>` : ''}
								${isOver ? `<span style="color: #DC2626; font-weight: 800;">⚠️ Atrasada</span>` : ''}
							</div>
						</div>
					</div>
				</div>
			`;
		});

		tasksContainer.innerHTML = html;

		tasksContainer.querySelectorAll<HTMLElement>('[data-open-detail]').forEach((elem) => {
			elem.addEventListener('click', (e) => {
				e.stopPropagation();
				const taskId = elem.dataset.openDetail;
				if (!taskId) return;
				openTaskDetailModal(taskId);
			});
		});

		tasksContainer.querySelectorAll<HTMLButtonElement>('[data-agenda-toggle]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const taskId = btn.dataset.agendaToggle;
				if (!taskId) return;
				toggleTaskComplete(taskId);
				showToast('Estado de actividad actualizado.');
			});
		});
	}

	// ==========================================
	// VISTA 3: DIAGRAMA DE GANTT (CON FRAPPE GANTT)
	// ==========================================
	function renderGanttView() {
		const viewport = document.getElementById('gantt-svg-viewport');
		if (!viewport) return;

		const allProjTasks = getTasksByProject(activeProjectId);
		let filtered = filterTasks(allProjTasks);
		if (ganttCrewFilter !== 'all') {
			filtered = filtered.filter((t) => t.assigned_to === ganttCrewFilter);
		}
		const chapters = getProjectChapters(activeProjectId);
		const todayStr = getTodayDateString();

		if (filtered.length === 0) {
			viewport.innerHTML = '<div style="padding: 2rem; color: #64748B; font-size: 0.875rem;">No hay tareas para mostrar en el cronograma con este filtro.</div>';
			return;
		}

		// Limpiar completamente el contenedor para evitar cabeceras anidadas o acumuladas entre vistas
		viewport.innerHTML = '<svg id="frappe-gantt-target"></svg>';
		const targetSvg = document.getElementById('frappe-gantt-target');
		if (!targetSvg) return;

		let targetChapters = chapters;
		if (ganttChapterFilter !== 'all') {
			targetChapters = chapters.filter((c) => c.id === ganttChapterFilter);
		}

		const ganttTasks: any[] = [];

		targetChapters.forEach((chap) => {
			const chapTasks = filtered.filter((t) => t.chapter_id === chap.id);
			if (chapTasks.length === 0) return;

			// Fechas y avance acumulado del capítulo presupuestal
			let minStart = chapTasks[0].start_date;
			let maxEnd = chapTasks[0].end_date;
			chapTasks.forEach((t) => {
				if (t.start_date < minStart) minStart = t.start_date;
				if (t.end_date > maxEnd) maxEnd = t.end_date;
			});

			const allChapTasks = allProjTasks.filter((t) => t.chapter_id === chap.id);
			const completedCount = allChapTasks.filter((t) => t.status === 'completed').length;
			const chapPct = allChapTasks.length > 0 ? Math.round((completedCount / allChapTasks.length) * 100) : 0;

			if (maxEnd <= minStart) {
				const d = new Date(minStart + 'T00:00:00');
				d.setDate(d.getDate() + 1);
				maxEnd = d.toISOString().split('T')[0];
			}

			// 1. Barra Resumen del Capítulo Presupuestal
			ganttTasks.push({
				id: `chapter_${chap.id}`,
				name: `📁 ${chap.name.toUpperCase()} (${chapPct}%)`,
				start: minStart,
				end: maxEnd,
				progress: chapPct,
				custom_class: 'bar-chapter'
			});

			// 2. Actividades del Capítulo
			chapTasks.forEach((t) => {
				const isOver = isTaskOverdue(t, todayStr);
				let customClass = `bar-${t.status}`;
				if (isOver && t.status !== 'completed') {
					customClass = 'bar-overdue';
				}

				let end = t.end_date;
				if (end <= t.start_date) {
					const d = new Date(t.start_date + 'T00:00:00');
					d.setDate(d.getDate() + 1);
					end = d.toISOString().split('T')[0];
				}

				ganttTasks.push({
					id: t.id,
					name: `  ↳ ${t.title} [${t.assigned_to}]`,
					start: t.start_date,
					end: end,
					progress: t.progress_pct,
					custom_class: customClass
				});
			});
		});

		// Manejo de tareas huérfanas si las hubiera
		if (ganttChapterFilter === 'all') {
			const knownChapterIds = new Set(chapters.map((c) => c.id));
			const orphanTasks = filtered.filter((t) => !knownChapterIds.has(t.chapter_id));
			if (orphanTasks.length > 0) {
				let oMin = orphanTasks[0].start_date;
				let oMax = orphanTasks[0].end_date;
				orphanTasks.forEach((t) => {
					if (t.start_date < oMin) oMin = t.start_date;
					if (t.end_date > oMax) oMax = t.end_date;
				});
				if (oMax <= oMin) {
					const d = new Date(oMin + 'T00:00:00');
					d.setDate(d.getDate() + 1);
					oMax = d.toISOString().split('T')[0];
				}
				ganttTasks.push({
					id: 'chapter_other',
					name: '📁 OTRAS ACTIVIDADES',
					start: oMin,
					end: oMax,
					progress: 0,
					custom_class: 'bar-chapter'
				});
				orphanTasks.forEach((t) => {
					let end = t.end_date;
					if (end <= t.start_date) {
						const d = new Date(t.start_date + 'T00:00:00');
						d.setDate(d.getDate() + 1);
						end = d.toISOString().split('T')[0];
					}
					ganttTasks.push({
						id: t.id,
						name: `  ↳ ${t.title} [${t.assigned_to}]`,
						start: t.start_date,
						end: end,
						progress: t.progress_pct,
						custom_class: `bar-${t.status}`
					});
				});
			}
		}

		if (ganttTasks.length === 0) {
			targetSvg.innerHTML = '<text x="20" y="40" fill="#64748B" font-size="14">No hay tareas registradas en el capítulo seleccionado.</text>';
			return;
		}

		try {
			frappeGanttInstance = new (Gantt as any)('#frappe-gantt-target', ganttTasks, {
				header_height: 50,
				column_width: getModeColumnWidth(ganttViewMode),
				step: 24,
				view_modes: ['Day', 'Week', 'Month'],
				bar_height: 28,
				bar_corner_radius: 5,
				arrow_curve: 5,
				padding: 18,
				view_mode: ganttViewMode,
				date_format: 'YYYY-MM-DD',
				language: 'es', // <--- Configuración oficial en Español para meses (Noviembre, Diciembre, Enero...)
				infinite_padding: false, // <--- Desactiva los 4 años fantasma (2026-2029) y ajusta la escala a los meses reales del proyecto
				today_button: true,
				popup_trigger: 'click',
				custom_popup_html: function(task: any) {
					if (task.id.startsWith('chapter_')) {
						const chapId = task.id.replace('chapter_', '');
						const chapObj = chapters.find((c) => c.id === chapId);
						const chapAll = allProjTasks.filter((t) => t.chapter_id === chapId);
						const chapDone = chapAll.filter((t) => t.status === 'completed').length;
						return `
							<div style="padding: 12px; font-family: inherit; min-width: 250px;">
								<div style="font-size: 0.6875rem; font-weight: 800; color: #EA580C; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 3px;">
									Capítulo Presupuestal
								</div>
								<div style="font-weight: 800; font-size: 0.9375rem; color: #0F172A; margin-bottom: 6px;">
									${escapeHtml(chapObj?.name || task.name)}
								</div>
								<div style="font-size: 0.75rem; color: #64748B; margin-bottom: 8px;">
									📅 Plazo del capítulo: ${task.start} al ${task.end}
								</div>
								<div style="display: flex; align-items: center; justify-content: space-between; background: #F1F5F9; padding: 6px 10px; border-radius: 6px; font-size: 0.75rem;">
									<span style="font-weight: 700; color: #334155;">Avance del Capítulo:</span>
									<span style="font-weight: 800; color: #059669; font-family: monospace;">${task.progress}% (${chapDone}/${chapAll.length} listas)</span>
								</div>
							</div>
						`;
					}

					const originTask = allProjTasks.find((t) => t.id === task.id);
					const chapObj = chapters.find((c) => c.id === originTask?.chapter_id);
					const evCount = originTask?.evidences?.length || 0;
					const cmCount = originTask?.comments?.length || 0;
					const cleanName = task.name.replace(/^\s*↳\s*/, '');

					return `
						<div style="padding: 12px; font-family: inherit; min-width: 250px;">
							<div style="display: flex; align-items: center; gap: 6px; margin-bottom: 4px;">
								<span style="font-size: 0.6875rem; font-weight: 700; background: #E2E8F0; color: #1E293B; padding: 2px 6px; border-radius: 4px;">
									📁 ${escapeHtml(chapObj?.name || 'Capítulo Presupuestal')}
								</span>
							</div>
							<div style="font-weight: 800; font-size: 0.875rem; color: #0F172A; margin-bottom: 4px;">
								${escapeHtml(cleanName)}
							</div>
							<div style="font-size: 0.75rem; color: #64748B; margin-bottom: 6px;">
								📅 ${task.start} al ${task.end}
							</div>
							<div style="display: flex; gap: 6px; margin-bottom: 8px;">
								<span style="font-size: 0.6875rem; font-weight: 700; background: #FFEDD5; color: #EA580C; padding: 2px 6px; border-radius: 9999px;">
									${task.progress}% Avance
								</span>
								${evCount > 0 ? `<span style="font-size: 0.6875rem; font-weight: 700; background: #DCFCE7; color: #166534; padding: 2px 6px; border-radius: 9999px;">📸 ${evCount}</span>` : ''}
								${cmCount > 0 ? `<span style="font-size: 0.6875rem; font-weight: 700; background: #DBEAFE; color: #1E40AF; padding: 2px 6px; border-radius: 9999px;">💬 ${cmCount}</span>` : ''}
							</div>
							<button type="button" style="width: 100%; min-height: 38px; background: #0F172A; color: #fff; border: none; border-radius: 6px; font-size: 0.75rem; font-weight: 700; cursor: pointer;" onclick="window.dispatchEvent(new CustomEvent('open-task-modal-from-gantt', { detail: { taskId: '${task.id}' } }))">
								Ver Detalle & Evidencias →
							</button>
						</div>
					`;
				},
				on_click: function(task: any) {
					if (task.id.startsWith('chapter_')) {
						return;
					}
					openTaskDetailModal(task.id);
				},
				on_date_change: function(task: any, start: Date, end: Date) {
					if (task.id.startsWith('chapter_')) {
						return;
					}
					const startStr = start.toISOString().split('T')[0];
					const endStr = end.toISOString().split('T')[0];
					updateTask(task.id, { start_date: startStr, end_date: endStr });
					showToast(`✓ Fechas actualizadas: ${startStr} al ${endStr}`);
				},
				on_progress_change: function(task: any, progress: number) {
					if (task.id.startsWith('chapter_')) {
						return;
					}
					updateTask(task.id, { progress_pct: progress });
					const cleanTitle = task.name.replace(/^\s*↳\s*/, '').split(' [')[0];
					showToast(`✓ Avance de "${cleanTitle}" actualizado a ${progress}%`);
				}
			});
			localizeGanttUI();
			fixChapterBarsEnclosure();

			requestAnimationFrame(() => {
				fixChapterBarsEnclosure();
				localizeGanttUI();
			});
			setTimeout(() => {
				fixChapterBarsEnclosure();
				localizeGanttUI();
			}, 60);
		} catch (err) {
			console.error('Error inicializando Frappe Gantt:', err);
		}
	}

	// ==========================================
	// MODAL DE CREACIÓN DE TAREAS
	// ==========================================
	function setupModalHandlers() {
		const backdrop = document.getElementById('create-task-modal-backdrop');
		const modal = document.getElementById('create-task-modal');
		const form = document.getElementById('create-task-form') as HTMLFormElement | null;
		const closeBtn = document.getElementById('btn-close-task-modal');
		const cancelBtn = document.getElementById('btn-cancel-create-task');

		function closeModal() {
			backdrop?.classList.add('hidden');
			modal?.classList.add('hidden');
			form?.reset();
			document.getElementById('task-form-title-error')?.classList.add('hidden');
			document.getElementById('task-form-dates-error')?.classList.add('hidden');
		}

		closeBtn?.addEventListener('click', closeModal);
		cancelBtn?.addEventListener('click', closeModal);
		backdrop?.addEventListener('click', closeModal);

		window.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
				closeModal();
			}
		});

		form?.addEventListener('submit', (e) => {
			e.preventDefault();
			const titleInput = document.getElementById('task-form-title') as HTMLInputElement | null;
			const chapterSelect = document.getElementById('task-form-chapter') as HTMLSelectElement | null;
			const assignedSelect = document.getElementById('task-form-assigned') as HTMLSelectElement | null;
			const startDateInput = document.getElementById('task-form-start-date') as HTMLInputElement | null;
			const endDateInput = document.getElementById('task-form-end-date') as HTMLInputElement | null;
			const descInput = document.getElementById('task-form-desc') as HTMLTextAreaElement | null;

			const titleErr = document.getElementById('task-form-title-error');
			const datesErr = document.getElementById('task-form-dates-error');

			if (!titleInput || !chapterSelect || !assignedSelect || !startDateInput || !endDateInput) return;

			const title = titleInput.value.trim();
			const chapterId = chapterSelect.value;
			const assignedTo = assignedSelect.value;
			const startDate = startDateInput.value;
			const endDate = endDateInput.value;
			const desc = descInput?.value.trim() || '';

			let hasError = false;

			if (!title) {
				titleErr?.classList.remove('hidden');
				hasError = true;
			} else {
				titleErr?.classList.add('hidden');
			}

			if (endDate < startDate) {
				datesErr?.classList.remove('hidden');
				hasError = true;
			} else {
				datesErr?.classList.add('hidden');
			}

			if (hasError) return;

			createTask({
				project_id: activeProjectId,
				chapter_id: chapterId,
				title,
				description: desc,
				start_date: startDate,
				end_date: endDate,
				assigned_to: assignedTo,
				status: 'pending'
			});

			closeModal();
			showToast(`✓ Actividad "${title}" programada con éxito.`);
		});
	}

	function openCreateTaskModal() {
		const backdrop = document.getElementById('create-task-modal-backdrop');
		const modal = document.getElementById('create-task-modal');
		const chapterSelect = document.getElementById('task-form-chapter') as HTMLSelectElement | null;
		const projIdInput = document.getElementById('task-form-project-id') as HTMLInputElement | null;
		const startDateInput = document.getElementById('task-form-start-date') as HTMLInputElement | null;
		const endDateInput = document.getElementById('task-form-end-date') as HTMLInputElement | null;

		if (!modal || !backdrop) return;

		// Poblar capítulos del proyecto activo
		if (chapterSelect) {
			const chapters = getProjectChapters(activeProjectId);
			chapterSelect.innerHTML = chapters.map((c) => `<option value="${c.id}">${escapeHtml(c.name)}</option>`).join('');
		}

		if (projIdInput) projIdInput.value = activeProjectId;

		const today = getTodayDateString();
		if (startDateInput) startDateInput.value = today;
		if (endDateInput) {
			const d = new Date();
			d.setDate(d.getDate() + 3);
			endDateInput.value = d.toISOString().split('T')[0];
		}

		backdrop.classList.remove('hidden');
		modal.classList.remove('hidden');

		const titleInput = document.getElementById('task-form-title') as HTMLInputElement | null;
		setTimeout(() => titleInput?.focus(), 50);
	}

	// ==========================================
	// MODAL DE DETALLE, EDICIÓN, EVIDENCIAS Y BITÁCORA
	// ==========================================
	let currentDetailTaskId: string | null = null;
	let currentDetailTab: 'edit' | 'evidences' | 'comments' = 'edit';

	function setupTaskDetailModalHandlers() {
		const backdrop = document.getElementById('task-detail-modal-backdrop');
		const modal = document.getElementById('task-detail-modal');
		const closeBtn = document.getElementById('btn-close-task-detail');
		const editForm = document.getElementById('edit-task-form') as HTMLFormElement | null;
		const progressRange = document.getElementById('edit-task-progress-range') as HTMLInputElement | null;
		const progressNum = document.getElementById('edit-task-progress-num');
		const statusPreview = document.getElementById('edit-task-status-preview');

		function closeDetailModal() {
			backdrop?.classList.add('hidden');
			modal?.classList.add('hidden');
			currentDetailTaskId = null;
		}

		closeBtn?.addEventListener('click', closeDetailModal);
		backdrop?.addEventListener('click', closeDetailModal);

		window.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
				closeDetailModal();
			}
		});

		// Pestañas
		const tabButtons = document.querySelectorAll<HTMLButtonElement>('.detail-tab-btn');
		tabButtons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const tab = btn.dataset.tab as 'edit' | 'evidences' | 'comments';
				if (!tab) return;
				currentDetailTab = tab;

				tabButtons.forEach((b) => {
					b.classList.remove('active');
					b.setAttribute('aria-selected', 'false');
				});
				btn.classList.add('active');
				btn.setAttribute('aria-selected', 'true');

				document.getElementById('panel-tab-edit')?.classList.toggle('hidden', tab !== 'edit');
				document.getElementById('panel-tab-evidences')?.classList.toggle('hidden', tab !== 'evidences');
				document.getElementById('panel-tab-comments')?.classList.toggle('hidden', tab !== 'comments');
			});
		});

		// Slider de progreso
		progressRange?.addEventListener('input', () => {
			const val = parseInt(progressRange.value, 10);
			if (progressNum) progressNum.textContent = `${val}%`;
			if (statusPreview) {
				if (val === 100) {
					statusPreview.textContent = 'Completada ✓';
					statusPreview.style.backgroundColor = '#ECFDF5';
					statusPreview.style.color = '#047857';
				} else if (val > 0) {
					statusPreview.textContent = 'En Curso';
					statusPreview.style.backgroundColor = '#FFF7ED';
					statusPreview.style.color = '#EA580C';
				} else {
					statusPreview.textContent = 'Pendiente';
					statusPreview.style.backgroundColor = '#F1F5F9';
					statusPreview.style.color = '#475569';
				}
			}
		});

		// Envío de edición
		editForm?.addEventListener('submit', (e) => {
			e.preventDefault();
			if (!currentDetailTaskId) return;

			const title = (document.getElementById('edit-task-title') as HTMLInputElement)?.value.trim();
			const chapterId = (document.getElementById('edit-task-chapter') as HTMLSelectElement)?.value;
			const assignedTo = (document.getElementById('edit-task-assigned') as HTMLSelectElement)?.value;
			const startDate = (document.getElementById('edit-task-start-date') as HTMLInputElement)?.value;
			const endDate = (document.getElementById('edit-task-end-date') as HTMLInputElement)?.value;
			const progressVal = parseInt((document.getElementById('edit-task-progress-range') as HTMLInputElement)?.value || '0', 10);
			const desc = (document.getElementById('edit-task-desc') as HTMLTextAreaElement)?.value.trim();

			if (!title) {
				showToast('El título de la tarea es obligatorio.');
				return;
			}
			if (endDate < startDate) {
				showToast('La fecha de fin no puede ser anterior a la de inicio.');
				return;
			}

			updateTask(currentDetailTaskId, {
				title,
				chapter_id: chapterId,
				assigned_to: assignedTo,
				start_date: startDate,
				end_date: endDate,
				progress_pct: progressVal,
				description: desc
			});

			closeDetailModal();
			showToast('✓ Cambios guardados en la actividad.');
		});

		// Evidencias: botón cámara / archivo
		const fileInput = document.getElementById('evidence-file-input') as HTMLInputElement | null;
		document.getElementById('btn-trigger-upload-evidence')?.addEventListener('click', () => {
			fileInput?.click();
		});

		fileInput?.addEventListener('change', () => {
			if (!currentDetailTaskId || !fileInput.files || fileInput.files.length === 0) return;
			const file = fileInput.files[0];
			const captionInput = document.getElementById('evidence-caption-input') as HTMLInputElement | null;
			const caption = captionInput?.value.trim() || file.name;
			const roleConfig = getActiveRoleConfig();

			const reader = new FileReader();
			reader.onload = (ev) => {
				const dataUrl = ev.target?.result as string;
				if (dataUrl && currentDetailTaskId) {
					addTaskEvidence(currentDetailTaskId, {
						file_name: file.name,
						file_type: 'photo',
						file_url: dataUrl,
						caption,
						uploaded_by: `${roleConfig.name} (${roleConfig.badgeText})`
					});
					if (captionInput) captionInput.value = '';
					fileInput.value = '';
					refreshDetailModalData();
					showToast('📸 Evidencia fotográfica adjuntada con éxito.');
				}
			};
			reader.readAsDataURL(file);
		});

		// Evidencias: botón foto rápida demo
		document.getElementById('btn-quick-demo-evidence')?.addEventListener('click', () => {
			if (!currentDetailTaskId) return;
			const task = loadAllTasks().find((t) => t.id === currentDetailTaskId);
			if (!task) return;

			const captionInput = document.getElementById('evidence-caption-input') as HTMLInputElement | null;
			const caption = captionInput?.value.trim() || 'Verificación visual de avance en obra';
			const roleConfig = getActiveRoleConfig();

			const svgUrl = generateEvidenceSvg(task.title, caption, roleConfig.name);
			addTaskEvidence(currentDetailTaskId, {
				file_name: `inspeccion_${Date.now()}.svg`,
				file_type: 'photo',
				file_url: svgUrl,
				caption,
				uploaded_by: `${roleConfig.name} (${roleConfig.badgeText})`
			});

			if (captionInput) captionInput.value = '';
			refreshDetailModalData();
			showToast('📸 Foto técnica con sello de agua generada.');
		});

		// Comentarios: botón publicar
		document.getElementById('btn-submit-comment')?.addEventListener('click', () => {
			if (!currentDetailTaskId) return;
			const commentArea = document.getElementById('new-comment-textarea') as HTMLTextAreaElement | null;
			const message = commentArea?.value.trim();
			if (!message) return;

			const roleConfig = getActiveRoleConfig();
			addTaskComment(currentDetailTaskId, {
				author_name: roleConfig.name,
				author_role: roleConfig.label,
				message
			});

			if (commentArea) commentArea.value = '';
			refreshDetailModalData();
			showToast('💬 Comentario publicado en la bitácora.');
		});

		// Lightbox cierre
		document.getElementById('btn-close-lightbox')?.addEventListener('click', () => {
			document.getElementById('evidence-lightbox-modal')?.classList.add('hidden');
		});
		document.getElementById('evidence-lightbox-modal')?.addEventListener('click', (e) => {
			if (e.target === document.getElementById('evidence-lightbox-modal')) {
				document.getElementById('evidence-lightbox-modal')?.classList.add('hidden');
			}
		});
	}

	function openTaskDetailModal(taskId: string) {
		currentDetailTaskId = taskId;
		refreshDetailModalData();

		const backdrop = document.getElementById('task-detail-modal-backdrop');
		const modal = document.getElementById('task-detail-modal');
		backdrop?.classList.remove('hidden');
		modal?.classList.remove('hidden');
	}

	function refreshDetailModalData() {
		if (!currentDetailTaskId) return;
		const task = loadAllTasks().find((t) => t.id === currentDetailTaskId);
		if (!task) return;

		const chapters = getProjectChapters(activeProjectId);
		const chap = chapters.find((c) => c.id === task.chapter_id);
		const chapName = chap ? chap.name : 'Capítulo';

		// Header
		const titleHeader = document.getElementById('task-detail-title-header');
		const chapBadge = document.getElementById('task-detail-chapter-badge');
		const statusBadge = document.getElementById('task-detail-status-badge');

		if (titleHeader) titleHeader.textContent = task.title;
		if (chapBadge) chapBadge.textContent = chapName;
		if (statusBadge) {
			statusBadge.textContent = task.status === 'completed' ? 'Completada ✓' : task.status === 'in_progress' ? 'En Curso' : 'Pendiente';
			statusBadge.style.backgroundColor = task.status === 'completed' ? '#ECFDF5' : task.status === 'in_progress' ? '#FFF7ED' : '#F1F5F9';
			statusBadge.style.color = task.status === 'completed' ? '#047857' : task.status === 'in_progress' ? '#EA580C' : '#475569';
		}

		// Tab 1: Editar
		const editId = document.getElementById('edit-task-id') as HTMLInputElement | null;
		const editTitle = document.getElementById('edit-task-title') as HTMLInputElement | null;
		const editChapter = document.getElementById('edit-task-chapter') as HTMLSelectElement | null;
		const editAssigned = document.getElementById('edit-task-assigned') as HTMLSelectElement | null;
		const editStartDate = document.getElementById('edit-task-start-date') as HTMLInputElement | null;
		const editEndDate = document.getElementById('edit-task-end-date') as HTMLInputElement | null;
		const editProgress = document.getElementById('edit-task-progress-range') as HTMLInputElement | null;
		const editProgressNum = document.getElementById('edit-task-progress-num');
		const editStatusPreview = document.getElementById('edit-task-status-preview');
		const editDesc = document.getElementById('edit-task-desc') as HTMLTextAreaElement | null;

		if (editId) editId.value = task.id;
		if (editTitle) editTitle.value = task.title;
		if (editChapter) {
			editChapter.innerHTML = chapters.map((c) => `<option value="${c.id}" ${c.id === task.chapter_id ? 'selected' : ''}>${escapeHtml(c.name)}</option>`).join('');
		}
		if (editAssigned) editAssigned.value = task.assigned_to;
		if (editStartDate) editStartDate.value = task.start_date;
		if (editEndDate) editEndDate.value = task.end_date;
		if (editProgress) editProgress.value = task.progress_pct.toString();
		if (editProgressNum) editProgressNum.textContent = `${task.progress_pct}%`;
		if (editStatusPreview) {
			editStatusPreview.textContent = task.status === 'completed' ? 'Completada ✓' : task.status === 'in_progress' ? 'En Curso' : 'Pendiente';
			editStatusPreview.style.backgroundColor = task.status === 'completed' ? '#ECFDF5' : task.status === 'in_progress' ? '#FFF7ED' : '#F1F5F9';
			editStatusPreview.style.color = task.status === 'completed' ? '#047857' : task.status === 'in_progress' ? '#EA580C' : '#475569';
		}
		if (editDesc) editDesc.value = task.description || '';

		// Tab 2: Evidencias
		const evidencesGrid = document.getElementById('evidences-gallery-grid');
		const evidencesEmpty = document.getElementById('evidences-empty-state');
		const evidencesBadge = document.getElementById('tab-evidences-badge');
		const evidences = task.evidences || [];

		if (evidencesBadge) evidencesBadge.textContent = evidences.length.toString();

		if (evidencesGrid) {
			if (evidences.length === 0) {
				evidencesGrid.innerHTML = '';
				evidencesEmpty?.classList.remove('hidden');
			} else {
				evidencesEmpty?.classList.add('hidden');
				evidencesGrid.innerHTML = evidences.map((ev) => `
					<div class="evidence-card" id="ev-card-${ev.id}">
						<div class="evidence-thumb-wrap" data-lightbox-src="${encodeURI(ev.file_url)}" data-lightbox-cap="${escapeHtml(ev.caption || ev.file_name)}">
							<img src="${ev.file_url}" alt="${escapeHtml(ev.caption || ev.file_name)}" class="evidence-thumb-img" />
							<button type="button" class="btn-delete-evidence" data-delete-ev-id="${ev.id}" title="Eliminar evidencia">
								✕
							</button>
						</div>
						<div class="evidence-caption-box">
							<span class="evidence-caption-text">${escapeHtml(ev.caption || ev.file_name)}</span>
							<span class="evidence-meta-text">${escapeHtml(ev.uploaded_by)} • ${formatDateShort(ev.created_at.split('T')[0])}</span>
						</div>
					</div>
				`).join('');

				// Click en imagen para abrir lightbox
				evidencesGrid.querySelectorAll<HTMLElement>('.evidence-thumb-wrap').forEach((thumb) => {
					thumb.addEventListener('click', (e) => {
						if ((e.target as HTMLElement).closest('.btn-delete-evidence')) return;
						const src = thumb.dataset.lightboxSrc;
						const cap = thumb.dataset.lightboxCap;
						const lightbox = document.getElementById('evidence-lightbox-modal');
						const img = document.getElementById('lightbox-image') as HTMLImageElement | null;
						const captionText = document.getElementById('lightbox-caption');
						if (lightbox && img && src) {
							img.src = src;
							if (captionText) captionText.textContent = cap || '';
							lightbox.classList.remove('hidden');
						}
					});
				});

				// Eliminar evidencia
				evidencesGrid.querySelectorAll<HTMLButtonElement>('.btn-delete-evidence').forEach((btn) => {
					btn.addEventListener('click', (e) => {
						e.stopPropagation();
						const evId = btn.dataset.deleteEvId;
						if (!evId || !currentDetailTaskId) return;
						deleteTaskEvidence(currentDetailTaskId, evId);
						refreshDetailModalData();
						showToast('Evidencia eliminada.');
					});
				});
			}
		}

		// Tab 3: Comentarios
		const commentsStream = document.getElementById('comments-history-list');
		const commentsEmpty = document.getElementById('comments-empty-state');
		const commentsBadge = document.getElementById('tab-comments-badge');
		const activeAuthorLabel = document.getElementById('comment-active-author-label');
		const comments = task.comments || [];

		if (commentsBadge) commentsBadge.textContent = comments.length.toString();

		const roleConfig = getActiveRoleConfig();
		if (activeAuthorLabel) {
			activeAuthorLabel.textContent = `${roleConfig.name} (${roleConfig.badgeText})`;
		}

		if (commentsStream) {
			if (comments.length === 0) {
				commentsStream.innerHTML = '';
				commentsEmpty?.classList.remove('hidden');
			} else {
				commentsEmpty?.classList.add('hidden');
				commentsStream.innerHTML = comments.map((cmt) => {
					const initials = cmt.author_name.split(' ').map((n) => n[0]).join('').substring(0, 2).toUpperCase();
					const isDailyLogSync = cmt.message.includes('[Bitácora Diaria');
					return `
						<div class="comment-bubble-item ${isDailyLogSync ? 'comment-daily-log-sync' : ''}" id="cmt-item-${cmt.id}">
							<div class="comment-author-avatar" style="${isDailyLogSync ? 'background-color: #EA580C;' : ''}">${isDailyLogSync ? '📋' : initials}</div>
							<div class="comment-bubble-content" style="${isDailyLogSync ? 'border-color: #FED7AA; background-color: #FFFDFB;' : ''}">
								<div class="comment-author-meta">
									<span class="comment-author-name">${escapeHtml(cmt.author_name)}</span>
									<span class="comment-role-pill" style="${isDailyLogSync ? 'background-color: #FFEDD5; color: #C2410C;' : ''}">${escapeHtml(cmt.author_role)}</span>
									${isDailyLogSync ? '<span style="font-size: 0.6875rem; font-weight: 800; background-color: #FEF3C7; color: #92400E; padding: 1px 6px; border-radius: 4px;">Bitácora Sincronizada</span>' : ''}
									<span class="comment-timestamp">${formatDateShort(cmt.created_at.split('T')[0])}</span>
								</div>
								<p class="comment-text">${escapeHtml(cmt.message)}</p>
							</div>
						</div>
					`;
				}).join('');
			}
		}
	}

	// ==========================================
	// UTILIDADES DE FORMATO
	// ==========================================
	function escapeHtml(str: string): string {
		return str
			.replace(/&/g, '&amp;')
			.replace(/</g, '&lt;')
			.replace(/>/g, '&gt;')
			.replace(/"/g, '&quot;')
			.replace(/'/g, '&#039;');
	}

	function formatDateShort(dateStr: string): string {
		if (!dateStr) return '';
		const parts = dateStr.split('-');
		if (parts.length < 3) return dateStr;
		const day = parts[2];
		const monthNum = parseInt(parts[1], 10) - 1;
		const monthName = MONTH_NAMES[monthNum]?.substring(0, 3) || '';
		return `${day} ${monthName}`;
	}

	function formatDateFull(dateStr: string): string {
		if (!dateStr) return '';
		const parts = dateStr.split('-');
		if (parts.length < 3) return dateStr;
		const day = parseInt(parts[2], 10);
		const monthNum = parseInt(parts[1], 10) - 1;
		const monthName = MONTH_NAMES[monthNum] || '';
		return `${day} de ${monthName} de ${parts[0]}`;
	}

	function showToast(message: string) {
		window.dispatchEvent(
			new CustomEvent('show-toast', {
				detail: {
					message,
					type: 'success'
				}
			})
		);
	}

	// Inicialización
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initWorkspace);
	} else {
		initWorkspace();
	}
</script>
