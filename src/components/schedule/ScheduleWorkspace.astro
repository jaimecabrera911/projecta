				if (!taskId) return;
				const updated = toggleTaskComplete(taskId);
				if (updated) {
					const msg = updated.status === 'completed'
						? `✓ Actividad completada: "${updated.title}"`
						: `Actividad reabierta: "${updated.title}"`;
					showToast(msg);
				}
			});
