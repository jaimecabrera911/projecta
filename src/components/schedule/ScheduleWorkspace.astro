							<div class="task-info-col" data-open-detail="${task.id}" title="Toca para ver detalle, fotos y comentarios">
								<div class="task-title-line">
									<span class="task-title-text">${escapeHtml(task.title)}</span>
								</div>

								${task.description ? `<p class="task-desc-text">${escapeHtml(task.description)}</p>` : ''}

								<div class="task-meta-row">
									<span class="crew-chip">
										<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
											<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
											<circle cx="9" cy="7" r="4"></circle>
										</svg>
										${escapeHtml(task.assigned_to)}
									</span>

									<span class="dates-chip">
										<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
											<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
											<line x1="16" y1="2" x2="16" y2="6"></line>
											<line x1="8" y1="2" x2="8" y2="6"></line>
											<line x1="3" y1="10" x2="21" y2="10"></line>
										</svg>
										${formatDateShort(task.start_date)} → ${formatDateShort(task.end_date)}
									</span>

