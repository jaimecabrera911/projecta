			}

			// Calcular avance del capítulo con todas sus tareas
			const chapAllTasks = allProjTasks.filter((t) => t.chapter_id === chap.id);
			const chapCompleted = chapAllTasks.filter((t) => t.status === 'completed').length;
			const chapTotal = chapAllTasks.length;
			const chapPct = chapTotal > 0 ? Math.round((chapCompleted / chapTotal) * 100) : 0;

			html += `
				<div class="chapter-task-group" id="chapter-group-${chap.id}">
