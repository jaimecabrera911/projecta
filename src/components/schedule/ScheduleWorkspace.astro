---
// src/components/schedule/ScheduleWorkspace.astro
// HU-16: Espacio de Trabajo del Cronograma Táctil de Obra.
// Integra selector de proyecto, métricas de avance físico, selector de 3 vistas (Lista / Calendario / Gantt),
// barra de filtros por estado y orquestación reactiva.

import TaskListView from './TaskListView.astro';
import CalendarView from './CalendarView.astro';
import GanttChartView from './GanttChartView.astro';
import CreateTaskModal from './CreateTaskModal.astro';
import TaskDetailModal from './TaskDetailModal.astro';
---

<div id="schedule-workspace-root" class="schedule-workspace-shell">
	<!-- 1. BARRA SUPERIOR DE CONTROL DE OBRA -->
	<header id="schedule-top-bar" class="schedule-top-bar">
		<div class="top-bar-left">
			<div class="project-selector-wrapper">
				<label for="schedule-project-select" class="project-select-label">Obra Activa:</label>
				<div class="custom-select-container">
					<select id="schedule-project-select" class="schedule-project-select" aria-label="Seleccionar proyecto de obra">
						<option value="proj_penthouse_poblado" selected>Remodelación Penthouse El Poblado (Dr. Andrés Restrepo)</option>
						<option value="proj_torre_medica">Adecuación Consultorios Torre Médica (Inversiones Salud)</option>
					</select>
					<div class="select-chevron" aria-hidden="true">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
							<polyline points="6 9 12 15 18 9"></polyline>
						</svg>
					</div>
				</div>
			</div>
		</div>

		<div class="top-bar-actions">
			<button
				id="schedule-reset-btn"
				type="button"
				class="btn-reset-tasks"
				title="Restablecer tareas de demostración iniciales"
			>
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
					<path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
				</svg>
				<span class="desktop-only">Reset Demo</span>
			</button>

			<button
				id="schedule-new-task-btn"
				type="button"
				class="btn-new-task"
				title="Programar una nueva actividad en el cronograma"
			>
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
					<line x1="12" y1="5" x2="12" y2="19"></line>
					<line x1="5" y1="12" x2="19" y2="12"></line>
				</svg>
				<span>+ Nueva Tarea</span>
			</button>
		</div>
	</header>

	<!-- 2. TARJETA DE AVANCE FÍSICO GLOBAL DEL PROYECTO -->
	<section id="schedule-metrics-card" class="schedule-metrics-card" aria-label="Métricas de avance físico de obra">
		<div class="metrics-main-col">
			<div class="metrics-title-row">
				<div class="metrics-badge-lead">
					<span class="pulse-indicator"></span>
					<span>AVANCE FÍSICO DE OBRA</span>
				</div>
				<span id="metrics-overdue-alert-pill" class="overdue-alert-pill hidden">
					⚠️ <span id="overdue-pill-text">1 Tarea Atrasada</span>
				</span>
			</div>

			<div class="progress-indicator-row">
				<div class="progress-big-number">
					<span id="metrics-overall-pct" class="pct-val">60.0%</span>
					<span class="pct-label">Completado</span>
				</div>

				<div class="progress-bar-track">
					<div id="metrics-progress-bar-fill" class="progress-bar-fill" style="width: 60%;"></div>
				</div>
			</div>
		</div>

		<!-- Mini contadores -->
		<div class="metrics-chips-grid">
			<div class="metric-chip-card">
				<span class="chip-number" id="metrics-total-count">5</span>
				<span class="chip-label">Total Tareas</span>
			</div>
			<div class="metric-chip-card chip-completed">
				<span class="chip-number" id="metrics-completed-count">3</span>
				<span class="chip-label">Completadas</span>
			</div>
			<div class="metric-chip-card chip-in-progress">
				<span class="chip-number" id="metrics-in-progress-count">1</span>
				<span class="chip-label">En Curso</span>
			</div>
			<div class="metric-chip-card chip-overdue" id="chip-overdue-card">
				<span class="chip-number" id="metrics-overdue-count">1</span>
				<span class="chip-label">Atrasadas</span>
			</div>
		</div>
	</section>

	<!-- 3. SELECTOR DE VISTAS (CONTROL SEGMENTADO TRIPLE) -->
	<div class="schedule-controls-cluster">
		<div id="schedule-view-switcher" class="segmented-view-switcher" role="tablist" aria-label="Modo de visualización de tareas">
			<button
				id="tab-view-list"
				type="button"
				role="tab"
				aria-selected="true"
				class="view-switch-btn active"
				data-view="list"
			>
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
					<line x1="8" y1="6" x2="21" y2="6"></line>
					<line x1="8" y1="12" x2="21" y2="12"></line>
					<line x1="8" y1="18" x2="21" y2="18"></line>
					<line x1="3" y1="6" x2="3.01" y2="6"></line>
					<line x1="3" y1="12" x2="3.01" y2="12"></line>
					<line x1="3" y1="18" x2="3.01" y2="18"></line>
				</svg>
				<span>Lista de Tareas</span>
				<span id="tab-list-count" class="tab-badge">5</span>
			</button>

			<button
				id="tab-view-calendar"
				type="button"
				role="tab"
				aria-selected="false"
				class="view-switch-btn"
				data-view="calendar"
			>
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
					<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
					<line x1="16" y1="2" x2="16" y2="6"></line>
					<line x1="8" y1="2" x2="8" y2="6"></line>
					<line x1="3" y1="10" x2="21" y2="10"></line>
				</svg>
				<span>Calendario</span>
			</button>

			<button
				id="tab-view-gantt"
				type="button"
				role="tab"
				aria-selected="false"
				class="view-switch-btn"
				data-view="gantt"
			>
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
					<line x1="3" y1="6" x2="15" y2="6"></line>
					<line x1="7" y1="12" x2="21" y2="12"></line>
					<line x1="4" y1="18" x2="18" y2="18"></line>
				</svg>
				<span>Diagrama de Gantt</span>
			</button>
		</div>

		<!-- 4. CHIPS DE FILTRO POR ESTADO (Visible en Lista y Gantt) -->
		<div id="schedule-filter-bar" class="filter-chips-bar" role="group" aria-label="Filtrar tareas por estado">
			<button id="filter-all" type="button" class="filter-chip active" data-filter="all">
				Todas
			</button>
			<button id="filter-pending" type="button" class="filter-chip" data-filter="pending">
				Pendientes
			</button>
			<button id="filter-in_progress" type="button" class="filter-chip" data-filter="in_progress">
				En Curso
			</button>
			<button id="filter-completed" type="button" class="filter-chip" data-filter="completed">
				Completadas
			</button>
			<button id="filter-overdue" type="button" class="filter-chip chip-alert" data-filter="overdue">
				Atrasadas ⚠️
			</button>
		</div>
	</div>

	<!-- 5. CONTENEDOR DE VISTAS -->
	<div class="views-stage-area">
		<!-- Vista 1: Lista (Principal / Operate Mode) -->
		<TaskListView />

		<!-- Vista 2: Calendario Mensual -->
		<CalendarView />

		<!-- Vista 3: Diagrama de Gantt Temporal -->
		<GanttChartView />
	</div>

	<!-- Modal de Creación de Tarea -->
	<CreateTaskModal />

	<!-- Modal de Detalle, Edición, Evidencias y Bitácora (HU-16) -->
	<TaskDetailModal />
</div>

<style>
	.schedule-workspace-shell {
		max-width: 1320px;
		margin: 0 auto;
		padding: 1.5rem 1rem 3rem 1rem;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	/* 1. Top Bar */
	.schedule-top-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.top-bar-left {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex: 1;
		min-width: 280px;
	}

	.project-selector-wrapper {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		width: 100%;
		max-width: 520px;
	}

	.project-select-label {
		font-size: 0.75rem;
		font-weight: 700;
		color: #64748B;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.custom-select-container {
		position: relative;
		display: flex;
		align-items: center;
	}

	.schedule-project-select {
		width: 100%;
		min-height: 48px;
		padding: 0.625rem 2.5rem 0.625rem 1rem;
		background-color: #FFFFFF;
		border: 1.5px solid #CBD5E1;
		border-radius: 0.625rem;
		font-size: 0.9375rem;
		font-weight: 700;
		color: #0F172A;
		appearance: none;
		cursor: pointer;
		box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
	}

	.schedule-project-select:focus {
		outline: none;
		border-color: #F97316;
		box-shadow: 0 0 0 3px rgba(249, 115, 22, 0.15);
	}

	.select-chevron {
		position: absolute;
		right: 1rem;
		pointer-events: none;
		color: #64748B;
		display: flex;
		align-items: center;
	}

	.top-bar-actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.btn-reset-tasks {
		min-height: 48px;
		padding: 0 1rem;
		border-radius: 0.625rem;
		border: 1px solid #CBD5E1;
		background-color: #FFFFFF;
		color: #475569;
		font-size: 0.8125rem;
		font-weight: 700;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.btn-reset-tasks:hover {
		background-color: #F8FAFC;
		border-color: #94A3B8;
		color: #0F172A;
	}

	.btn-new-task {
		min-height: 48px;
		padding: 0 1.35rem;
		border-radius: 0.625rem;
		border: none;
		background: linear-gradient(135deg, #F97316 0%, #EA580C 100%);
		color: #FFFFFF;
		font-size: 0.9375rem;
		font-weight: 800;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		cursor: pointer;
		box-shadow: 0 2px 6px rgba(249, 115, 22, 0.35);
		transition: all 0.15s ease;
	}

	.btn-new-task:hover {
		background: linear-gradient(135deg, #EA580C 0%, #C2410C 100%);
		transform: translateY(-1px);
		box-shadow: 0 4px 10px rgba(249, 115, 22, 0.45);
	}

	/* 2. Tarjeta de Métricas */
	.schedule-metrics-card {
		background: linear-gradient(180deg, #FFFFFF 0%, #F8FAFC 100%);
		border: 1px solid #E2E8F0;
		border-radius: 1rem;
		padding: 1.5rem;
		box-shadow: 0 2px 5px rgba(15, 23, 42, 0.04);
		display: grid;
		grid-template-columns: 1.3fr 1fr;
		gap: 1.5rem;
		align-items: center;
	}

	.metrics-main-col {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.metrics-title-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.metrics-badge-lead {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.75rem;
		font-weight: 800;
		color: #0F172A;
		letter-spacing: 0.05em;
	}

	.pulse-indicator {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background-color: #10B981;
		box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
	}

	.overdue-alert-pill {
		font-size: 0.75rem;
		font-weight: 800;
		color: #B91C1C;
		background-color: #FEF2F2;
		border: 1px solid #FECACA;
		padding: 0.2rem 0.6rem;
		border-radius: 9999px;
	}

	.progress-indicator-row {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.progress-big-number {
		display: flex;
		flex-direction: column;
		line-height: 1;
	}

	.pct-val {
		font-size: 2.25rem;
		font-weight: 900;
		color: #0F172A;
		font-family: 'JetBrains Mono', monospace;
	}

	.pct-label {
		font-size: 0.6875rem;
		font-weight: 700;
		color: #64748B;
		text-transform: uppercase;
		margin-top: 0.2rem;
	}

	.progress-bar-track {
		flex: 1;
		height: 16px;
		background-color: #E2E8F0;
		border-radius: 9999px;
		overflow: hidden;
		position: relative;
	}

	.progress-bar-fill {
		height: 100%;
		background: linear-gradient(90deg, #10B981 0%, #059669 100%);
		border-radius: 9999px;
		transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.metrics-chips-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 0.75rem;
	}

	.metric-chip-card {
		background-color: #FFFFFF;
		border: 1px solid #E2E8F0;
		border-radius: 0.625rem;
		padding: 0.75rem 0.5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.2rem;
	}

	.chip-number {
		font-size: 1.25rem;
		font-weight: 900;
		color: #0F172A;
		font-family: 'JetBrains Mono', monospace;
	}

	.chip-label {
		font-size: 0.6875rem;
		font-weight: 700;
		color: #64748B;
	}

	.metric-chip-card.chip-completed .chip-number {
		color: #059669;
	}

	.metric-chip-card.chip-in-progress .chip-number {
		color: #EA580C;
	}

	.metric-chip-card.chip-overdue .chip-number {
		color: #DC2626;
	}

	/* 3. Controls Cluster */
	.schedule-controls-cluster {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.segmented-view-switcher {
		display: flex;
		background-color: #E2E8F0;
		border-radius: 0.75rem;
		padding: 4px;
		gap: 4px;
	}

	.view-switch-btn {
		min-height: 48px;
		padding: 0 1.25rem;
		border-radius: 0.5rem;
		border: none;
		background: transparent;
		color: #475569;
		font-size: 0.875rem;
		font-weight: 700;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.view-switch-btn:hover {
		color: #0F172A;
	}

	.view-switch-btn.active {
		background-color: #FFFFFF;
		color: #0F172A;
		box-shadow: 0 1px 3px rgba(15, 23, 42, 0.1);
	}

	.tab-badge {
		font-size: 0.6875rem;
		font-weight: 800;
		padding: 0.15rem 0.45rem;
		border-radius: 9999px;
		background-color: #F1F5F9;
		color: #0F172A;
	}

	.view-switch-btn.active .tab-badge {
		background-color: #0F172A;
		color: #FFFFFF;
	}

	/* 4. Filter Chips */
	.filter-chips-bar {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.filter-chip {
		min-height: 44px;
		padding: 0 1rem;
		border-radius: 9999px;
		border: 1px solid #CBD5E1;
		background-color: #FFFFFF;
		color: #475569;
		font-size: 0.8125rem;
		font-weight: 700;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.filter-chip:hover {
		background-color: #F8FAFC;
		border-color: #94A3B8;
		color: #0F172A;
	}

	.filter-chip.active {
		background-color: #0F172A;
		border-color: #0F172A;
		color: #FFFFFF;
	}

	.filter-chip.chip-alert.active {
		background-color: #EF4444;
		border-color: #EF4444;
		color: #FFFFFF;
	}

	.views-stage-area {
		width: 100%;
	}

	.hidden {
		display: none !important;
	}

	@media (max-width: 900px) {
		.schedule-metrics-card {
			grid-template-columns: 1fr;
		}

		.metrics-chips-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.schedule-controls-cluster {
			flex-direction: column;
			align-items: flex-start;
		}

		.segmented-view-switcher {
			width: 100%;
			overflow-x: auto;
		}

		.view-switch-btn {
			flex: 1;
			justify-content: center;
			padding: 0 0.75rem;
			font-size: 0.75rem;
		}
	}

	@media (max-width: 640px) {
		.desktop-only {
			display: none !important;
		}

		.schedule-top-bar {
			flex-direction: column;
			align-items: stretch;
		}

		.top-bar-actions {
			justify-content: space-between;
		}

		.btn-new-task {
			flex: 1;
			justify-content: center;
		}
	}
</style>

<script>
	// HU-16: Orquestador y Motor Reactivo del Cronograma Táctil
	import {
		loadAllTasks,
		getTasksByProject,
		toggleTaskComplete,
		deleteTask,
		createTask,
		updateTask,
		addTaskEvidence,
		deleteTaskEvidence,
		addTaskComment,
		generateEvidenceSvg,
		resetDemoTasks,
		calculateProjectScheduleMetrics,
		isTaskOverdue,
		getProjectChapters,
		getTodayDateString,
		type ScheduleTask
	} from '../../lib/task-schedule-store.ts';
	import { getActiveRoleConfig } from '../../lib/role-store.ts';
	import Gantt from 'frappe-gantt';
	import '../../styles/frappe-gantt.css';

	// Estado local de la sesión
	let activeProjectId = 'proj_penthouse_poblado';
	let currentView: 'list' | 'calendar' | 'gantt' = 'list';
	let currentFilter: 'all' | 'pending' | 'in_progress' | 'completed' | 'overdue' = 'all';

	// Estado del Calendario
	let calYear = 2026;
	let calMonth = 10; // Noviembre (0-indexed: 10 = Noviembre)
	let calSelectedDate = getTodayDateString();

	// Estado del Gantt (Frappe Gantt)
	let ganttViewMode: 'Day' | 'Week' | 'Month' = 'Day';
	let ganttChapterFilter: string = 'all';
	let ganttCrewFilter: string = 'all';
	let frappeGanttInstance: any = null;
	let ganttZoom: 'days' | 'weeks' = 'days';

	function getModeColumnWidth(mode: 'Day' | 'Week' | 'Month'): number {
		switch (mode) {
			case 'Day': return 50;
			case 'Week': return 170; // Ancho generoso para que las fechas semanales (ej: 22 oct - 28 nov) no se partan y las barras sean amplias
			case 'Month': return 160; // 160px para que los nombres largos como "Septiembre" o "Noviembre" tengan espacio de sobra sin superponerse
		}
	}

	function initWorkspace() {
		setupEventListeners();
		updateAll();
	}

	function setupEventListeners() {
		// 1. Selector de Proyecto
		const projectSelect = document.getElementById('schedule-project-select') as HTMLSelectElement | null;
		projectSelect?.addEventListener('change', () => {
			activeProjectId = projectSelect.value;
			updateAll();
		});

		// 2. Botón Reset Demo
		document.getElementById('schedule-reset-btn')?.addEventListener('click', () => {
			resetDemoTasks();
			showToast('Tareas de demostración restablecidas correctamente.');
		});

		// 3. Botón Nueva Tarea (Abre Modal)
		document.getElementById('schedule-new-task-btn')?.addEventListener('click', () => {
			openCreateTaskModal();
		});

		// 4. Conmutador de Vistas (Lista / Calendario / Gantt)
		const tabBtns = document.querySelectorAll<HTMLButtonElement>('.view-switch-btn');
		tabBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const view = btn.dataset.view as 'list' | 'calendar' | 'gantt';
				if (!view || view === currentView) return;
				currentView = view;

				tabBtns.forEach((b) => {
					b.classList.remove('active');
					b.setAttribute('aria-selected', 'false');
				});
				btn.classList.add('active');
				btn.setAttribute('aria-selected', 'true');

				switchView(currentView);
			});
		});

		// 5. Filtros de Estado
		const filterChips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
		filterChips.forEach((chip) => {
			chip.addEventListener('click', () => {
				const filter = chip.dataset.filter as any;
				if (!filter) return;
				currentFilter = filter;

				filterChips.forEach((c) => c.classList.remove('active'));
				chip.classList.add('active');

				renderCurrentView();
			});
		});

		// 6. Controles de Calendario
		document.getElementById('cal-prev-month-btn')?.addEventListener('click', () => {
			calMonth--;
			if (calMonth < 0) {
				calMonth = 11;
				calYear--;
			}
			renderCalendarView();
		});

		document.getElementById('cal-next-month-btn')?.addEventListener('click', () => {
			calMonth++;
			if (calMonth > 11) {
				calMonth = 0;
				calYear++;
			}
			renderCalendarView();
		});

		document.getElementById('cal-today-btn')?.addEventListener('click', () => {
			const today = new Date();
			calYear = today.getFullYear();
			calMonth = today.getMonth();
			calSelectedDate = getTodayDateString();
			renderCalendarView();
		});

		// 7. Controles de Frappe Gantt (Escalas Día / Semana / Mes y Filtro de Capítulos)
		const setGanttMode = (mode: 'Day' | 'Week' | 'Month', activeBtnId: string) => {
			ganttViewMode = mode;
			['gantt-mode-day-btn', 'gantt-mode-week-btn', 'gantt-mode-month-btn'].forEach((id) => {
				const btn = document.getElementById(id);
				const isActive = id === activeBtnId;
				btn?.classList.toggle('active', isActive);
				btn?.setAttribute('aria-pressed', isActive ? 'true' : 'false');
			});
			renderGanttView();
		};

		document.getElementById('gantt-mode-day-btn')?.addEventListener('click', () => {
			setGanttMode('Day', 'gantt-mode-day-btn');
		});

		document.getElementById('gantt-mode-week-btn')?.addEventListener('click', () => {
			setGanttMode('Week', 'gantt-mode-week-btn');
		});

		document.getElementById('gantt-mode-month-btn')?.addEventListener('click', () => {
			setGanttMode('Month', 'gantt-mode-month-btn');
		});

		document.getElementById('gantt-chapter-select')?.addEventListener('change', (e) => {
			ganttChapterFilter = (e.target as HTMLSelectElement).value;
			renderGanttView();
		});

		document.getElementById('gantt-crew-select')?.addEventListener('change', (e) => {
			ganttCrewFilter = (e.target as HTMLSelectElement).value;
			renderGanttView();
		});

		window.addEventListener('open-task-modal-from-gantt', (e: any) => {
			if (e.detail?.taskId) {
				openTaskDetailModal(e.detail.taskId);
			}
		});

		// 8. Modal de Tareas y Modal de Detalle
		setupModalHandlers();
		setupTaskDetailModalHandlers();

		// 9. Evento global de actualización
		window.addEventListener('obraflow:tasks-updated', () => {
			updateAll();
		});
	}

	function switchView(view: 'list' | 'calendar' | 'gantt') {
		const listView = document.getElementById('schedule-task-list-view');
		const calView = document.getElementById('schedule-calendar-view');
		const ganttView = document.getElementById('schedule-gantt-view');
		const filterBar = document.getElementById('schedule-filter-bar');

		if (listView) listView.classList.toggle('hidden', view !== 'list');
		if (calView) calView.classList.toggle('hidden', view !== 'calendar');
		if (ganttView) ganttView.classList.toggle('hidden', view !== 'gantt');

		// Barra de filtros visible principalmente en Lista y Gantt
		if (filterBar) {
			filterBar.classList.toggle('hidden', view === 'calendar');
		}

		renderCurrentView();
	}

	function updateAll() {
		updateGanttChapterFilterOptions();
		updateGanttCrewFilterOptions();
		renderMetrics();
		renderCurrentView();
	}

	function updateGanttChapterFilterOptions() {
		const select = document.getElementById('gantt-chapter-select') as HTMLSelectElement | null;
		if (!select) return;
		const chapters = getProjectChapters(activeProjectId);
		const currentValue = select.value || 'all';
		let optionsHtml = '<option value="all">📁 Todos los Capítulos</option>';
		chapters.forEach((ch) => {
			optionsHtml += `<option value="${ch.id}">${escapeHtml(ch.name)}</option>`;
		});
		select.innerHTML = optionsHtml;
		if (chapters.some((ch) => ch.id === currentValue)) {
			select.value = currentValue;
			ganttChapterFilter = currentValue;
		} else {
			select.value = 'all';
			ganttChapterFilter = 'all';
		}
	}

	function updateGanttCrewFilterOptions() {
		const select = document.getElementById('gantt-crew-select') as HTMLSelectElement | null;
		if (!select) return;
		const allProjTasks = getTasksByProject(activeProjectId);
		const crewsSet = new Set<string>();
		allProjTasks.forEach((t) => {
			if (t.assigned_to) crewsSet.add(t.assigned_to.trim());
		});
		const crews = Array.from(crewsSet).sort();
		const currentValue = select.value || 'all';
		let optionsHtml = '<option value="all">👷 Todos los Responsables</option>';
		crews.forEach((c) => {
			optionsHtml += `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`;
		});
		select.innerHTML = optionsHtml;
		if (crews.includes(currentValue)) {
			select.value = currentValue;
			ganttCrewFilter = currentValue;
		} else {
			select.value = 'all';
			ganttCrewFilter = 'all';
		}
	}

	function localizeGanttUI() {
		const todayBtn = document.querySelector('#gantt-svg-viewport .today-button');
		if (todayBtn) {
			todayBtn.textContent = 'Hoy';
			todayBtn.setAttribute('title', 'Ir a la fecha actual');
		}
	}

	function fixChapterBarsEnclosure() {
		const chapterWrappers = document.querySelectorAll<SVGGElement>('#gantt-svg-viewport .bar-wrapper.bar-chapter');
		chapterWrappers.forEach((group) => {
			const bar = group.querySelector<SVGRectElement>('.bar');
			const barProgress = group.querySelector<SVGRectElement>('.bar-progress');
			const label = group.querySelector<SVGTextElement>('.bar-label');
			if (!bar || !label) return;

			let labelWidth = 240;
			try {
				const bbox = label.getBBox();
				if (bbox && bbox.width > 0) {
					labelWidth = bbox.width;
				}
			} catch (e) {}

			const barX = parseFloat(bar.getAttribute('x') || '0');
			const currentBarWidth = parseFloat(bar.getAttribute('width') || '0');
			const minWidthForLabel = labelWidth + 40;
			const finalWidth = Math.max(currentBarWidth, minWidthForLabel);

			if (finalWidth > currentBarWidth) {
				bar.setAttribute('width', finalWidth.toString());
				if (barProgress) {
					const currentProgWidth = parseFloat(barProgress.getAttribute('width') || '0');
					if (currentProgWidth > 0 && currentBarWidth > 0) {
						const pct = currentProgWidth / currentBarWidth;
						barProgress.setAttribute('width', (finalWidth * pct).toString());
					}
				}
			}

			// Asegura que el texto permanezca 100% adentro del cuadro oscuro con contraste blanco
			label.classList.remove('big');
			label.setAttribute('x', (barX + finalWidth / 2).toString());
			label.setAttribute('text-anchor', 'middle');
			label.style.fill = '#FFFFFF';
		});
	}

	function renderCurrentView() {
		if (currentView === 'list') {
			renderListView();
		} else if (currentView === 'calendar') {
			renderCalendarView();
		} else if (currentView === 'gantt') {
			renderGanttView();
		}
	}

	// ==========================================
	// MÉTRICAS GLOBALES
	// ==========================================
	function renderMetrics() {
		const metrics = calculateProjectScheduleMetrics(activeProjectId);

		const pctElem = document.getElementById('metrics-overall-pct');
		const barFill = document.getElementById('metrics-progress-bar-fill');
		const totalElem = document.getElementById('metrics-total-count');
		const compElem = document.getElementById('metrics-completed-count');
		const inProgElem = document.getElementById('metrics-in-progress-count');
		const overdueElem = document.getElementById('metrics-overdue-count');
		const tabCount = document.getElementById('tab-list-count');
		const overduePill = document.getElementById('metrics-overdue-alert-pill');
		const overduePillText = document.getElementById('overdue-pill-text');

		if (pctElem) pctElem.textContent = `${metrics.overall_progress_pct.toFixed(1)}%`;
		if (barFill) barFill.style.width = `${metrics.overall_progress_pct}%`;
		if (totalElem) totalElem.textContent = metrics.total_tasks.toString();
		if (compElem) compElem.textContent = metrics.completed_tasks.toString();
		if (inProgElem) inProgElem.textContent = metrics.in_progress_tasks.toString();
		if (overdueElem) overdueElem.textContent = metrics.overdue_tasks.toString();
		if (tabCount) tabCount.textContent = metrics.total_tasks.toString();

		if (overduePill && overduePillText) {
			if (metrics.overdue_tasks > 0) {
				overduePill.classList.remove('hidden');
				overduePillText.textContent = `${metrics.overdue_tasks} ${metrics.overdue_tasks === 1 ? 'Tarea Atrasada' : 'Tareas Atrasadas'}`;
			} else {
				overduePill.classList.add('hidden');
			}
		}
	}

	function filterTasks(tasks: ScheduleTask[]): ScheduleTask[] {
		const today = getTodayDateString();
		return tasks.filter((t) => {
			if (currentFilter === 'all') return true;
			if (currentFilter === 'completed') return t.status === 'completed';
			if (currentFilter === 'in_progress') return t.status === 'in_progress';
			if (currentFilter === 'pending') return t.status === 'pending';
			if (currentFilter === 'overdue') return isTaskOverdue(t, today);
			return true;
		});
	}

