		emptyState?.classList.add('hidden');
		let html = '';

		chapters.forEach((chap) => {
			const chapTasks = filteredTasks.filter((t) => t.chapter_id === chap.id);
			if (chapTasks.length === 0 && currentFilter !== 'all') {
