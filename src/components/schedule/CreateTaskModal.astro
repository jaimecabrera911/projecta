---
// src/components/schedule/CreateTaskModal.astro
// HU-16: Modal Táctil para Programar Nueva Actividad de Obra.
import { renderIconSvg } from '../../lib/icons';
---

<!-- Backdrop -->
<div id="create-task-modal-backdrop" class="modal-backdrop hidden" aria-hidden="true"></div>

<!-- Modal Container -->
<div
	id="create-task-modal"
	class="modal-dialog hidden"
	role="dialog"
	aria-modal="true"
	aria-labelledby="modal-task-heading"
>
	<div class="modal-card">
		<!-- Header del Modal -->
		<div class="modal-header">
			<div class="modal-header-left">
				<div class="modal-icon-badge">
					<Fragment set:html={renderIconSvg('calendar', { size: 20 })} />
				</div>
				<div>
					<h3 id="modal-task-heading" class="modal-title">Programar Actividad</h3>
					<p class="modal-subtitle">Agrega una tarea al cronograma de la obra</p>
				</div>
			</div>

			<button
				id="btn-close-task-modal"
				type="button"
				class="btn-modal-close"
				aria-label="Cerrar modal de tarea"
				title="Cerrar (Escape)"
			>
				<Fragment set:html={renderIconSvg('x', { size: 20 })} />
			</button>
		</div>

		<!-- Formulario -->
		<form id="create-task-form" class="modal-form" novalidate>
			<!-- Proyecto Activo (Oculto) -->
			<input type="hidden" id="task-form-project-id" name="project_id" value="" />

			<!-- Título de la Tarea -->
			<div class="form-group">
				<label for="task-form-title" class="form-label">
					Título de la Actividad <span class="required">*</span>
				</label>
				<input
					type="text"
					id="task-form-title"
					name="title"
					class="form-input"
					placeholder="Ej: Resane e imprimación de muros Sala"
					required
					autocomplete="off"
				/>
				<span id="task-form-title-error" class="form-error hidden">El título de la actividad es obligatorio.</span>
			</div>

			<!-- Capítulo de Obra -->
			<div class="form-group">
				<label for="task-form-chapter" class="form-label">
					Capítulo Presupuestal <span class="required">*</span>
				</label>
				<select id="task-form-chapter" name="chapter_id" class="form-select" required>
					<!-- Poblado dinámicamente -->
				</select>
			</div>

			<!-- Cuadrilla Asignada -->
			<div class="form-group">
				<label for="task-form-assigned" class="form-label">
					Cuadrilla / Responsable <span class="required">*</span>
				</label>
				<select id="task-form-assigned" name="assigned_to" class="form-select" required>
					<option value="Cuadrilla 1 - Albañilería">Cuadrilla 1 — Albañilería y Demolición</option>
					<option value="Cuadrilla 2 - Pintura y Yesos">Cuadrilla 2 — Pintura, Yesos y Acabados</option>
					<option value="Cuadrilla 3 - Plomería y Sanitarios">Cuadrilla 3 — Plomería e Instalaciones Hidráulicas</option>
					<option value="Cuadrilla 4 - Electricidad">Cuadrilla 4 — Redes Eléctricas e Iluminación</option>
					<option value="Oficial Maestro Restrepo">Oficial Maestro Restrepo</option>
					<option value="Contratista Carpintería">Contratista Carpintería y Muebles</option>
					<option value="Residente de Obra">Residente de Obra</option>
				</select>
			</div>

			<!-- Fechas: Inicio y Fin -->
			<div class="form-row-dates">
				<div class="form-group">
					<label for="task-form-start-date" class="form-label">
						Fecha de Inicio <span class="required">*</span>
					</label>
					<input
						type="date"
						id="task-form-start-date"
						name="start_date"
						class="form-input"
						required
					/>
				</div>

				<div class="form-group">
					<label for="task-form-end-date" class="form-label">
						Fecha Estimada de Fin <span class="required">*</span>
					</label>
					<input
						type="date"
						id="task-form-end-date"
						name="end_date"
						class="form-input"
						required
					/>
				</div>
			</div>
			<span id="task-form-dates-error" class="form-error hidden">La fecha de fin no puede ser anterior a la fecha de inicio.</span>

			<!-- Notas / Instrucciones -->
			<div class="form-group">
				<label for="task-form-desc" class="form-label">
					Instrucciones Técnicas / Notas (Opcional)
				</label>
				<textarea
					id="task-form-desc"
					name="description"
					class="form-textarea"
					rows="3"
					placeholder="Especificar detalles técnicos, precauciones o insumos requeridos..."
				></textarea>
			</div>

			<!-- Footer de Acciones -->
			<div class="modal-footer">
				<button
					id="btn-cancel-create-task"
					type="button"
					class="btn-modal-cancel"
				>
					Cancelar
				</button>
				<button
					id="btn-submit-create-task"
					type="submit"
					class="btn-modal-submit"
				>
					<Fragment set:html={renderIconSvg('check', { size: 18 })} />
					<span>Guardar Tarea</span>
				</button>
			</div>
		</form>
	</div>
</div>

<style>
	.modal-backdrop {
		position: fixed;
		inset: 0;
		background-color: rgba(15, 23, 42, 0.6);
		backdrop-filter: blur(4px);
		z-index: 200;
		transition: opacity 0.2s ease;
	}

	.modal-dialog {
		position: fixed;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem;
		z-index: 210;
		overflow-y: auto;
	}

	.modal-card {
		background-color: #FFFFFF;
		width: 100%;
		max-width: 540px;
		border-radius: 1rem;
		box-shadow: 0 20px 25px -5px rgba(15, 23, 42, 0.2), 0 10px 10px -5px rgba(15, 23, 42, 0.1);
		border: 1px solid #E2E8F0;
		overflow: hidden;
		animation: modalPopIn 0.2s cubic-bezier(0.16, 1, 0.3, 1);
	}

	@keyframes modalPopIn {
		from {
			opacity: 0;
			transform: scale(0.95) translateY(10px);
		}
		to {
			opacity: 1;
			transform: scale(1) translateY(0);
		}
	}

	.modal-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.25rem 1.5rem;
		border-bottom: 1px solid #E2E8F0;
		background-color: #F8FAFC;
	}

	.modal-header-left {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.modal-icon-badge {
		width: 40px;
		height: 40px;
		border-radius: 0.5rem;
		background-color: #FFF7ED;
		color: #EA580C;
		border: 1px solid #FFEDD5;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.modal-title {
		font-size: 1.125rem;
		font-weight: 800;
		color: #0F172A;
		margin: 0;
	}

	.modal-subtitle {
		font-size: 0.75rem;
		color: #64748B;
		margin: 0.15rem 0 0 0;
	}

	.btn-modal-close {
		width: 48px;
		height: 48px;
		border-radius: 0.5rem;
		border: none;
		background: transparent;
		color: #64748B;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.btn-modal-close:hover {
		background-color: #F1F5F9;
		color: #0F172A;
	}

	.modal-form {
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 1.125rem;
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.form-label {
		font-size: 0.8125rem;
		font-weight: 700;
		color: #1E293B;
	}

	.required {
		color: #EF4444;
	}

	.form-input,
	.form-select,
	.form-textarea {
		width: 100%;
		border-radius: 0.5rem;
		border: 1px solid #CBD5E1;
		background-color: #FFFFFF;
		color: #0F172A;
		font-family: inherit;
		font-size: 0.875rem;
		padding: 0.625rem 0.875rem;
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
		box-sizing: border-box;
	}

	.form-input:focus,
	.form-select:focus,
	.form-textarea:focus {
		outline: none;
		border-color: #F97316;
		box-shadow: 0 0 0 3px rgba(249, 115, 22, 0.15);
	}

	.form-row-dates {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	.form-textarea {
		resize: vertical;
		min-height: 70px;
	}

	.form-error {
		font-size: 0.75rem;
		color: #DC2626;
		font-weight: 600;
	}

	.modal-footer {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.75rem;
		padding-top: 0.5rem;
		border-top: 1px solid #F1F5F9;
	}

	.btn-modal-cancel {
		min-height: 48px;
		padding: 0 1.25rem;
		border-radius: 0.5rem;
		border: 1px solid #CBD5E1;
		background-color: #FFFFFF;
		color: #475569;
		font-size: 0.875rem;
		font-weight: 700;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.btn-modal-cancel:hover {
		background-color: #F8FAFC;
		color: #0F172A;
	}

	.btn-modal-submit {
		min-height: 48px;
		padding: 0 1.5rem;
		border-radius: 0.5rem;
		border: none;
		background: linear-gradient(135deg, #F97316 0%, #EA580C 100%);
		color: #FFFFFF;
		font-size: 0.875rem;
		font-weight: 800;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		cursor: pointer;
		box-shadow: 0 2px 6px rgba(249, 115, 22, 0.35);
		transition: all 0.15s ease;
	}

	.btn-modal-submit:hover {
		background: linear-gradient(135deg, #EA580C 0%, #C2410C 100%);
		transform: translateY(-1px);
		box-shadow: 0 4px 10px rgba(249, 115, 22, 0.4);
	}

	.hidden {
		display: none !important;
	}

	@media (max-width: 640px) {
		.form-row-dates {
			grid-template-columns: 1fr;
		}

		.modal-footer {
			flex-direction: column-reverse;
			width: 100%;
		}

		.btn-modal-cancel,
		.btn-modal-submit {
			width: 100%;
			justify-content: center;
		}
	}
</style>
